-- 튜토리얼 한 스텝의 표시/진행 데이터를 정의하는 구조체입니다.
@Struct
script TutorialStepData

	property string kind = "normal"

	property string portrait = ""

	property string text = ""

	property string textKey = ""

	property Vector2 charPos = Vector2(-200, -480)

	property boolean flip = false

	property any highlights = {}

	property string advanceEventId = ""

end

-- 활동 결과를 서버 권위 캐릭터/진행 데이터에 적용합니다.
@Logic
script ActivityHandler extends Logic

	@ExecSpace("Server")
	method void RequestApplyActivity(string requestId, string characterId, string activityId)
		-- 활동 결과 한 건 적용을 서버에 요청합니다.
		-- requestId는 비동기 응답 매칭용이며, characterId와 activityId는 적용 대상입니다.
		-- 결과는 반환하지 않고 ActivityAppliedEvent로 호출한 클라이언트에 전달합니다.
		if _CharacterManager:CanUseCharacters(senderUserId) == false then
			local deniedResult = ActivityApplyResult()
			deniedResult.requestId = requestId or ""
			self:SyncActivityApplied(deniedResult:ToPlainTable(), senderUserId)
			return
		end

		local result = self:ApplyActivity(requestId, characterId, activityId)
		if result == nil then
			result = ActivityApplyResult()
			result.requestId = requestId or ""
		end

		if result.success == true then
			if result.characterChanged == true then
				_CharacterManager:PushCharactersToClient(senderUserId)
			end
			if result.progressChanged == true and _ProgressManager ~= nil and _ProgressManager:IsProgressLoaded() then
				_ProgressManager:PushProgressToClient(senderUserId)
			end
		end

		self:SyncActivityApplied(result:ToPlainTable(), senderUserId)
	end

	@ExecSpace("Client")
	method void SyncActivityApplied(table tResultPlain)
		-- 서버에서 받은 활동 적용 결과를 클라이언트 이벤트로 알립니다.
		local activityAppliedEvent = ActivityAppliedEvent()
		activityAppliedEvent.result = tResultPlain
		self:SendEvent(activityAppliedEvent)
	end

	@ExecSpace("ServerOnly")
	method any ApplyActivity(string requestId, string characterId, string activityId)
		-- 검증된 활동 결과 한 건을 서버 권위 데이터에 적용합니다.
		local result = ActivityApplyResult()
		result.requestId = requestId or ""

		local safeCharacterId = characterId or ""
		local safeActivityId = activityId or ""
		if _ActivityManager ~= nil and _ActivityManager:ServerHasActivityUnlocked(safeActivityId) == false then
			log_warning("[ActivityHandler] activity is locked activityId=" .. tostring(safeActivityId))
			return result
		end

		local activity = _ActivityMaster:GetActivity(safeActivityId)
		if activity == nil then
			log_warning("[ActivityHandler] activity not found activityId=" .. tostring(safeActivityId))
			return result
		end

		local tCharacter = nil
		if safeCharacterId ~= "" then
			tCharacter = _CharacterManager:ServerGetCharacterById(safeCharacterId)
		end

		local currentFatigue = tCharacter ~= nil and tCharacter.fatigue or 0
		local vocalGain = activity.vocal or 0
		local danceGain = activity.dance or 0
		local visualGain = activity.visual or 0
		local fandomDelta = activity.fandom or 0
		local fatigueDelta = activity.fatigue or 0
		local activityType = string.lower(activity.type or "")
		local failureChance = 0
		local isFailed = false
		local characterRequested = vocalGain ~= 0 or danceGain ~= 0 or visualGain ~= 0 or fatigueDelta ~= 0

		if activityType == "training" and tCharacter ~= nil then
			failureChance = _ConditionMaster:GetFailureChanceByFatigue(currentFatigue)
			isFailed = self:IsTrainingFailed(failureChance)
			if isFailed == true then
				log("[ActivityHandler] training failed characterId=" .. tostring(safeCharacterId)
					.. " activityId=" .. tostring(safeActivityId)
					.. " startFatigue=" .. tostring(currentFatigue)
					.. " failureChance=" .. tostring(failureChance))
				vocalGain = 0
				danceGain = 0
				visualGain = 0
				fandomDelta = 0
			end
		end

		if characterRequested == true and tCharacter == nil then
			log_warning("[ActivityHandler] character stat apply skipped. character not found characterId=" .. tostring(safeCharacterId)
				.. " activityId=" .. tostring(safeActivityId))
			vocalGain = 0
			danceGain = 0
			visualGain = 0
			fatigueDelta = 0
		end

		if tCharacter ~= nil then
			vocalGain = self:GetClampAppliedDelta(tCharacter.vocal, vocalGain, 0, 999)
			danceGain = self:GetClampAppliedDelta(tCharacter.dance, danceGain, 0, 999)
			visualGain = self:GetClampAppliedDelta(tCharacter.visual, visualGain, 0, 999)
			fatigueDelta = self:GetClampAppliedDelta(currentFatigue, fatigueDelta, 0, 100)
		end

		local progressRequested = fandomDelta ~= 0
		if fandomDelta ~= 0 and _ProgressManager ~= nil then
			local progress = _ProgressManager:ServerGetProgress()
			if progress ~= nil then
				fandomDelta = self:GetClampMinAppliedDelta(progress.fandom or 0, fandomDelta)
			end
		end

		local characterStatDelta = CharacterStatDelta()
		characterStatDelta.characterId = safeCharacterId
		characterStatDelta.vocal = vocalGain
		characterStatDelta.dance = danceGain
		characterStatDelta.visual = visualGain
		characterStatDelta.fatigue = fatigueDelta

		local characterChanged = vocalGain ~= 0 or danceGain ~= 0 or visualGain ~= 0 or fatigueDelta ~= 0
		result.characterChanged = characterChanged
		result.fandomDelta = fandomDelta
		-- CharacterStatDelta는 매니저/RPC 결과로 넘기기 전에 plain table로 보관합니다.
		result.characterStatDelta = characterStatDelta:ToPlainTable()
		local progressStatDelta = ProgressStatDelta()
		progressStatDelta.fandom = fandomDelta
		result.progressStatDelta = progressStatDelta:ToPlainTable()
		result.activityResult = {
			characterId = safeCharacterId,
			activityId = activity.id or "",
			activityType = activityType,
			vocal = vocalGain,
			dance = danceGain,
			visual = visualGain,
			fatigue = fatigueDelta,
			fandom = fandomDelta,
			failed = isFailed,
			failureChance = failureChance,
			startFatigue = currentFatigue
		}

		if fandomDelta ~= 0 and (_ProgressManager == nil or _ProgressManager:IsProgressLoaded() == false) then
			log_warning("[ActivityHandler] ProgressManager is not ready")
			return result
		end

		if characterChanged == true and _CharacterManager:ApplyCharacterStat(result.characterStatDelta) == false then
			return result
		end

		if fandomDelta ~= 0 then
			if _ProgressManager:ApplyProgressStat(progressStatDelta:ToPlainTable()) == false then
				return result
			end
			result.progressChanged = true
		end

		if characterRequested == true and tCharacter == nil and progressRequested == false then
			return result
		end

		result.success = true
		return result
	end

	@ExecSpace("ServerOnly")
	method boolean IsTrainingFailed(number failureChancePercent)
		-- 0~100 범위의 실패 확률을 바탕으로 훈련 실패 여부를 결정합니다.
		if failureChancePercent <= 0 then
			return false
		end

		if failureChancePercent >= 100 then
			return true
		end

		local roll = math.random(1, 100)
		return roll <= failureChancePercent
	end

	@ExecSpace("ServerOnly")
	method number GetClampMinAppliedDelta(number currentValue, number requestedDelta)
		-- 하한 클램프가 있는 스탯의 실제 적용 델타를 계산합니다.
		local current = currentValue or 0
		local delta = requestedDelta or 0
		local nextValue = _MathUtil:ClampMin(current + delta, 0)
		return nextValue - current
	end

	@ExecSpace("ServerOnly")
	method number GetClampAppliedDelta(number currentValue, number requestedDelta, number minValue, number maxValue)
		-- 상하한 클램프가 있는 스탯의 실제 적용 델타를 계산합니다.
		local current = currentValue or 0
		local delta = requestedDelta or 0
		local nextValue = _MathUtil:Clamp(current + delta, minValue, maxValue)
		return nextValue - current
	end

end

@Logic
script MathUtil extends Logic

	method integer Round(number value)
		-- 현재 점수와 평균 계산에서 사용하는 양수 기준 반올림입니다.
		return math.floor(value + 0.5)
	end

	method number ClampMin(number value, number minValue)
		-- 값이 최소값보다 작으면 최소값으로 보정합니다.
		return math.max(value, minValue)
	end

	method number ClampMax(number value, number maxValue)
		-- 값이 최대값보다 크면 최대값으로 보정합니다.
		return math.min(value, maxValue)
	end

	method number Clamp(number value, number minValue, number maxValue)
		-- 값을 최소값과 최대값 사이로 보정합니다.
		return math.min(math.max(value, minValue), maxValue)
	end

	method number RandomRange(number minValue, number maxValue)
		-- 최소값과 최대값 사이의 랜덤 실수 값을 반환합니다.
		if maxValue <= minValue then
			return minValue
		end

		return minValue + (_UtilLogic:RandomDouble() * (maxValue - minValue))
	end
end

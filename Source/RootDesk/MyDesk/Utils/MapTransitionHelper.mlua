-- 화면 페이드와 실제 맵 도착 대기를 포함한 클라이언트 맵 전환을 담당합니다.
@Logic
script MapTransitionHelper extends Logic

	property number transitionDuration = 1

	property number settleDelay = 0.75

	property number prevCameraTransitionBlendTime = 2

	property boolean isCameraTransitionBlendOverride = false

	property boolean isWaitingMapTransition = false

	property boolean isFadeInStarted = false

	-- 현재 전환의 이동 콜백 실행 여부
	property boolean isMoveActionDispatched = false

	-- 이전 전환의 지연 콜백 차단용 번호
	property integer transitionSequence = 0

	-- 진행 중인 전환 이후 실행할 이동 요청
	property any queuedMoveActions = {}

	---@type MapTransitionRequestData
	property any tActiveRequest = nil

	---@type MapTransitionResultData
	property any tPendingResult = nil

	property any pendingFadeInCallback = nil

	property boolean isShuttingDown = false

	property string REASON_CANCELLED = "cancelled"

	property string REASON_FADE_OUT_TIMEOUT = "fade_out_timeout"

	property string REASON_ARRIVAL_TIMEOUT = "arrival_timeout"

	property string REASON_MOVE_ACTION_FAILED = "move_action_failed"

	property string REASON_PLAY_ENDED = "play_ended"

	property string pendingMapName = ""

	property number pendingElapsed = 0

	property number transitionTimeout = 5

	property number worldViewSizeToleranceRatio = 0.02

	property boolean hasWorldViewReference = false

	property number worldViewWidthAtZoom100 = 0

	property number worldViewHeightAtZoom100 = 0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 새 플레이 세션의 이동 요청 접수 허용
		self.isShuttingDown = false
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 페이드와 이동 대기를 구분하고 모든 종료 경로에서 결과 통지
		if self.isWaitingMapTransition == false then
			return
		end

		self.pendingElapsed = self.pendingElapsed + delta
		local fadeTimeout = math.max(self.transitionDuration, 0) + self.transitionTimeout
		if self.isFadeInStarted == true then
			if self.pendingElapsed >= fadeTimeout then
				log_warning("[MapTransition] fade in callback timed out map=" .. tostring(self.pendingMapName))
				if _ScreenEffectUILogic ~= nil
					and _ScreenEffectUILogic.onEffectComplete == self.pendingFadeInCallback
					and _ScreenEffectUILogic:IsBlackHeld() == false then
					_ScreenEffectUILogic:Clear()
				end
				self:Complete()
			end
			return
		end

		if self.isMoveActionDispatched == false then
			if self.pendingElapsed >= fadeTimeout then
				self:FinishTransition(false, self.REASON_FADE_OUT_TIMEOUT)
			end
			return
		end

		local player = _UserService.LocalPlayer
		local currentMap = player ~= nil and player.CurrentMap or nil
		local isArrived = isvalid(currentMap) and currentMap.Name == self.pendingMapName
		local isConfirmed = self.tActiveRequest.requiresArrivalConfirmation == false
			or self.tActiveRequest.isArrivalConfirmed == true
		local arrivalTimeout = self.tActiveRequest.arrivalTimeout > 0
			and self.tActiveRequest.arrivalTimeout or self.transitionTimeout
		if isArrived == true and isConfirmed == true and self:IsTargetMapCameraReady(currentMap) == true then
			self:FinishTransition(true, "")
		elseif self.pendingElapsed >= arrivalTimeout then
			self:FinishTransition(false, self.REASON_ARRIVAL_TIMEOUT)
		end
	end

	@ExecSpace("ClientOnly")
	method boolean IsTargetMapCameraReady(Entity currentMap)
		-- 목표 카메라 전환과 해당 줌 기준의 월드 가시 범위 반영이 모두 끝났는지 확인합니다.
		if isvalid(currentMap) == false then
			return false
		end

		---@type CameraControlComponent
		local cameraControl = currentMap:GetComponent("script.CameraControlComponent")
		if isvalid(cameraControl) == false then
			return true
		end

		local targetCamera = cameraControl:GetMapCamera()
		if targetCamera == nil then return true end
		local currentCamera = _CameraService:GetCurrentCameraComponent()
		if currentCamera ~= targetCamera then
			return false
		end

		return self:IsCameraProjectionReady(targetCamera)
	end

	@ExecSpace("ClientOnly")
	method boolean CaptureWorldViewReference()
		-- zoom이 100일때를 기준으로 목표 zoom을 통해 화면의 월드 좌표 영역이 올바르게 세팅되었는지 검사합니다.
		if _CameraBoundsUtil == nil then
			self.hasWorldViewReference = false
			return false
		end

		local bounds = _CameraBoundsUtil:GetCurrentWorldPosBounds()
		local currentZoom = _CameraService.currentZoomRatio
		if bounds == nil or currentZoom == nil or currentZoom <= 0 then
			self.hasWorldViewReference = false
			return false
		end

		local worldViewSize = _CameraBoundsUtil:GetBoundsSize(bounds)
		self.worldViewWidthAtZoom100 = worldViewSize.x * currentZoom / 100
		self.worldViewHeightAtZoom100 = worldViewSize.y * currentZoom / 100
		self.hasWorldViewReference = self.worldViewWidthAtZoom100 > 0 and self.worldViewHeightAtZoom100 > 0
		return self.hasWorldViewReference
	end

	@ExecSpace("ClientOnly")
	method boolean IsCameraProjectionReady(CameraComponent targetCamera)
		-- 현재 화면 좌표 변환 크기가 이 디바이스와 목표 줌에서 예상되는 월드 크기인지 확인합니다.
		if targetCamera == nil or self.hasWorldViewReference == false or _CameraBoundsUtil == nil then
			return false
		end

		local targetZoom = targetCamera.ZoomRatio
		if targetZoom == nil or targetZoom <= 0 then
			return false
		end

		local bounds = _CameraBoundsUtil:GetCurrentWorldPosBounds()
		if bounds == nil then
			return false
		end

		local expectedWorldViewSize = Vector2(
			self.worldViewWidthAtZoom100 * 100 / targetZoom,
			self.worldViewHeightAtZoom100 * 100 / targetZoom
		)
		return _CameraBoundsUtil:IsBoundsSizeWithinRatio(bounds, expectedWorldViewSize, self.worldViewSizeToleranceRatio)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 플레이 종료 시 활성·대기 요청에 종료 결과 통지
		self.isShuttingDown = true
		local queuedRequests = self.queuedMoveActions
		self.queuedMoveActions = {}
		if self.tActiveRequest ~= nil then
			self.tPendingResult = self:CreateResult(self.tActiveRequest, false, self.REASON_PLAY_ENDED)
		end
		self:Complete()
		for _, tRequest in ipairs(queuedRequests) do
			self:NotifyCompleted(tRequest, self:CreateResult(tRequest, false, self.REASON_PLAY_ENDED))
		end
	end

	@ExecSpace("ClientOnly")
	method void RequestMoveToMap(string targetMapName, any mapMoveAction)
		-- 기존 호출부의 두 인자 이동 API 유지
		self:RequestMoveToMapWithResult(targetMapName, mapMoveAction, nil)
	end

	@ExecSpace("ClientOnly")
	method integer RequestMoveToMapWithResult(string targetMapName, any mapMoveAction, any onCompleted)
		-- 완료 결과와 취소용 전환 ID를 제공하는 이동 요청 등록
		local tRequest = MapTransitionRequestData()
		tRequest.targetMapName = targetMapName
		tRequest.moveAction = mapMoveAction
		tRequest.onCompleted = onCompleted
		return self:SubmitRequest(tRequest)
	end

	@ExecSpace("ClientOnly")
	method integer SubmitRequest(MapTransitionRequestData tRequest)
		-- 콜백 실행 전에 전환 ID를 확정하고 내부 요청 Struct 등록
		if self.isShuttingDown == true or tRequest == nil or tRequest.transitionId ~= 0
			or tRequest.targetMapName == nil or tRequest.targetMapName == ""
			or type(tRequest.moveAction) ~= "function" then
			return 0
		end

		self.transitionSequence = self.transitionSequence + 1
		tRequest.transitionId = self.transitionSequence
		table.insert(self.queuedMoveActions, tRequest)
		if self.isWaitingMapTransition == true then
			log("[MapTransition] queued map=" .. tostring(tRequest.targetMapName)
				.. " count=" .. tostring(#self.queuedMoveActions))
		end
		self:StartNextMove()
		return tRequest.transitionId
	end

	@ExecSpace("ClientOnly")
	method void StartNextMove()
		-- 진행 중인 전환이 없을 때 가장 먼저 등록된 요청 실행
		if self.isShuttingDown == true or self.isWaitingMapTransition == true or #self.queuedMoveActions == 0 then
			return
		end

		local tRequest = table.remove(self.queuedMoveActions, 1)
		self:BeginMoveToMap(tRequest)
	end

	@ExecSpace("ClientOnly")
	method void BeginMoveToMap(MapTransitionRequestData tRequest)
		-- 요청 소유권 설정과 페이드아웃 이후 이동 콜백 예약
		local transitionId = tRequest.transitionId
		self.tActiveRequest = tRequest
		self.tPendingResult = nil
		self.pendingMapName = tRequest.targetMapName
		self.pendingElapsed = 0
		self.isWaitingMapTransition = true
		self.isFadeInStarted = false
		self.isMoveActionDispatched = false
		log("[MapTransition] started id=" .. tostring(transitionId)
			.. " map=" .. tostring(self.pendingMapName))
		if self:CaptureWorldViewReference() == false then
			log_warning("[MapTransition] failed to capture world view reference map=" .. tostring(self.pendingMapName))
		end
		self:BeginImmediateCameraMode()

		-- 이미 덮인 화면에서는 이동 콜백 즉시 실행
		if _ScreenEffectUILogic ~= nil then
			if _ScreenEffectUILogic.currentAlpha >= 0.99 then
				self:ExecuteMoveAction(transitionId)
				return
			end

			_ScreenEffectUILogic:FadeOut(self.transitionDuration, function()
				self:ExecuteMoveAction(transitionId)
			end)
			return
		end

		self:ExecuteMoveAction(transitionId)
	end

	@ExecSpace("ClientOnly")
	method void ExecuteMoveAction(integer transitionId)
		-- 현재 전환에 해당하는 이동 콜백을 한 번만 실행
		if self:IsCurrentTransition(transitionId) == false
			or self.isFadeInStarted == true
			or self.isMoveActionDispatched == true then
			return
		end

		self.isMoveActionDispatched = true
		self.pendingElapsed = 0
		log("[MapTransition] dispatched id=" .. tostring(transitionId)
			.. " map=" .. tostring(self.pendingMapName))
		local moveAction = self.tActiveRequest.moveAction
		self.tActiveRequest.moveAction = nil
		local success, errorMessage = pcall(moveAction)
		if success == false and self:IsCurrentTransition(transitionId) == true then
			log_error("[MapTransition] move action failed id=" .. tostring(transitionId) .. " error=" .. tostring(errorMessage))
			self:FinishTransition(false, self.REASON_MOVE_ACTION_FAILED)
		end
	end

	@ExecSpace("ClientOnly")
	method boolean IsCurrentTransition(integer transitionId)
		-- 활성 요청에 대한 지연 콜백 소유권 확인
		return self.isWaitingMapTransition == true and self.tActiveRequest ~= nil
			and self.tActiveRequest.transitionId == transitionId
	end

	@ExecSpace("ClientOnly")
	method boolean ConfirmArrival(integer transitionId)
		-- 서버 도착 결과를 이미 이동 요청이 실행된 해당 전환에만 반영
		if self:IsCurrentTransition(transitionId) == false
			or self.isMoveActionDispatched == false or self.isFadeInStarted == true then
			return false
		end
		self.tActiveRequest.isArrivalConfirmed = true
		return true
	end

	@ExecSpace("ClientOnly")
	method void FinishTransition(boolean success, string reason)
		-- 전환 결과 보관 후 화면 복구 시작
		if self.tActiveRequest == nil then
			return
		end
		self.tPendingResult = self:CreateResult(self.tActiveRequest, success, reason)
		self:StartFadeIn()
	end

	@ExecSpace("ClientOnly")
	method void StartFadeIn()
		-- 현재 전환의 화면 복구를 한 번 시작하고 완료 콜백 소유권 확인
		if self.isWaitingMapTransition == false or self.isFadeInStarted == true then
			return
		end

		self.isFadeInStarted = true
		self.pendingElapsed = 0
		local transitionId = self.tActiveRequest.transitionId
		if _ScreenEffectUILogic ~= nil then
			self.pendingFadeInCallback = function()
				if self:IsCurrentTransition(transitionId) == true then
					self:Complete()
				end
			end
			_ScreenEffectUILogic:FadeIn(self.transitionDuration, self.pendingFadeInCallback)
			return
		end

		self:Complete()
	end

	@ExecSpace("ClientOnly")
	method void Complete()
		-- 현재 전환 상태와 카메라 블렌드 복구 이후 다음 대기 요청 시작
		local tRequest = self.tActiveRequest
		local tResult = self.tPendingResult
		self.tActiveRequest = nil
		self.tPendingResult = nil
		self.pendingFadeInCallback = nil
		self.isWaitingMapTransition = false
		self.isFadeInStarted = false
		self.isMoveActionDispatched = false
		self.pendingMapName = ""
		self.pendingElapsed = 0
		self:EndImmediateCameraMode()
		if tRequest ~= nil then
			self:NotifyCompleted(tRequest, tResult or self:CreateResult(tRequest, false, self.REASON_CANCELLED))
		end
		self:StartNextMove()
	end

	@ExecSpace("ClientOnly")
	method MapTransitionResultData CreateResult(MapTransitionRequestData tRequest, boolean success, string reason)
		-- 요청 ID와 목적지가 포함된 전환 결과 생성
		local tResult = MapTransitionResultData()
		tResult.transitionId = tRequest.transitionId
		tResult.targetMapName = tRequest.targetMapName
		tResult.success = success
		tResult.reason = reason or ""
		return tResult
	end

	@ExecSpace("ClientOnly")
	method void NotifyCompleted(MapTransitionRequestData tRequest, MapTransitionResultData tResult)
		-- 콜백 참조를 먼저 해제하고 결과를 한 번 통지
		local onCompleted = tRequest.onCompleted
		tRequest.onCompleted = nil
		tRequest.moveAction = nil
		log("[MapTransition] completed id=" .. tostring(tResult.transitionId)
			.. " map=" .. tostring(tResult.targetMapName)
			.. " success=" .. tostring(tResult.success) .. " reason=" .. tostring(tResult.reason))
		if onCompleted ~= nil then
			local success, errorMessage = pcall(onCompleted, tResult)
			if success == false then
				log_error("[MapTransition] completion callback failed error=" .. tostring(errorMessage))
			end
		end
	end

	@ExecSpace("ClientOnly")
	method boolean CancelTransition(integer transitionId, string reason)
		-- 요청 ID가 일치하는 활성 또는 대기 전환만 취소
		if self:IsCurrentTransition(transitionId) == true then
			self:FinishTransition(false, reason)
			return true
		end
		for index, tRequest in ipairs(self.queuedMoveActions) do
			if tRequest.transitionId == transitionId then
				table.remove(self.queuedMoveActions, index)
				self:NotifyCompleted(tRequest, self:CreateResult(tRequest, false, reason))
				return true
			end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method void CancelPendingTransition()
		-- 기존 활성 전환 취소 API 유지
		if self.tActiveRequest == nil then
			return
		end

		self:CancelTransition(self.tActiveRequest.transitionId, self.REASON_CANCELLED)
	end

	@ExecSpace("ClientOnly")
	method void BeginImmediateCameraMode()
		-- 실제 맵 이동 RPC가 완료될 때까지 카메라 전환 블렌드를 0으로 유지합니다.
		if self.isCameraTransitionBlendOverride == false then
			self.prevCameraTransitionBlendTime = _CameraService.TransitionBlendTime
			self.isCameraTransitionBlendOverride = true
		end

		_CameraService.TransitionBlendTime = 0
	end

	@ExecSpace("ClientOnly")
	method void EndImmediateCameraMode()
		-- 임시로 0으로 둔 카메라 전환 블렌드를 원래 값으로 되돌립니다.
		if self.isCameraTransitionBlendOverride == false then
			return
		end

		_CameraService.TransitionBlendTime = self.prevCameraTransitionBlendTime
		self.isCameraTransitionBlendOverride = false
	end

end

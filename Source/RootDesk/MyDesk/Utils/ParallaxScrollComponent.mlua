---@description "배경 레이어 패럴랙스 스크롤 컴포넌트. 클라 전용 연출."
@Component
script ParallaxScrollComponent extends Component

	-- 실제 카메라 이동량을 레이어에 반영하는 축별 비율, 0=월드 고정, 1=화면 고정
	property Vector2 FollowFactor = Vector2(0.85, 0.85)

	-- 배경 위치 계산의 기준 월드 좌표
	@HideFromInspector
	property Vector3 _initialLayerPos = Vector3(0, 0, 0)

	-- 최초 유효 프레임의 카메라 뷰 중심 월드 좌표
	@HideFromInspector
	property Vector2 _initialCameraPos = Vector2(0, 0)

	-- 카메라 기준 좌표 캡처 완료 여부
	@HideFromInspector
	property boolean _initialized = false

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 레이어 원점 저장 및 카메라 기준 좌표 초기화
		self._initialLayerPos = self.Entity.TransformComponent.WorldPosition
		self._initialized = false
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 현재 맵의 카메라 준비 이후 초기 위치 기준 패럴랙스 계산
		local player = _UserService.LocalPlayer
		if not isvalid(player) or player.CurrentMap ~= self.Entity.CurrentMap then return end

		local cameraPos = self:GetCameraCenterWorldPosition()
		if cameraPos == nil then return end

		if not self._initialized then
			self._initialCameraPos = Vector2(cameraPos.x, cameraPos.y)
			self._initialized = true
			return
		end

		-- 미세 이동량을 버리지 않고 초기 카메라 좌표와의 차이를 직접 반영
		local offsetX = (cameraPos.x - self._initialCameraPos.x) * self.FollowFactor.x
		local offsetY = (cameraPos.y - self._initialCameraPos.y) * self.FollowFactor.y
		self.Entity.TransformComponent.WorldPosition = Vector3(
			self._initialLayerPos.x + offsetX,
			self._initialLayerPos.y + offsetY,
			self._initialLayerPos.z)
	end

	@ExecSpace("ClientOnly")
	method any GetCameraCenterWorldPosition()
		-- 화면 중심의 월드 변환으로 카메라 경계 제한과 오프셋이 반영된 좌표 조회
		if _UILogic == nil or _UILogic.ScreenWidth <= 0 or _UILogic.ScreenHeight <= 0 then
			return nil
		end
		local screenCenter = Vector2(_UILogic.ScreenWidth / 2, _UILogic.ScreenHeight / 2)
		return _UILogic:ScreenToWorldPosition(screenCenter)
	end

end

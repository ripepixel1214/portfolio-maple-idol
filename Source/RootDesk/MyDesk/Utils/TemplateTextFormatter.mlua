@Logic
script TemplateTextFormatter extends Logic

	method string FormatText(string text, string token, any value)
		-- 템플릿 문자열 안의 단일 토큰을 지정한 값으로 치환합니다.
		if text == nil then
			return ""
		end

		return self:ReplaceToken(text, token, tostring(value))
	end

	method string FormatNumberValue(string text, integer valueIndex, number value)
		-- valueIndex에 해당하는 {valueN} 토큰을 숫자 문자열로 치환합니다.
		local valueToken = "{value" .. tostring(valueIndex) .. "}"
		return self:ReplaceToken(text, valueToken, self:ToNumberText(value))
	end

	method string FormatPercentValue(string text, integer valueIndex, number value)
		-- valueIndex에 해당하는 {valueNPercent} 토큰을 퍼센트 숫자 문자열로 치환합니다.
		local percentToken = "{value" .. tostring(valueIndex) .. "Percent}"
		return self:ReplaceToken(text, percentToken, self:ToPercentText(value))
	end

	method string ToPercentText(number value)
		-- 0.3 같은 비율 값을 30 같은 퍼센트 숫자 문자열로 변환합니다.
		return self:ToNumberText(value * 100)
	end

	method string ToNumberText(number value)
		-- 소수점이 필요 없는 숫자를 정수 문자열로 정리합니다.
		local flooredValue = math.floor(value)

		if value == flooredValue then
			return tostring(flooredValue)
		end

		return tostring(value)
	end

	method Color TextToColor(string colorKey)
		-- 테이블에서 사용하는 색상 키를 UI 텍스트 색상으로 변환합니다.
		if colorKey == "green" then
			return Color(0.49, 0.89, 0.64, 1)
		end

		if colorKey == "red" then
			return Color(1, 0.42, 0.48, 1)
		end

		if colorKey == "purple" then
			return Color(0.86, 0.55, 0.95, 1)
		end

		if colorKey == "pink" then
			return Color(0.96, 0.45, 0.72, 1)
		end

		if colorKey == "blue" then
			return Color(0.47, 0.68, 0.96, 1)
		end

		if colorKey == "neutral" then
			return Color(0.91, 0.93, 0.96, 1)
		end

		return Color(0.96, 0.63, 0.81, 1)
	end

	method string ReplaceToken(string text, string token, string value)
		-- 패턴과 치환 문자열 해석을 피한 순수 토큰 치환
		if text == nil then
			return ""
		end

		if token == nil or token == "" then
			return text
		end

		local replacement = value or ""
		local formattedText = text
		local searchStart = 1
		while true do
			local tokenStart, tokenEnd = string.find(formattedText, token, searchStart, true)
			if tokenStart == nil then
				break
			end

			local prefixText = string.sub(formattedText, 1, tokenStart - 1)
			local suffixText = string.sub(formattedText, tokenEnd + 1)
			formattedText = prefixText .. replacement .. suffixText
			searchStart = tokenStart + string.len(replacement)
		end

		return formattedText
	end

end

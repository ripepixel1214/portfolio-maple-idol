-- EventTable을 로드하고 이벤트 ID 기준의 정적 데이터를 제공합니다.
@Logic
script EventMaster extends Logic

	property boolean IsEventTableLoaded = false

	-- Dictionary<string, EventRow>
	property any tEventById = {}

	-- EventTable row plain table[]
	property any tEvents = {}

	method void OnBeginPlay()
		-- 이벤트 정적 데이터는 클라이언트와 서버 양쪽에서 조회하므로 시작 시 캐시를 준비합니다.
		self:EnsureEventTableLoaded()
	end

	method void EnsureEventTableLoaded()
		-- 이벤트 테이블이 아직 로드되지 않았다면 로드합니다.
		if self.IsEventTableLoaded == true then
			return
		end

		self:LoadEventTable()
	end

	method void LoadEventTable()
		-- EventTable을 읽고 id와 전체 목록 기준으로 캐싱합니다.
		if self.IsEventTableLoaded == true then
			return
		end

		self.tEventById = {}
		self.tEvents = {}
		self.IsEventTableLoaded = false

		local dataSet = _DataService:GetTable("EventTable")
		if dataSet == nil then
			log_warning("[EventMaster] EventTable not found")
			return
		end

		for rowIndex = 1, dataSet:GetRowCount() do
			local id = _DataTableUtil:SafeGetString(dataSet, rowIndex, "eventId", "")
			if id ~= "" then
				local tEvent = self:CreateEventRow(dataSet, rowIndex, id)
				self.tEventById[id] = tEvent
				table.insert(self.tEvents, tEvent)
			end
		end

		self.IsEventTableLoaded = true
	end

	method any CreateEventRow(any dataSet, integer rowIndex, string id)
		-- EventTable의 row를 plain table로 변환합니다.
		local tEvent = {}
		tEvent.id = id
		tEvent.nameKey = _DataTableUtil:SafeGetString(dataSet, rowIndex, "nameKey", "")
		tEvent.descriptionKey = _DataTableUtil:SafeGetString(dataSet, rowIndex, "descriptionKey", "")
		tEvent.name = ""
		tEvent.description = ""
		if _LocalizationLogic ~= nil then
			tEvent.name = _LocalizationLogic:GetText(tEvent.nameKey, "")
			tEvent.description = _LocalizationLogic:GetText(tEvent.descriptionKey, "")
		end
		tEvent.eventType = _EEventType:FromKey(_DataTableUtil:SafeGetString(dataSet, rowIndex, "eventType", ""))
		tEvent.dialogId = _DataTableUtil:SafeGetString(dataSet, rowIndex, "dialogId", "")
		tEvent.miniGameId = _DataTableUtil:SafeGetString(dataSet, rowIndex, "miniGameId", "")
		tEvent.successResultId = _DataTableUtil:SafeGetString(dataSet, rowIndex, "successResultId", "")
		tEvent.successValue1 = _DataTableUtil:SafeGetString(dataSet, rowIndex, "successValue1", "")
		tEvent.successValue2 = _DataTableUtil:SafeGetString(dataSet, rowIndex, "successValue2", "")
		tEvent.successValue3 = _DataTableUtil:SafeGetString(dataSet, rowIndex, "successValue3", "")
		tEvent.failResultId = _DataTableUtil:SafeGetString(dataSet, rowIndex, "failResultId", "")
		tEvent.failValue1 = _DataTableUtil:SafeGetString(dataSet, rowIndex, "failValue1", "")
		tEvent.failValue2 = _DataTableUtil:SafeGetString(dataSet, rowIndex, "failValue2", "")
		tEvent.failValue3 = _DataTableUtil:SafeGetString(dataSet, rowIndex, "failValue3", "")
		tEvent.choiceEventId1 = _DataTableUtil:SafeGetString(dataSet, rowIndex, "choiceEventId1", "")
		tEvent.choiceEventId2 = _DataTableUtil:SafeGetString(dataSet, rowIndex, "choiceEventId2", "")
		tEvent.choiceEventId3 = _DataTableUtil:SafeGetString(dataSet, rowIndex, "choiceEventId3", "")
		tEvent.choiceEventId4 = _DataTableUtil:SafeGetString(dataSet, rowIndex, "choiceEventId4", "")
		tEvent.choiceEventId5 = _DataTableUtil:SafeGetString(dataSet, rowIndex, "choiceEventId5", "")
		tEvent.characterId = _DataTableUtil:SafeGetString(dataSet, rowIndex, "characterId", "")
		return tEvent
	end

	method any GetEvent(string id)
		-- id에 해당하는 이벤트 row를 반환합니다.
		self:EnsureEventTableLoaded()
		return self.tEventById[id]
	end

	method any GetAllEvents()
		-- 전체 이벤트 row 목록을 반환합니다.
		self:EnsureEventTableLoaded()
		return self.tEvents
	end

	method any GetChoiceEventIds(string eventId)
		-- 이벤트 ID에 해당하는 choiceEventId 후보 목록을 순서대로 반환합니다.
		local tEvent = self:GetEvent(eventId)
		if tEvent == nil then
			return {}
		end

		return {
			tEvent.choiceEventId1,
			tEvent.choiceEventId2,
			tEvent.choiceEventId3,
			tEvent.choiceEventId4,
			tEvent.choiceEventId5
		}
	end

	method boolean IsEventCompletionFor(string pendingEventId, string completedEventId)
		-- 완료된 이벤트가 대기 중인 이벤트 자체 또는 choice 자식 이벤트인지 확인합니다.
		if pendingEventId == nil or pendingEventId == "" then
			return false
		end

		if completedEventId == nil or completedEventId == "" then
			return false
		end

		if pendingEventId == completedEventId then
			return true
		end

		local tEvent = self:GetEvent(pendingEventId)
		if tEvent == nil or tEvent.eventType ~= _EEventType.Choice then
			return false
		end

		local tChoiceEventIds = self:GetChoiceEventIds(pendingEventId)
		for index = 1, 5 do
			if tChoiceEventIds[index] == completedEventId then
				return true
			end
		end

		return false
	end

end

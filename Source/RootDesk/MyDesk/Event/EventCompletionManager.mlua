-- 일회성 이벤트의 완료 상태를 서버 권위로 보관하고 UserDataStorage에 저장/동기화합니다.
-- 완료 key = "eventId|characterId". EventTriggerManager의 일회성 트리거 게이트가 이 클라 캐시를 조회합니다.
@Logic
script EventCompletionManager extends Logic

	property boolean isCompletionLoaded = false

	-- completedKeys: { "eventId|characterId", ... }
	property any completedKeys = {}

	-- completedKeySet: { ["eventId|characterId"] = true }
	property any completedKeySet = {}

	property string currentUserId = ""

	property any userEnterHandler = nil

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 유저 입장 시점에 서버 권위 완료 목록을 로드하고 클라이언트에 동기화합니다.
		self.userEnterHandler = _UserService:ConnectEvent(UserEnterEvent, self.OnUserEnter)
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 서버 종료 시점에 유저 입장 이벤트 핸들러를 정리합니다.
		if self.userEnterHandler ~= nil then
			_UserService:DisconnectEvent(UserEnterEvent, self.userEnterHandler)
			self.userEnterHandler = nil
		end
	end

	@ExecSpace("ClientOnly")
	method boolean ClientIsEventCompleted(string eventId, string characterId)
		-- 클라이언트 로컬 캐시에 저장된 이벤트 완료 여부를 반환합니다.
		if eventId == nil or eventId == "" then
			return false
		end

		local completionKey = self:BuildCompletionKey(eventId, characterId)
		return self.completedKeySet[completionKey] == true
	end

	@ExecSpace("ServerOnly")
	method boolean ServerIsEventCompleted(string eventId, string characterId)
		-- 서버 권위 완료 캐시에서 이벤트 완료 여부 확인
		if self:IsCompletionsLoaded() == false or eventId == nil or eventId == "" then
			return false
		end

		local completionKey = self:BuildCompletionKey(eventId, characterId)
		return self.completedKeySet[completionKey] == true
	end

	@ExecSpace("Server")
	method void RequestMarkEventCompleted(string eventId, string characterId)
		-- 클라이언트가 완료를 보고하면 서버 권위 완료 목록에 반영하고 저장/동기화합니다.
		if self:CanUseCompletions(senderUserId) == false then
			return
		end
		if _EventTriggerManager ~= nil and _EventTriggerManager:IsNpcTriggeredEvent(eventId) == true then
			log_warning("[EventCompletionManager] direct npc completion rejected userId=" .. tostring(senderUserId)
				.. " eventId=" .. tostring(eventId))
			return
		end

		self:MarkEventCompletedWithCommit(eventId, characterId or "", senderUserId)
	end

	@ExecSpace("ServerOnly")
	method void OnUserEnter(UserEnterEvent event)
		-- 유저가 서버에 입장하면 완료 데이터를 로드하고 해당 클라이언트에 전송합니다.
		if event == nil or event.UserId == nil or event.UserId == "" then
			return
		end

		if self.currentUserId ~= nil and self.currentUserId ~= "" and self.currentUserId ~= event.UserId then
			log_warning("[ERROR][EventCompletionManager] single-user instance violation currentUserId=" .. tostring(self.currentUserId)
				.. " enteredUserId=" .. tostring(event.UserId))
			return
		end

		self.currentUserId = event.UserId
		self:LoadCompletions()

		if self:IsCompletionsLoaded() then
			self:PushCompletionsToClient(event.UserId)
		end
	end

	@ExecSpace("ServerOnly")
	method void LoadCompletions()
		-- Storage에서 완료 이벤트 key 목록을 읽어 서버 권위 캐시로 보관합니다.
		if self.currentUserId == nil or self.currentUserId == "" then
			log_warning("[EventCompletionManager] currentUserId is required")
			self.isCompletionLoaded = false
			return
		end

		local loadedKeys = {}
		if _EventCompletionStorage ~= nil then
			loadedKeys = _EventCompletionStorage:LoadCompletions(self.currentUserId)
			if loadedKeys == nil then
				log_warning("[EventCompletionManager] completion keys are nil")
				self.isCompletionLoaded = false
				return
			end
		end

		self:RegisterCompletions(loadedKeys)
		self.isCompletionLoaded = true
	end

	@ExecSpace("ServerOnly")
	method boolean IsCompletionsLoaded()
		-- 서버 완료 데이터 로드 여부를 반환합니다.
		return self.isCompletionLoaded
	end

	@ExecSpace("ServerOnly")
	method boolean CanUseCompletions(string userId)
		-- Request 입구에서 현재 유저와 완료 데이터 로드 상태를 검증합니다.
		if self:IsCompletionsLoaded() == false then
			log_warning("[EventCompletionManager] request rejected because completions are not loaded")
			return false
		end

		if self.currentUserId == nil or self.currentUserId == "" then
			log_warning("[EventCompletionManager] request rejected because currentUserId is empty")
			return false
		end

		if userId == nil or userId == "" or userId ~= self.currentUserId then
			log_warning("[EventCompletionManager] request rejected invalid userId=" .. tostring(userId))
			return false
		end

		return true
	end

	@ExecSpace("ServerOnly")
	method boolean MarkEventCompleted(string eventId, string characterId)
		-- 일회성 이벤트만 서버 권위 완료 목록에 추가합니다. 반복 이벤트는 저장하지 않습니다.
		if self:IsCompletionsLoaded() == false then
			return false
		end

		if eventId == nil or eventId == "" then
			return false
		end

		-- 반복 이벤트(countWindow != none)는 완료 저장 대상이 아니다. 저장 크기를 일회성 이벤트로 제한
		if _EventTriggerManager == nil or _EventTriggerManager:IsEventOneTime(eventId) == false then
			return false
		end

		local completionKey = self:BuildCompletionKey(eventId, characterId)
		if self.completedKeySet[completionKey] == true then
			return false
		end

		table.insert(self.completedKeys, completionKey)
		self.completedKeySet[completionKey] = true
		return true
	end

	@ExecSpace("ServerOnly")
	method void MarkEventCompletedWithCommit(string eventId, string characterId, string forUserId)
		-- 완료를 런타임 캐시에 반영한 뒤 저장하고 대상 클라이언트에 동기화합니다.
		local isMarked = self:MarkEventCompleted(eventId, characterId)
		if isMarked == false then
			return
		end

		self:SaveCompletionsToStorage()
		if forUserId ~= nil and forUserId ~= "" then
			self:PushCompletionsToClient(forUserId)
		end
	end

	@ExecSpace("ServerOnly")
	method void SaveCompletionsToStorage()
		-- 서버 권위 완료 목록을 Storage에 저장합니다.
		if _EventCompletionStorage == nil then
			return
		end

		if self.currentUserId == nil or self.currentUserId == "" then
			log_warning("[EventCompletionManager] currentUserId is required")
			return
		end

		if self:IsCompletionsLoaded() == false then
			log_warning("[EventCompletionManager] completions are not loaded")
			return
		end

		_EventCompletionStorage:SaveCompletionsAsync(self.currentUserId, self:CopyStringList(self.completedKeys))
	end

	@ExecSpace("ServerOnly")
	method void RegisterCompletions(any completionKeys)
		-- 로드한 완료 key 목록을 서버 권위 캐시에 등록합니다.
		self.completedKeys = {}
		self.completedKeySet = {}

		if completionKeys == nil or type(completionKeys) ~= "table" then
			return
		end

		for _, completionKey in ipairs(completionKeys) do
			self:AddCompletionKeyIfValid(completionKey)
		end
	end

	@ExecSpace("ServerOnly")
	method void AddCompletionKeyIfValid(string completionKey)
		-- 중복 없이 유효한 완료 key만 캐시에 추가합니다.
		if completionKey == nil or completionKey == "" then
			return
		end

		if self.completedKeySet[completionKey] == true then
			return
		end

		table.insert(self.completedKeys, completionKey)
		self.completedKeySet[completionKey] = true
	end

	@ExecSpace("ServerOnly")
	method void PushCompletionsToClient(string forUserId)
		-- 서버 권위 완료 목록을 지정한 클라이언트의 로컬 캐시로 전송합니다.
		if forUserId == nil or forUserId == "" then
			return
		end

		self:SyncCompletions(self:CopyStringList(self.completedKeys), forUserId)
	end

	@ExecSpace("Client")
	method void SyncCompletions(table completionKeys)
		-- 서버에서 받은 완료 목록을 클라이언트 로컬 캐시에 반영합니다.
		self:RegisterCompletionsClientOnly(completionKeys)
	end

	@ExecSpace("ClientOnly")
	method void RegisterCompletionsClientOnly(any completionKeys)
		-- 클라이언트 로컬 완료 캐시를 교체합니다.
		self.completedKeys = {}
		self.completedKeySet = {}

		if completionKeys == nil or type(completionKeys) ~= "table" then
			return
		end

		for _, completionKey in ipairs(completionKeys) do
			if completionKey ~= nil and completionKey ~= "" and self.completedKeySet[completionKey] ~= true then
				table.insert(self.completedKeys, completionKey)
				self.completedKeySet[completionKey] = true
			end
		end
	end

	method string BuildCompletionKey(string eventId, string characterId)
		-- eventId와 characterId를 하나의 완료 key로 변환합니다. EventTriggerManager 게이트와 동일 규칙
		return (eventId or "") .. "|" .. (characterId or "")
	end

	method any CopyStringList(any source)
		-- 문자열 배열 복사본을 만듭니다.
		local copied = {}
		if source == nil or type(source) ~= "table" then
			return copied
		end

		for _, value in ipairs(source) do
			if value ~= nil and value ~= "" then
				table.insert(copied, tostring(value))
			end
		end

		return copied
	end

end

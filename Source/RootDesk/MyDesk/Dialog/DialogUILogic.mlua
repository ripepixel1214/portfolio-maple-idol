	@ExecSpace("ClientOnly")
	method any GetAnchoredPositionForBottomCenter(SpriteGUIRendererComponent renderer, Vector2 bottomCenterInParent, Vector2 size)
		-- 부모 UI 좌표의 중앙 하단 목표점을 현재 앵커 기준 anchoredPosition으로 변환합니다.
		if renderer == nil or renderer.Entity == nil or renderer.Entity.Parent == nil then
			return nil
		end
		local transform = renderer.Entity.UITransformComponent
		local parentTransform = renderer.Entity.Parent.UITransformComponent
		if transform == nil or parentTransform == nil then
			return nil
		end

		local pivot = transform.Pivot
		local pivotPosition = Vector2(
			bottomCenterInParent.x - (0.5 - pivot.x) * size.x,
			bottomCenterInParent.y + pivot.y * size.y
		)
		local parentSize = parentTransform.RectSize
		local parentLeft = -parentTransform.Pivot.x * parentSize.x
		local parentBottom = -parentTransform.Pivot.y * parentSize.y
		local anchorRatioX = transform.AnchorsMin.x + (transform.AnchorsMax.x - transform.AnchorsMin.x) * transform.Pivot.x
		local anchorRatioY = transform.AnchorsMin.y + (transform.AnchorsMax.y - transform.AnchorsMin.y) * transform.Pivot.y
		local anchorX = parentLeft + anchorRatioX * parentSize.x
		local anchorY = parentBottom + anchorRatioY * parentSize.y
		return Vector2(pivotPosition.x - anchorX, pivotPosition.y - anchorY)
	end

	@ExecSpace("ClientOnly")
	method Vector2 GetBottomCenterFromAnchoredPosition(SpriteGUIRendererComponent renderer, Vector2 anchoredPosition, Vector2 size)
		-- anchoredPosition과 크기에서 기존 픽셀 배치 코드가 사용하는 중앙 하단 좌표를 반환합니다.
		if renderer == nil or renderer.Entity == nil or renderer.Entity.UITransformComponent == nil then
			return Vector2(0, 0)
		end
		local pivot = renderer.Entity.UITransformComponent.Pivot
		return Vector2(
			anchoredPosition.x + (0.5 - pivot.x) * size.x,
			anchoredPosition.y - pivot.y * size.y
		)
	end

	@ExecSpace("ClientOnly")
	method Vector2 GetRendererBottomCenter(SpriteGUIRendererComponent renderer)
		-- 렌더러의 현재 박스에서 중앙 하단 지점을 계산합니다.
		if renderer == nil or renderer.Entity == nil or renderer.Entity.UITransformComponent == nil then
			return Vector2(0, 0)
		end

		local uiTransform = renderer.Entity.UITransformComponent
		local position = uiTransform.anchoredPosition
		local size = uiTransform.RectSize
		local pivot = uiTransform.Pivot
		return Vector2(
			position.x + (0.5 - pivot.x) * size.x,
			position.y - pivot.y * size.y
		)
	end

	@ExecSpace("ClientOnly")
	method void SendDialogClosedEvent(string dialogId)
		-- 닫힌 다이얼로그 ID를 담아 다이얼로그 닫힘 이벤트를 발송합니다.
		if dialogId == nil or dialogId == "" then
			return
		end

		local dialogClosedEvent = DialogClosedEvent()
		dialogClosedEvent.dialogId = dialogId
		self:SendEvent(dialogClosedEvent)
	end

end

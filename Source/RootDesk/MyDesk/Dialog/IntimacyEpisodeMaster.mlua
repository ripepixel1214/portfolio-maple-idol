@Logic
script IntimacyEpisodeMaster extends Logic

	property boolean IsLoaded = false

	-- { [characterId:string] = { [level:integer] = IntimacyEpisodeRow } }
	property any tEpisodeByCharacterIdAndLevel = {}

	method void OnBeginPlay()
		-- IntimacyEpisodeTable을 읽어 친밀도 에피소드 연결 정보를 캐싱합니다.
		self:LoadEpisodes()
	end

	method string GetDialogId(string characterId, integer level)
		-- characterId와 level에 연결된 dialogId를 반환합니다.
		local tEpisode = self:GetEpisode(characterId, level)
		if tEpisode == nil then
			return ""
		end

		return tEpisode.dialogId
	end

	method string GetBackground(string characterId, integer level)
		-- characterId와 level에 연결된 background id를 반환합니다.
		local tEpisode = self:GetEpisode(characterId, level)
		if tEpisode == nil then
			return ""
		end

		return tEpisode.background
	end

	method void LoadEpisodes()
		-- IntimacyEpisodeTable의 전체 row를 characterId와 level 기준으로 캐싱합니다.
		self.tEpisodeByCharacterIdAndLevel = {}
		self.IsLoaded = false

		local dataSet = _DataService:GetTable("IntimacyEpisodeTable")
		if dataSet == nil then
			log_warning("[IntimacyEpisodeMaster] IntimacyEpisodeTable not found")
			return
		end

		for rowIndex = 1, dataSet:GetRowCount() do
			local characterId = _DataTableUtil:SafeGetString(dataSet, rowIndex, "characterId", "")
			local level = _DataTableUtil:SafeGetInteger(dataSet, rowIndex, "level", 0)

			if characterId ~= "" and level > 0 then
				local tEpisode = self:CreateEpisodeRow(dataSet, rowIndex, characterId, level)
				if self.tEpisodeByCharacterIdAndLevel[characterId] == nil then
					self.tEpisodeByCharacterIdAndLevel[characterId] = {}
				end
				self.tEpisodeByCharacterIdAndLevel[characterId][level] = tEpisode
			end
		end

		self.IsLoaded = true
	end

	method any CreateEpisodeRow(any dataSet, integer rowIndex, string characterId, integer level)
		-- IntimacyEpisodeTable의 한 row를 IntimacyEpisodeRow 구조체로 변환합니다.
		local tEpisode = IntimacyEpisodeRow()
		tEpisode.characterId = characterId
		tEpisode.level = level
		tEpisode.dialogId = _DataTableUtil:SafeGetString(dataSet, rowIndex, "dialogId", "")
		tEpisode.background = _DataTableUtil:SafeGetString(dataSet, rowIndex, "background", "")
		return tEpisode
	end

	method any GetEpisode(string characterId, integer level)
		-- characterId와 level에 해당하는 IntimacyEpisodeRow를 반환합니다.
		self:EnsureLoaded()
		if characterId == nil or characterId == "" or level <= 0 then
			return nil
		end

		local tEpisodeByLevel = self.tEpisodeByCharacterIdAndLevel[characterId]
		if tEpisodeByLevel == nil then
			return nil
		end

		return tEpisodeByLevel[level]
	end

	method void EnsureLoaded()
		-- 캐시가 비어 있으면 IntimacyEpisodeTable을 다시 로드합니다.
		if self.IsLoaded == false then
			self:LoadEpisodes()
		end
	end

end

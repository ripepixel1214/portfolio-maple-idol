-- DialogOptionTable을 로드하고 dialogId별 대화 전체 연출 옵션을 캐싱해 제공합니다.
@Logic
script DialogOptionMaster extends Logic

	property boolean isLoaded = false

	-- Dictionary<string, DialogOptionRow>
	property any tOptionByDialogId = {}

	method void OnBeginPlay()
		-- 게임 시작 시 DialogOptionTable의 대화 연출 옵션을 캐싱합니다.
		self:LoadOptions()
	end

	method void LoadOptions()
		-- DialogOptionTable 전체 행을 dialogId 기준 캐시로 다시 구성합니다.
		self.tOptionByDialogId = {}
		self.isLoaded = false

		local dataSet = _DataService:GetTable("DialogOptionTable")
		if dataSet == nil then
			log_warning("[DialogOptionMaster] DialogOptionTable not found")
			return
		end

		local hasFailure = false
		for rowIndex = 1, dataSet:GetRowCount() do
			local ok, err = pcall(function()
				self:CacheRow(dataSet, rowIndex)
			end)
			if ok == false then
				hasFailure = true
				log_warning("[DialogOptionMaster] row cache failed rowIndex=" .. tostring(rowIndex) .. " err=" .. tostring(err))
			end
		end

		if hasFailure == false then
			self.isLoaded = true
		end
	end

	method void CacheRow(any dataSet, integer rowIndex)
		-- 한 행을 DialogOptionRow로 변환해 dialogId 기준 캐시에 저장합니다.
		local dialogId = _DataTableUtil:SafeGetString(dataSet, rowIndex, "dialogId", "")
		if dialogId == "" then
			return
		end

		if self.tOptionByDialogId[dialogId] ~= nil then
			log_warning("[DialogOptionMaster] duplicated dialogId=" .. tostring(dialogId) .. " rowIndex=" .. tostring(rowIndex))
		end

		self.tOptionByDialogId[dialogId] = self:CreateOptionRow(dataSet, rowIndex, dialogId)
	end

	method any CreateOptionRow(any dataSet, integer rowIndex, string dialogId)
		-- DialogOptionTable의 한 행을 검증된 DialogOptionRow 구조체로 변환합니다.
		local tOption = DialogOptionRow()
		tOption.dialogId = dialogId
		tOption.backgroundId = _DataTableUtil:SafeGetString(dataSet, rowIndex, "backgroundId", "")
		tOption.blackout = _DataTableUtil:SafeGetBoolean(dataSet, rowIndex, "blackout", false)
		tOption.dialogBgmRuid = _DataTableUtil:SafeGetString(dataSet, rowIndex, "dialogBgmRuid", "")
		tOption.dialogBgmVolume = math.max(_DataTableUtil:SafeGetNumber(dataSet, rowIndex, "dialogBgmVolume", 1), 0)

		local openFadeOutText = _DataTableUtil:SafeGetString(dataSet, rowIndex, "openFadeOutDuration", "")
		local openFadeInText = _DataTableUtil:SafeGetString(dataSet, rowIndex, "openFadeInDuration", "")
		local hasOpenFadeOut = self:IsCellSet(openFadeOutText)
		local hasOpenFadeIn = self:IsCellSet(openFadeInText)
		if hasOpenFadeOut and hasOpenFadeIn then
			local openFadeOutDuration = tonumber(openFadeOutText)
			local openFadeInDuration = tonumber(openFadeInText)
			if openFadeOutDuration ~= nil and openFadeInDuration ~= nil then
				tOption.openFadeOutDuration = math.max(openFadeOutDuration, 0)
				tOption.openFadeInDuration = math.max(openFadeInDuration, 0)
			else
				log_warning("[DialogOptionMaster] open fade durations must be numbers dialogId=" .. tostring(dialogId))
			end
		elseif hasOpenFadeOut or hasOpenFadeIn then
			log_warning("[DialogOptionMaster] open fade requires both durations dialogId=" .. tostring(dialogId))
		end

		local closeFadeOutText = _DataTableUtil:SafeGetString(dataSet, rowIndex, "closeFadeOutDuration", "")
		local closeFadeInText = _DataTableUtil:SafeGetString(dataSet, rowIndex, "closeFadeInDuration", "")
		local hasCloseFadeOut = self:IsCellSet(closeFadeOutText)
		local hasCloseFadeIn = self:IsCellSet(closeFadeInText)
		if hasCloseFadeOut and hasCloseFadeIn then
			local closeFadeOutDuration = tonumber(closeFadeOutText)
			local closeFadeInDuration = tonumber(closeFadeInText)
			if closeFadeOutDuration ~= nil and closeFadeInDuration ~= nil then
				tOption.closeFadeOutDuration = math.max(closeFadeOutDuration, 0)
				tOption.closeFadeInDuration = math.max(closeFadeInDuration, 0)
			else
				log_warning("[DialogOptionMaster] close fade durations must be numbers dialogId=" .. tostring(dialogId))
			end
		elseif hasCloseFadeOut or hasCloseFadeIn then
			log_warning("[DialogOptionMaster] close fade requires both durations dialogId=" .. tostring(dialogId))
		end

		return tOption
	end

	method any GetDialogOption(string dialogId)
		-- dialogId에 해당하는 대화 전체 연출 옵션을 반환합니다.
		self:EnsureLoaded()
		if dialogId == nil or dialogId == "" then
			return nil
		end

		return self.tOptionByDialogId[dialogId]
	end

	method boolean HasDialogOption(string dialogId)
		-- dialogId에 대응되는 연출 옵션 행이 존재하는지 반환합니다.
		return self:GetDialogOption(dialogId) ~= nil
	end

	method void EnsureLoaded()
		-- 옵션 캐시가 준비되지 않았으면 DialogOptionTable을 다시 로드합니다.
		if self.isLoaded == false then
			self:LoadOptions()
		end
	end

	method boolean IsCellSet(string value)
		-- CSV 셀 문자열에 공백 이외의 값이 입력되어 있는지 반환합니다.
		return value ~= nil and string.match(value, "%S") ~= nil
	end

end

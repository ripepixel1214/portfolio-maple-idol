-- Character 상태머신의 요청에 따라 액터 스피치를 재생하고 유지 시간을 반환합니다.
@Component
script ActorSpeechComponent extends Component

	@HideFromInspector
	property ChatBalloonComponent chatBalloon = nil

	@HideFromInspector
	property TextComponent measureText = nil

	@HideFromInspector
	property number baseBalloonScale = 0

	@Description("ActorSpeechTable의 actorId와 매칭되는 액터 식별자입니다.")
	property string actorId = ""

	@Description("true이면 Character touch 상태에서 touchType 대사를 재생합니다.")
	property boolean enableTouchSpeech = true

	@Description("true이면 Character idle 상태에서 idleType 대사를 재생합니다.")
	property boolean enableIdleSpeech = true

	@Description("대사가 유지되는 시간입니다.")
	property number defaultDuration = 3

	@Description("텍스트를 한 글자씩 출력할 때 글자 사이에 기다리는 시간입니다.")
	property number defaultCharInterval = 0.04

	@HideFromInspector
	property integer intimacyLevel = 0

	@HideFromInspector
	property integer typingTimerId = 0

	@HideFromInspector
	property integer hideTimerId = 0

	@HideFromInspector
	property any currentCharacters = {}

	@HideFromInspector
	property integer currentCharacterIndex = 1

	@HideFromInspector
	property string currentMessage = ""

	@HideFromInspector
	property string currentSpeechType = ""

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 스피치 재생에 필요한 챗벌룬 참조를 준비합니다.
		self:CacheChatBalloon()
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 출력 중인 스피치 타이머를 정리합니다.
		self:ClearTypingTimer()
		self:ClearHideTimer()
	end

	@ExecSpace("ClientOnly")
	method number PlaySpeech(integer interactionType)
		-- 스피치 타입에 맞는 대사를 찾아 챗벌룬으로 재생하고 전체 시간을 반환합니다.
		if self:CanPlaySpeech(interactionType) == false then
			return 0
		end

		local speechType = _EActorInteractionType:ToSpeechType(interactionType)
		if speechType == "" then
			return 0
		end

		if self.currentSpeechType == speechType then
			return 0
		end

		if self.actorId == "" then
			log_warning("[ActorSpeechComponent] actorId is empty: " .. self.Entity.Name)
			return 0
		end

		local tSpeech = _ActorSpeechMaster:GetRandomSpeech(self.actorId, speechType, self.intimacyLevel)
		if tSpeech == nil or tSpeech.message == "" then
			return 0
		end

		if self.chatBalloon == nil then
			log_warning("[ActorSpeechComponent] ChatBalloonComponent not found: " .. self.Entity.Name)
			return 0
		end

		self:ClearTypingTimer()
		self:ClearHideTimer()
		self.currentSpeechType = speechType
		self:InitializeChatBalloon()
		self:ApplyBalloonScaleByMessage(tSpeech.message)
		self:StartTyping(tSpeech.message)

		return self:GetSpeechTotalDuration(tSpeech.message)
	end

	@ExecSpace("ClientOnly")
	method boolean CanPlaySpeech(integer interactionType)
		-- Character 상태별 스피치 사용 여부를 반환합니다.
		local interactionTypes = _EActorInteractionType
		if interactionType == interactionTypes:GetIdleInteger() and self.enableIdleSpeech == false then
			return false
		end

		if interactionType == interactionTypes:GetTouchInteger() and self.enableTouchSpeech == false then
			return false
		end

		return true
	end

	@ExecSpace("ClientOnly")
	method number GetSpeechTotalDuration(string message)
		-- 타이핑 시간과 유지 시간을 합산한 전체 스피치 시간을 반환합니다.
		local typingDuration = self:GetTypingDuration(message)
		return typingDuration + self.defaultDuration
	end

	@ExecSpace("ClientOnly")
	method number GetTypingDuration(string message)
		-- 메시지 글자 수와 글자 출력 간격을 기준으로 타이핑 시간을 계산합니다.
		if self.defaultCharInterval <= 0 then
			return 0
		end

		local characters = self:SplitCharacters(message)
		return #characters * self.defaultCharInterval
	end

	@ExecSpace("ClientOnly")
	method void CacheChatBalloon()
		-- 액터 엔티티의 네이티브 챗벌룬 컴포넌트 참조를 찾습니다.
		if self.chatBalloon == nil then
			self.chatBalloon = self.Entity.ChatBalloonComponent
		end

		if self.chatBalloon ~= nil and (self.baseBalloonScale == nil or self.baseBalloonScale <= 0) then
			self.baseBalloonScale = self.chatBalloon.BalloonScale or 0
			if self.baseBalloonScale <= 0 then
				self.baseBalloonScale = 1
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void InitializeChatBalloon()
		-- 네이티브 챗벌룬의 표시 옵션과 유지 시간을 설정합니다.
		self.chatBalloon.ChatModeEnabled = true
		self.chatBalloon.AutoShowEnabled = true
		self.chatBalloon.ShowDuration = self.defaultDuration
		self.chatBalloon.Message = ""
	end

	@ExecSpace("ClientOnly")
	method void ApplyBalloonScaleByMessage(string message)
		-- 측정용 TextComponent의 선호 너비를 이용해 챗벌룬 스케일을 조절합니다.
		if self.chatBalloon == nil then
			return
		end

		local baseScale = self.baseBalloonScale or 0
		if baseScale <= 0 then
			baseScale = self.chatBalloon.BalloonScale or 0
			if baseScale <= 0 then
				baseScale = 1
			end
		end

		local measureText = self:GetMeasureTextComponent()
		if measureText == nil or message == "" then
			self.chatBalloon.BalloonScale = baseScale
			return
		end

		local preferredWidth = measureText:GetPreferredWidth(message)
		if preferredWidth == nil or preferredWidth <= 0 then
			self.chatBalloon.BalloonScale = baseScale
			return
		end

		local nativeBalloonTextWidth = 190
		local fontSize = self.chatBalloon.FontSize or 1
		local targetScale = preferredWidth / nativeBalloonTextWidth * fontSize
		if targetScale < baseScale then
			targetScale = baseScale
		end

		self.chatBalloon.BalloonScale = targetScale
	end

	@ExecSpace("ClientOnly")
	method any GetMeasureTextComponent()
		-- 대사 폭 측정에 사용할 TextComponent를 반환합니다.
		if self.measureText ~= nil then
			return self.measureText
		end

		if _DialogUILogic ~= nil and _DialogUILogic.panelMessageText ~= nil then
			return _DialogUILogic.panelMessageText
		end

		return nil
	end

	@ExecSpace("ClientOnly")
	method void StartTyping(string message)
		-- 메시지를 글자 단위로 나누고 시간차 출력 타이머를 시작합니다.
		self.currentCharacters = self:SplitCharacters(message)
		self.currentCharacterIndex = 1
		self.currentMessage = ""

		if self.defaultCharInterval <= 0 then
			self:SetMessageText(message)
			self:PlayHideTimer()
			return
		end

		self.typingTimerId = _TimerService:SetTimerRepeat(function() self:OnTypingTick() end, self.defaultCharInterval)
	end

	@ExecSpace("ClientOnly")
	method void OnTypingTick()
		-- 시간차 출력 타이머마다 다음 글자를 챗벌룬 메시지에 추가합니다.
		if self.currentCharacterIndex > #self.currentCharacters then
			self:ClearTypingTimer()
			self:PlayHideTimer()
			return
		end

		self.currentMessage = self.currentMessage .. self.currentCharacters[self.currentCharacterIndex]
		self.currentCharacterIndex = self.currentCharacterIndex + 1
		self:SetMessageText(self.currentMessage)

		if self.currentCharacterIndex > #self.currentCharacters then
			self:ClearTypingTimer()
			self:PlayHideTimer()
		end
	end

	@ExecSpace("ClientOnly")
	method any SplitCharacters(string text)
		-- UTF-8 문자열을 글자 단위 테이블로 분리합니다.
		local characters = {}

		if text == nil or text == "" then
			return characters
		end

		for _, code in utf8.codes(text) do
			table.insert(characters, utf8.char(code))
		end

		return characters
	end

	@ExecSpace("ClientOnly")
	method void SetMessageText(string message)
		-- 네이티브 챗벌룬 메시지를 갱신합니다.
		if self.chatBalloon == nil then
			return
		end

		self.chatBalloon.Message = message
	end

	@ExecSpace("ClientOnly")
	method void PlayHideTimer()
		-- 대사 유지 시간이 지나면 챗벌룬 메시지를 비우도록 예약합니다.
		if self.defaultDuration <= 0 then
			return
		end

		self:ClearHideTimer()
		self.hideTimerId = _TimerService:SetTimerOnce(function() self:HideSpeech() end, self.defaultDuration)
	end

	@ExecSpace("ClientOnly")
	method void HideSpeech()
		-- 출력 중인 스피치를 정리하고 챗벌룬 메시지를 비웁니다.
		self:ClearTypingTimer()
		self:ClearHideTimer()
		self.currentCharacters = {}
		self.currentCharacterIndex = 1
		self.currentMessage = ""
		self.currentSpeechType = ""
		self:SetMessageText("")
	end

	@ExecSpace("ClientOnly")
	method void ClearHideTimer()
		-- 챗벌룬 숨김 타이머를 해제합니다.
		if self.hideTimerId > 0 then
			_TimerService:ClearTimer(self.hideTimerId)
			self.hideTimerId = 0
		end
	end

	@ExecSpace("ClientOnly")
	method void ClearTypingTimer()
		-- 텍스트 시간차 출력 타이머를 해제합니다.
		if self.typingTimerId > 0 then
			_TimerService:ClearTimer(self.typingTimerId)
			self.typingTimerId = 0
		end
	end

end

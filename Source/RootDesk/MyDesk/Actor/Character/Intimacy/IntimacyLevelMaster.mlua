---@description "친밀도 수치를 레벨로 변환하고, 레벨별 해금 타입/인덱스를 제공하는 마스터 로직."
@Logic
script IntimacyLevelMaster extends Logic

	property boolean IsLoaded = false

	-- IntimacyLevelData 목록
	property any tLevels = {}

	-- { [level:number] = IntimacyLevelData }
	property any tLevelDataByLevel = {}

	method void OnBeginPlay()
		-- 로직 시작 시 친밀도 레벨 테이블을 로드합니다.
		self:LoadLevels()
	end

	method void LoadLevels()
		-- IntimacyLevelTable을 읽어 레벨별 친밀도 기준과 해금 정보를 캐싱합니다.
		self.tLevels = {}
		self.tLevelDataByLevel = {}
		self.IsLoaded = false

		local dataSet = _DataService:GetTable("IntimacyLevelTable")
		if dataSet == nil then
			log_warning("[IntimacyLevelMaster] IntimacyLevelTable not found")
			return
		end

		for rowIndex = 1, dataSet:GetRowCount() do
			local level = _DataTableUtil:SafeGetInteger(dataSet, rowIndex, "level", 0)
			if level > 0 then
				local tLevelData = {
					level = level,
					intimacyCut = _DataTableUtil:SafeGetNumber(dataSet, rowIndex, "intimacyCut", 0),
					unlockType = _DataTableUtil:SafeGetString(dataSet, rowIndex, "unlockType", ""),
					unlockIndex = _DataTableUtil:SafeGetInteger(dataSet, rowIndex, "unlockIndex", 0)
				}

				table.insert(self.tLevels, tLevelData)
				self.tLevelDataByLevel[level] = tLevelData
			end
		end

		table.sort(self.tLevels, function(left, right)
			return left.intimacyCut < right.intimacyCut
		end)

		self.IsLoaded = true
	end

	method integer GetCurrentLevel(number intimacy)
		-- 현재 친밀도 수치로 도달한 가장 높은 친밀도 레벨을 반환합니다.
		self:EnsureLoaded()

		local reachedLevel = 0
		for _, tLevelData in ipairs(self.tLevels) do
			if intimacy >= tLevelData.intimacyCut then
				reachedLevel = tLevelData.level
			else
				break
			end
		end

		return reachedLevel
	end

	method any GetLevelData(integer level)
		-- 지정한 친밀도 레벨의 IntimacyLevelData를 반환합니다.
		self:EnsureLoaded()
		return self.tLevelDataByLevel[level]
	end

	method boolean IsUnlockIndexUnlocked(integer currentLevel, string unlockType, integer unlockIndex)
		-- 현재 레벨 이하에서 지정한 unlockType/unlockIndex가 해금되었는지 반환합니다.
		self:EnsureLoaded()

		if unlockType == nil or unlockType == "" or unlockIndex <= 0 then
			return false
		end

		for _, tLevelData in ipairs(self.tLevels) do
			if tLevelData.level > currentLevel then
				break
			end

			if tLevelData.unlockType == unlockType and tLevelData.unlockIndex == unlockIndex then
				return true
			end
		end

		return false
	end

	method integer GetUnlockLevel(string unlockType, integer unlockIndex)
		-- 지정한 unlockType/unlockIndex가 해금되는 레벨을 반환합니다.
		self:EnsureLoaded()

		if unlockType == nil or unlockType == "" or unlockIndex <= 0 then
			return 0
		end

		for _, tLevelData in ipairs(self.tLevels) do
			if tLevelData.unlockType == unlockType and tLevelData.unlockIndex == unlockIndex then
				return tLevelData.level
			end
		end

		return 0
	end

	method void EnsureLoaded()
		-- 캐시가 비어 있으면 친밀도 레벨 테이블을 다시 로드합니다.
		if self.IsLoaded == false then
			self:LoadLevels()
		end
	end

end

@Logic
script PhotoCardMaster extends Logic

	property boolean IsLoaded = false

	-- PhotoCardRow[]
	property any tPhotoCards = {}

	-- { [itemId:string] = PhotoCardRow }
	property any tPhotoCardByItemId = {}

	-- { [characterId:string] = PhotoCardRow[] }
	property any tPhotoCardsByCharacterId = {}

	method void OnBeginPlay()
		-- 로직 시작 시 PhotoCardTable을 읽어 정적 포토카드 데이터를 캐싱합니다.
		self:LoadPhotoCards()
	end

	method void LoadPhotoCards()
		-- PhotoCardTable의 전체 행을 읽고 캐릭터/친밀도 기준으로 정렬합니다.
		self.tPhotoCards = {}
		self.tPhotoCardByItemId = {}
		self.tPhotoCardsByCharacterId = {}
		self.IsLoaded = false

		local dataSet = _DataService:GetTable("PhotoCardTable")
		if dataSet == nil then
			log_warning("[PhotoCardMaster] PhotoCardTable not found")
			return
		end

		for rowIndex = 1, dataSet:GetRowCount() do
			local itemId = _DataTableUtil:SafeGetString(dataSet, rowIndex, "itemId", "")
			if itemId ~= "" then
				local tPhotoCard = PhotoCardRow()
				tPhotoCard.itemId = itemId
				tPhotoCard.characterId = _DataTableUtil:SafeGetString(dataSet, rowIndex, "characterId", "")
				tPhotoCard.intimacyLevel = _DataTableUtil:SafeGetInteger(dataSet, rowIndex, "intimacyLevel", 0)
				tPhotoCard.cardFront = _DataTableUtil:SafeGetString(dataSet, rowIndex, "cardFront", "")
				tPhotoCard.cardBack = _DataTableUtil:SafeGetString(dataSet, rowIndex, "cardBack", "")

				table.insert(self.tPhotoCards, tPhotoCard)
				self.tPhotoCardByItemId[itemId] = tPhotoCard

				if tPhotoCard.characterId ~= "" then
					if self.tPhotoCardsByCharacterId[tPhotoCard.characterId] == nil then
						self.tPhotoCardsByCharacterId[tPhotoCard.characterId] = {}
					end
					table.insert(self.tPhotoCardsByCharacterId[tPhotoCard.characterId], tPhotoCard)
				end
			end
		end

		table.sort(self.tPhotoCards, function(leftCard, rightCard)
			return self:ComparePhotoCardOrder(leftCard, rightCard)
		end)
		for _, tPhotoCards in pairs(self.tPhotoCardsByCharacterId) do
			table.sort(tPhotoCards, function(leftCard, rightCard)
				return self:ComparePhotoCardOrder(leftCard, rightCard)
			end)
		end

		self.IsLoaded = true
	end

	method any GetPhotoCards()
		-- 전체 PhotoCardRow 목록을 반환합니다.
		self:EnsureLoaded()
		return self.tPhotoCards
	end

	method any GetPhotoCardByItemId(string itemId)
		-- itemId에 해당하는 PhotoCardRow를 반환합니다.
		self:EnsureLoaded()
		if itemId == nil or itemId == "" then
			return nil
		end

		return self.tPhotoCardByItemId[itemId]
	end

	method any GetPhotoCardsByCharacterId(string characterId)
		-- characterId에 해당하는 PhotoCardRow 목록을 반환합니다.
		self:EnsureLoaded()
		if characterId == nil or characterId == "" then
			return {}
		end

		return self.tPhotoCardsByCharacterId[characterId] or {}
	end

	method any GetPhotoCardByCharacterIdAndIntimacyLevel(string characterId, integer intimacyLevel)
		-- 캐릭터와 친밀도 레벨에 해당하는 첫 번째 PhotoCardRow를 반환합니다.
		local tPhotoCards = self:GetPhotoCardsByCharacterId(characterId)
		for _, tPhotoCard in ipairs(tPhotoCards) do
			if tPhotoCard.intimacyLevel == intimacyLevel then
				return tPhotoCard
			end
		end

		return nil
	end

	method void EnsureLoaded()
		-- 캐시가 비어 있으면 PhotoCardTable을 다시 로드합니다.
		if self.IsLoaded == false then
			self:LoadPhotoCards()
		end
	end

	method boolean ComparePhotoCardOrder(any leftCard, any rightCard)
		-- 캐릭터 id, 친밀도 레벨, itemId 순서로 안정적인 표시 순서를 유지합니다.
		if leftCard.characterId == rightCard.characterId then
			if leftCard.intimacyLevel == rightCard.intimacyLevel then
				return leftCard.itemId < rightCard.itemId
			end
			return leftCard.intimacyLevel < rightCard.intimacyLevel
		end

		return leftCard.characterId < rightCard.characterId
	end

end

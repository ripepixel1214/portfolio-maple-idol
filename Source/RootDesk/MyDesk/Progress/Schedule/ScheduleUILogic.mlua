	property string UI_EMPTY_ACTIVITY_KEY = "ui.schedule.empty_activity"
	property string UI_WEEK_TITLE_KEY = "ui.schedule.week_title"
	property string UI_GOAL_COUNTDOWN_KEY = "ui.schedule.goal_countdown"
	property string UI_PERFORMANCE_WEEK_TITLE_KEY = "ui.schedule.performance_week_title"

	property string UI_PERFORMANCE_NAME_KEY = "ui.common.performance"
	property any tCharacters = {}
	property any tActivities = {}

@Logic
script CharacterSelectUILogic extends Logic

	property EntityRef root = "0df74f01-9d3d-455d-9282-6720d468cb7d"
	property EntityRef selection = "dc213453-e5c2-4d1c-99f2-0634395be020"
	property GridViewComponent cardList = "63f4b59e-c289-4450-ae79-772c159f05ee"
	property EntityRef cardTemplate = "dcc253df-43bf-4f47-ab13-609d08c8277b"
	property ButtonComponent confirmButton = "c5ea434a-5b9c-4765-b63f-be9cfc683c48"
	property ButtonComponent cancelButton = "8dbf6dec-78cb-438c-b593-6e953bd37751"
	property string lockedPortraitRuid = "efd29925505946719c34d8fe8007838f"
	property string targetStage = ""
	property integer requiredCharacterCount = 3
	property boolean waiting = false
	property any characters = {}
	property any selectedCharacterIds = {}
	property any profiles = {}
	property any cardBindings = {}
	property any confirmClickHandler = nil
	property any cancelClickHandler = nil
	property any characterChangedHandler = nil
	property any progressChangedHandler = nil

	------------------------------------------------------------------------------------------------------------------------------------------------------
	-- Public API
	------------------------------------------------------------------------------------------------------------------------------------------------------

	@ExecSpace("ClientOnly")
	method boolean Open(string stageId)
		-- 편성 복사본을 열어 확인 전까지 실제 편성을 변경하지 않습니다.
		if _ProgressManager:ClientGetCurrentStep() ~= _EProgressStep.StageSelect or #_CharacterManager:ClientGetCharacters() == 0 then return false end
		self.targetStage = stageId
		self.waiting = false
		self.selectedCharacterIds = _CharacterManager:ClientGetActiveCharacterIds()
		self._T.cardHighlightTime = 0
		self.root.Enable = true
		self:RefreshCharacters()
		_UIVisibilityNotifierLogic:SendFrom(self, "characterSelect", true)
		return true
	end

	@ExecSpace("ClientOnly")
	method void Close()
		-- 선택창과 임시 편성만 정리하고 캐릭터 권위 데이터는 유지합니다.
		if self.root.Enable == false then return end
		self.root.Enable = false
		self.waiting = false
		self.targetStage = ""
		self.selectedCharacterIds = {}
		_UIVisibilityNotifierLogic:SendFrom(self, "characterSelect", false)
	end

	@ExecSpace("ClientOnly")
	method void ApplySelectionResult(string stageId, boolean isApplied)
		-- 서버가 거절한 요청은 선택창을 유지하고 입력을 다시 허용합니다.
		if self.root.Enable == false or self.targetStage ~= stageId then return end
		self.waiting = false
		if isApplied then self:Close() else self:RefreshButtons() end
	end

	------------------------------------------------------------------------------------------------------------------------------------------------------
	-- Event Handlers
	------------------------------------------------------------------------------------------------------------------------------------------------------

	@ExecSpace("ClientOnly")
	method void OnCharacterClicked(string characterId)
		-- 보유 캐릭터를 선택하거나 해제하며 선택한 순서대로 왼쪽에 표시합니다.
		if self.root.Enable == false or self.waiting then return end
		local character = _CharacterManager:ClientGetCharacterById(characterId)
		if character == nil or character.isDiscovered ~= true then return end
		local selectedIndex = self:GetSelectedIndex(characterId)
		if selectedIndex > 0 then
			table.remove(self.selectedCharacterIds, selectedIndex)
		elseif #self.selectedCharacterIds < self.requiredCharacterCount then
			table.insert(self.selectedCharacterIds, characterId)
		else
			return
		end
		self:UpdateCardHighlights(0)
		self:RefreshProfiles()
		self:RefreshButtons()
	end

	@ExecSpace("ClientOnly")
	method void OnConfirmClicked(ButtonClickEvent event)
		-- 정확히 세 명을 선택한 경우에만 편성과 스테이지 진입을 함께 요청합니다.
		if self.waiting or #self.selectedCharacterIds ~= self.requiredCharacterCount then return end
		self.waiting = true
		self:RefreshButtons()
		_ProgressManager:RequestSelectStage(self.targetStage, self.selectedCharacterIds)
	end

	@ExecSpace("ClientOnly")
	method void OnCancelClicked(ButtonClickEvent event)
		-- 원래 편성을 유지한 채 스테이지 선택창으로 돌아갑니다.
		if self.waiting then return end
		_StageSelectUILogic:Open()
		self:Close()
	end

	@ExecSpace("ClientOnly")
	method void OnCharactersChanged(CharacterChangedEvent event)
		-- 열린 선택창에 해금이나 능력치 동기화 결과를 반영합니다.
		if self.root.Enable then self:RefreshCharacters() end
	end

	@ExecSpace("ClientOnly")
	method void OnProgressChanged(ProgressChangedEvent event)
		-- 서버에서 스테이지 진입이 확정되거나 스텝이 변경되면 선택창을 닫습니다.
		if _ProgressManager:ClientGetCurrentStep() ~= _EProgressStep.StageSelect then self:Close() end
	end


	@ExecSpace("ClientOnly")
	method void OnCardRefresh(integer index, Entity entity)
		-- 재사용되는 셀에 정보를 채우고 클릭 연결은 한 번만 만듭니다.
		local binding = self.cardBindings[entity.Id]
		if binding == nil then
			binding = {entity = entity, characterId = ""}
			binding.clickHandler = entity:ConnectEvent(ButtonClickEvent, function() self:OnCharacterClicked(binding.characterId) end)
			self.cardBindings[entity.Id] = binding
		end
		local character = self.characters[index + 1]
		local isOwned = character ~= nil and character.isDiscovered == true
		binding.characterId = character ~= nil and character.id or ""
		entity.ButtonComponent.Enable = isOwned and self.waiting == false
		local portrait = entity:GetChildByName("Frame"):GetChildByName("Portrait").SpriteGUIRendererComponent
		local level = entity:GetChildByName("LevelBar"):GetChildByName("Level").TextGUIRendererComponent
		local nameText = entity:GetChildByName("Name").TextGUIRendererComponent
		-- 미보유 이미지의 왼쪽 아래 원본 피벗 대신 카드 영역을 기준으로 표시합니다.
		portrait.PreserveSprite = isOwned and PreserveSpriteType.AspectOnly or PreserveSpriteType.None
		if isOwned then
			portrait.ImageRUID = DataRef(_RuntimeActorManager:ClientGetActorPortraitRuid(character.id, ""))
			portrait.Color = Color(1, 1, 1, 1)
			level.Text = "Lv. " .. tostring(_IntimacyLevelMaster:GetCurrentLevel(character.intimacy))
			nameText.Text = self:GetCharacterName(character)
		else
			portrait.ImageRUID = DataRef(self.lockedPortraitRuid)
			portrait.Color = Color(0.45, 0.45, 0.45, 1)
			level.Text = "Lv. 0"
			nameText.Text = "???"
		end
		local isSelected = isOwned and self:GetSelectedIndex(binding.characterId) > 0
		entity.SpriteGUIRendererComponent.Outline = isSelected
	end

	------------------------------------------------------------------------------------------------------------------------------------------------------
	-- LifeCycle
	------------------------------------------------------------------------------------------------------------------------------------------------------

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- UI 참조를 준비하고 목록 입력 및 데이터 변경 이벤트를 연결합니다.
		self.root.Enable = false
		self.cardTemplate.Enable = false
		self.cardBindings = {}
		self.profiles = {}
		self._T.cardHighlightTime = 0
		for index = 1, self.requiredCharacterCount do
			local entity = self.selection:GetChildByName("Character" .. tostring(index))
			local stats = entity:GetChildByName("Stats")
			self.profiles[index] = {entity = entity, portrait = entity:GetChildByName("Portrait").SpriteGUIRendererComponent, nameText = entity:GetChildByName("Name"):GetChildByName("Label").TextGUIRendererComponent, stats = {}}
			for _, stat in ipairs({"Vocal", "Dance", "Visual", "Fatigue"}) do self.profiles[index].stats[string.lower(stat)] = stats:GetChildByName(stat):GetChildByName("Value").LocalizedFormatTextComponent end
		end
		self.cardList.ItemEntity = self.cardTemplate
		self.cardList.OnRefresh = function(index, entity) self:OnCardRefresh(index, entity) end
		self.confirmClickHandler = self.confirmButton.Entity:ConnectEvent(ButtonClickEvent, self.OnConfirmClicked)
		self.cancelClickHandler = self.cancelButton.Entity:ConnectEvent(ButtonClickEvent, self.OnCancelClicked)
		self.characterChangedHandler = _CharacterManager:ConnectEvent(CharacterChangedEvent, self.OnCharactersChanged)
		self.progressChangedHandler = _ProgressManager:ConnectEvent(ProgressChangedEvent, self.OnProgressChanged)
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 선택창이 열린 동안 테두리 연출만 갱신합니다.
		if self.root.Enable then self:UpdateCardHighlights(delta) end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 고정 버튼과 재사용 목록 셀의 이벤트 연결을 모두 해제합니다.
		self:Close()
		self.cardList.OnRefresh = nil
		if self.confirmClickHandler ~= nil then self.confirmButton.Entity:DisconnectEvent(ButtonClickEvent, self.confirmClickHandler) end
		if self.cancelClickHandler ~= nil then self.cancelButton.Entity:DisconnectEvent(ButtonClickEvent, self.cancelClickHandler) end
		if self.characterChangedHandler ~= nil then _CharacterManager:DisconnectEvent(CharacterChangedEvent, self.characterChangedHandler) end
		if self.progressChangedHandler ~= nil then _ProgressManager:DisconnectEvent(ProgressChangedEvent, self.progressChangedHandler) end
		for _, binding in pairs(self.cardBindings) do
			if isvalid(binding.entity) then binding.entity:DisconnectEvent(ButtonClickEvent, binding.clickHandler) end
		end
		self.cardBindings = {}
		self.confirmClickHandler = nil
		self.cancelClickHandler = nil
		self.characterChangedHandler = nil
		self.progressChangedHandler = nil
	end

	------------------------------------------------------------------------------------------------------------------------------------------------------
	-- Private Methods
	------------------------------------------------------------------------------------------------------------------------------------------------------

	@ExecSpace("ClientOnly")
	method void RefreshCharacters()
		-- 보유 여부가 바뀐 임시 선택을 제거하고 목록 및 능력치를 갱신합니다.
		self.characters = _CharacterManager:ClientGetCharacters()
		for index = #self.selectedCharacterIds, 1, -1 do
			local character = _CharacterManager:ClientGetCharacterById(self.selectedCharacterIds[index])
			if character == nil or character.isDiscovered ~= true then table.remove(self.selectedCharacterIds, index) end
		end
		self.cardList.TotalCount = math.max(9, #self.characters)
		self.cardList:Refresh(false, true)
		self:UpdateCardHighlights(0)
		self:RefreshProfiles()
		self:RefreshButtons()
	end

	@ExecSpace("ClientOnly")
	method void RefreshProfiles()
		-- 전신 이미지와 정수 능력치를 왼쪽 세 칸에 표시합니다.
		for index, profile in ipairs(self.profiles) do
			local character = _CharacterManager:ClientGetCharacterById(self.selectedCharacterIds[index] or "")
			if character ~= nil then
				profile.portrait.ImageRUID = DataRef(_RuntimeActorManager:ClientGetActorPortraitFullBodyRuid(character.id, ""))
				profile.nameText.Text = self:GetCharacterName(character)
				for stat, text in pairs(profile.stats) do
					text:SetArguments(math.floor(character[stat] or 0), nil, nil, nil)
				end
			end
			profile.entity.Enable = character ~= nil
		end
	end

	@ExecSpace("ClientOnly")
	method void UpdateCardHighlights(number delta)
		-- 선택 여부는 즉시 반영하고 선택된 카드의 민트빛 초록 테두리만 반짝입니다.
		self._T.cardHighlightTime = self._T.cardHighlightTime + delta * 1.3
		local pulse = (math.sin(self._T.cardHighlightTime * 4) + 1) / 2
		local flash = (math.cos(self._T.cardHighlightTime * math.pi * 2 / 2.4) + 1) / 2
		for _, binding in pairs(self.cardBindings) do
			if isvalid(binding.entity) then
				local active = self:GetSelectedIndex(binding.characterId) > 0
				local renderer = binding.entity.SpriteGUIRendererComponent
				renderer.Outline = active
				if active then renderer.OutlineColor = Color(0.32 + flash * 0.5, 0.87 + flash * 0.13, 0.67 + flash * 0.26, math.min(1, 0.8 + pulse * 0.16 + flash * 0.12)) end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshButtons()
		-- 세 명 선택 완료와 서버 응답 대기에 맞춰 입력 및 확인 색상을 제어합니다.
		local canConfirm = #self.selectedCharacterIds == self.requiredCharacterCount and self.waiting == false
		self.confirmButton.Enable = canConfirm
		self.cancelButton.Enable = self.waiting == false
		self.confirmButton.Entity:GetChildByName("Background").SpriteGUIRendererComponent.Color = canConfirm and Color(0.69, 1, 0.42, 1) or Color(0.6, 0.6, 0.6, 1)
		for _, binding in pairs(self.cardBindings) do
			if isvalid(binding.entity) then
				local character = _CharacterManager:ClientGetCharacterById(binding.characterId)
				binding.entity.ButtonComponent.Enable = self.waiting == false and character ~= nil and character.isDiscovered == true
			end
		end
	end

	@ExecSpace("ClientOnly")
	method integer GetSelectedIndex(string characterId)
		-- 임시 편성 위치를 반환하고 미선택 캐릭터는 0을 반환합니다.
		for index, selectedId in ipairs(self.selectedCharacterIds) do if selectedId == characterId then return index end end
		return 0
	end

	@ExecSpace("ClientOnly")
	method string GetCharacterName(table character)
		-- ActorTable 번역 키로 이름을 조회합니다.
		local actor = _ActorMaster:GetActor(character.id)
		return _LocaleTextUtil:GetText(actor.nameKey)
	end

end

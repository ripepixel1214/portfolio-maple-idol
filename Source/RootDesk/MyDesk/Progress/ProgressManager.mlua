-- 플레이어의 전체 게임 진행 상태와 클라이언트 표시용 로컬 캐시를 관리합니다.
@Logic
script ProgressManager extends Logic
	property boolean confirmedCurrencyWrite = false

	property boolean isCurrencySaveDeferred = false

	@ExecSpace("ServerOnly")
	method boolean TrySpendMesoConfirmed(integer amount, string userId)
		-- 참가비와 일반 메소 거래의 저장 확인 경로 통일
		return self:TrySpendMeso(amount, userId)
	end

	property boolean isProgressLoaded = false

	-- ProgressData
	property any tCurrentProgress = nil

	-- save/load
	property string currentUserId = ""

	property any userEnterHandler = nil

	-- 행동력 최대치 (외출 스텝 진입 시 이 값으로 충전하고, 행동력 세팅 시 상한으로 사용)
	property integer maxActionPoint = 2

	property string CURRENCY_MESO = "meso"

	property string CURRENCY_DIAMOND = "diamond"

	property string CURRENCY_NIGHT_MARKET_COIN = "nightMarketCoin"

	property string CURRENCY_TEMP_WORLD_COIN = "tempWorldCoin"

	-- 부동소수점에서도 정수 덧셈 결과를 정확히 표현 가능한 상한
	property number MAX_SAFE_CURRENCY_AMOUNT = 9007199254740991

	------------------------------------------------------------------------------------------------------------------------------------------------------
	-- Public API
	------------------------------------------------------------------------------------------------------------------------------------------------------

	@ExecSpace("ClientOnly")
	method any ClientGetProgress()
		-- 클라이언트 로컬 캐시에 저장된 현재 진행 데이터의 복사본을 반환합니다.
		if self.tCurrentProgress == nil then
			return nil
		end

		return ProgressData():CreatePlainTableCopy(self.tCurrentProgress)
	end

	@ExecSpace("ClientOnly")
	method string ClientGetCurrentStage()
		-- 현재 진행 중인 스테이지 ID를 반환합니다. StageSelect 상태이면 빈 문자열입니다.
		if self.tCurrentProgress == nil or self.tCurrentProgress.eCurrentStage == nil then
			return ""
		end

		return self.tCurrentProgress.eCurrentStage
	end

	@ExecSpace("ClientOnly")
	method integer ClientGetCurrentStep()
		-- 클라이언트 로컬 캐시의 현재 내부 진행 스텝을 반환합니다. 캐시가 아직 없으면 0입니다.
		if self.tCurrentProgress == nil or self.tCurrentProgress.eCurrentStep == nil then
			return 0
		end

		return self.tCurrentProgress.eCurrentStep
	end

	-- Server/Client 공용
	method boolean IsValidStageStep(string currentStage, integer currentStep)
		-- 복합 진행 상태가 "몇 Stage의 어떤 Step" 규칙을 만족하는지 확인합니다.
		if currentStage == nil or currentStep == nil or _EProgressStep:IsValidStep(currentStep) == false then
			return false
		end

		if currentStep == _EProgressStep.StageSelect then
			return currentStage == ""
		end

		if currentStage == "" or _StageMaster == nil then return false end
		local tStage = _StageMaster:GetStage(currentStage)
		return _StageMaster:IsUsableStage(tStage)
	end

	@ExecSpace("Server")
	method boolean RequestCompleteStep(integer currentStep)
		-- 클라이언트 요청을 서버의 공통 스텝 완료 경로로 전달합니다.
		return self:CompleteStep(currentStep, senderUserId)
	end

	@ExecSpace("ServerOnly")
	method boolean CompleteStep(integer currentStep, string forUserId)
		-- 클라이언트 요청과 서버 콘텐츠 완료에서 현재 Step을 검증하고 다음 Step과 저장을 확정합니다.
		if self:CanUseProgress(forUserId) == false then
			return false
		end

		if self:IsCurrentStep(currentStep) == false then
			return false
		end
		if currentStep == _EProgressStep.BeforeTraining and _TagTrainingManager:IsTrainingComplete() == false then return false end
		if currentStep == _EProgressStep.Performance and _PerformanceResultManager:ApplyStageReward(self.tCurrentProgress.eCurrentStage, forUserId) == false then return false end

		local isApplied = self:ApplyCompleteStep()
		if isApplied then
			if currentStep == _EProgressStep.Performance then
				_TagTrainingManager:ClearState()
				_CharacterManager:ResetAllCharacterTags()
				_CharacterManager:PushCharactersToClient(forUserId)
			end
			_UserDataManager:SaveCoreData()
			self:PushProgressToClient(forUserId)
		end

		return isApplied
	end

	@ExecSpace("Server")
	method boolean RequestSelectStage(string targetStage, table characterIds)
		-- 보유 캐릭터 세 명을 검증한 뒤 스테이지와 편성을 함께 확정합니다.
		if self:CanUseProgress(senderUserId) == false or _CharacterManager:CanUseCharacters(senderUserId) == false or _CharacterManager:CanSetStageCharacters(characterIds) == false then
			self:NotifyStageSelectionResult(targetStage, false, senderUserId)
			return false
		end

		local isApplied = self:ApplySelectStage(targetStage)
		if isApplied then
			_CharacterManager:SetActiveCharacters(characterIds)
			_CharacterManager:ResetActiveCharacterTags()
			_TagTrainingManager:ClearState()
			_PerformanceResultManager:ResetStageReward()
			_CharacterManager:PushCharactersToClient(senderUserId)
			self:PushProgressToClient(senderUserId)
			_CharacterManager:SaveCharactersToStorage()
			self:SaveProgressToStorage()
		end
		self:NotifyStageSelectionResult(targetStage, isApplied, senderUserId)

		return isApplied
	end

	@ExecSpace("Client")
	method void NotifyStageSelectionResult(string targetStage, boolean isApplied)
		-- 선택 요청의 처리 결과를 전달해 거절 시 입력 잠금을 해제합니다.
		_CharacterSelectUILogic:ApplySelectionResult(targetStage, isApplied)
	end

	@ExecSpace("ServerOnly")
	method void ReloadProgressAfterStorageReset(string userId)
		-- 전체 저장소 초기화 이후 Progress 데이터와 클라이언트 캐시만 기본값으로 다시 구성합니다.
		if userId == nil or userId == "" then
			return
		end

		self.currentUserId = userId
		self:LoadProgressFromStorage()
		self:PushProgressResetToClient(userId)
	end

	@ExecSpace("Server")
	method void RequestCompleteTutorial(string tutorialId)
		-- 지정 튜토리얼 완료 상태를 서버 권위 진행 데이터에 반영하고 저장합니다. 클라(튜토리얼/프롤로그 종료)가 호출하므로 반드시 Server에서 실행되어 스토리지에 영속되어야 한다.
		if tutorialId == nil or tutorialId == "" then
			return
		end

		if self.tCurrentProgress == nil then
			return
		end

		if self:IsTutorialDone(tutorialId) then
			return
		end

		if type(self.tCurrentProgress.completedTutorials) ~= "table" then
			self.tCurrentProgress.completedTutorials = {}
		end
		self.tCurrentProgress.completedTutorials[tutorialId] = true
		self:PushProgressToClient(senderUserId)
		self:SaveProgressToStorage()
	end

	@ExecSpace("ServerOnly")
	method boolean IsProgressLoaded()
		-- 서버 진행 데이터 로드 여부를 반환합니다.
		return self.isProgressLoaded
	end

	@ExecSpace("ServerOnly")
	method boolean CanUseProgress(string userId)
		-- Request 입구에서 현재 유저와 진행 데이터 로드 완료 여부를 검증합니다.
		if self.confirmedCurrencyWrite or self:IsProgressLoaded() == false then
			log_warning("[ProgressManager] request rejected because progress is not loaded")
			return false
		end

		if self.currentUserId == nil or self.currentUserId == "" then
			log_warning("[ProgressManager] request rejected because currentUserId is empty")
			return false
		end

		if userId == nil or userId == "" or userId ~= self.currentUserId then
			log_warning("[ProgressManager] request rejected invalid userId=" .. tostring(userId))
			return false
		end

		return true
	end

	@ExecSpace("ServerOnly")
	method void SaveProgressToStorage()
		-- 확정 거래 중 저장 요청은 거래 종료 후 최신 잔액으로 재생성
		if self.confirmedCurrencyWrite then
			self.isCurrencySaveDeferred = true
			return
		end
		if self.currentUserId == nil or self.currentUserId == "" then
			log_warning("[ProgressManager] currentUserId is required")
			return
		end

		if self:IsProgressLoaded() == false or self.tCurrentProgress == nil then
			log_warning("[ProgressManager] CurrentProgress is nil")
			return
		end

		self:UpdateProgressPositionByUserId(self.currentUserId)
		_ProgressStorage:SaveProgressByUserIdAsync(self.currentUserId, self.tCurrentProgress)
	end

	@ExecSpace("Server")
	method void RequestSaveProgressToStorage()
		-- 맵 이동 후 현재 서버 진행 데이터와 외출 위치를 저장하고 클라이언트 캐시에 반영합니다.
		if self:CanUseProgress(senderUserId) == false then
			return
		end

		self:SaveProgressToStorage()
		self:PushProgressToClient(senderUserId)
	end

	@ExecSpace("ServerOnly")
	method any ServerGetProgress()
		-- 서버 권위 진행 데이터의 복사본을 반환합니다.
		if self:IsProgressLoaded() == false or self.tCurrentProgress == nil then
			return nil
		end

		return ProgressData():CreatePlainTableCopy(self.tCurrentProgress)
	end

	@ExecSpace("ServerOnly")
	method boolean TryConsumeNpcActionPoint(string userId)
		-- NPC 이벤트 시작에 필요한 행동력 1을 서버에서 검증하고 한 번만 차감
		if self:CanUseProgress(userId) == false or self.tCurrentProgress == nil then
			return false
		end

		local currentActionPoint = self.tCurrentProgress.actionPoint or 0
		if currentActionPoint < 1 then
			log_warning("[ProgressManager] npc action point rejected userId=" .. tostring(userId)
				.. " current=" .. tostring(currentActionPoint))
			return false
		end

		self:ApplyActionPointDelta(-1)

		self:PushProgressToClient(userId)
		self:SaveProgressToStorage()
		log("[ProgressManager] npc action point consumed userId=" .. tostring(userId)
			.. " remaining=" .. tostring(self.tCurrentProgress.actionPoint or 0))
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean RollbackNpcActionPoint(string userId)
		-- 첫 NPC 이벤트 실행 실패로 소비가 성립하지 않은 행동력 1 복구
		if self:CanUseProgress(userId) == false or self.tCurrentProgress == nil then
			log_warning("[ProgressManager] npc action point rollback rejected userId=" .. tostring(userId))
			return false
		end

		local currentActionPoint = self.tCurrentProgress.actionPoint or 0
		if currentActionPoint >= self.maxActionPoint then
			log_warning("[ProgressManager] npc action point rollback skipped userId=" .. tostring(userId)
				.. " current=" .. tostring(currentActionPoint))
			return false
		end

		self:ApplyActionPointDelta(1)
		self:PushProgressToClient(userId)
		self:SaveProgressToStorage()
		log("[ProgressManager] npc action point rolled back userId=" .. tostring(userId)
			.. " current=" .. tostring(self.tCurrentProgress.actionPoint or 0))
		return true
	end

	@ExecSpace("ServerOnly")
		-- tDelta == ProgressStatDelta:ToPlainTable()
	method boolean ApplyProgressStat(table tDelta)
		-- 진행 데이터에 속한 스탯 변경량 한 건을 서버 권위 데이터에 적용합니다.
		if self.confirmedCurrencyWrite or self:IsProgressLoaded() == false or self.tCurrentProgress == nil then
			log_warning("[ProgressManager] CurrentProgress is nil")
			return false
		end

		if type(tDelta) ~= "table" then
			log_warning("[ProgressManager] progress stat delta is nil")
			return false
		end

		-- 유료 지갑과 진행 데이터의 비원자적 동시 변경 차단
		if tDelta[self.CURRENCY_DIAMOND] ~= nil and tDelta[self.CURRENCY_DIAMOND] ~= 0 then
			log_warning("[ProgressManager] diamond delta requires DiamondWalletLogic transaction API")
			return false
		end
		-- 진행 재화 전체 검증 후 잔액 변경 적용
		local currencyIds = { self.CURRENCY_MESO, self.CURRENCY_NIGHT_MARKET_COIN, self.CURRENCY_TEMP_WORLD_COIN }
		local nextBalances = {}
		for _, currencyId in ipairs(currencyIds) do
			local delta = tDelta[currencyId]
			if delta == nil then delta = 0 end
			if type(delta) ~= "number" or self:IsValidCurrencyAmount(math.abs(delta)) == false then
				return false
			end
			local balance = self:GetCurrencyBalance(currencyId)
			if self:IsValidCurrencyAmount(balance) == false then
				return false
			end
			local nextBalance = balance + delta
			if self:IsValidCurrencyAmount(nextBalance) == false then
				log_warning("[ProgressManager] invalid currency stat delta currency=" .. tostring(currencyId) .. " delta=" .. tostring(delta))
				return false
			end
			nextBalances[currencyId] = nextBalance
		end

		local actionPointDelta = _MathUtil:Round(tDelta.actionPoint or 0)
		if actionPointDelta ~= 0 then
			self:ApplyActionPointDelta(actionPointDelta)
		end

		local fandomDelta = _MathUtil:Round(tDelta.fandom or 0)
		if fandomDelta ~= 0 then
			local nextFandom = math.floor(_MathUtil:ClampMin((self.tCurrentProgress.fandom or 0) + fandomDelta, 0))
			self.tCurrentProgress.fandom = nextFandom
		end

		for _, currencyId in ipairs(currencyIds) do
			self.tCurrentProgress[currencyId] = nextBalances[currencyId]
		end

		return true
	end

	@ExecSpace("ServerOnly")
	method boolean TrySpendTempWorldCoin(integer amount, string forUserId)
		-- 기존 상점의 임시 월드코인 차감을 공통 거래 경로로 전달
		return self:TrySpendCurrency(self.CURRENCY_TEMP_WORLD_COIN, amount, forUserId)
	end

	@ExecSpace("ServerOnly")
	method any GetCurrencyBalance(string currencyId)
		-- 허용된 거래 재화의 서버 잔액 조회
		if self:IsProgressLoaded() == false or self.tCurrentProgress == nil then
			return nil
		end

		if currencyId == self.CURRENCY_MESO then
			return self.tCurrentProgress.meso or 0
		end

		if currencyId == self.CURRENCY_DIAMOND then
			return _DiamondWalletLogic:GetBalance(self.currentUserId)
		end

		if currencyId == self.CURRENCY_NIGHT_MARKET_COIN then
			return self.tCurrentProgress.nightMarketCoin or 0
		end

		if currencyId == self.CURRENCY_TEMP_WORLD_COIN then
			return self.tCurrentProgress.tempWorldCoin or 0
		end

		return nil
	end

	@ExecSpace("ServerOnly")
	method boolean TryApplyCurrencyTransaction(string currencyId, integer debit, integer credit, string forUserId)
		-- 허용된 재화의 차감과 지급을 검증 후 한 번에 반영
		if self:CanUseProgress(forUserId) == false or self.tCurrentProgress == nil then
			return false
		end

		if self:IsValidCurrencyAmount(debit) == false or self:IsValidCurrencyAmount(credit) == false or (debit == 0 and credit == 0) then
			log_warning("[ProgressManager] invalid currency transaction currency=" .. tostring(currencyId) .. " debit=" .. tostring(debit) .. " credit=" .. tostring(credit))
			return false
		end

		if currencyId == self.CURRENCY_DIAMOND then
			log_warning("[Currency] diamond requires TryApplyDiamondTransaction with a stable operation ID")
			return false
		end

		local currentBalance = self:GetCurrencyBalance(currencyId)
		if currentBalance == nil then
			log_warning("[ProgressManager] unsupported currency transaction currency=" .. tostring(currencyId))
			return false
		end

		if self:IsValidCurrencyAmount(currentBalance) == false then
			return false
		end

		if currentBalance < debit then
			log_warning("[ProgressManager] insufficient currency userId=" .. tostring(forUserId) .. " currency=" .. tostring(currencyId) .. " current=" .. tostring(currentBalance) .. " debit=" .. tostring(debit))
			return false
		end

		local remainingBalance = currentBalance - debit
		if credit > self.MAX_SAFE_CURRENCY_AMOUNT - remainingBalance then return false end
		local nextBalance = remainingBalance + credit
		if nextBalance == currentBalance then return true end
		return self:CommitCurrencyBalanceConfirmed(currencyId, nextBalance, nil, forUserId)
	end

	@ExecSpace("ServerOnly")
	method boolean TrySpendCurrencyForShopItems(string currencyId, integer amount, table shopItemIds, string forUserId)
		-- 상점의 잔액 차감과 구매 소유 목록을 함께 확정
		if not self:CanUseProgress(forUserId) or not self:IsValidCurrencyAmount(amount) or amount <= 0
			or currencyId == self.CURRENCY_DIAMOND or type(shopItemIds) ~= "table"
			or _ShopItemManager.currentUserId ~= forUserId then return false end
		local balance = self:GetCurrencyBalance(currencyId)
		if not self:IsValidCurrencyAmount(balance) or balance < amount then return false end
		return self:CommitCurrencyBalanceConfirmed(currencyId, balance - amount, shopItemIds, forUserId)
	end

	@ExecSpace("ServerOnly")
	method boolean CommitCurrencyBalanceConfirmed(string currencyId, integer nextBalance, any shopItemIds, string forUserId)
		-- 성공 확인 전 캐시 변경·UI 통지 차단, 거래 중 일반 저장은 뒤로 연기
		if not self:CanUseProgress(forUserId) or not self:IsValidCurrencyAmount(nextBalance)
			or (currencyId ~= self.CURRENCY_MESO and currencyId ~= self.CURRENCY_NIGHT_MARKET_COIN
				and currencyId ~= self.CURRENCY_TEMP_WORLD_COIN)
			or not _ProgressStorage.CanSaveProgress then return false end

		self.confirmedCurrencyWrite = true
		local ok, confirmed = pcall(function()
			local progressString = _ProgressStorage:CreateCurrencyProgressString(self.tCurrentProgress, currencyId, nextBalance)
			if shopItemIds ~= nil then
				return _ShopItemStorage:SavePurchaseConfirmed(forUserId, progressString, shopItemIds)
			end
			return _ProgressStorage:SaveProgressStringConfirmed(forUserId, progressString)
		end)
		if ok and confirmed then self.tCurrentProgress[currencyId] = nextBalance end
		self.confirmedCurrencyWrite = false
		if not _ProgressStorage.CanSaveProgress then self.isProgressLoaded = false end

		if self.isCurrencySaveDeferred then
			self.isCurrencySaveDeferred = false
			if self.isProgressLoaded then self:SaveProgressToStorage() end
		end
		if not ok then
			log_error("[Currency] confirmed transaction exception userId=" .. tostring(forUserId) .. " error=" .. tostring(confirmed))
			return false
		end
		if not confirmed then return false end
		self:PushProgressToClient(forUserId)
		log("[VRF][Currency] durable currency=" .. currencyId .. " balance=" .. tostring(nextBalance))
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean IsValidCurrencyAmount(any amount)
		-- 음수·소수·비정상 숫자와 정수 정밀도 범위를 벗어난 금액 거부
		return type(amount) == "number" and amount == amount and amount >= 0
			and amount <= self.MAX_SAFE_CURRENCY_AMOUNT and amount == math.floor(amount)
	end

	@ExecSpace("ServerOnly")
	method boolean TryGrantCurrency(string currencyId, integer amount, string forUserId)
		return self:TryApplyCurrencyTransaction(currencyId, 0, amount, forUserId)
	end

	@ExecSpace("ServerOnly")
	method boolean TrySpendCurrency(string currencyId, integer amount, string forUserId)
		return self:TryApplyCurrencyTransaction(currencyId, amount, 0, forUserId)
	end

	@ExecSpace("ServerOnly")
	method boolean TryGrantMeso(integer amount, string forUserId)
		return self:TryGrantCurrency(self.CURRENCY_MESO, amount, forUserId)
	end

	@ExecSpace("ServerOnly")
	method boolean TrySpendMeso(integer amount, string forUserId)
		return self:TrySpendCurrency(self.CURRENCY_MESO, amount, forUserId)
	end

	@ExecSpace("ServerOnly")
	method boolean TryGrantDiamond(integer amount, string forUserId, string operationId, string reason)
		-- 거래 ID를 보존하는 다이아몬드 지급
		return self:TryApplyDiamondTransaction(0, amount, forUserId, operationId, reason)
	end

	@ExecSpace("ServerOnly")
	method boolean TrySpendDiamond(integer amount, string forUserId, string operationId, string reason)
		-- 거래 ID를 보존하는 다이아몬드 차감
		return self:TryApplyDiamondTransaction(amount, 0, forUserId, operationId, reason)
	end

	@ExecSpace("ServerOnly")
	method boolean TryGrantNightMarketCoin(integer amount, string forUserId)
		return self:TryGrantCurrency(self.CURRENCY_NIGHT_MARKET_COIN, amount, forUserId)
	end

	@ExecSpace("ServerOnly")
	method boolean TrySpendNightMarketCoin(integer amount, string forUserId)
		return self:TrySpendCurrency(self.CURRENCY_NIGHT_MARKET_COIN, amount, forUserId)
	end

	@ExecSpace("ServerOnly")
	method boolean TryGrantTempWorldCoin(integer amount, string forUserId)
		return self:TryGrantCurrency(self.CURRENCY_TEMP_WORLD_COIN, amount, forUserId)
	end

	@ExecSpace("ServerOnly")
	method boolean TryApplyDiamondTransaction(integer debit, integer credit, string forUserId, string operationId, string reason)
		-- 진행 소유권 확인 후 동일 거래 ID로 유료 지갑 갱신
		if self:CanUseProgress(forUserId) == false then return false end
		return _DiamondWalletLogic:TryApplyTransactionWithId(forUserId, operationId, debit, credit, reason)
	end

	@ExecSpace("ServerOnly")
	method boolean TryApplyMesoTransaction(integer debit, integer credit, string forUserId)
		-- 기존 메소 거래 호출을 공통 재화 거래 경로로 전달
		return self:TryApplyCurrencyTransaction(self.CURRENCY_MESO, debit, credit, forUserId)
	end

	@ExecSpace("ServerOnly")
	method boolean TryApplyNightMarketCoinTransaction(integer debit, integer credit, string forUserId)
		-- 야시장 코인 거래를 공통 재화 거래 경로로 전달
		return self:TryApplyCurrencyTransaction(self.CURRENCY_NIGHT_MARKET_COIN, debit, credit, forUserId)
	end

	@ExecSpace("ServerOnly")
	method void PushProgressToClient(string forUserId)
		-- 서버 권위 진행 데이터를 지정한 클라이언트의 로컬 캐시로 전송합니다.
		if forUserId == nil or forUserId == "" then
			return
		end

		if self:IsProgressLoaded() == false or self.tCurrentProgress == nil then
			return
		end

		local tProgressData = ProgressData():CreatePlainTableCopy(self.tCurrentProgress)
		self:SyncProgress(tProgressData, forUserId)
	end

	------------------------------------------------------------------------------------------------------------------------------------------------------
	-- Event Handlers
	------------------------------------------------------------------------------------------------------------------------------------------------------

	@ExecSpace("ServerOnly")
	method void OnUserEnter(UserEnterEvent event)
		-- 싱글 플레이어가 서버에 입장하면 진행 데이터를 로드하고 해당 클라이언트에 전송합니다.
		if event == nil or event.UserId == nil or event.UserId == "" then
			return
		end

		if self.currentUserId ~= nil and self.currentUserId ~= "" and self.currentUserId ~= event.UserId then
			log_warning("[ERROR][ProgressManager] single-user instance violation currentUserId=" .. tostring(self.currentUserId)
				.. " enteredUserId=" .. tostring(event.UserId))
			return
		end

		self.currentUserId = event.UserId
		self:LoadProgressFromStorage()

		if self:IsProgressLoaded() then
			self:PushProgressToClient(event.UserId)
		end
	end

	------------------------------------------------------------------------------------------------------------------------------------------------------
	-- Debug API
	------------------------------------------------------------------------------------------------------------------------------------------------------

	@ExecSpace("Server")
	method boolean RequestAddWeek()
		-- 클라이언트가 현재 주차를 1 증가시키도록 서버에 요청합니다.
		if self:CanUseProgress(senderUserId) == false then
			return false
		end

		local isApplied = self:ApplyWeekDelta(1)
		if isApplied then
			self:PushProgressToClient(senderUserId)
		end

		return isApplied
	end

	@ExecSpace("Server")
	method boolean RequestSetActionPoint(integer actionPoint)
		-- 디버그 입력에서 현재 액션 포인트를 지정값으로 세팅하도록 서버에 요청합니다.
		if self:CanUseProgress(senderUserId) == false then
			return false
		end

		self:ApplyActionPoint(actionPoint)
		self:PushProgressToClient(senderUserId)
		self:SaveProgressToStorage()
		return true
	end

	@ExecSpace("Server")
	method boolean RequestAddActionPoint(integer amount)
		-- 디버그 입력에서 현재 액션 포인트에 델타를 적용하도록 서버에 요청합니다.
		if self:CanUseProgress(senderUserId) == false then
			return false
		end

		self:ApplyActionPointDelta(amount)
		self:PushProgressToClient(senderUserId)
		self:SaveProgressToStorage()
		return true
	end

	@ExecSpace("Server")
	method boolean RequestDebugMoveToPerformanceWeek(string performanceId)
		-- 디버그 입력에서 지정 공연의 공연 주간으로 즉시 이동하도록 서버 진행도를 변경합니다.
		if Environment:IsMakerPlay() == false or self:CanUseProgress(senderUserId) == false then
			return false
		end
		if self:IsProgressLoaded() == false or self.tCurrentProgress == nil then
			log_warning("[ProgressManager] CurrentProgress is nil")
			return false
		end
		if performanceId == nil or performanceId == "" then
			log_warning("[ProgressManager] debug performanceId is required")
			return false
		end

		local stage = _StageMaster:GetStage(self.tCurrentProgress.eCurrentStage)
		if stage == nil or stage.performanceId ~= performanceId then
			stage = nil
			for _, candidate in ipairs(_StageMaster:GetStages()) do
				if candidate.performanceId == performanceId then
					stage = candidate
					break
				end
			end
		end
		if stage == nil then
			log_warning("[ProgressManager] stage not found for performanceId=" .. performanceId)
			return false
		end

		self.tCurrentProgress.eCurrentStage = stage.stageId
		self.tCurrentProgress.currentMonth = stage.month
		self.tCurrentProgress.currentWeek = stage.week
		self.tCurrentProgress.eCurrentStep = _EProgressStep.Performance
		self:ClearProgressLocation()
		_PerformanceResultManager:ResetStageReward()
		self:PushProgressToClient(senderUserId)
		_UserDataManager:SaveCoreData()

		return true
	end

	------------------------------------------------------------------------------------------------------------------------------------------------------
	-- LifeCycle
	------------------------------------------------------------------------------------------------------------------------------------------------------

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 서버에서 유저 입장을 구독하고 진행 데이터를 로드합니다.
		self.userEnterHandler = _UserService:ConnectEvent(UserEnterEvent, self.OnUserEnter)
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 진행 매니저가 연결한 이벤트를 실행 공간에 맞게 정리합니다.
		if self.userEnterHandler ~= nil then
			_UserService:DisconnectEvent(UserEnterEvent, self.userEnterHandler)
			self.userEnterHandler = nil
		end
	end

	------------------------------------------------------------------------------------------------------------------------------------------------------
	-- Private Methods
	------------------------------------------------------------------------------------------------------------------------------------------------------

	@ExecSpace("ClientOnly")
	method void SendProgressChangedEvent()
		-- 진행 데이터 변경을 구독 중인 UI와 로직에 알립니다.
		if self.tCurrentProgress == nil then
			log_warning("[ProgressManager] CurrentProgress is nil")
			return
		end

		local progressChangedEvent = ProgressChangedEvent()
		self:SendEvent(progressChangedEvent)
	end

	@ExecSpace("ClientOnly")
	method void SendProgressStepChangedEvent(integer previousStep, integer currentStep)
		-- 진행 스텝 변경을 클라이언트 후속 처리 로직에 알립니다.
		local progressStepChangedEvent = ProgressStepChangedEvent()
		progressStepChangedEvent.previousStep = previousStep
		progressStepChangedEvent.currentStep = currentStep
		self:SendEvent(progressStepChangedEvent)
	end

	@ExecSpace("ServerOnly")
	method boolean IsCurrentStep(integer currentStep)
		-- 요청 시점의 Step이 서버 권위 Step과 일치하는지 확인해 중복 요청을 차단합니다.
		if self.tCurrentProgress == nil then
			return false
		end

		if currentStep == nil or _EProgressStep:IsValidStep(currentStep) == false then
			log_warning("[ProgressManager] transition rejected because currentStep is invalid step=" .. _EProgressStep:GetName(currentStep))
			return false
		end

		local serverCurrentStep = self.tCurrentProgress.eCurrentStep
		if serverCurrentStep ~= currentStep then
			log_warning("[ProgressManager] transition rejected requestStep=" .. _EProgressStep:GetName(currentStep) .. " serverCurrentStep=" .. _EProgressStep:GetName(serverCurrentStep))
			return false
		end

		return true
	end

	@ExecSpace("ServerOnly")
	method void PushProgressResetToClient(string forUserId)
		-- 초기 진행 데이터를 맵 이동 없이 지정 클라이언트 캐시에 반영합니다.
		if forUserId == nil or forUserId == "" then
			return
		end

		if self:IsProgressLoaded() == false or self.tCurrentProgress == nil then
			return
		end

		self:SyncProgressAfterReset(ProgressData():CreatePlainTableCopy(self.tCurrentProgress), forUserId)
	end

	@ExecSpace("Client")
	method void SyncProgressAfterReset(table tProgressData)
		-- 초기화된 진행 데이터를 타이틀 맵 이동 없이 클라이언트 로컬 캐시에 교체합니다.
		if tProgressData == nil then
			return
		end

		self.tCurrentProgress = tProgressData
		self.tCurrentProgress.completedTutorials = self:ParseCompletedCsv(tProgressData.completedTutorials)
		self:SendProgressChangedEvent()
	end

	@ExecSpace("ServerOnly")
	method boolean IsTutorialDone(string tutorialId)
		-- 서버 권위 데이터의 완료 집합(테이블)에 tutorialId가 있는지 확인합니다.
		if self.tCurrentProgress == nil or tutorialId == nil or tutorialId == "" then
			return false
		end

		local done = self.tCurrentProgress.completedTutorials
		return type(done) == "table" and done[tutorialId] == true
	end

	@ExecSpace("ServerOnly")
	method void LoadProgressFromStorage()
		-- Storage에서 로드한 진행 데이터를 서버 권위 데이터로 보관합니다.
		if self.currentUserId == nil or self.currentUserId == "" then
			log_warning("[ProgressManager] currentUserId is required")
			self.isProgressLoaded = false
			return
		end

		-- 레거시 다이아몬드 이관 실패 시 진행 저장으로 원본을 잃지 않도록 로드 보류
		if _DiamondWalletLogic:IsInitializedForUser(self.currentUserId) == false
			and _DiamondWalletLogic:LoadForUser(self.currentUserId) == false then
			self.isProgressLoaded = false
			return
		end

		local tProgressData = _ProgressStorage:LoadProgressByUserId(self.currentUserId)
		if tProgressData == nil then
			log_warning("[ProgressManager] progressData is nil")
			self.isProgressLoaded = false
			return
		end

		self.tCurrentProgress = tProgressData
		_PerformanceResultManager:ClearStageAttempt()
		self.isProgressLoaded = true
	end

	@ExecSpace("ServerOnly")
	method void ClearProgressLocation()
		-- 스텝이 바뀌면 이전 맵 위치를 비워 다음 맵이 소유한 기본 진입점을 사용하게 합니다.
		if self.tCurrentProgress == nil then
			return
		end

		self.tCurrentProgress.currentMapId = ""
		self.tCurrentProgress.positionX = 0
		self.tCurrentProgress.positionY = 0
	end

	@ExecSpace("ServerOnly")
	method void UpdateProgressPositionByUserId(string userId)
		-- 외출 가능한 스텝의 실제 외출 위치를 기록하고, 자유 외출에서 Studio로 복귀하면 위치를 비웁니다.
		if self.tCurrentProgress == nil or userId == nil or userId == "" then
			return
		end

		local currentStep = self.tCurrentProgress.eCurrentStep
		if currentStep ~= _EProgressStep.Outdoor and currentStep ~= _EProgressStep.StageSelect then
			return
		end

		local userEntity = _UserService:GetUserEntityByUserId(userId)
		if userEntity == nil or isvalid(userEntity) == false or userEntity.TransformComponent == nil or isvalid(userEntity.CurrentMap) == false then
			return
		end

		local currentMapName = userEntity.CurrentMap.Name
		if _OutdoorMapTransitionLogic:IsOutdoorMap(currentMapName) == false then
			if currentStep == _EProgressStep.StageSelect and currentMapName == _OutdoorMapTransitionLogic.STUDIO_MAP_NAME then
				self:ClearProgressLocation()
			end
			return
		end

		local position = userEntity.TransformComponent.WorldPosition
		self.tCurrentProgress.currentMapId = currentMapName
		self.tCurrentProgress.positionX = position.x
		self.tCurrentProgress.positionY = position.y
	end

	@ExecSpace("ServerOnly")
	method boolean ApplySelectStage(string targetStage)
		-- 스테이지를 선택하고 월·주차를 시작값으로 돌린 뒤 훈련 전 스텝을 시작합니다.
		if self:IsProgressLoaded() == false or self.tCurrentProgress == nil then
			log_warning("[ProgressManager] CurrentProgress is nil")
			return false
		end

		if self.tCurrentProgress.eCurrentStep ~= _EProgressStep.StageSelect then
			log_warning("[ProgressManager] stage selection rejected currentStep=" .. _EProgressStep:GetName(self.tCurrentProgress.eCurrentStep))
			return false
		end

		local stage = _StageMaster:GetStage(targetStage)
		if stage == nil then
			log_warning("[ProgressManager] stage selection rejected targetStage=" .. tostring(targetStage))
			return false
		end
		if _StageMaster:IsUsableStage(stage) == false then return false end

		_PerformanceResultManager:ClearStageAttempt()
		local tDefaultProgress = ProgressData()
		self.tCurrentProgress.currentMonth = tDefaultProgress.currentMonth
		self.tCurrentProgress.currentWeek = tDefaultProgress.currentWeek
		self.tCurrentProgress.eCurrentStage = targetStage
		self.tCurrentProgress.eCurrentStep = _EProgressStep.BeforeTraining
		self:ClearProgressLocation()

		return true
	end

	@ExecSpace("ServerOnly")
	method boolean ApplyCompleteStep()
		-- 현재 내부 스텝을 완료하고 정해진 다음 스텝으로 이동합니다.
		if self:IsProgressLoaded() == false or self.tCurrentProgress == nil then
			log_warning("[ProgressManager] CurrentProgress is nil")
			return false
		end

		local previousStep = self.tCurrentProgress.eCurrentStep
		if self:IsValidStageStep(self.tCurrentProgress.eCurrentStage, previousStep) == false then
			log_warning("[ProgressManager] 단계 완료 거부: 유효하지 않은 스테이지")
			return false
		end
		if previousStep == _EProgressStep.Performance
			and _PerformanceResultManager:CanCompleteStage(self.currentUserId) == false then
			log_warning("[ProgressManager] 공연 완료 거부: 서버 확정 성공 결과 없음")
			return false
		end
		if previousStep == _EProgressStep.StageSelect then
			log_warning("[ProgressManager] select a stage before moving to the next step")
			return false
		end

		local nextStep = self:GetNextStep(previousStep)
		if previousStep == _EProgressStep.Outdoor then
			if self:ApplyWeekDelta(1) == false then
				return false
			end

			if self:IsCurrentStagePerformanceDue() then
				nextStep = _EProgressStep.Performance
			end
		end

		if nextStep == _EProgressStep.Outdoor then
			self:ApplyActionPoint(self.maxActionPoint)
		end

		if nextStep == _EProgressStep.StageSelect then
			self.tCurrentProgress.eCurrentStage = ""
			_PerformanceResultManager:ClearStageAttempt()
		end

		self.tCurrentProgress.eCurrentStep = nextStep
		self:ClearProgressLocation()

		return true
	end

	@ExecSpace("ServerOnly")
	method integer GetNextStep(integer currentStep)
		-- 현재 내부 스텝의 정해진 다음 스텝을 반환합니다.
		if currentStep == _EProgressStep.BeforeTraining then
			return _EProgressStep.AfterTraining
		end

		if currentStep == _EProgressStep.AfterTraining then
			return _EProgressStep.Outdoor
		end

		if currentStep == _EProgressStep.Outdoor then
			return _EProgressStep.BeforeTraining
		end

		if currentStep == _EProgressStep.Performance then
			return _EProgressStep.StageSelect
		end

		return _EProgressStep.StageSelect
	end

	@ExecSpace("ServerOnly")
	method boolean IsCurrentStagePerformanceDue()
		-- 현재 진행 월·주차가 선택한 스테이지의 공연 발생 시점인지 확인합니다.
		if self.tCurrentProgress == nil then
			return false
		end

		local stage = _StageMaster:GetStage(self.tCurrentProgress.eCurrentStage)
		if stage == nil then
			return false
		end

		return self.tCurrentProgress.currentMonth == stage.month and self.tCurrentProgress.currentWeek == stage.week
	end

	@ExecSpace("ServerOnly")
	method void ApplyActionPoint(integer actionPoint)
		-- 현재 행동력을 지정한 값으로 설정합니다.
		if self:IsProgressLoaded() == false or self.tCurrentProgress == nil then
			log_warning("[ProgressManager] CurrentProgress is nil")
			return
		end

		local nextActionPoint = math.floor(_MathUtil:Clamp(actionPoint, 0, self.maxActionPoint))
		if self.tCurrentProgress.actionPoint == nextActionPoint then
			return
		end

		self.tCurrentProgress.actionPoint = nextActionPoint
	end

	@ExecSpace("ServerOnly")
	method void ApplyActionPointDelta(integer amount)
		-- 현재 행동력에 지정한 값을 더합니다. 음수 값은 차감으로 처리합니다.
		if self:IsProgressLoaded() == false or self.tCurrentProgress == nil then
			log_warning("[ProgressManager] CurrentProgress is nil")
			return
		end

		if amount == 0 then
			return
		end

		self:ApplyActionPoint((self.tCurrentProgress.actionPoint or 0) + amount)
	end

	@ExecSpace("ServerOnly")
	method boolean ApplyWeekDelta(integer amount)
		-- 현재 월/주차에 지정한 주차 변화를 적용합니다. Push와 Storage 저장은 호출자가 결정합니다.
		if self:IsProgressLoaded() == false or self.tCurrentProgress == nil then
			log_warning("[ProgressManager] CurrentProgress is nil")
			return false
		end

		if amount == nil then
			log_warning("[ProgressManager] week amount is nil")
			return false
		end

		local currentMonth = math.floor(_MathUtil:ClampMin(self.tCurrentProgress.currentMonth or 1, 1))
		local currentWeek = math.floor(_MathUtil:ClampMin(self.tCurrentProgress.currentWeek or 1, 1))
		if currentWeek > 4 then
			currentWeek = 4
		end

		local zeroBasedWeek = _MathUtil:ClampMin((currentMonth - 1) * 4 + currentWeek - 1 + amount, 0)
		local nextMonth = math.floor(zeroBasedWeek / 4) + 1
		local nextWeek = (zeroBasedWeek % 4) + 1
		if self.tCurrentProgress.currentMonth == nextMonth and self.tCurrentProgress.currentWeek == nextWeek then
			return true
		end

		self.tCurrentProgress.currentMonth = nextMonth
		self.tCurrentProgress.currentWeek = nextWeek
		return true
	end

	@ExecSpace("Client")
	method void SyncProgress(table tProgressData)
		-- 서버에서 받은 진행 데이터를 클라이언트 로컬 캐시에 저장합니다.
		local hasCachedProgress = self.tCurrentProgress ~= nil
		local previousStep = hasCachedProgress and self.tCurrentProgress.eCurrentStep or 0
		self.tCurrentProgress = tProgressData
		-- 전송은 CSV 문자열이므로 클라 로컬에선 완료 집합을 테이블로 복원해 조회를 단순화한다.
		self.tCurrentProgress.completedTutorials = self:ParseCompletedCsv(tProgressData.completedTutorials)

		if hasCachedProgress and previousStep ~= self.tCurrentProgress.eCurrentStep then
			self:SendProgressStepChangedEvent(previousStep, self.tCurrentProgress.eCurrentStep)
		end

		self:SendProgressChangedEvent()
	end

	@ExecSpace("ClientOnly")
	method any ParseCompletedCsv(any csv)
		-- CSV 문자열(또는 이미 테이블)을 완료 집합 테이블로 복원한다.
		local set = {}
		if type(csv) == "string" then
			for id in string.gmatch(csv, "([^,]+)") do
				set[id] = true
			end
		elseif type(csv) == "table" then
			for id, done in pairs(csv) do
				if done == true then
					set[id] = true
				end
			end
		end
		return set
	end

end

@Logic
script EProgressStep extends Logic

	property integer StageSelect = 1

	property integer BeforeTraining = 2

	property integer AfterTraining = 3

	property integer Outdoor = 4

	property integer Performance = 5

	method boolean IsValidStep(integer step)
		-- 사용할 수 있는 진행 스텝인지 확인합니다.
		return step == self.StageSelect or step == self.BeforeTraining or step == self.AfterTraining or step == self.Outdoor or step == self.Performance
	end

	method string GetName(integer step)
		-- 스텝 값을 화면 표시와 로그 출력용 이름으로 변환합니다.
		if step == self.StageSelect then
			return "스테이지 선택"
		end

		if step == self.BeforeTraining then
			return "훈련 전"
		end

		if step == self.AfterTraining then
			return "훈련 후"
		end

		if step == self.Outdoor then
			return "외출"
		end

		if step == self.Performance then
			return "공연"
		end

		return tostring(step)
	end

	method boolean IsPerformanceStep(integer step)
		-- 공연 스텝인지 확인합니다.
		return step == self.Performance
	end

end

@Logic
script StepEntryLogic extends Logic

	property string studioMapId = "Map_Studio"

	property any progressStepChangedHandler = nil

	------------------------------------------------------------------------------------------------------------------------------------------------------
	-- Public API
	------------------------------------------------------------------------------------------------------------------------------------------------------

	@ExecSpace("ClientOnly")
	method void RequestEnterCurrentStep()
		-- 현재 스텝의 맵으로 진입하고, 진행 중인 외출이 있으면 저장 위치를 복원합니다.
		if _ProgressManager == nil then
			return
		end

		local progress = _ProgressManager:ClientGetProgress()
		if progress == nil or _EProgressStep:IsValidStep(progress.eCurrentStep) == false then
			return
		end

		local hasOutdoorLocation = _OutdoorMapTransitionLogic ~= nil and _OutdoorMapTransitionLogic:IsOutdoorMap(progress.currentMapId)
		if progress.eCurrentStep == _EProgressStep.Outdoor or (progress.eCurrentStep == _EProgressStep.StageSelect and hasOutdoorLocation) then
			if _OutdoorMapTransitionLogic ~= nil then
				_OutdoorMapTransitionLogic:EnterOutdoor(progress.currentMapId)
			end
			return
		end

		self:RequestEnterDefaultStep(progress.eCurrentStep)
	end

	@ExecSpace("ClientOnly")
	method void RequestEnterStudio()
		-- Studio에 이미 있으면 위치를 건드리지 않고, 다른 맵에 있을 때만 Studio로 이동합니다.
		if self:IsCurrentMap(self.studioMapId) then
			return
		end

		local player = _UserService.LocalPlayer
		if player == nil or player.PlayerComponent == nil then
			log_warning("[StepEntryLogic] LocalPlayer or PlayerComponent is nil")
			return
		end

		local moveAction = function()
			player.PlayerComponent:MoveToMapPosition(self.studioMapId, Vector2(0, 0))
		end
		if _MapTransitionHelper == nil then
			moveAction()
			return
		end

		_MapTransitionHelper:RequestMoveToMap(self.studioMapId, moveAction)
	end

	------------------------------------------------------------------------------------------------------------------------------------------------------
	-- Event Handlers
	------------------------------------------------------------------------------------------------------------------------------------------------------

	@ExecSpace("ClientOnly")
	method void OnProgressStepChanged(any progressStepChangedEvent)
		-- 스텝 전환에 따라 필요한 맵으로 이동합니다.
		if progressStepChangedEvent == nil then
			return
		end

		self:RequestEnterDefaultStep(progressStepChangedEvent.currentStep)
	end

	------------------------------------------------------------------------------------------------------------------------------------------------------
	-- LifeCycle
	------------------------------------------------------------------------------------------------------------------------------------------------------

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 진행 스텝 변경 이벤트를 구독합니다.
		if _ProgressManager ~= nil then
			self.progressStepChangedHandler = _ProgressManager:ConnectEvent(ProgressStepChangedEvent, self.OnProgressStepChanged)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 진행 스텝 변경 이벤트 구독을 해제합니다.
		if self.progressStepChangedHandler ~= nil and _ProgressManager ~= nil then
			_ProgressManager:DisconnectEvent(ProgressStepChangedEvent, self.progressStepChangedHandler)
			self.progressStepChangedHandler = nil
		end
	end

	------------------------------------------------------------------------------------------------------------------------------------------------------
	-- Private Methods
	------------------------------------------------------------------------------------------------------------------------------------------------------

	@ExecSpace("ClientOnly")
	method void RequestEnterDefaultStep(integer currentStep)
		-- Outdoor 스텝은 OurdoorMapTransitionLogic에 위임하고 Studio 스텝은 필요한 경우에만 맵을 전환합니다.
		if currentStep == _EProgressStep.Outdoor then
			if _OutdoorMapTransitionLogic ~= nil then
				_OutdoorMapTransitionLogic:EnterOutdoor("")
			end
			return
		end

		if self:IsStudioStep(currentStep) then
			self:RequestEnterStudio()
		end
	end

	@ExecSpace("ClientOnly")
	method boolean IsStudioStep(integer currentStep)
		-- Studio에서 진행하는 스텝인지 반환합니다.
		return currentStep == _EProgressStep.StageSelect or currentStep == _EProgressStep.BeforeTraining or currentStep == _EProgressStep.AfterTraining or currentStep == _EProgressStep.Performance
	end

	@ExecSpace("ClientOnly")
	method boolean IsCurrentMap(string mapName)
		-- 현재 로컬 플레이어가 지정한 맵에 있는지 확인합니다.
		if mapName == nil or mapName == "" then
			return false
		end

		local player = _UserService.LocalPlayer
		if player == nil then
			return false
		end

		local currentMap = player.CurrentMap
		if isvalid(currentMap) == false then
			return false
		end

		return currentMap.Name == mapName
	end

end

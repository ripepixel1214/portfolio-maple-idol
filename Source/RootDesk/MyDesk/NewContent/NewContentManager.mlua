@Logic
script NewContentManager extends Logic

	property boolean isLoaded = false

	property string currentUserId = ""

	property any unreadKeys = {}

	property any unreadKeySet = {}

	property any userEnterHandler = nil

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 유저 입장 시 신규 콘텐츠 데이터를 불러오도록 이벤트를 연결합니다.
		self.userEnterHandler = _UserService:ConnectEvent(UserEnterEvent, self.OnUserEnter)
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 로직 종료 시 연결된 유저 입장 이벤트를 해제합니다.
		if self.userEnterHandler ~= nil then
			_UserService:DisconnectEvent(UserEnterEvent, self.userEnterHandler)
			self.userEnterHandler = nil
		end
	end

	@ExecSpace("ServerOnly")
	method void OnUserEnter(UserEnterEvent event)
		-- 입장한 유저의 신규 콘텐츠 데이터를 불러와 클라이언트에 전달합니다.
		if event == nil or event.UserId == nil or event.UserId == "" then
			return
		end
		if self.currentUserId ~= nil and self.currentUserId ~= "" and self.currentUserId ~= event.UserId then
			log_warning("[ERROR][NewContentManager] single-user instance violation currentUserId=" .. tostring(self.currentUserId)
				.. " enteredUserId=" .. tostring(event.UserId))
			return
		end

		self.currentUserId = event.UserId
		self:LoadNewContent()
		if self.isLoaded then
			self:PushNewContentToClient(event.UserId)
		end
	end

	@ExecSpace("ServerOnly")
	method void LoadNewContent()
		-- 현재 유저의 읽지 않은 신규 콘텐츠 키를 스토리지에서 불러옵니다.
		if self.currentUserId == "" then
			self.isLoaded = false
			return
		end

		local loadedKeys = {}
		if _NewContentStorage ~= nil then
			loadedKeys = _NewContentStorage:LoadNewContent(self.currentUserId)
			if loadedKeys == nil then
				self.isLoaded = false
				return
			end
		end

		self:RegisterUnreadKeys(loadedKeys)
		self.isLoaded = true
	end

	@ExecSpace("ServerOnly")
	method boolean MarkNewContentEntries(any tEntries, string forUserId)
		-- 신규 콘텐츠 항목을 읽지 않은 목록에 추가하고 저장 및 동기화합니다.
		if self:CanUseNewContent(forUserId) == false or tEntries == nil then
			return false
		end

		local isChanged = false
		for _, tEntry in ipairs(tEntries) do
			if tEntry ~= nil then
				local key = self:MakeKey(tEntry.domain or "", tEntry.category or "", tEntry.contentId or "")
				if key ~= "" and self.unreadKeySet[key] ~= true then
					table.insert(self.unreadKeys, key)
					self.unreadKeySet[key] = true
					isChanged = true
				end
			end
		end

		if isChanged then
			self:SaveNewContentToStorage()
			self:PushNewContentToClient(forUserId)
		end
		return isChanged
	end

	@ExecSpace("Server")
	method boolean RequestAcknowledgeCategory(string domain, string category)
		-- 클라이언트가 요청한 카테고리의 신규 표시 확인 처리를 수행합니다.
		if self:CanUseNewContent(senderUserId) == false then
			return false
		end

		return self:AcknowledgeCategory(domain, category, senderUserId)
	end

	@ExecSpace("ServerOnly")
	method boolean AcknowledgeCategory(string domain, string category, string forUserId)
		-- 지정한 도메인과 카테고리에 속한 읽지 않은 키를 모두 제거합니다.
		if domain == nil or domain == "" or category == nil or category == "" then
			return false
		end

		local remainingKeys = {}
		local isChanged = false
		for _, key in ipairs(self.unreadKeys) do
			local tScope = self:GetKeyScope(key)
			if tScope.domain == domain and tScope.category == category then
				isChanged = true
			else
				table.insert(remainingKeys, key)
			end
		end

		if isChanged == false then
			return false
		end

		self:RegisterUnreadKeys(remainingKeys)
		self:SaveNewContentToStorage()
		self:PushNewContentToClient(forUserId)
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean CanUseNewContent(string userId)
		-- 신규 콘텐츠 데이터가 준비되었고 요청 유저가 현재 유저인지 확인합니다.
		return self.isLoaded and self.currentUserId ~= "" and userId ~= nil and userId == self.currentUserId
	end

	@ExecSpace("ServerOnly")
	method void SaveNewContentToStorage()
		-- 현재 읽지 않은 신규 콘텐츠 키 목록을 스토리지에 저장합니다.
		if _NewContentStorage ~= nil and self.isLoaded and self.currentUserId ~= "" then
			_NewContentStorage:SaveNewContentAsync(self.currentUserId, self:CopyStringList(self.unreadKeys))
		end
	end

	@ExecSpace("ServerOnly")
	method void PushNewContentToClient(string forUserId)
		-- 현재 읽지 않은 신규 콘텐츠 키 목록을 지정한 클라이언트에 전달합니다.
		if forUserId ~= nil and forUserId ~= "" then
			self:SyncNewContent(self:CopyStringList(self.unreadKeys), forUserId)
		end
	end

	@ExecSpace("Client")
	method void SyncNewContent(table unreadKeys)
		-- 서버에서 받은 신규 콘텐츠 키를 등록하고 변경 이벤트를 전송합니다.
		self:RegisterUnreadKeys(unreadKeys)
		self:SendEvent(NewContentChangedEvent())
	end

	@ExecSpace("ClientOnly")
	method boolean ClientHasNewContent(string domain, string category, string contentId)
		-- 지정한 콘텐츠가 읽지 않은 신규 콘텐츠인지 확인합니다.
		local key = self:MakeKey(domain, category, contentId)
		return key ~= "" and self.unreadKeySet[key] == true
	end

	@ExecSpace("ClientOnly")
	method boolean ClientHasAnyNewContent(string domain, string category)
		-- 지정한 범위에 읽지 않은 신규 콘텐츠가 하나라도 있는지 확인합니다.
		for _, key in ipairs(self.unreadKeys) do
			local tScope = self:GetKeyScope(key)
			if tScope.domain == domain and (category == nil or category == "" or tScope.category == category) then
				return true
			end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method any ClientGetNewContentIds(string domain, string category)
		-- 지정한 범위에 속한 읽지 않은 콘텐츠 ID 목록을 반환합니다.
		local contentIds = {}
		for _, key in ipairs(self.unreadKeys) do
			local tScope = self:GetKeyScope(key)
			if tScope.domain == domain and tScope.category == category and tScope.contentId ~= "" then
				table.insert(contentIds, tScope.contentId)
			end
		end
		return contentIds
	end

	method string MakeKey(string domain, string category, string contentId)
		-- 도메인과 카테고리 및 콘텐츠 ID를 하나의 신규 콘텐츠 키로 만듭니다.
		if domain == nil or domain == "" or category == nil or category == "" or contentId == nil or contentId == "" then
			return ""
		end
		return domain .. "|" .. category .. "|" .. contentId
	end

	method any GetKeyScope(string key)
		-- 신규 콘텐츠 키를 도메인과 카테고리 및 콘텐츠 ID로 분리합니다.
		if key == nil or key == "" then
			return { domain = "", category = "", contentId = "" }
		end

		local firstSeparator, _ = string.find(key, "|", 1, true)
		if firstSeparator == nil then
			return { domain = "", category = "", contentId = "" }
		end

		local secondSeparator, _ = string.find(key, "|", firstSeparator + 1, true)
		if secondSeparator == nil then
			return { domain = "", category = "", contentId = "" }
		end

		return {
			domain = string.sub(key, 1, firstSeparator - 1),
			category = string.sub(key, firstSeparator + 1, secondSeparator - 1),
			contentId = string.sub(key, secondSeparator + 1)
		}
	end

	method void RegisterUnreadKeys(any source)
		-- 유효한 키만 중복 없이 읽지 않은 신규 콘텐츠 목록에 등록합니다.
		self.unreadKeys = {}
		self.unreadKeySet = {}
		if source == nil or type(source) ~= "table" then
			return
		end

		for _, key in ipairs(source) do
			local tScope = self:GetKeyScope(key)
			local normalizedKey = self:MakeKey(tScope.domain, tScope.category, tScope.contentId)
			if normalizedKey ~= "" and self.unreadKeySet[normalizedKey] ~= true then
				table.insert(self.unreadKeys, normalizedKey)
				self.unreadKeySet[normalizedKey] = true
			end
		end
	end

	method any CopyStringList(any source)
		-- 유효한 문자열 항목만 복사한 새 목록을 반환합니다.
		local copied = {}
		if source == nil or type(source) ~= "table" then
			return copied
		end
		for _, value in ipairs(source) do
			if value ~= nil and value ~= "" then
				table.insert(copied, value)
			end
		end
		return copied
	end

end

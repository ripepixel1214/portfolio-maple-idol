@Logic
script OutdoorMapTransitionLogic extends Logic

	property string DOWNTOWN_MAP_NAME = "Map_Downtown"

	property string DOWNTOWN_DISPLAY_NAME = "메리단길"

	property string DOWNTOWN_PORTAL_PATH = "/maps/Map_Downtown/MapPortal"

	property string STUDIO_MAP_NAME = "Map_Studio"

	property string NIGHT_MARKET_MAP_NAME = "Map_NightMarket"

	property string NIGHT_MARKET_DISPLAY_NAME = "야시장"

	property string NIGHT_MARKET_PORTAL_PATH = "/maps/Map_NightMarket/MapPortal"

	property boolean NIGHT_MARKET_ENABLED = true

	-- 구체적인 해금 스테이지 확정 전에는 기존 접근 조건 유지
	property string DOWNTOWN_REQUIRED_CLEAR_STAGE_ID = ""

	property string NIGHT_MARKET_REQUIRED_CLEAR_STAGE_ID = ""

	-- 저장 계층 연결 전 서버에서 주입받는 누적 클리어 이력 사본
	property any stageClearHistoryByUserId = {}

	property any preStageTravelEnabledByUserId = {}

	property integer moveRequestSequence = 0

	property string pendingMoveRequestId = ""

	property integer pendingTransitionId = 0

	property string pendingDestinationMapName = ""

	property any pendingMoveCompleted = nil

	property integer mapListRequestSequence = 0

	property any tPendingMapListRequests = {}

	property number mapListTimeout = 5

	property boolean isClientEnding = false

	property string MOVE_REQUEST_PREFIX = "outdoor:"

	property string LIST_REQUEST_PREFIX = "outdoor-list:"

	property string REQUEST_CACHE_SEPARATOR = "|"

	property string REASON_TRANSITION_UNAVAILABLE = "transition_unavailable"

	property string MOVE_STATE_ACCEPTED = "accepted"

	property string MOVE_STATE_ARRIVED = "arrived"

	property string MOVE_STATE_FAILED = "failed"

	property string REASON_INVALID_REQUEST = "invalid_request"

	property string REASON_MOVE_IN_PROGRESS = "move_in_progress"

	property string REASON_INVALID_USER = "invalid_user"

	property string REASON_PROGRESS_UNAVAILABLE = "progress_unavailable"

	property string REASON_INVALID_PROGRESS = "invalid_progress"

	property string REASON_INVALID_DESTINATION = "invalid_destination"

	property string REASON_PORTAL_UNAVAILABLE = "portal_unavailable"

	property string REASON_TELEPORT_FAILED = "teleport_failed"

	property string REASON_SERVER_TIMEOUT = "server_timeout"

	property string REASON_CLIENT_CANCELLED = "client_cancelled"

	property string REASON_MAP_DISABLED = "map_disabled"

	property string REASON_MAP_LOCKED = "map_locked"

	property string REASON_CLEAR_HISTORY_UNAVAILABLE = "clear_history_unavailable"

	property string REASON_CURRENT_MAP = "current_map"

	property string REASON_LIST_TIMEOUT = "list_timeout"

	property string REASON_PLAY_ENDED = "play_ended"

	property any processedServerMoveRequestIds = {}

	property any processedServerMoveRequestIdOrder = {}

	property integer MAX_PROCESSED_REQUEST_ID_COUNT = 32

	---@type OutdoorMapMoveSessionData
	property any tServerMoveSession = nil

	property number serverMoveTimeout = 5

	property number serverResponseGrace = 2

	property integer MAX_REQUEST_ID_LENGTH = 64

	@HideFromInspector
	property any userLeaveHandler = nil

	@ExecSpace("ClientOnly")
	method void EnterOutdoor(string requestMapName)
		-- 저장된 외출 맵 복원 또는 기본 외출 진입을 공통 이동 경로에 전달
		local mapName = requestMapName
		if self:FindMap(mapName) == nil then
			mapName = self:GetDefaultMapName()
		end
		local player = _UserService.LocalPlayer
		if player ~= nil and isvalid(player.CurrentMap) and player.CurrentMap.Name == mapName then
			return
		end
		self:RequestMapTransition(mapName, true, nil)
	end

	method boolean IsOutdoorMap(string mapName)
		-- 활성 외출 맵 여부를 저장 계층과 진입 로직에 제공
		local tDestination = self:FindMap(mapName)
		return tDestination ~= nil and tDestination.enabled == true
	end

	method string GetDefaultMapName()
		-- 저장 위치가 없는 외출 단계의 기본 진입 맵
		return self.DOWNTOWN_MAP_NAME
	end

	@ExecSpace("ClientOnly")
	@EventSender("LocalPlayer")
	handler HandleLocalPlayerMapChanged(EntityMapChangedEvent event)
		-- 외출 도착 저장은 서버에서 처리하고 Studio 복귀 시 저장 위치 갱신 요청
		if isvalid(event.NewMap) == false or isvalid(event.OldMap) == false then
			return
		end
		if event.NewMap.Name == self.STUDIO_MAP_NAME and self:IsOutdoorMap(event.OldMap.Name) then
			_ProgressManager:RequestSaveProgressToStorage()
		end
	end

	method void OnBeginPlay()
		-- 서버 승인 상태와 클라이언트 요청 생명주기 분리 초기화
		if self:IsClient() then
			self.isClientEnding = false
			self.tPendingMapListRequests = {}
			self.pendingMoveRequestId = ""
			self.pendingTransitionId = 0
			self.pendingDestinationMapName = ""
			self.pendingMoveCompleted = nil
			return
		end
		self.processedServerMoveRequestIds = {}
		self.processedServerMoveRequestIdOrder = {}
		self.stageClearHistoryByUserId = {}
		self.preStageTravelEnabledByUserId = {}
		self.tServerMoveSession = nil
		if self.userLeaveHandler == nil and _UserService ~= nil then
			self.userLeaveHandler = _UserService:ConnectEvent(UserLeaveEvent, self.OnUserLeave)
		end
	end

	method void OnEndPlay()
		-- 종료 시 대기 중인 호출자에게 결과 전달 후 요청과 구독 정리
		if self:IsClient() then
			self.isClientEnding = true
			if self.pendingMoveRequestId ~= "" then
				local tResult = MapTransitionResultData()
				tResult.transitionId = self.pendingTransitionId
				tResult.targetMapName = self.pendingDestinationMapName
				tResult.reason = self.REASON_PLAY_ENDED
				self:OnTransitionCompleted(self.pendingMoveRequestId, tResult)
			end
			local requestIds = {}
			for requestId, _ in pairs(self.tPendingMapListRequests) do
				table.insert(requestIds, requestId)
			end
			for _, requestId in ipairs(requestIds) do
				self:CompleteMapListRequest(requestId, self:CreateMapListFailure(self.REASON_PLAY_ENDED))
			end
			return
		end
		if self.userLeaveHandler ~= nil and _UserService ~= nil then
			_UserService:DisconnectEvent(UserLeaveEvent, self.userLeaveHandler)
			self.userLeaveHandler = nil
		end
		self.tServerMoveSession = nil
		self.stageClearHistoryByUserId = {}
		self.preStageTravelEnabledByUserId = {}
	end

	@ExecSpace("ServerOnly")
	method void OnUserLeave(UserLeaveEvent event)
		-- 이탈한 사용자에게 속한 서버 이동 대기와 재전송 캐시 정리
		if event == nil or event.UserId == nil then
			return
		end
		if self.tServerMoveSession ~= nil and self.tServerMoveSession.userId == event.UserId then
			self.tServerMoveSession = nil
		end
		self.stageClearHistoryByUserId[event.UserId] = nil
		self.preStageTravelEnabledByUserId[event.UserId] = nil
		local remainingKeys = {}
		local prefix = event.UserId .. self.REQUEST_CACHE_SEPARATOR
		for _, cacheKey in ipairs(self.processedServerMoveRequestIdOrder) do
			if string.sub(cacheKey, 1, #prefix) == prefix then
				self.processedServerMoveRequestIds[cacheKey] = nil
			else
				table.insert(remainingKeys, cacheKey)
			end
		end
		self.processedServerMoveRequestIdOrder = remainingKeys
	end

	method void OnUpdate(number delta)
		-- 서버 도착 감시와 클라이언트 목록 응답 시간 초과 처리
		if self:IsServer() then
			self:PollServerMove(delta)
			return
		end
		if next(self.tPendingMapListRequests) == nil then
			return
		end
		local expiredRequestIds = {}
		for requestId, tRequest in pairs(self.tPendingMapListRequests) do
			tRequest.elapsed = tRequest.elapsed + math.max(delta, 0)
			if tRequest.elapsed >= self.mapListTimeout then
				table.insert(expiredRequestIds, requestId)
			end
		end
		for _, requestId in ipairs(expiredRequestIds) do
			self:CompleteMapListRequest(requestId, self:CreateMapListFailure(self.REASON_LIST_TIMEOUT))
		end
	end

	@ExecSpace("ClientOnly")
	method void OpenMapSelection()
		-- 외출 맵 선택 UI 공통 진입
		if self:IsMoving() == true or self.isClientEnding == true then
			return
		end
		if _NpcInteractionGateLogic ~= nil and _NpcInteractionGateLogic:IsLocked() == true then
			return
		end
		if _OutdoorMapTransitionUILogic ~= nil then
			_OutdoorMapTransitionUILogic:Open()
		end
	end

	method table GetMapCatalog()
		-- 잠긴 항목도 목록에 표시할 수 있도록 전체 카탈로그 구성
		local tDowntown = OutdoorMapDestinationData()
		tDowntown.mapName = self.DOWNTOWN_MAP_NAME
		tDowntown.displayName = self.DOWNTOWN_DISPLAY_NAME
		tDowntown.portalPath = self.DOWNTOWN_PORTAL_PATH
		tDowntown.requiredClearStageId = self.DOWNTOWN_REQUIRED_CLEAR_STAGE_ID
		local tNightMarket = OutdoorMapDestinationData()
		tNightMarket.mapName = self.NIGHT_MARKET_MAP_NAME
		tNightMarket.displayName = self.NIGHT_MARKET_DISPLAY_NAME
		tNightMarket.portalPath = self.NIGHT_MARKET_PORTAL_PATH
		tNightMarket.requiredClearStageId = self.NIGHT_MARKET_REQUIRED_CLEAR_STAGE_ID
		tNightMarket.enabled = self.NIGHT_MARKET_ENABLED
		return { tDowntown, tNightMarket }
	end

	method table GetMapList()
		-- 기존 호출부용 활성 맵 메타데이터 목록 반환
		local mapList = {}
		for _, tDestination in ipairs(self:GetMapCatalog()) do
			if tDestination.enabled == true then
				table.insert(mapList, tDestination)
			end
		end
		return mapList
	end

	method table GetDestinations(string currentMapName)
		-- 현재 맵을 제외한 목적지 목록 반환
		local destinations = {}
		for _, tDestination in ipairs(self:GetMapList()) do
			if tDestination.mapName ~= currentMapName then
				table.insert(destinations, tDestination)
			end
		end
		return destinations
	end

	method OutdoorMapDestinationData FindMap(string mapName)
		-- 접근 권한과 독립된 외출 맵 메타데이터 조회
		for _, tDestination in ipairs(self:GetMapCatalog()) do
			if tDestination.mapName == mapName then
				return tDestination
			end
		end
		return nil
	end

	@ExecSpace("ServerOnly")
	method boolean SetStageClearHistory(string userId, table clearedStageIds)
		-- 저장 계층 수정 없이 신뢰할 수 있는 서버 누적 이력 사본 주입
		if _ProgressManager == nil or _ProgressManager:CanUseProgress(userId) == false
			or type(clearedStageIds) ~= "table" then
			return false
		end
		local history = {}
		local count = 0
		for index, stageId in pairs(clearedStageIds) do
			if type(index) ~= "number" or index < 1 or index > #clearedStageIds or index ~= math.floor(index)
				or type(stageId) ~= "string" or stageId == "" then
				return false
			end
			history[stageId] = true
			count = count + 1
		end
		if count ~= #clearedStageIds then
			return false
		end
		self.stageClearHistoryByUserId[userId] = history
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean SetPreStageTravelEnabled(string userId, boolean enabled)
		-- 스테이지 선택 진입·종료를 서버에서 명시적으로 연결하는 접근 상태
		if _ProgressManager == nil or _ProgressManager:CanUseProgress(userId) == false then
			return false
		end
		if enabled == true and self.stageClearHistoryByUserId[userId] == nil then
			return false
		end
		self.preStageTravelEnabledByUserId[userId] = enabled == true
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean CanUseOutdoorProgress(string userId)
		-- 진행 데이터 소유권과 서버에서 승인한 외출 시점 판정
		if _ProgressManager == nil or _ProgressManager:CanUseProgress(userId) == false then
			return false
		end
		local progress = _ProgressManager:ServerGetProgress()
		return progress ~= nil and (progress.eCurrentStep == _EProgressStep.Outdoor
			or progress.eCurrentStep == _EProgressStep.StageSelect)
	end

	@ExecSpace("ServerOnly")
	method boolean IsMapUnlocked(string userId, OutdoorMapDestinationData tDestination)
		-- 맵별 해금 상태를 저장하지 않고 누적 클리어 이력으로 파생
		if tDestination == nil or tDestination.enabled == false then
			return false
		end
		if tDestination.requiredClearStageId == "" then
			return true
		end
		local history = self.stageClearHistoryByUserId[userId]
		return history ~= nil and history[tDestination.requiredClearStageId] == true
	end

	@ExecSpace("ServerOnly")
	method boolean CanAccessOutdoorMap(string userId, string mapName)
		-- 이동 및 NPC 상호작용에 공통으로 사용하는 해금 판정
		local tDestination = self:FindMap(mapName)
		return self:CanUseOutdoorProgress(userId) == true and self:IsMapUnlocked(userId, tDestination) == true
	end

	@ExecSpace("ServerOnly")
	method string GetDestinationUnavailableReason(string userId, string currentMapName, OutdoorMapDestinationData tDestination, boolean restoreLocation)
		-- 목록 표시와 실제 이동 요청에서 동일한 서버 접근 조건 재검증
		if self:CanUseOutdoorProgress(userId) == false then
			return self.REASON_INVALID_PROGRESS
		end
		local isAllowedSource = currentMapName == self.STUDIO_MAP_NAME
			or self:FindMap(currentMapName) ~= nil or restoreLocation
		if isAllowedSource == false or tDestination == nil then
			return self.REASON_INVALID_DESTINATION
		end
		if tDestination.enabled == false then
			return self.REASON_MAP_DISABLED
		end
		if self:IsMapUnlocked(userId, tDestination) == false then
			if self.stageClearHistoryByUserId[userId] == nil then
				return self.REASON_CLEAR_HISTORY_UNAVAILABLE
			end
			return self.REASON_MAP_LOCKED
		end
		if tDestination.mapName == currentMapName then
			return self.REASON_CURRENT_MAP
		end
		if self.tServerMoveSession ~= nil then
			return self.REASON_MOVE_IN_PROGRESS
		end
		if restoreLocation then
			local progress = _ProgressManager:ServerGetProgress()
			if progress ~= nil and progress.currentMapId == tDestination.mapName then
				return ""
			end
		end
		local portal = _EntityService:GetEntityByPath(tDestination.portalPath)
		if isvalid(portal) == false or isvalid(portal.CurrentMap) == false
			or portal.CurrentMap.Name ~= tDestination.mapName then
			return self.REASON_PORTAL_UNAVAILABLE
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method string RequestMapList(any onCompleted)
		-- UI 종류와 독립된 요청별 서버 목록 조회
		self.mapListRequestSequence = self.mapListRequestSequence + 1
		local requestId = self.LIST_REQUEST_PREFIX .. tostring(self.mapListRequestSequence)
		local tRequest = OutdoorMapListRequestData()
		tRequest.requestId = requestId
		tRequest.onCompleted = onCompleted
		self.tPendingMapListRequests[requestId] = tRequest
		if self.isClientEnding == true then
			self:CompleteMapListRequest(requestId, self:CreateMapListFailure(self.REASON_PLAY_ENDED))
		else
			self:RequestMapListSnapshot(requestId)
		end
		return requestId
	end

	@ExecSpace("ClientOnly")
	method OutdoorMapListResultData CreateMapListFailure(string reason)
		-- 목록 요청 실패 결과 생성
		local tResult = OutdoorMapListResultData()
		tResult.reason = reason
		return tResult
	end

	@ExecSpace("ClientOnly")
	method void CompleteMapListRequest(string requestId, OutdoorMapListResultData tResult)
		-- 요청 제거 이후 호출자별 콜백을 한 번만 실행
		local tRequest = self.tPendingMapListRequests[requestId]
		if tRequest == nil then
			return
		end
		self.tPendingMapListRequests[requestId] = nil
		tResult.requestId = requestId
		local onCompleted = tRequest.onCompleted
		tRequest.onCompleted = nil
		if type(onCompleted) == "function" then
			local success, errorMessage = pcall(onCompleted, tResult)
			if success == false then
				log_error("[OutdoorMapTransition] list callback failed error=" .. tostring(errorMessage))
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void CancelMapListRequest(string requestId)
		-- 닫힌 UI에 속한 목록 요청만 취소
		self:CompleteMapListRequest(requestId, self:CreateMapListFailure(self.REASON_CLIENT_CANCELLED))
	end

	@ExecSpace("Server")
	method void RequestMapListSnapshot(string requestId)
		-- 클라이언트가 보낸 진행 정보 없이 서버의 현재 접근 상태만 반환
		if requestId == nil or requestId == "" or #requestId > self.MAX_REQUEST_ID_LENGTH then
			return
		end
		local tResult = OutdoorMapListResultData()
		local user = _UserService:GetUserEntityByUserId(senderUserId)
		if _ProgressManager == nil or _ProgressManager:CanUseProgress(senderUserId) == false then
			tResult.reason = self.REASON_PROGRESS_UNAVAILABLE
		elseif isvalid(user) == false or isvalid(user.CurrentMap) == false then
			tResult.reason = self.REASON_INVALID_USER
		else
			tResult.success = true
			tResult.currentMapName = user.CurrentMap.Name
			for _, tDestination in ipairs(self:GetMapCatalog()) do
				tDestination.isCurrentMap = tDestination.mapName == tResult.currentMapName
				tDestination.isUnlocked = self:IsMapUnlocked(senderUserId, tDestination)
				tDestination.unavailableReason = self:GetDestinationUnavailableReason(senderUserId, tResult.currentMapName, tDestination, false)
				tDestination.isMoveAllowed = tDestination.unavailableReason == ""
				table.insert(tResult.tDestinations, tDestination)
			end
		end
		log("[OutdoorMapTransition] list requestId=" .. tostring(requestId)
			.. " success=" .. tostring(tResult.success) .. " count=" .. tostring(#tResult.tDestinations))
		self:PushMapListResult(requestId, tResult:ToPlainTable(), senderUserId)
	end

	@ExecSpace("Client")
	method void PushMapListResult(string requestId, table tPlainResult)
		-- 지연 응답을 해당 요청의 새 Struct 결과로 복원
		if self.tPendingMapListRequests[requestId] == nil then
			return
		end
		self:CompleteMapListRequest(requestId, OutdoorMapListResultData():FromPlainTable(tPlainResult))
	end

	@ExecSpace("ClientOnly")
	method boolean IsMoving()
		-- 로컬 화면 전환 완료까지 유지되는 요청 잠금 조회
		return self.pendingMoveRequestId ~= ""
	end

	@ExecSpace("ClientOnly")
	method void MoveToMap(string mapName)
		-- 기존 호출부의 이동 API 호환 유지
		self:MoveToMapWithResult(mapName, nil)
	end

	@ExecSpace("ClientOnly")
	method string MoveToMapWithResult(string mapName, any onCompleted)
		-- 일반 외출 이동과 완료 콜백을 공통 요청 경로에 전달
		return self:RequestMapTransition(mapName, false, onCompleted)
	end

	@ExecSpace("ClientOnly")
	method string RequestMapTransition(string mapName, boolean restoreLocation, any onCompleted)
		-- 일반 이동과 저장 위치 복원에 동일한 도착 확인·실패 복구 적용
		local reason = ""
		local tDestination = self:FindMap(mapName)
		if self.isClientEnding == true then
			reason = self.REASON_PLAY_ENDED
		elseif self:IsMoving() == true then
			reason = self.REASON_MOVE_IN_PROGRESS
		elseif tDestination == nil then
			reason = self.REASON_INVALID_DESTINATION
		elseif tDestination.enabled == false then
			reason = self.REASON_MAP_DISABLED
		elseif _MapTransitionHelper == nil then
			reason = self.REASON_TRANSITION_UNAVAILABLE
		end
		if reason ~= "" then
			local tResult = MapTransitionResultData()
			tResult.targetMapName = mapName
			tResult.reason = reason
			self:NotifyMoveCompleted(onCompleted, tResult)
			return ""
		end

		self.moveRequestSequence = self.moveRequestSequence + 1
		self.pendingMoveRequestId = self.MOVE_REQUEST_PREFIX .. tostring(self.moveRequestSequence)
		self.pendingDestinationMapName = mapName
		self.pendingMoveCompleted = onCompleted
		local requestId = self.pendingMoveRequestId
		local tRequest = MapTransitionRequestData()
		tRequest.targetMapName = mapName
		tRequest.requiresArrivalConfirmation = true
		tRequest.arrivalTimeout = self.serverMoveTimeout + self.serverResponseGrace
		tRequest.moveAction = function()
			self.pendingTransitionId = tRequest.transitionId
			self:RequestMoveToOutdoorMap(requestId, mapName, restoreLocation)
		end
		tRequest.onCompleted = function(tResult)
			self:OnTransitionCompleted(requestId, tResult)
		end
		local transitionId = _MapTransitionHelper:SubmitRequest(tRequest)
		if self.pendingMoveRequestId == requestId then
			self.pendingTransitionId = transitionId
			if transitionId <= 0 then
				local tResult = MapTransitionResultData()
				tResult.targetMapName = mapName
				tResult.reason = self.REASON_TRANSITION_UNAVAILABLE
				self:OnTransitionCompleted(requestId, tResult)
				return ""
			end
		end
		return requestId
	end

	@ExecSpace("ClientOnly")
	method void OnTransitionCompleted(string requestId, MapTransitionResultData tResult)
		-- 화면 복구 이후 성공·실패 여부와 무관하게 해당 요청 잠금 해제
		if requestId ~= self.pendingMoveRequestId then
			return
		end
		local onCompleted = self.pendingMoveCompleted
		self.pendingMoveCompleted = nil
		self.pendingMoveRequestId = ""
		self.pendingTransitionId = 0
		self.pendingDestinationMapName = ""
		if tResult.success == false and tResult.reason ~= self.REASON_PLAY_ENDED then
			log_warning("[OutdoorMapTransition] transition failed requestId=" .. tostring(requestId)
				.. " reason=" .. tostring(tResult.reason))
			self:RequestCancelMove(requestId)
		end
		self:NotifyMoveCompleted(onCompleted, tResult)
	end

	@ExecSpace("ClientOnly")
	method void NotifyMoveCompleted(any onCompleted, MapTransitionResultData tResult)
		-- 팝업 또는 이동 탭에서 선택한 완료 처리만 실행
		if type(onCompleted) == "function" then
			local success, errorMessage = pcall(onCompleted, tResult)
			if success == false then
				log_error("[OutdoorMapTransition] move callback failed error=" .. tostring(errorMessage))
			end
		end
	end

	@ExecSpace("Server")
	method void RequestMoveToOutdoorMap(string requestId, string destinationMapName, boolean restoreLocation)
		-- 요청자 진행 단계와 허용된 외출 맵 관계를 검증한 뒤 서버 이동 처리
		if requestId == nil or requestId == "" or #requestId > self.MAX_REQUEST_ID_LENGTH then
			self:RejectMoveRequest(requestId or "", destinationMapName, self.REASON_INVALID_REQUEST, senderUserId, "")
			return
		end

		local user = _UserService:GetUserEntityByUserId(senderUserId)
		if isvalid(user) == false or isvalid(user.CurrentMap) == false then
			self:RejectMoveRequest(requestId, destinationMapName, self.REASON_INVALID_USER, senderUserId, "")
			return
		end
		local currentMapName = user.CurrentMap.Name

		if _ProgressManager == nil or _ProgressManager:CanUseProgress(senderUserId) == false then
			self:RejectMoveRequest(requestId, destinationMapName, self.REASON_PROGRESS_UNAVAILABLE, senderUserId, currentMapName)
			return
		end

		local cacheKey = self:GetMoveRequestCacheKey(senderUserId, requestId)
		local tCachedFeedback = self.processedServerMoveRequestIds[cacheKey]
		if tCachedFeedback ~= nil then
			self:PushMoveFeedback(requestId, tCachedFeedback:ToPlainTable(), senderUserId)
			return
		end
		if self.tServerMoveSession ~= nil then
			self:RejectMoveRequest(requestId, destinationMapName, self.REASON_MOVE_IN_PROGRESS, senderUserId, currentMapName)
			return
		end

		local progress = _ProgressManager:ServerGetProgress()
		local savedMap = progress ~= nil and self:FindMap(progress.currentMapId) or nil
		if restoreLocation then
			local entryMapName = savedMap ~= nil and savedMap.mapName or self:GetDefaultMapName()
			if destinationMapName ~= entryMapName
				or (progress ~= nil and progress.eCurrentStep == _EProgressStep.StageSelect and savedMap == nil) then
				self:RejectMoveRequest(requestId, destinationMapName, self.REASON_INVALID_DESTINATION, senderUserId, currentMapName)
				return
			end
		end
		local tDestination = self:FindMap(destinationMapName)
		local reason = self:GetDestinationUnavailableReason(senderUserId, currentMapName, tDestination, restoreLocation)
		if reason ~= "" then
			self:RejectMoveRequest(requestId, destinationMapName, reason, senderUserId, currentMapName)
			return
		end

		log("[OutdoorMapTransition] move accepted userId=" .. tostring(senderUserId)
			.. " requestId=" .. tostring(requestId)
			.. " from=" .. tostring(currentMapName)
			.. " to=" .. tostring(destinationMapName)
			.. " reason=accepted")
		local tSession = OutdoorMapMoveSessionData()
		tSession.requestId = requestId
		tSession.userId = senderUserId
		tSession.destinationMapName = destinationMapName
		self.tServerMoveSession = tSession
		local tFeedback = self:CreateMoveFeedback(self.MOVE_STATE_ACCEPTED, destinationMapName, "")
		self:RecordMoveFeedback(senderUserId, requestId, tFeedback)
		self:PushMoveFeedback(requestId, tFeedback:ToPlainTable(), senderUserId)
		local success, errorMessage = pcall(function()
			if restoreLocation and savedMap ~= nil then
				_TeleportService:TeleportToMapPosition(user, Vector3(progress.positionX, progress.positionY, 0), destinationMapName)
			else
				_TeleportService:TeleportToEntityPath(user, tDestination.portalPath)
			end
		end)
		if success == false then
			log_error("[OutdoorMapTransition] teleport failed requestId=" .. tostring(requestId)
				.. " error=" .. tostring(errorMessage))
			if self.tServerMoveSession == tSession then
				self:CompleteServerMove(self.MOVE_STATE_FAILED, self.REASON_TELEPORT_FAILED)
			end
			return
		end
		self:PollServerMove(0)
	end

	@ExecSpace("ServerOnly")
	method void PollServerMove(number delta)
		-- 서버 사용자 맵을 기준으로 도착·이탈·시간 초과 판정
		local tSession = self.tServerMoveSession
		if tSession == nil then
			return
		end
		local user = _UserService:GetUserEntityByUserId(tSession.userId)
		if isvalid(user) == false then
			self:CompleteServerMove(self.MOVE_STATE_FAILED, self.REASON_INVALID_USER)
			return
		end
		if isvalid(user.CurrentMap) == true and user.CurrentMap.Name == tSession.destinationMapName then
			self:CompleteServerMove(self.MOVE_STATE_ARRIVED, "")
			return
		end
		tSession.elapsed = tSession.elapsed + math.max(delta, 0)
		if tSession.elapsed >= self.serverMoveTimeout then
			self:CompleteServerMove(self.MOVE_STATE_FAILED, self.REASON_SERVER_TIMEOUT)
		end
	end

	@ExecSpace("ServerOnly")
	method void CompleteServerMove(string state, string reason)
		-- 서버 이동 잠금 해제와 마지막 처리 결과 기록·통지
		local tSession = self.tServerMoveSession
		if tSession == nil then
			return
		end
		self.tServerMoveSession = nil
		if state == self.MOVE_STATE_ARRIVED and _ProgressManager:CanUseProgress(tSession.userId) then
			_ProgressManager:SaveProgressToStorage()
			_ProgressManager:PushProgressToClient(tSession.userId)
		end
		local tFeedback = self:CreateMoveFeedback(state, tSession.destinationMapName, reason)
		self:RecordMoveFeedback(tSession.userId, tSession.requestId, tFeedback)
		log("[OutdoorMapTransition] server completed requestId=" .. tostring(tSession.requestId)
			.. " state=" .. tostring(state) .. " reason=" .. tostring(reason))
		self:PushMoveFeedback(tSession.requestId, tFeedback:ToPlainTable(), tSession.userId)
	end

	@ExecSpace("Server")
	method void RequestCancelMove(string requestId)
		-- 요청자에게 속한 현재 서버 이동 대기만 취소
		if self.tServerMoveSession == nil or self.tServerMoveSession.requestId ~= requestId
			or self.tServerMoveSession.userId ~= senderUserId then
			return
		end
		self:CompleteServerMove(self.MOVE_STATE_FAILED, self.REASON_CLIENT_CANCELLED)
	end

	@ExecSpace("ServerOnly")
	method string GetMoveRequestCacheKey(string userId, string requestId)
		-- 사용자별 요청 ID 캐시 키 생성
		return userId .. self.REQUEST_CACHE_SEPARATOR .. requestId
	end

	@ExecSpace("ServerOnly")
	method OutdoorMapMoveFeedbackData CreateMoveFeedback(string state, string destinationMapName, string reason)
		-- 서버 승인·도착·실패 피드백 생성
		local tFeedback = OutdoorMapMoveFeedbackData()
		tFeedback.state = state
		tFeedback.destinationMapName = destinationMapName
		tFeedback.reason = reason
		return tFeedback
	end

	@ExecSpace("ServerOnly")
	method void RecordMoveFeedback(string userId, string requestId, OutdoorMapMoveFeedbackData tFeedback)
		-- 최근 요청의 마지막 피드백만 보관하는 사용자별 FIFO 캐시 갱신
		local cacheKey = self:GetMoveRequestCacheKey(userId, requestId)
		if self.processedServerMoveRequestIds[cacheKey] == nil then
			table.insert(self.processedServerMoveRequestIdOrder, cacheKey)
		end
		self.processedServerMoveRequestIds[cacheKey] = tFeedback
		while #self.processedServerMoveRequestIdOrder > self.MAX_PROCESSED_REQUEST_ID_COUNT do
			local expiredRequestId = table.remove(self.processedServerMoveRequestIdOrder, 1)
			if expiredRequestId ~= nil then
				self.processedServerMoveRequestIds[expiredRequestId] = nil
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void RejectMoveRequest(string requestId, string destinationMapName, string reason, string userId, string currentMapName)
		-- 외출 이동 거절 상관관계 로그 기록과 대상 클라이언트 통지
		log_warning("[OutdoorMapTransition] move rejected userId=" .. tostring(userId)
			.. " requestId=" .. tostring(requestId)
			.. " from=" .. tostring(currentMapName)
			.. " to=" .. tostring(destinationMapName)
			.. " reason=" .. tostring(reason))
		if userId ~= nil and userId ~= "" then
			local tFeedback = self:CreateMoveFeedback(self.MOVE_STATE_FAILED, destinationMapName, reason)
			self:PushMoveFeedback(requestId, tFeedback:ToPlainTable(), userId)
		end
	end

	@ExecSpace("Client")
	method void PushMoveFeedback(string requestId, table tPlainFeedback)
		-- 서버 도착 확인 이후에도 로컬 도착·화면 복구가 끝날 때까지 요청 잠금 유지
		if requestId ~= self.pendingMoveRequestId then
			return
		end

		local tFeedback = OutdoorMapMoveFeedbackData():FromPlainTable(tPlainFeedback)
		if tFeedback.destinationMapName ~= self.pendingDestinationMapName then
			return
		end
		if _MapTransitionHelper == nil then
			return
		end
		if tFeedback.state == self.MOVE_STATE_ARRIVED then
			_MapTransitionHelper:ConfirmArrival(self.pendingTransitionId)
		elseif tFeedback.state == self.MOVE_STATE_FAILED then
			_MapTransitionHelper:CancelTransition(self.pendingTransitionId, tFeedback.reason)
		end
	end

end

@Component
script LocalizedNameTagComponent extends Component

	property string actorId = ""
	property any actorChangedHandler = nil

	-- Public API

	method void OnBeginPlay()
		if self:IsClient() == false then
			return
		end

		self.actorChangedHandler = _RuntimeActorManager:ConnectEvent(ActorChangedEvent, self.OnActorChanged)
		self:Refresh()
	end

	method void OnEndPlay()
		if self.actorChangedHandler ~= nil then
			_RuntimeActorManager:DisconnectEvent(ActorChangedEvent, self.actorChangedHandler)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnActorChanged(ActorChangedEvent event)
		if event.actorId == "" or event.actorId == self.actorId then
			self:Refresh()
		end
	end

	-- Private Methods

	@ExecSpace("ClientOnly")
	method void Refresh()
		local resolvedActorId = self:ResolveActorId()
		if string.sub(resolvedActorId, 1, 4) == "npc_" then
			local characterActorId = "character_" .. string.sub(resolvedActorId, 5)
			if _ActorMaster:GetActor(characterActorId) ~= nil then
				resolvedActorId = characterActorId
				self.actorId = characterActorId
			end
		end

		self.Entity.NameTagComponent.Name = _RuntimeActorManager:ClientGetLocalizedActorName(resolvedActorId)
	end

	method string ResolveActorId()
		if self.actorId ~= "" then
			return self.actorId
		end

		local staticSpeech = self.Entity:GetComponent("script.StaticActorSpeechComponent")
		if staticSpeech ~= nil and staticSpeech.actorId ~= "" then
			self.actorId = staticSpeech.actorId
			return self.actorId
		end

		local actorSpeech = self.Entity:GetComponent("script.ActorSpeechComponent")
		if actorSpeech ~= nil and actorSpeech.actorId ~= "" then
			self.actorId = actorSpeech.actorId
			return self.actorId
		end

		local npcEventTrigger = self.Entity:GetComponent("script.NpcEventTriggerComponent")
		if npcEventTrigger ~= nil then
			self.actorId = npcEventTrigger.npcId
		end

		return self.actorId
	end

end

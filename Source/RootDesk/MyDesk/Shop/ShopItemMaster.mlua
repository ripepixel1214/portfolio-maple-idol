-- 상점 상품 데이터 조회와 원본 행 검증
@Logic
script ShopItemMaster extends Logic

	property boolean IsLoaded = false

	property string TABLE_SHOP_ITEMS = "ShopItemTable"
	-- 숫자 변환 후 정밀도를 보장하는 최대 정수
	property integer MAX_EXACT_PRICE = 9007199254740991
	property string COIN_TYPE_MESO = "meso"
	property string COIN_TYPE_DIAMOND = "diamond"
	property string COIN_TYPE_NIGHT_MARKET = "nightMarketCoin"
	property string COIN_TYPE_LEGACY_WORLD_COIN = "worldCoin"

	-- ShopItemRow 목록입니다(테이블 행 순서 유지).
	property any tShopItems = {}

	-- { [shopItemId:string] = ShopItemRow }
	property any tShopItemById = {}

	-- { [category:string] = ShopItemRow[] }
	property any tShopItemsByCategory = {}

	method void OnBeginPlay()
		-- 로직 시작 시 ShopItemTable을 읽어 상점 아이템 데이터를 캐싱합니다.
		self:LoadShopItems()
	end

	method void LoadShopItems()
		-- 중복 ID와 잘못된 행을 제외한 상품 목록 구성
		self.tShopItems = {}
		self.tShopItemById = {}
		self.tShopItemsByCategory = {}
		self.IsLoaded = false

		local dataSet = _DataService:GetTable(self.TABLE_SHOP_ITEMS)
		if dataSet == nil then
			log_warning("[ShopItemMaster] ShopItemTable not found")
			return
		end

		local rowCount = dataSet:GetRowCount()
		local tIdCounts = {}
		for rowIndex = 1, rowCount do
			local shopItemId = _DataTableUtil:SafeGetString(dataSet, rowIndex, "shopItemId", "")
			tIdCounts[shopItemId] = (tIdCounts[shopItemId] or 0) + 1
		end

		local rejectedCount = 0
		local legacyCount = 0
		for rowIndex = 1, rowCount do
			local shopItemId = _DataTableUtil:SafeGetString(dataSet, rowIndex, "shopItemId", "")
			local tShopItem = nil
			if shopItemId == "" or tIdCounts[shopItemId] ~= 1 then
				log_warning("[ShopItemMaster] invalid or duplicate shopItemId row=" .. tostring(rowIndex) .. " id=" .. shopItemId)
			else
				tShopItem = self:ReadShopItem(dataSet, rowIndex)
			end
			if tShopItem == nil then
				rejectedCount = rejectedCount + 1
			else
				table.insert(self.tShopItems, tShopItem)
				self.tShopItemById[shopItemId] = tShopItem
				if self.tShopItemsByCategory[tShopItem.category] == nil then
					self.tShopItemsByCategory[tShopItem.category] = {}
				end
				table.insert(self.tShopItemsByCategory[tShopItem.category], tShopItem)
				if tShopItem.coinType == self.COIN_TYPE_LEGACY_WORLD_COIN then legacyCount = legacyCount + 1 end
			end
		end

		self.IsLoaded = true
		log("[VRF][ShopItemMaster] loaded=" .. tostring(#self.tShopItems) .. " rejected=" .. tostring(rejectedCount) .. " legacyWorldCoin=" .. tostring(legacyCount))
	end

	method any ReadShopItem(any dataSet, integer rowIndex)
		-- 결제 금액을 임의 보정하지 않고 필수 값과 참조 검사
		local tShopItem = ShopItemRow()
		tShopItem.shopItemId = _DataTableUtil:SafeGetString(dataSet, rowIndex, "shopItemId", "")
		tShopItem.nameKey = _DataTableUtil:SafeGetString(dataSet, rowIndex, "nameKey", "")
		tShopItem.category = _DataTableUtil:SafeGetString(dataSet, rowIndex, "category", "")
		tShopItem.characterId = _DataTableUtil:SafeGetString(dataSet, rowIndex, "characterId", "")
		tShopItem.coinType = _DataTableUtil:SafeGetString(dataSet, rowIndex, "coinType", "")
		tShopItem.ruid = _DataTableUtil:SafeGetString(dataSet, rowIndex, "ruid", "")
		local priceValue = tonumber(_DataTableUtil:SafeGetString(dataSet, rowIndex, "price", ""))
		local widthValue = tonumber(_DataTableUtil:SafeGetString(dataSet, rowIndex, "width", "0"))
		local heightValue = tonumber(_DataTableUtil:SafeGetString(dataSet, rowIndex, "height", "0"))
		local invalidReason = ""
		if tShopItem.shopItemId == "" or tShopItem.nameKey == "" or tShopItem.category == "" then
			invalidReason = "missing required ID/nameKey/category"
		elseif self:IsSupportedCoinType(tShopItem.coinType) == false then
			invalidReason = "unknown coinType=" .. tShopItem.coinType
		elseif self:IsNonNegativeFiniteNumber(priceValue) == false then
			invalidReason = "invalid price"
		elseif priceValue > self.MAX_EXACT_PRICE then
			invalidReason = "price exceeds exact integer range"
		elseif priceValue ~= math.floor(priceValue) then
			invalidReason = "fractional price"
		elseif self:IsNonNegativeFiniteNumber(widthValue) == false or self:IsNonNegativeFiniteNumber(heightValue) == false then
			invalidReason = "invalid display size"
		elseif tShopItem.characterId ~= "" then
			if _CharacterBaseStatMaster == nil or _CharacterBaseStatMaster:GetCharacterBaseStat(tShopItem.characterId) == nil
				or _ActorMaster == nil or _ActorMaster:GetActor(tShopItem.characterId) == nil then
				invalidReason = "unknown characterId=" .. tShopItem.characterId
			end
		elseif tShopItem.ruid == "" then
			invalidReason = "missing costume ruid"
		end
		if invalidReason ~= "" then
			log_warning("[ShopItemMaster] rejected row=" .. tostring(rowIndex) .. " id=" .. tShopItem.shopItemId .. " reason=" .. invalidReason)
			return nil
		end

		tShopItem.price = math.floor(priceValue)
		tShopItem.width = widthValue
		tShopItem.height = heightValue
		if self:IsClient() then tShopItem.name = _LocaleTextUtil:GetText(tShopItem.nameKey) end
		return tShopItem
	end

	method boolean IsSupportedCoinType(string coinType)
		-- 기존 임시 월드 코인은 데이터 이전 전까지 호환 유지
		return coinType == self.COIN_TYPE_MESO or coinType == self.COIN_TYPE_DIAMOND
			or coinType == self.COIN_TYPE_NIGHT_MARKET or coinType == self.COIN_TYPE_LEGACY_WORLD_COIN
	end

	method boolean IsNonNegativeFiniteNumber(any value)
		-- 누락 값과 음수, NaN, 무한대 거부
		return type(value) == "number" and value == value and value >= 0 and value < math.huge
	end

	method any GetShopItems()
		-- 테이블 행 순서를 유지한 전체 ShopItemRow 목록을 반환합니다.
		self:EnsureLoaded()
		return self.tShopItems
	end

	method any GetShopItemsByCategory(string category)
		-- 지정한 category의 ShopItemRow 목록을 반환합니다. 비어 있으면 전체를 반환합니다.
		self:EnsureLoaded()
		if category == nil or category == "" then
			return self.tShopItems
		end

		return self.tShopItemsByCategory[category] or {}
	end

	method any GetShopItemById(string shopItemId)
		-- shopItemId에 해당하는 ShopItemRow를 반환합니다.
		self:EnsureLoaded()
		if shopItemId == nil or shopItemId == "" then
			return nil
		end

		return self.tShopItemById[shopItemId]
	end

	method Vector2 GetDisplaySize(string shopItemId)
		-- shopItemId의 상점 표시 크기(width, height)를 Vector2로 반환합니다. 없으면 (0, 0)입니다.
		self:EnsureLoaded()
		local tShopItem = self.tShopItemById[shopItemId]
		if tShopItem == nil then
			return Vector2(0, 0)
		end

		return Vector2(tShopItem.width, tShopItem.height)
	end

	method void EnsureLoaded()
		-- 캐시가 비어 있으면 ShopItemTable을 다시 로드합니다.
		if self.IsLoaded == false then
			self:LoadShopItems()
		end
	end

end

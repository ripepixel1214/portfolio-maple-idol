@Logic
script ImageResourceMetaMaster extends Logic

	property any tImagePixelSizeById = {}

	property boolean IsImageResourceMetaLoaded = false

	method void OnBeginPlay()
		-- 로직 시작 때 이미지 리소스 메타 데이터를 로드합니다.
		self:LoadImageResourceMeta()
	end

	method void LoadImageResourceMeta()
		-- ImageResourceMetaTable을 resourceId 기준 실제 픽셀 크기 조회 맵으로 구성합니다.
		self.IsImageResourceMetaLoaded = false

		self.tImagePixelSizeById = {}

		local dataSet = _DataService:GetTable("ImageResourceMetaTable")
		if dataSet == nil then
			log_warning("[ImageResourceMetaMaster] ImageResourceMetaTable not found")
			return
		end

		for rowIndex = 1, dataSet:GetRowCount() do
			local resourceId = _DataTableUtil:SafeGetString(dataSet, rowIndex, "resourceId", "")
			if resourceId ~= "" then
				local width = _DataTableUtil:SafeGetNumber(dataSet, rowIndex, "width", 0)
				local height = _DataTableUtil:SafeGetNumber(dataSet, rowIndex, "height", 0)
				if width > 0 and height > 0 then
					self.tImagePixelSizeById[resourceId] = Vector2(width, height)
				end
			end
		end

		self.IsImageResourceMetaLoaded = true
	end

	method Vector2 GetImagePixelSize(string resourceId)
		-- 이미지 리소스의 실제 픽셀 크기를 반환합니다.
		if self.IsImageResourceMetaLoaded == false then
			self:LoadImageResourceMeta()
		end

		if resourceId == nil or resourceId == "" then
			log_warning("empty resource id : ", resourceId)
			return Vector2(0, 0)
		end

		return self.tImagePixelSizeById[resourceId] or Vector2(0, 0)
	end

end

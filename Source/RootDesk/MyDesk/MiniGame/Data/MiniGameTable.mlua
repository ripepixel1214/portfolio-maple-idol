				skin = { id = "performance_timing", title = "박자 맞추기", instruction = "타이밍에 맞춰 스페이스바를 눌러 트레이닝 효율을 극대화하세요." },
				allowedContexts = { EMContext.Standalone, EMContext.Performance, EMContext.Event },
				successRewards = { { type = "PerformanceScore", amount = 100 } },
				failureRewards = { { type = "PerformanceScore", amount = 30 } }
			},
			{
				id = "command_sequence",

	property string AUTHORITY_CLIENT = "client"

	property string AUTHORITY_SERVER = "server"

	property string INPUT_CHANNEL_PRIMARY = "primary"

	property string INPUT_ADAPTER_MASH = "Mash"

	property string INPUT_ADAPTER_TIMING = "Timing"

	property string INPUT_ADAPTER_COMMAND = "Command"

	property string INPUT_ADAPTER_DRAG = "Drag"

	property string INPUT_ADAPTER_SELECTION = "Selection"

	property string PHASE_PLAYING = "playing"

	property string PHASE_RESULT = "result"

	property string TIME_RULE_COUNTDOWN = "Countdown"

	property string TIME_RULE_GAUGE_DRAIN = "GaugeDrain"

	property string OBJECTIVE_EVALUATOR_COUNT = "Count"

	property string OBJECTIVE_EVALUATOR_TIMING_HIT = "TimingHit"

	property string OBJECTIVE_EVALUATOR_SEQUENCE = "Sequence"

	property string OBJECTIVE_EVALUATOR_GAUGE_FILL = "GaugeFill"

	property string OBJECTIVE_EVALUATOR_SHAPE_MATCH = "ShapeMatch"

	property string OBJECTIVE_EVALUATOR_BLOCK_DRAW = "BlockDraw"

	property string RESULT_RESOLVER_OBJECTIVE = "ObjectiveResult"

	property string RESULT_RESOLVER_ACCURACY = "AccuracyResult"


	property string PRESENTATION_DALGONA_CHALLENGE = "dalgona_challenge"

	property string MINI_GAME_DALGONA_CHALLENGE = "dalgona_challenge"

	property string SETTLEMENT_AMOUNT_PLAYER_SELECTED = "PlayerSelected"

	property string CURRENCY_MESO = "meso"
	property string CURRENCY_NIGHT_MARKET_COIN = "nightMarketCoin"
	property integer DEFAULT_ENTRY_MESO = 1000
	property integer DALGONA_BET_STEP = 100
	property integer MAX_BET_AMOUNT = 1000

	method any GetDalgonaChallengeBlockCatalog()
		-- 기획 기준 달고나 블록 형태와 임시 배율 반환
		return {
			{
				id = "square",
				cells = {
					{ row = 0, column = 0, multiplier = 0.5 },
					{ row = 0, column = 1, multiplier = 0.5 },
					{ row = 1, column = 0, multiplier = 0.5 },
					{ row = 1, column = 1, multiplier = 0.5 }
				},
				rotations = { 0 }
			},
			{
				id = "s_block",
				cells = {
					{ row = 0, column = 0, multiplier = 1 },
					{ row = 1, column = 0, multiplier = 1 },
					{ row = 1, column = 1, multiplier = 1 },
					{ row = 2, column = 1, multiplier = 1 }
				},
				rotations = { 0 }
			},
			{
				id = "line_three",
				cells = {
					{ row = 0, column = 0, multiplier = 3 },
					{ row = 0, column = 1, multiplier = 3 },
					{ row = 0, column = 2, multiplier = 3 }
				},
				rotations = { 0 }
			}
		}
	end

	-- 미니게임 프리셋 마스터 데이터. 중첩 구조라 CSV DataSet 대신 데이터 스크립트로 관리한다.
	method any GetCirclePoints(integer count)
		-- 정규화 좌표(0~1, 중심 0.5)로 원형 가이드/판정 점들을 생성한다. (드래그 도형 정의)
		local points = {}
		for k = 0, count - 1 do
			local angle = (2 * math.pi * k) / count
			points[k + 1] = { x = 0.5 + 0.5 * math.cos(angle), y = 0.5 + 0.5 * math.sin(angle) }
		end

		return points
	end

	method any FindMiniGame(string miniGameId)
		-- 식별자가 일치하는 미니게임 프리셋을 반환한다. (서버/클라이언트 공용)
		if miniGameId == nil or miniGameId == "" then
			return nil
		end

		for _, miniGame in ipairs(self:GetMiniGames()) do
			if miniGame.id == miniGameId then
				return miniGame
			end
		end

		return nil
	end


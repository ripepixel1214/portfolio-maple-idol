---@description "럭키 큐브 진행 상태와 전송 데이터"
@Struct
script MiniGameLuckyCubeState
	property string stage = "ready"
	property string initialChoice = ""
	property string choice = ""
	property integer first = 0
	property integer second = 0
	property integer third = 0
	property integer revealed = 0
	property integer bet = 0
	property integer mesoBalance = 0
	property integer coinBalance = 0
	property integer coinChange = 0
	-- 한 판 시작 전 코인 잔액, 서버 내부 변화량 산출 기준
	property integer coinBalanceBeforeRound = 0
	property string entryCurrency = ""
	property integer entryAmount = 0
	property integer payout = 0
	property integer multiplierTenths = 0
	property integer revision = 0
	property boolean isWin = false
	property boolean isDebug = false
	property number elapsed = 0

	method table ToPlainTable()
		-- 공개 단계에 도달한 주사위만 RPC에 포함
		return {stage = self.stage, initialChoice = self.initialChoice, choice = self.choice,
			first = self.revealed >= 1 and self.first or 0,
			second = self.revealed >= 2 and self.second or 0,
			third = self.revealed >= 3 and self.third or 0,
			revealed = self.revealed, bet = self.bet, payout = self.payout,
			mesoBalance = self.mesoBalance, coinBalance = self.coinBalance, coinChange = self.coinChange,
			multiplierTenths = self.multiplierTenths, revision = self.revision,
			isWin = self.isWin, isDebug = self.isDebug, entryCurrency = self.entryCurrency, entryAmount = self.entryAmount}
	end

	method any FromPlainTable(any data)
		-- 서버 표시 데이터의 타입과 범위 정규화
		if type(data) ~= "table" then return self end
		self.stage = type(data.stage) == "string" and data.stage or _MiniGameLuckyCubeRule.STAGE_READY
		self.initialChoice = type(data.initialChoice) == "string" and data.initialChoice or ""
		self.choice = type(data.choice) == "string" and data.choice or ""
		self.first = math.max(0, math.min(6, math.floor(tonumber(data.first) or 0)))
		self.second = math.max(0, math.min(6, math.floor(tonumber(data.second) or 0)))
		self.third = math.max(0, math.min(6, math.floor(tonumber(data.third) or 0)))
		self.revealed = math.max(0, math.min(3, math.floor(tonumber(data.revealed) or 0)))
		self.bet = math.max(0, math.floor(tonumber(data.bet) or 0))
		self.mesoBalance = math.max(0, math.floor(tonumber(data.mesoBalance) or 0))
		self.coinBalance = math.max(0, math.floor(tonumber(data.coinBalance) or 0))
		self.coinChange = math.floor(tonumber(data.coinChange) or 0)
		self.payout = math.max(0, math.floor(tonumber(data.payout) or 0))
		self.multiplierTenths = math.max(0, math.floor(tonumber(data.multiplierTenths) or 0))
		self.revision = math.max(0, math.floor(tonumber(data.revision) or 0))
		self.isWin = data.isWin == true
		self.isDebug = data.isDebug == true
		self.entryCurrency = type(data.entryCurrency) == "string" and data.entryCurrency or ""
		self.entryAmount = math.max(0, math.floor(tonumber(data.entryAmount) or 0))
		return self
	end
end

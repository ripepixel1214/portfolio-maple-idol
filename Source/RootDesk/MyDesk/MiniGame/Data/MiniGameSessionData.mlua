---@description "서버 측 미니게임 세션 데이터"
@Struct
script MiniGameSessionData

	-- 서버 내부 세션 상태, RPC 직접 전송 및 동기화 대상에서 제외
	property string id = ""
	property string miniGameId = ""
	-- 서버 프리셋에서 확정한 게임 규칙 종류
	property string gameKind = ""
	property string userId = ""
	property string startMapId = ""
	property boolean cancelOnMapChange = true
	property number lifetimeElapsed = 0
	property integer contextType = -1
	property string contextId = ""
	property string presentationActorId = ""

	property string status = ""
	property string endReason = ""
	property integer inputType = -1
	property number elapsed = 0
	property number duration = 0
	property number prepareElapsed = 0
	property number finishedElapsed = 0

	-- 기존 규칙 엔진과 정산 규칙이 소유하는 상태 table
	property any ruleState = nil
	property any settlement = nil

	-- 미니게임 종류별 서버 상태 Struct 확장 지점
	property any tModeState = nil

	property integer resultType = -1
	property number score = 0
	property number progress = 0
	property string accuracy = ""

end

---@description "서버 측 미니게임 클라이언트 결과 처리 로직"
@Logic
script MiniGameClientResultServerHandler extends Logic

	property string REASON_INVALID_INPUT = "invalidInput"
	property string REASON_OBJECTIVE = "objective"
	property string REASON_COMPLETE = "complete"
	property string REASON_TIMEOUT = "timeout"
	property string REASON_DRAIN = "drain"
	property string ACCURACY_MISS = "miss"
	property string ACCURACY_GOOD = "good"
	property string ACCURACY_PERFECT = "perfect"
	property number CLOCK_TOLERANCE_SECONDS = 0.5
	-- 프레임에 모인 입력을 허용하는 넉넉한 기록 상한
	property number MAX_PRESS_SAMPLES_PER_SECOND = 120
	property number MAX_SHAPE_SAMPLES_PER_SECOND = 480
	property integer PRESS_BURST_SAMPLES = 4
	property number SHAPE_COORDINATE_SCALE = 120

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 입력 재검산 처리기 등록 확인
		log("[VRF] 미니게임 입력 검증 처리기 준비")
	end

	@ExecSpace("ServerOnly")
	method void Configure(any tSession, any preset)
		-- 클라이언트 예측과 독립된 서버 규칙 상태 초기화
		tSession.tModeState = nil
	end

	@ExecSpace("ServerOnly")
	method boolean RequiresPreparation()
		-- 별도 서버 준비 응답 미사용
		return false
	end

	@ExecSpace("ServerOnly")
	method string GetLaunchCommandPayload(any tSession)
		-- 커맨드 실행 정보 미사용
		return ""
	end

	@ExecSpace("ServerOnly")
	method number GetProgress(any tSession)
		-- 기존 취소 결과 진행률 유지
		return 0
	end

	@ExecSpace("ServerOnly")
	method boolean AcceptsClientResult(any tSession)
		-- 기존 클라이언트 결과 제출 계약 유지
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean HandlesFinishedFeedback()
		-- 입력 검증 결과를 별도 RPC로 전달
		return true
	end

	@ExecSpace("ServerOnly")
	method any ResolveClientResult(any tSession, any preset, any tPlainResult)
		-- 새 입력 기록 Struct로 클라이언트 성공 여부와 점수 재계산
		if tSession == nil or preset == nil or type(tPlainResult) ~= "table" then return nil end
		local tProof = MiniGameInputProof():FromPlainTable(tPlainResult.inputProof)
		if tProof == nil or tProof.elapsed > tSession.elapsed + self.CLOCK_TOLERANCE_SECONDS then return nil end
		local state = _MiniGameRuleEngine:CreateState(preset)
		if state == nil or state.timeState == nil then return nil end
		local duration = state.timeState.duration or 0
		if duration > 0 and tProof.elapsed > duration + self.CLOCK_TOLERANCE_SECONDS then return nil end
		local kind = tSession.gameKind
		local isShape = kind == _EMiniGameKind.SHAPE_TRACE
		local isTiming = kind == _EMiniGameKind.TIMING_ACCURACY
		local isGauge = kind == _EMiniGameKind.GAUGE_MAINTENANCE
		if not isShape and not isTiming and not isGauge and kind ~= _EMiniGameKind.RAPID_PRESS_COUNT then return nil end
		local config = preset.inputConfig or {}
		local timings = config.timings or {}
		local consumed = {}
		local maxAttempts = #timings * 2
		local shapeObjective = nil
		local phase = _MiniGameRuleEngine:GetPhase(preset, state.phaseId)
		for _, objective in ipairs(phase.objectives or {}) do
			if objective.evaluator == _MiniGameTable.OBJECTIVE_EVALUATOR_TIMING_HIT and objective.target > 0 then
				maxAttempts = objective.target * 2
			elseif objective.evaluator == _MiniGameTable.OBJECTIVE_EVALUATOR_SHAPE_MATCH then
				shapeObjective = objective
			end
		end
		if isShape and (shapeObjective == nil or #(shapeObjective.shapePoints or {}) == 0) then return nil end
		local shapeHits = {}
		local previousTime = 0
		local sampleRate = isShape and self.MAX_SHAPE_SAMPLES_PER_SECOND or self.MAX_PRESS_SAMPLES_PER_SECOND
		for i, sample in ipairs(tProof.samples) do
			if i > self.PRESS_BURST_SAMPLES + math.floor(sample.time * sampleRate) then return nil end
			if not isShape and (sample.x ~= 0 or sample.y ~= 0) then return nil end
			if not isShape and _MiniGameRuleEngine:EvaluateObjectives(preset, state).allRequiredMet then return nil end
			_MiniGameRuleEngine:Update(preset, state, sample.time - previousTime)
			if _MiniGameRuleEngine:IsTimeExpired(state) then return nil end
			previousTime = sample.time
			if isTiming then
				if i > maxAttempts then return nil end
				self:ExpireTimings(state, timings, consumed, sample.time, config.goodWindow or 0.2)
				self:ApplyTimingPress(state, timings, consumed, sample.time, config)
			elseif isShape then
				if not self:ApplyShapePoint(state, shapeObjective, shapeHits, sample) then return nil end
			else
				state.successCount += 1
				if isGauge then
					state.gauge += config.gaugePerInput or 0
					state.timeState.gauge = state.gauge
				end
			end
		end
		_MiniGameRuleEngine:Update(preset, state, tProof.elapsed - previousTime)
		if isTiming then self:ExpireTimings(state, timings, consumed, tProof.elapsed, config.goodWindow or 0.2) end
		local met = _MiniGameRuleEngine:EvaluateObjectives(preset, state).allRequiredMet
		local expired = _MiniGameRuleEngine:IsTimeExpired(state)
		if not met and not expired and not isShape then
			local allConsumed = isTiming and #timings > 0
			for i = 1, #timings do
				if consumed[i] ~= true then allConsumed = false end
			end
			if not isTiming or (#tProof.samples < maxAttempts and not allConsumed) then return nil end
		end
		local reason = met and self.REASON_OBJECTIVE or self.REASON_COMPLETE
		if isShape then reason = self.REASON_COMPLETE end
		if expired and not met then reason = isGauge and self.REASON_DRAIN or self.REASON_TIMEOUT end
		local resolved = _MiniGameRuleEngine:BuildResult(preset, state, reason)
		if resolved == nil then return nil end
		local tResult = MiniGameResultData()
		tResult.success = resolved.isSuccess
		tResult.score = resolved.score
		tResult.progress = resolved.progress
		tResult.accuracy = resolved.accuracy
		tResult.reason = reason
		tResult.successCount = state.successCount
		tResult.hitCount = state.hitCount
		tResult.shapeRatio = state.shapeRatio
		tSession.ruleState = state
		log("[VRF] 미니게임 입력 검증 session=" .. tSession.id .. " samples=" .. tostring(#tProof.samples) .. " success=" .. tostring(tResult.success))
		return tResult
	end

	@ExecSpace("ServerOnly")
	method void ExpireTimings(any state, any timings, any consumed, number elapsed, number goodWindow)
		-- 입력 없이 지난 타이밍을 서버 기준으로 소비
		for i, timing in ipairs(timings) do
			if not consumed[i] and elapsed > timing + goodWindow then
				consumed[i] = true
				state.missCount += 1
				state.lastAccuracy = self.ACCURACY_MISS
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void ApplyTimingPress(any state, any timings, any consumed, number elapsed, any config)
		-- 가장 가까운 미소비 타이밍에 허용 오차를 적용
		local bestIndex = 0
		local bestDifference = math.huge
		for i, timing in ipairs(timings) do
			local difference = math.abs(elapsed - timing)
			if not consumed[i] and difference <= (config.goodWindow or 0.2) and difference < bestDifference then
				bestIndex = i
				bestDifference = difference
			end
		end
		if bestIndex == 0 then
			state.missCount += 1
			state.lastAccuracy = self.ACCURACY_MISS
			return
		end
		consumed[bestIndex] = true
		state.hitCount += 1
		state.successCount = state.hitCount
		state.lastAccuracy = bestDifference <= (config.perfectWindow or 0.08) and self.ACCURACY_PERFECT or self.ACCURACY_GOOD
	end

	@ExecSpace("ServerOnly")
	method boolean ApplyShapePoint(any state, any objective, any covered, any sample)
		-- 서버 도형의 최근접 체크포인트와 중복 커버리지 판정
		local points = objective.shapePoints
		local tolerance = objective.tolerance or 18
		local bound = self.SHAPE_COORDINATE_SCALE + tolerance
		if math.abs(sample.x) > bound or math.abs(sample.y) > bound then return false end
		local bestIndex = 0
		local bestSquared = math.huge
		for i, point in ipairs(points) do
			local dx = sample.x - (point.x - 0.5) * self.SHAPE_COORDINATE_SCALE
			local dy = sample.y - (point.y - 0.5) * self.SHAPE_COORDINATE_SCALE
			local squared = dx * dx + dy * dy
			if squared < bestSquared then
				bestIndex = i
				bestSquared = squared
			end
		end
		if bestIndex == 0 or bestSquared > tolerance * tolerance or covered[bestIndex] then return false end
		covered[bestIndex] = true
		local coveredCount = 0
		for _, hit in pairs(covered) do
			if hit then coveredCount += 1 end
		end
		state.shapeRatio = coveredCount / #points
		state.accuracyScore = state.shapeRatio
		return true
	end

	@ExecSpace("ServerOnly")
	method void UpdateSession(any tSession, number delta)
		-- 클라이언트 결과 유실 시 유예 시간 이후 서버 세션 취소
		tSession.elapsed = tSession.elapsed + delta
		if tSession.duration > 0 and tSession.elapsed >= tSession.duration + _MiniGameSessionService.CLIENT_RESULT_GRACE_SECONDS then
			_MiniGameSessionService:AbortSession(tSession, _MiniGameSessionService.SESSION_REASON_TIMEOUT)
		end
	end

end

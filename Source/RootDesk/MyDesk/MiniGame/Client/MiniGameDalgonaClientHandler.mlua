---@description "클라이언트 측 달고나 미니게임 처리 로직"
@Logic
script MiniGameDalgonaClientHandler extends Logic

	@ExecSpace("ClientOnly")
	method any CreateBehavior()
		-- 게임별 클라이언트 처리와 필수 View 기능 구성
		local tBehavior = MiniGameClientBehavior()
		local caps = _MiniGameViewRegistry
		tBehavior.requiredCapabilities = {caps.CAP_STAGE, caps.CAP_SELECTION}
		tBehavior.usesInputHub = false
		tBehavior.acceptsSelection = true
		tBehavior.openLobby = function() _MiniGameDalgonaPresenter:OpenLobby() end
		tBehavior.openDebugLobby = function(testMesoBalance)
			_MiniGameDalgonaPresenter:OpenDebugLobby(testMesoBalance)
		end
		tBehavior.prepareView = function(presenter, tContext)
			_MiniGameDalgonaPresenter:BeginSession(presenter.tModel.preset, tContext)
		end
		tBehavior.selectionAccepted = function(presenter, targetSessionId)
			_MiniGameDalgonaPresenter:HandleSelectionAccepted(targetSessionId)
		end
		tBehavior.drawResult = function(presenter, targetSessionId, tDrawResult)
			_MiniGameDalgonaPresenter:ApplyDrawResult(targetSessionId, tDrawResult)
			presenter:FinishSelectionSessionFromServer(targetSessionId)
		end
		tBehavior.requestRejected = function(miniGameId, reason)
			_MiniGameDalgonaPresenter:HandleRequestRejected(miniGameId, reason)
		end
		tBehavior.endSession = function(presenter)
			_MiniGameDalgonaPresenter:EndSession(presenter.sessionId)
		end
		tBehavior.reset = function()
			_MiniGameDalgonaPresenter:ClearState()
		end
		return tBehavior
	end

end

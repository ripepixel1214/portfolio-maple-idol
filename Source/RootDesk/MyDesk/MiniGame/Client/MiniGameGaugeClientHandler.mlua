---@description "클라이언트 측 게이지 미니게임 처리 로직"
@Logic
script MiniGameGaugeClientHandler extends Logic

	@ExecSpace("ClientOnly")
	method any CreateBehavior()
		-- 게임별 클라이언트 처리와 필수 View 기능 구성
		local tBehavior = MiniGameClientBehavior()
		local caps = _MiniGameViewRegistry
		tBehavior.requiredCapabilities = {caps.CAP_STAGE, caps.CAP_HUD, caps.CAP_RESULT, caps.CAP_MASH, caps.CAP_GAUGE}
		tBehavior.afterInput = function(presenter, event)
			if event.action == _EMiniGameInputAction.Input then
				presenter:GetViewCapability(caps.CAP_MASH):PlayMashPose()
				presenter:GetViewCapability(caps.CAP_GAUGE):PlayGaugeSway()
			end
		end
		return tBehavior
	end

end

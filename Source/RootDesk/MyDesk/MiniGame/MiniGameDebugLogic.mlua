---@description "야시장 미니게임 공통 디버그 진입 로직"
@Logic
script MiniGameDebugLogic extends Logic

	property boolean<const> isDebugMode = true

	-- F1 달고나, F2 럭키큐브, F3 물고기 잡기, F4 달팽이 사다리 타기
	property any miniGameIds = {}
	property integer DEBUG_TEST_MESO_BALANCE = 1000

	-- 키 입력 구독 핸들러
	property any keyDownHandler = nil

	method void OnBeginPlay()
		-- 클라이언트에서 디버그 키 입력 구독
		if self:IsClient() then
			-- 저장된 슬롯 값을 사용하지 않고 현재 게임 규칙으로 재구성
			self.miniGameIds = {
				_MiniGameTable.MINI_GAME_DALGONA_CHALLENGE,
				_MiniGameLuckyCubeRule.MINI_GAME_ID,
				_MiniGameFishingRule.MINI_GAME_ID,
				_MiniGameSnailLadderRule.MINI_GAME_ID
			}
			self.keyDownHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnKeyDown)
		end
	end

	method void OnEndPlay()
		-- 키 입력 구독 해제
		if self.keyDownHandler ~= nil then
			_InputService:DisconnectEvent(KeyDownEvent, self.keyDownHandler)
			self.keyDownHandler = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void OnKeyDown(KeyDownEvent event)
		-- 야시장 디버그 슬롯만 공통 실행 입구로 전달
		if event == nil or not self.isDebugMode then return end
		if event.key == KeyboardKey.F1 then
			self:LaunchSlot(1)
		elseif event.key == KeyboardKey.F2 then
			self:LaunchSlot(2)
		elseif event.key == KeyboardKey.F3 then
			self:LaunchSlot(3)
		elseif event.key == KeyboardKey.F4 then
			self:LaunchSlot(4)
		end
	end

	@ExecSpace("ClientOnly")
	method void LaunchSlot(integer slot)
		-- 게임 ID와 테스트 메소만 공통 MiniGamePlay 진입점으로 전달
		local miniGameId = self.miniGameIds[slot]
		if miniGameId == nil or miniGameId == "" then return end
		_MiniGamePlayLogic:OpenDebugLobby(miniGameId, self.DEBUG_TEST_MESO_BALANCE)
	end

end

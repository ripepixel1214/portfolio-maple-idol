@Logic
@ExecSpace("ClientOnly")
script MiniGamePerformanceUILogic extends Logic

	-- 공연 컨텍스트 전용 미니게임 UI 스킨. 기본 스킨(MiniGameUILogic)과 동일한 표시 계약(메서드 시그니처)을
	-- 구현하되, 공연 컨셉에 맞는 별도 .ui(/ui/MiniGamePerformanceUI)에 바인딩된다. 라우팅은 MiniGameUIRouter가 담당.

	-- 타이밍 마커 경로 베이스 (뒤에 인덱스를 붙여 해석). Stage들은 Panel이 아니라 UI 그룹 바로 아래에 있다.
	property string GROUPPATH_MARKERS = "/ui/MiniGamePerformanceUI/TimingStage/TimingMarker"

	-- UI 엔티티 바인딩 (UIBuilder가 UUID를 주입). UI 미구성 시 nil로 동작해 안전하게 무시된다.
	property Entity playGroup = "9c496245-a986-4ca6-a421-7e9e36a25de0"

	-- 연타(Mash) 스테이지 컨테이너 — 공연 미니게임은 커맨드/연타 2종만 사용(연타는 카운트형)
	property Entity mashStage = "ec5f0dc9-c20c-421c-b0e1-fe0494339e05"
	-- 모바일 연타 입력 버튼 참조
	property ButtonComponent mobilePrimaryInputButton = "a728337a-45a2-4528-af66-af3dac8891cd"
	@HideFromInspector
	property any mobilePrimaryInputButtonHandler = nil
	-- 연타 카운트 표시 텍스트 (MashStage/CounterBox의 TextGUIRenderer)
	property TextGUIRendererComponent counterLabel = "15612fa4-00cc-417b-9aec-a8c2994dfda4"
	-- 연타 스테이지 타이머 텍스트 (MashStage/Timer/TimerLabel). 미니게임 큐 길이(제한시간)를 {mm : ss}로 카운트다운 표시
	property TextGUIRendererComponent mashTimerLabel = "1ccbd6c8-16b9-49ab-98f2-3e73bbda3056"
	-- 연타 스테이지 아바타: 대상 캐릭터(TargetAvatar) / 내 아바타(MyAvatar)
	property CostumeManagerComponent mashTargetAvatar = "bce7ca59-3734-4153-b95c-db1169ee754b"
	property Entity mashMyAvatar = "138589d5-0d01-45f6-925e-4fad51ff3a6e"
	property boolean mashPoseDown = false

	-- 타이밍 스테이지 (Timing) — 공연 스킨 미사용(라우터 표시 계약 정합용, 런타임 nil로 무시됨)
	property Entity timingStage = nil
	property Entity timingCursor = nil

	-- 커맨드 스테이지 (Command) — 이미지 아이콘 방식 (기본 스킨 MiniGameUILogic과 동일 배치)
	property Entity commandStage = "147f5aae-f6c7-4dc8-a5e3-cb7a42b9a621"
	-- 아이콘 배치/렌더/이펙트는 CommandBox의 MiniGameCommandBox 컴포넌트가 담당한다.
	property Entity commandBox = nil

	-- 성공 연출 오버레이 (공연 전용: 미니게임 성공 시 SUCCESS 애니메이션 재생)
	property Entity successOverlay = "3663cada-f299-4f99-a818-b937b8d7ba42"

	-- 실패 연출 오버레이 (공연 전용: 미니게임 실패/시간초과 시 FAIL 애니메이션 재생)
	property Entity failOverlay = "1aa1e9e4-a1f6-4b9a-889f-d34eb95d0a0c"

	-- 성공/실패 오버레이 애니메이션 RUID (.ui의 SuccessOverlay/FailOverlay ImageRUID와 동일해야 함. 재생 길이 계산용)
	property string successAnimRuid = "6d5a507b49764376bc71df113c5d7cf2"
	property string failAnimRuid = "ec808ad55fd04cc787d06f02db1a6c39"
	-- 각 결과 애니메이션 1회 재생 길이(초). OnBeginPlay에서 클립 프레임으로 계산
	property number successAnimDuration = 1.0
	property number failAnimDuration = 1.0
	-- 결과 오버레이 자동 숨김 타이머(초). >0이면 카운트다운, 0 이하가 되면 오버레이를 숨긴다.
	property number overlayHideTimer = 0

	-- 타이밍 마커 풀 (경로로 해석)
	property any markers = {}
	-- 타이밍 트랙 절반 너비(px). 마커/커서 좌표 계산 기준
	property number trackHalfWidth = 330

	-- 결과 표시 후 자동 종료 타이머
	property boolean isResultShown = false
	property number resultCloseTimer = 0
	property number resultCloseDelay = 2.0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 타이밍 마커/커맨드 박스를 해석하고 결과 오버레이를 준비한 뒤 UI를 숨긴다.
		self:ConnectMobilePrimaryInputButton()
		self:ResolveMarkers()
		self:ResolveCommandBox()
		self:SetupResultOverlays()
		self:SetVisible(false)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 모바일 연타 버튼 이벤트 구독 해제
		self:DisconnectMobilePrimaryInputButton()
	end

	@ExecSpace("ClientOnly")
	method void ConnectMobilePrimaryInputButton()
		-- 모바일 공용 입력 버튼 클릭 이벤트 구독
		if Environment:IsMobilePlatform() == false then
			self:SetMobilePrimaryInputEnabled(false)
			return
		end

		if self.mobilePrimaryInputButton ~= nil and self.mobilePrimaryInputButtonHandler == nil then
			self.mobilePrimaryInputButtonHandler = self.mobilePrimaryInputButton.Entity:ConnectEvent(ButtonClickEvent, self.OnMobilePrimaryInputClicked)
		end

		self:SetMobilePrimaryInputEnabled(false)
	end

	@ExecSpace("ClientOnly")
	method void DisconnectMobilePrimaryInputButton()
		-- 모바일 공용 입력 버튼 클릭 이벤트 구독 해제
		if self.mobilePrimaryInputButton ~= nil and self.mobilePrimaryInputButtonHandler ~= nil then
			self.mobilePrimaryInputButton.Entity:DisconnectEvent(ButtonClickEvent, self.mobilePrimaryInputButtonHandler)
			self.mobilePrimaryInputButtonHandler = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void OnMobilePrimaryInputClicked(ButtonClickEvent event)
		-- 현재 입력 타입에 맞는 모바일 공용 입력 전달
		if _MiniGameInputHubLogic ~= nil then
			_MiniGameInputHubLogic:SubmitMobilePrimaryInput()
		end
	end

	@ExecSpace("ClientOnly")
	method void SetMobilePrimaryInputEnabled(boolean enabled)
		-- 실제 입력 활성 상태에 따른 모바일 공용 입력 버튼 제어
		if self.mobilePrimaryInputButton == nil or self.mobilePrimaryInputButton.Entity == nil then
			return
		end

		self.mobilePrimaryInputButton.Entity.Enable = Environment:IsMobilePlatform() == true and enabled == true
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 결과 오버레이 숨김/자동 종료 타이머를 처리한다. (커맨드 오답/정답 이펙트는 MiniGameCommandBox 컴포넌트가 자체 처리)
		-- 결과 오버레이는 1회 재생 길이 후 즉시 숨기고, 결과 표시 후 일정 시간이 지나면 UI를 닫는다.
		if self.overlayHideTimer > 0 then
			self.overlayHideTimer = self.overlayHideTimer - delta
			if self.overlayHideTimer <= 0 then
				self.overlayHideTimer = 0
				self:SetEntityEnable(self.successOverlay, false)
				self:SetEntityEnable(self.failOverlay, false)
			end
		end

		if self.isResultShown == false then
			return
		end

		self.resultCloseTimer = self.resultCloseTimer - delta
		if self.resultCloseTimer <= 0 then
			self:Close()
		end
	end

	@ExecSpace("ClientOnly")
	method void ResolveMarkers()
		-- 타이밍 마커 엔티티를 경로로 해석한다.
		self.markers = {}
		for i = 1, 6 do
			local marker = _EntityService:GetEntityByPath(self.GROUPPATH_MARKERS .. tostring(i))
			self.markers[i] = marker
		end
	end

	@ExecSpace("ClientOnly")
	method void SetupResultOverlays()
		-- 결과 오버레이(성공/실패)를 Loop 재생으로 두고, 1회 재생 길이(초)를 클립 프레임에서 계산해 둔다.
		-- (Onetime은 1회 완료 후 재-Enable해도 다시 재생되지 않으므로, Loop + 길이 타이머로 "1회 재생 후 숨김"을 구현한다.)
		self.successAnimDuration = self:ComputeAnimDuration(self.successAnimRuid, self.successOverlay)
		self.failAnimDuration = self:ComputeAnimDuration(self.failAnimRuid, self.failOverlay)
	end

	@ExecSpace("ClientOnly")
	method number ComputeAnimDuration(string ruid, Entity overlay)
		-- 오버레이를 Loop 재생으로 설정하고, 애니메이션 1회 재생 길이(초)=Σ(프레임 Delay)/PlayRate 를 반환한다. (실패 시 1.0)
		if overlay ~= nil then
			local renderer = overlay.SpriteGUIRendererComponent
			if renderer ~= nil then
				renderer.AnimClipPlayType = SpriteAnimClipPlayType.Loop
			end
		end

		if ruid == nil or ruid == "" then
			return 1.0
		end

		local clip = _ResourceService:LoadAnimationClipAndWait(ruid)
		if clip == nil or clip.Frames == nil then
			return 1.0
		end

		local total = 0
		local list = clip.Frames:ToTable()
		for i = 1, #list do
			total = total + list[i].Delay
		end

		local rate = clip.PlayRate
		if rate == nil or rate <= 0 then
			rate = 1
		end

		local duration = total / rate
		if duration <= 0 then
			return 1.0
		end

		return duration
	end

	@ExecSpace("ClientOnly")
	method void OpenForSession(string title, string instruction, string presentationActorId)
		-- 새 세션 공통 영역을 숨김 상태로 초기화
		if self.playGroup == nil then
			return
		end

		self:SetVisible(false)
		self:HideAllStages()
		self.isResultShown = false
		self.resultCloseTimer = 0
		self.mashPoseDown = false

		-- 연타 카운트 초기화 + 연타 스테이지 아바타(대상/내 아바타) 세팅
		self:SetGuiText(self.counterLabel, "0")
		self:SetGuiText(self.mashTimerLabel, "")
		self:ApplyStageCharacter(presentationActorId)
		self:SetEntityEnable(self.successOverlay, false)
		self:SetEntityEnable(self.failOverlay, false)
		self.overlayHideTimer = 0
		-- 이전 세션의 커맨드 아이콘이 표시 직후 잠깐 보이지 않도록, UI를 켜기 전에 모두 숨긴다.
		self:HideAllCommandIcons()
	end

	@ExecSpace("ClientOnly")
	method void HideAllStages()
		-- 세션 준비 중 모든 스테이지 비표시
		self:SetEntityEnable(self.mashStage, false)
		self:SetEntityEnable(self.timingStage, false)
		self:SetEntityEnable(self.commandStage, false)
	end

	@ExecSpace("ClientOnly")
	method void ShowActiveSession()
		-- 스테이지와 입력 준비가 끝난 공연 미니게임 UI 표시
		self:SetVisible(true)
	end

	@ExecSpace("ClientOnly")
	method void SelectStage(integer inputType, boolean useGauge)
		-- 입력 타입에 맞는 스테이지만 켠다. 공연 미니게임은 연타(카운트형)/커맨드 2종만 사용한다. (useGauge는 라우터 계약 정합용)
		self:SetEntityEnable(self.mashStage, inputType == _EMiniGameInputType.Mash)
		self:SetEntityEnable(self.timingStage, inputType == _EMiniGameInputType.Timing)
		self:SetEntityEnable(self.commandStage, inputType == _EMiniGameInputType.Command)

		-- 커맨드/연타 스테이지에서 공연 응원봉 오버레이를 켠다. (상시 좌우 흔들림 + 입력마다 1회 위로 팝)
		if _PerformanceEffectLogic ~= nil then
			if inputType == _EMiniGameInputType.Command or inputType == _EMiniGameInputType.Mash then
				_PerformanceEffectLogic:ShowOtageForCommand()
			else
				_PerformanceEffectLogic:HideOtageForCommand()
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void SetupTiming(any timings, number duration)
		-- 목표 타이밍 위치에 마커를 배치하고 커서를 시작 위치로 되돌린다.
		if self.markers == nil then
			return
		end

		local half = self.trackHalfWidth
		local count = 0
		if timings ~= nil then
			count = #timings
		end

		for i = 1, #self.markers do
			local marker = self.markers[i]
			if marker ~= nil then
				if i <= count and duration > 0 then
					local x = -half + (timings[i] / duration) * (half * 2)
					self:SetPos(marker, x, 0)
					marker.Enable = true
				else
					marker.Enable = false
				end
			end
		end

		self:SetPos(self.timingCursor, -half, 0)
	end

	@ExecSpace("ClientOnly")
	method void UpdateTimingCursor(number elapsed, number duration)
		-- 경과 시간에 따라 타이밍 커서를 좌->우로 이동한다.
		if self.timingCursor == nil or duration <= 0 then
			return
		end

		local ratio = elapsed / duration
		if ratio < 0 then
			ratio = 0
		end
		if ratio > 1 then
			ratio = 1
		end

		self:SetPos(self.timingCursor, -self.trackHalfWidth + ratio * self.trackHalfWidth * 2, 0)
	end

	@ExecSpace("ClientOnly")
	method boolean SetupCommand(any names)
		-- 커맨드 시퀀스 표시를 CommandBox 컴포넌트에 위임한다.
		local box = self:GetCommandBox()
		if box ~= nil then
			return box:SetSequence(names)
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method boolean IsCommandVisualReady()
		-- 커맨드 화살표 리소스 사전 로드 완료 여부 반환
		local box = self:GetCommandBox()
		if box == nil then
			return false
		end
		return box:IsArrowResourcesReady()
	end

	@ExecSpace("ClientOnly")
	method void UpdateCommandProgress(integer doneCount)
		-- 커맨드 진행 표시를 CommandBox 컴포넌트에 위임한다.
		local box = self:GetCommandBox()
		if box ~= nil then
			box:SetProgress(doneCount)
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowCommandError()
		-- 커맨드 오답 이펙트를 CommandBox 컴포넌트에 위임한다.
		local box = self:GetCommandBox()
		if box ~= nil then
			box:ShowError()
		end
	end

	@ExecSpace("ClientOnly")
	method void PlayCommandHit(integer index)
		-- 정답 입력 아이콘 강조를 CommandBox 컴포넌트에 위임하고, 공연 응원봉을 1회 흔든다.
		local box = self:GetCommandBox()
		if box ~= nil then
			box:PlayHit(index)
		end

		-- 공연 전용 연출: 정답 방향(상하좌우)에 맞춰 화면 양쪽 응원봉을 그 방향으로 1회 흔든다. (오타게 오버레이가 켜져 있어야 보임)
		if _PerformanceEffectLogic ~= nil then
			_PerformanceEffectLogic:SwayLightStickDirection(self:GetCommandDirection(index))
		end
	end

	@ExecSpace("ClientOnly")
	method string GetCommandDirection(integer index)
		-- 방금 입력한 커맨드 인덱스의 방향(Up/Down/Left/Right)을 CommandBox 시퀀스에서 조회. 범위 밖이면 ""(위로 팝)
		local box = self:GetCommandBox()
		if box == nil then
			return ""
		end

		local names = box.commandNames
		if names == nil or index < 1 or index > #names then
			return ""
		end

		return names[index]
	end

	@ExecSpace("ClientOnly")
	method void PlayTimingHit()
		-- 타이밍 정답 입력 시 커서 위치 성공 이펙트. 공연 스킨은 별도 연출을 쓰므로 여기서는 표시하지 않는다. (표시 계약 유지용)
	end

	@ExecSpace("ClientOnly")
	method void PlayTimingMiss()
		-- 타이밍 실패(헛입력) 시 커서 위치 실패 이펙트. 공연 스킨은 별도 연출을 쓰므로 여기서는 표시하지 않는다. (표시 계약 유지용)
	end

	@ExecSpace("ClientOnly")
	method void UpdateTimingAttempts(integer remaining, integer max)
		-- 타이밍 남은 시도 횟수 표시. 공연 스킨은 전용 카운터가 없어 표시하지 않는다. (시도 제한 로직은 입력 모듈에서 동일 적용, 표시 계약 유지용)
	end

	@ExecSpace("ClientOnly")
	method void PlayMashPose()
		-- 연타할 때마다 내 아바타를 기본(stand1)↔엎드리기(prone)로 토글한다.
		self.mashPoseDown = not self.mashPoseDown
		local action = "stand1"
		if self.mashPoseDown == true then
			action = "prone"
		end

		self:SetAvatarAction(self.mashMyAvatar, action)

		-- 공연 전용 연출: 연타 입력마다 화면 양쪽 응원봉을 1회 흔든다. (커맨드 정답과 동일, 오타게 오버레이가 켜져 있어야 보임)
		if _PerformanceEffectLogic ~= nil then
			_PerformanceEffectLogic:SwayLightStickOnce()
		end
	end

	@ExecSpace("ClientOnly")
	method void PlayGaugeSway()
		-- 게이지 스테이지 응원봉 흔들림. 공연 스킨은 게이지 스테이지를 쓰지 않고 오타게는 PlayMashPose에서 처리하므로 동작 없음. (표시 계약 유지용)
	end

	@ExecSpace("ClientOnly")
	method void ResolveCommandBox()
		-- CommandBox 엔티티를 경로로 해석한다. (아이콘/이펙트는 CommandBox의 MiniGameCommandBox 컴포넌트가 관리)
		self.commandBox = _EntityService:GetEntityByPath("/ui/MiniGamePerformanceUI/CommandStage/CommandBox")
	end

	@ExecSpace("ClientOnly")
	method any GetCommandBox()
		-- CommandBox의 MiniGameCommandBox 컴포넌트를 반환한다. (nil 안전)
		if self.commandBox == nil then
			return nil
		end
		return self.commandBox.MiniGameCommandBox
	end

	@ExecSpace("ClientOnly")
	method void HideAllCommandIcons()
		-- 커맨드 아이콘 숨김/이펙트 초기화를 CommandBox 컴포넌트에 위임한다. (세션 간 잔상 방지)
		local box = self:GetCommandBox()
		if box ~= nil then
			box:HideAll()
		end
	end

	@ExecSpace("ClientOnly")
	method void UpdateHud(any tHudState)
		-- 진행 문자열(연타 카운트 등)을 카운터 텍스트에 표시한다. displayText 예: "3 / 20". (공연 스킨은 타이머/게이지 미표시)
		if self.playGroup == nil or self.isResultShown == true or tHudState == nil then
			return
		end

		self:SetGuiText(self.counterLabel, tHudState.displayText)
		-- 연타 스테이지 타이머: 미니게임 큐 길이(제한시간)에서 카운트다운되는 남은 시간을 {mm : ss}로 표시
		self:UpdateMashTimer(tHudState.timeRemaining, tHudState.showTimer)
	end

	@ExecSpace("ClientOnly")
	method void UpdateMashTimer(number timeRemaining, boolean showTimer)
		-- 카운트다운(Countdown) 미니게임일 때만 남은 시간을 표시하고, 그 외에는 비운다. (연타 큐 길이만큼의 시간)
		if self.mashTimerLabel == nil then
			return
		end

		if showTimer ~= true then
			self:SetGuiText(self.mashTimerLabel, "")
			return
		end

		self:SetGuiText(self.mashTimerLabel, self:FormatTime(timeRemaining))
	end

	@ExecSpace("ClientOnly")
	method string FormatTime(number seconds)
		-- 남은 시간(초)을 {mm : ss} 형태 문자열로 변환한다. (기본 스킨 MiniGameUILogic과 동일 포맷)
		local total = math.ceil(seconds)
		if total < 0 then
			total = 0
		end

		local minutes = math.floor(total / 60)
		local secs = total % 60
		return string.format("%02d : %02d", minutes, secs)
	end

	@ExecSpace("ClientOnly")
	method void ShowResult(boolean success, string reason, string detailText)
		-- 성공/실패 애니메이션 오버레이를 재생하고 자동 종료 타이머를 시작한다. (결과 텍스트는 오버레이로 대체됨)
		if self.playGroup == nil then
			return
		end

		-- 공연 전용: 성공 시 SUCCESS, 실패/시간초과 시 FAIL 애니메이션 오버레이를 재생한다. (사용자 취소는 제외)
		local isFailure = (success == false) and reason ~= "cancel" and reason ~= "restart" and reason ~= "clear"
		self:SetEntityEnable(self.successOverlay, success == true)
		self:SetEntityEnable(self.failOverlay, isFailure)
		-- 애니메이션 1회 재생 길이만큼만 오버레이를 표시하고, OnUpdate에서 자동으로 숨긴다.
		if success == true then
			self.overlayHideTimer = self.successAnimDuration
		elseif isFailure == true then
			self.overlayHideTimer = self.failAnimDuration
		else
			self.overlayHideTimer = 0
		end
		self.isResultShown = true
		self.resultCloseTimer = self.resultCloseDelay
	end

	@ExecSpace("ClientOnly")
	method void Close()
		-- 결과 오버레이를 끄고 UI를 닫는다.
		self.isResultShown = false
		self.resultCloseTimer = 0
		self:SetEntityEnable(self.successOverlay, false)
		self:SetEntityEnable(self.failOverlay, false)
		self.overlayHideTimer = 0
		-- 커맨드 미니게임이 켰던 공연 응원봉 오버레이를 정리한다. (상시 흔들림 기본값 복구)
		if _PerformanceEffectLogic ~= nil then
			_PerformanceEffectLogic:HideOtageForCommand()
		end
		self:SetVisible(false)
	end

	@ExecSpace("ClientOnly")
	method void SetVisible(boolean show)
		-- UI 그룹 표시 상태를 변경한다.
		if self.playGroup == nil then
			return
		end

		self.playGroup.Enable = show
	end

	@ExecSpace("ClientOnly")
	method void SetEntityEnable(Entity entity, boolean show)
		-- 엔티티 표시 상태를 변경한다. (nil 안전)
		if entity == nil then
			return
		end

		entity.Enable = show
	end

	@ExecSpace("ClientOnly")
	method void SetPos(Entity entity, number x, number y)
		-- 엔티티의 anchoredPosition을 설정한다. (UI 위치는 anchoredPosition만 사용)
		if entity == nil then
			return
		end

		local transform = entity.UITransformComponent
		if transform ~= nil then
			transform.anchoredPosition = Vector2(x, y)
		end
	end

	@ExecSpace("ClientOnly")
	method void SetText(TextGUIRendererComponent textComponent, string value)
		-- 텍스트 컴포넌트의 표시 문자열을 설정한다.
		if textComponent == nil then
			return
		end

		textComponent.Text = value
	end

	@ExecSpace("ClientOnly")
	method void SetGuiText(TextGUIRendererComponent guiText, string value)
		-- TextGUIRenderer 컴포넌트의 표시 문자열을 설정한다. (nil 안전)
		if guiText == nil then
			return
		end

		guiText.Text = value
	end

	@ExecSpace("ClientOnly")
	method void ApplyStageCharacter(string presentationActorId)
		-- 연타 스테이지 아바타 세팅: 대상 아바타=대상(없으면 내 선택) 캐릭터 코스튬 / 내 아바타=내 계정 기본 아바타.
		local myCharId = ""
		if _CharacterManager ~= nil then
			myCharId = _CharacterManager:ClientGetSelectedCharacterId()
		end

		local charId = presentationActorId
		if charId == nil or charId == "" then
			charId = myCharId
		end

		self:ApplyCostumeToManager(self.mashTargetAvatar, charId)
		self:ApplyMyDefaultAvatar(self.mashMyAvatar)
	end

	@ExecSpace("ClientOnly")
	method void ApplyCostumeToManager(CostumeManagerComponent costume, string charId)
		-- 지정 CostumeManager에 캐릭터 코스튬을 적용한다. (nil 안전)
		if costume == nil or charId == nil or charId == "" or _CharacterCostumeManager == nil then
			return
		end

		_CharacterCostumeManager:ClientApplyCurrentCostumeToManagerComponent(charId, costume)
	end

	@ExecSpace("ClientOnly")
	method string GetLocalUserId()
		-- 로컬 플레이어(내 계정)의 UserId를 반환한다. (nil 안전)
		if _UserService == nil then
			return ""
		end

		local player = _UserService.LocalPlayer
		if player == nil then
			return ""
		end

		local playerComp = player.PlayerComponent
		if playerComp == nil then
			return ""
		end

		return playerComp.UserId
	end

	@ExecSpace("ClientOnly")
	method void ApplyMyDefaultAvatar(Entity avatarEntity)
		-- 아바타 엔티티에 내 계정 기본 아바타를 그대로 출력한다. (DefaultEquipUserId로 내 계정 장비 복제, nil 안전)
		if avatarEntity == nil then
			return
		end

		local costume = avatarEntity.CostumeManagerComponent
		if costume == nil then
			return
		end

		local userId = self:GetLocalUserId()
		if userId == nil or userId == "" then
			return
		end

		costume.UseCustomEquipOnly = false
		costume.DefaultEquipUserId = userId
	end

	@ExecSpace("ClientOnly")
	method void SetAvatarAction(Entity avatarEntity, string action)
		-- UI 아바타의 바디 엔티티에 액션 애니메이션을 재생한다. (nil 안전)
		if avatarEntity == nil then
			return
		end

		local renderer = avatarEntity.AvatarGUIRendererComponent
		if renderer == nil then
			return
		end

		local body = renderer:GetBodyEntity()
		if body == nil or isvalid(body) == false then
			return
		end

		local event = ActionStateChangedEvent()
		event.CoreActionName = action
		event.PartsActionName = action
		event.PlayType = SpriteAnimClipPlayType.Loop
		body:SendEvent(event)
	end

end

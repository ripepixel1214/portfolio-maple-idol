---@description "미사용 공연 UI 숨김 처리"
@Logic
script MiniGamePerformanceUILogic extends Logic
	property Entity legacyGroup = "9c496245-a986-4ca6-a421-7e9e36a25de0"

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 사용 중인 공연 미니게임은 공통 훈련 View로 표시
		if isvalid(self.legacyGroup) then self.legacyGroup.Enable = false end
	end
end

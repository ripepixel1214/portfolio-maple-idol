@Logic
@ExecSpace("ClientOnly")
script TimingInputLogic extends Logic

	property string PC_INPUT_NAME = "Space"
	property string MOBILE_INPUT_NAME = "Touch"

	-- 모듈 활성 여부
	property boolean 	isActive = false

	-- 입력 채널 식별자
	property string channelId = ""

	-- KeyDownEvent 핸들러
	property any 		keyDownHandler = nil

	-- 입력으로 인정할 키
	property any 		targetKey = nil

	-- 입력으로 인정할 키 이름
	property string 	targetKeyName = ""

	-- 시작 후 경과 시간(초)
	property number 	elapsed = 0

	-- 목표 타이밍(초) 배열
	property any 		timings = {}

	-- 각 타이밍의 소비 여부 배열
	property any 		consumed = {}
	
	-- perfect 판정 허용 오차(초)
	property number 	perfectWindow = 0.08
	-- good 판정 허용 오차(초)
	property number 	goodWindow = 0.2
	-- 누적 성공(hit) 수
	property integer 	hitCount = 0
	-- 누적 실패(miss) 수
	property integer 	missCount = 0
	-- 최대 시도(스페이스 입력) 횟수. 클리어 목표의 2배(기본). 전부 소진하면 실패 처리.
	property integer 	maxAttempts = 6
	-- 누적 시도(스페이스 입력) 횟수
	property integer 	attemptCount = 0

	@ExecSpace("ClientOnly")
	method void StartModule(string sessionId, any config)
		-- 타이밍 입력을 받기 시작한다.
		self:Cleanup()

		self.elapsed = 0
		self.channelId = config.channelId or ""
		self.hitCount = 0
		self.missCount = 0
		self.attemptCount = 0
		self.targetKey = KeyboardKey.Space
		self.targetKeyName = self.PC_INPUT_NAME
		self.perfectWindow = 0.08
		self.goodWindow = 0.2

		if config.targetKey ~= nil then
			self.targetKey = config.targetKey
		end
		if config.targetKeyName ~= nil then
			self.targetKeyName = config.targetKeyName
		end
		if config.perfectWindow ~= nil then
			self.perfectWindow = config.perfectWindow
		end
		if config.goodWindow ~= nil then
			self.goodWindow = config.goodWindow
		end

		self.timings = {}
		self.consumed = {}
		if config.timings ~= nil then
			for i = 1, #config.timings do
				self.timings[i] = config.timings[i]
				self.consumed[i] = false
			end
		end

		-- 설정이 없으면 기본 타이밍을 사용한다.
		if #self.timings == 0 then
			self.timings = { 1.0, 2.0, 3.0 }
			self.consumed = { false, false, false }
		end

		-- 최대 시도 횟수: config(=클리어 목표의 2배) 우선, 없으면 타이밍 개수의 2배.
		self.maxAttempts = #self.timings * 2
		if config.maxAttempts ~= nil and config.maxAttempts > 0 then
			self.maxAttempts = config.maxAttempts
		end

		if Environment:IsPCPlatform() == true then
			self.keyDownHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnKeyDown)
		end
		self.isActive = true

		local inputName = self.targetKeyName
		if Environment:IsMobilePlatform() == true then
			inputName = self.MOBILE_INPUT_NAME
		end
		_MiniGameInputHubLogic:EmitForChannel(self.channelId, _EMiniGameInputAction.Start, {
			keyName = inputName,
			value = #self.timings
		})
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 경과 시간을 누적하고, 입력 없이 지나간 타이밍은 miss 처리한다.
		if self.isActive == false then
			return
		end
		if _MiniGameInputHubLogic:IsChannelEnabled(self.channelId) == false then
			return
		end

		self.elapsed = self.elapsed + delta

		for i = 1, #self.timings do
			if self.consumed[i] == false and self.elapsed > (self.timings[i] + self.goodWindow) then
				self.consumed[i] = true
				self.missCount = self.missCount + 1
				_MiniGameInputHubLogic:EmitForChannel(self.channelId, _EMiniGameInputAction.Miss, {
					accuracy = "miss",
					missCount = self.missCount,
					progress = self:GetProgress()
				})
			end
		end

		self:CheckFinished()
	end

	@ExecSpace("ClientOnly")
	method void OnKeyDown(KeyDownEvent event)
		-- PC 지정 키 입력을 공통 입력 처리로 전달
		if event.key ~= self.targetKey then
			return
		end

		self:SubmitInput(self.targetKeyName)
	end

	@ExecSpace("ClientOnly")
	method void SubmitMobileInput()
		-- 모바일 UI 버튼 입력을 공통 입력 처리로 전달
		self:SubmitInput(self.MOBILE_INPUT_NAME)
	end

	@ExecSpace("ClientOnly")
	method void SubmitInput(string inputName)
		-- 입력 장치와 무관한 타이밍 입력 판정
		if self.isActive == false then
			return
		end
		if _MiniGameInputHubLogic:IsChannelEnabled(self.channelId) == false then
			return
		end

		local resolvedInputName = inputName
		if resolvedInputName == nil or resolvedInputName == "" then
			resolvedInputName = self.targetKeyName
		end

		-- 스페이스 입력 1회 = 시도 1회. 명중이든 헛입력이든 시도 횟수를 소비한다.
		self.attemptCount = self.attemptCount + 1

		local bestIdx = 0
		local bestAbsDiff = 0

		for i = 1, #self.timings do
			if self.consumed[i] == false then
				local diff = self.elapsed - self.timings[i]
				local absDiff = diff
				if absDiff < 0 then
					absDiff = -absDiff
				end

				if absDiff <= self.goodWindow then
					if bestIdx == 0 or absDiff < bestAbsDiff then
						bestIdx = i
						bestAbsDiff = absDiff
					end
				end
			end
		end

		if bestIdx == 0 then
			-- 인접한 타이밍이 없으면 헛입력(miss)으로 처리한다.
			self.missCount = self.missCount + 1
			_MiniGameInputHubLogic:EmitForChannel(self.channelId, _EMiniGameInputAction.Miss, {
				keyName = resolvedInputName,
				accuracy = "miss",
				missCount = self.missCount,
				progress = self:GetProgress(),
				attemptsRemaining = self:GetAttemptsRemaining(),
				maxAttempts = self.maxAttempts
			})
		else
			self.consumed[bestIdx] = true
			self.hitCount = self.hitCount + 1

			local accuracy = "good"
			if bestAbsDiff <= self.perfectWindow then
				accuracy = "perfect"
			end

			_MiniGameInputHubLogic:EmitForChannel(self.channelId, _EMiniGameInputAction.Hit, {
				keyName = resolvedInputName,
				accuracy = accuracy,
				value = bestAbsDiff,
				successCount = self.hitCount,
				progress = self:GetProgress(),
				attemptsRemaining = self:GetAttemptsRemaining(),
				maxAttempts = self.maxAttempts
			})

			self:CheckFinished()
		end

		-- 명중으로 모든 타이밍을 채웠으면 CheckFinished가 이미 종료(isActive=false)했으므로 건너뛴다.
		-- 아직 진행 중인데 시도 횟수를 모두 소진했으면 실패로 종료한다.
		if self.isActive == true and self.attemptCount >= self.maxAttempts then
			self:Cleanup()
			_MiniGameInputHubLogic:EmitForChannel(self.channelId, _EMiniGameInputAction.Complete, {
				isTerminal = true,
				isSuccess = false,
				reason = "attemptsExhausted",
				progress = self:GetProgress(),
				successCount = self.hitCount,
				missCount = self.missCount,
				attemptsRemaining = 0,
				maxAttempts = self.maxAttempts
			})
			_MiniGameInputHubLogic:NotifyChannelFinished(self.channelId)
		end
	end

	@ExecSpace("ClientOnly")
	method integer GetAttemptsRemaining()
		-- 남은 시도 횟수를 반환한다. (0 미만 방지)
		local remaining = self.maxAttempts - self.attemptCount
		if remaining < 0 then
			remaining = 0
		end
		return remaining
	end

	@ExecSpace("ClientOnly")
	method number GetProgress()
		-- 소비한 타이밍 비율(0~1)을 반환한다.
		local total = #self.timings
		if total == 0 then
			return 1
		end

		local done = 0
		for i = 1, total do
			if self.consumed[i] == true then
				done = done + 1
			end
		end

		return done / total
	end

	@ExecSpace("ClientOnly")
	method void CheckFinished()
		-- 모든 타이밍이 소비되면 완료 이벤트를 발행한다.
		if self.isActive == false then
			return
		end

		local total = #self.timings
		if total == 0 then
			return
		end

		for i = 1, total do
			if self.consumed[i] == false then
				return
			end
		end

		self:Cleanup()
		_MiniGameInputHubLogic:EmitForChannel(self.channelId, _EMiniGameInputAction.Complete, {
			isTerminal = true,
			isSuccess = true,
			progress = 1,
			successCount = self.hitCount,
			missCount = self.missCount
		})
		_MiniGameInputHubLogic:NotifyChannelFinished(self.channelId)
	end

	@ExecSpace("ClientOnly")
	method void CancelModule()
		-- 외부 중단 요청 시 핸들러만 정리한다. (종료 이벤트는 허브가 발행)
		self:Cleanup()
	end

	@ExecSpace("ClientOnly")
	method void Cleanup()
		-- 입력 핸들러 연결을 해제하고 비활성화한다.
		if self.keyDownHandler ~= nil then
			_InputService:DisconnectEvent(KeyDownEvent, self.keyDownHandler)
			self.keyDownHandler = nil
		end

		self.isActive = false
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 월드 종료 시 핸들러 누수를 막는다.
		self:Cleanup()
	end

end

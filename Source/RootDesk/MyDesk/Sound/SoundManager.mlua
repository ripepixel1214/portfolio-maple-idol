-- 모든 사운드 재생이 거쳐가는 클라이언트 단일 창구.
-- 마스터/배경음/효과음 볼륨(유저 설정)을 보관하고, SoundService 재생 시 (작곡 볼륨 × 유저 설정 볼륨)을 곱해 넘긴다.
-- BGM은 설정이 바뀌면 재생 중인 것에 즉시 반영하고, 효과음은 단발성이라 다음 재생부터 반영된다. (클라이언트 로컬 전용)
@Logic
script SoundManager extends Logic

	-- 유저 설정 볼륨 (0~1)
	property number masterVolume = 1

	property number backgroundVolume = 0.3

	property number effectVolume = 0.5

	property string defaultButtonClickSfxRuid = "972843e759204d3e9ad84e7d3fa94f83"

	property number defaultButtonClickSfxVolume = 1

	property string scheduleActivitySuccessSfxRuid = "af59dcc4de044dc793ea31c71c2e4e91"

	property number scheduleActivitySuccessSfxVolume = 1

	property string scheduleActivityFailSfxRuid = "8727e134756141c58bf2f525a1598eee"

	property number scheduleActivityFailSfxVolume = 1

	property string studioMapName = "Map_Studio"

	property string studioBgmRuid = "87455f5f463441b4befc83a2c0b8b12a"

	property number studioBgmBaseVolume = 1

	property number studioBgmFadeOutDuration = 0.5

	property string downtownMapName = "Map_Downtown"

	property string downtownBgmRuid = "5935885b480a4f84ba880f71c97accbe"

	property number downtownBgmBaseVolume = 1

	property number downtownBgmFadeOutDuration = 0.5

	property string observedMapName = ""

	property string shopBgmRuid = "a6803c3691ee4058b200aa1fe999dabe"

	property number shopBgmBaseVolume = 1

	property boolean isShopBgmActive = false

	property string bgmBeforeShopRuid = ""

	property number bgmBeforeShopBaseVolume = 1

	property boolean wasBgmPlayingBeforeShop = false

	property string mapNameBeforeShop = ""

	property string weeklyScheduleBgmRuid = "6a3a57485388476da1969ca1a8d6d4c4"

	property number weeklyScheduleBgmBaseVolume = 1

	property boolean isWeeklyScheduleBgmActive = false

	property string bgmBeforeWeeklyScheduleRuid = ""

	property number bgmBeforeWeeklyScheduleBaseVolume = 1

	property boolean wasBgmPlayingBeforeWeeklySchedule = false

	property string mapNameBeforeWeeklySchedule = ""

	property boolean isDialogBgmActive = false

	property string bgmBeforeDialogRuid = ""

	property number bgmBeforeDialogBaseVolume = 1

	property boolean wasBgmPlayingBeforeDialog = false

	property string mapNameBeforeDialog = ""

	property string currentDialogBgmRuid = ""

	property boolean hasLoadedSoundSettings = false

	property string currentSoundUserId = ""

	property boolean isSoundSettingsLoaded = false

	property number serverMasterVolume = 1

	property number serverBackgroundVolume = 0.3

	property number serverEffectVolume = 0.5

	property any userEnterHandler = nil

	-- 현재 재생 중인 BGM 상태 (설정 변경 시 즉시 재적용에 사용)
	property string currentBgmRuid = ""

	property number currentBgmBaseVolume = 1

	property boolean isBgmPlaying = false

	property integer bgmFadeOutTimerId = 0

	property number bgmFadeOutMultiplier = 1

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 유저 입장 시 저장된 사운드 설정을 로드해 해당 클라이언트에 전달하도록 이벤트를 연결합니다.
		self.userEnterHandler = _UserService:ConnectEvent(UserEnterEvent, self.OnUserEnter)
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 서버에서 연결한 유저 입장 이벤트를 정리합니다.
		if self.userEnterHandler ~= nil then
			_UserService:DisconnectEvent(UserEnterEvent, self.userEnterHandler)
			self.userEnterHandler = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 로컬 플레이어의 맵 변경을 감지해 현재 맵에 지정된 BGM을 시작하거나 정리합니다.
		local player = _UserService.LocalPlayer
		if player == nil or isvalid(player.CurrentMap) == false then
			return
		end

		local currentMapName = player.CurrentMap.Name or ""
		if currentMapName == self.observedMapName then
			return
		end

		local previousMapName = self.observedMapName
		self.observedMapName = currentMapName
		if self.isShopBgmActive == true or self.isWeeklyScheduleBgmActive == true or self.isDialogBgmActive == true then
			return
		end

		if currentMapName == self.studioMapName then
			self:ReplaceBGMImmediately(self.studioBgmRuid, self.studioBgmBaseVolume)
			return
		end

		if currentMapName == self.downtownMapName then
			self:ReplaceBGMImmediately(self.downtownBgmRuid, self.downtownBgmBaseVolume)
			return
		end

		if previousMapName == self.studioMapName and self.currentBgmRuid == self.studioBgmRuid then
			self:StopBGM(self.studioBgmFadeOutDuration)
		elseif previousMapName == self.downtownMapName and self.currentBgmRuid == self.downtownBgmRuid then
			self:StopBGM(self.downtownBgmFadeOutDuration)
		end
	end

	@ExecSpace("ClientOnly")
	method void PlayShopBGM()
		-- 현재 맵 BGM 상태를 보관하고 상점 전용 BGM으로 교체합니다.
		if self.isShopBgmActive == true then
			return
		end

		self.isShopBgmActive = true
		self.bgmBeforeShopRuid = self.currentBgmRuid
		self.bgmBeforeShopBaseVolume = self.currentBgmBaseVolume
		self.wasBgmPlayingBeforeShop = self.isBgmPlaying
		self.mapNameBeforeShop = self:GetCurrentMapName()
		self:ReplaceBGMImmediately(self.shopBgmRuid, self.shopBgmBaseVolume)
	end

	@ExecSpace("ClientOnly")
	method void RestoreBGMAfterShop()
		-- 상점이 열린 맵이 유지되면 이전 BGM을 복원하고, 맵이 바뀌었으면 새 맵의 BGM 상태를 우선합니다.
		if self.isShopBgmActive == false then
			return
		end

		local previousRuid = self.bgmBeforeShopRuid
		local previousBaseVolume = self.bgmBeforeShopBaseVolume
		local wasPlaying = self.wasBgmPlayingBeforeShop
		local openedMapName = self.mapNameBeforeShop
		local currentMapName = self:GetCurrentMapName()
		local isShopBgmStillPlaying = self.isBgmPlaying == true and self.currentBgmRuid == self.shopBgmRuid

		self.isShopBgmActive = false
		self.bgmBeforeShopRuid = ""
		self.bgmBeforeShopBaseVolume = 1
		self.wasBgmPlayingBeforeShop = false
		self.mapNameBeforeShop = ""

		if currentMapName == self.studioMapName then
			self:ReplaceBGMImmediately(self.studioBgmRuid, self.studioBgmBaseVolume)
			return
		end

		if currentMapName == self.downtownMapName then
			self:ReplaceBGMImmediately(self.downtownBgmRuid, self.downtownBgmBaseVolume)
			return
		end

		if currentMapName == openedMapName then
			if wasPlaying == true and previousRuid ~= "" then
				self:ReplaceBGMImmediately(previousRuid, previousBaseVolume)
			elseif isShopBgmStillPlaying == true then
				self:StopBGM(0)
			end
			return
		end

		if isShopBgmStillPlaying == false then
			return
		end
		self:StopBGM(0)
	end

	@ExecSpace("ClientOnly")
	method void PlayWeeklyScheduleBGM()
		-- 현재 맵 BGM 상태를 보관하고 주간 스케줄 시퀀스 전용 BGM으로 교체합니다.
		if self.isWeeklyScheduleBgmActive == true then
			return
		end

		self.isWeeklyScheduleBgmActive = true
		self.bgmBeforeWeeklyScheduleRuid = self.currentBgmRuid
		self.bgmBeforeWeeklyScheduleBaseVolume = self.currentBgmBaseVolume
		self.wasBgmPlayingBeforeWeeklySchedule = self.isBgmPlaying
		self.mapNameBeforeWeeklySchedule = self:GetCurrentMapName()
		self:ReplaceBGMImmediately(self.weeklyScheduleBgmRuid, self.weeklyScheduleBgmBaseVolume)
	end

	@ExecSpace("ClientOnly")
	method void RestoreBGMAfterWeeklySchedule()
		-- 주간 스케줄 시작 전에 재생 중이던 BGM을 복원하고 저장된 상태가 없으면 현재 맵 BGM을 적용합니다.
		if self.isWeeklyScheduleBgmActive == false then
			return
		end

		local previousRuid = self.bgmBeforeWeeklyScheduleRuid
		local previousBaseVolume = self.bgmBeforeWeeklyScheduleBaseVolume
		local wasPlaying = self.wasBgmPlayingBeforeWeeklySchedule
		local openedMapName = self.mapNameBeforeWeeklySchedule
		local currentMapName = self:GetCurrentMapName()

		self.isWeeklyScheduleBgmActive = false
		self.bgmBeforeWeeklyScheduleRuid = ""
		self.bgmBeforeWeeklyScheduleBaseVolume = 1
		self.wasBgmPlayingBeforeWeeklySchedule = false
		self.mapNameBeforeWeeklySchedule = ""

		if currentMapName == openedMapName and wasPlaying == true and previousRuid ~= "" then
			self:ReplaceBGMImmediately(previousRuid, previousBaseVolume)
			return
		end

		if currentMapName == self.studioMapName then
			self:ReplaceBGMImmediately(self.studioBgmRuid, self.studioBgmBaseVolume)
			return
		end

		if currentMapName == self.downtownMapName then
			self:ReplaceBGMImmediately(self.downtownBgmRuid, self.downtownBgmBaseVolume)
			return
		end

		if self.isBgmPlaying == true and self.currentBgmRuid == self.weeklyScheduleBgmRuid then
			self:StopBGM(0)
		end
	end

	@ExecSpace("ClientOnly")
	method void BeginDialogBGM(string ruid, number baseVolume)
		-- 현재 BGM 상태를 보관하고 대화 세션 동안 사용할 BGM으로 교체합니다.
		if ruid == nil or ruid == "" then
			self:EndDialogBGM()
			return
		end

		local safeBaseVolume = self:NormalizeBaseVolume(baseVolume)
		if self.isDialogBgmActive == true then
			if self.currentDialogBgmRuid == ruid and self.currentBgmRuid == ruid then
				self:SetBgmBaseVolume(safeBaseVolume)
				return
			end

			self.currentDialogBgmRuid = ruid
			self:ReplaceBGMImmediately(ruid, safeBaseVolume)
			return
		end

		self.isDialogBgmActive = true
		self.bgmBeforeDialogRuid = self.currentBgmRuid
		self.bgmBeforeDialogBaseVolume = self.currentBgmBaseVolume
		self.wasBgmPlayingBeforeDialog = self.isBgmPlaying
		self.mapNameBeforeDialog = self:GetCurrentMapName()
		self.currentDialogBgmRuid = ruid
		self:ReplaceBGMImmediately(ruid, safeBaseVolume)
	end

	@ExecSpace("ClientOnly")
	method void EndDialogBGM()
		-- 대화 세션 전 BGM을 복원하고 맵이 바뀌었다면 현재 맵에 지정된 BGM을 적용합니다.
		if self.isDialogBgmActive == false then
			return
		end

		local previousRuid = self.bgmBeforeDialogRuid
		local previousBaseVolume = self.bgmBeforeDialogBaseVolume
		local wasPlaying = self.wasBgmPlayingBeforeDialog
		local openedMapName = self.mapNameBeforeDialog
		local dialogBgmRuid = self.currentDialogBgmRuid
		local currentMapName = self:GetCurrentMapName()
		local isDialogBgmStillPlaying = self.isBgmPlaying == true and self.currentBgmRuid == dialogBgmRuid

		self.isDialogBgmActive = false
		self.bgmBeforeDialogRuid = ""
		self.bgmBeforeDialogBaseVolume = 1
		self.wasBgmPlayingBeforeDialog = false
		self.mapNameBeforeDialog = ""
		self.currentDialogBgmRuid = ""

		if currentMapName == openedMapName and wasPlaying == true and previousRuid ~= "" then
			self:ReplaceBGMImmediately(previousRuid, previousBaseVolume)
			return
		end

		if currentMapName == self.studioMapName then
			self:ReplaceBGMImmediately(self.studioBgmRuid, self.studioBgmBaseVolume)
			return
		end

		if currentMapName == self.downtownMapName then
			self:ReplaceBGMImmediately(self.downtownBgmRuid, self.downtownBgmBaseVolume)
			return
		end

		if isDialogBgmStillPlaying == true then
			self:StopBGM(0)
		end
	end

	@ExecSpace("ClientOnly")
	method string GetCurrentMapName()
		-- 로컬 플레이어가 현재 위치한 맵 이름을 반환합니다.
		local player = _UserService.LocalPlayer
		if player == nil or isvalid(player.CurrentMap) == false then
			return ""
		end
		return player.CurrentMap.Name or ""
	end

	@ExecSpace("ServerOnly")
	method void OnUserEnter(UserEnterEvent event)
		-- 유저가 입장하면 사운드 설정을 서버 캐시에 로드하고 클라이언트에 동기화합니다.
		if event == nil or event.UserId == nil or event.UserId == "" then
			return
		end

		self:LoadSoundSettingsFromStorage(event.UserId)
		self:PushSoundSettingsToClient(event.UserId)
	end

	@ExecSpace("ServerOnly")
	method void LoadSoundSettingsFromStorage(string userId)
		-- SoundStorage에서 불러온 값을 서버 권위 사운드 설정 캐시에 반영합니다.
		self.currentSoundUserId = userId
		self.isSoundSettingsLoaded = false

		if _SoundStorage == nil then
			log_warning("[SoundManager] SoundStorage is nil")
			return
		end

		local tSettings = _SoundStorage:LoadSoundSettings(userId)
		if tSettings == nil then
			return
		end

		self.serverMasterVolume = self:NormalizeRequestedVolume(tSettings.masterVolume)
		self.serverBackgroundVolume = self:NormalizeRequestedVolume(tSettings.backgroundVolume)
		self.serverEffectVolume = self:NormalizeRequestedVolume(tSettings.effectVolume)
		self.isSoundSettingsLoaded = true
	end

	@ExecSpace("Server")
	method void RequestSaveSoundSettings(number requestedMasterVolume, number requestedBackgroundVolume, number requestedEffectVolume)
		-- 설정 패널을 닫은 클라이언트의 최신 사운드 설정을 서버 저장 메서드로 전달합니다.
		self:SaveSoundSettingsToStorage(
			senderUserId,
			requestedMasterVolume,
			requestedBackgroundVolume,
			requestedEffectVolume)
	end

	@ExecSpace("ServerOnly")
	method boolean SaveSoundSettingsToStorage(string userId, number requestedMasterVolume, number requestedBackgroundVolume, number requestedEffectVolume)
		-- 설정 닫기와 진행도 초기화에서 전달된 최신 사운드 설정을 검증하고 명시적으로 저장합니다.
		if userId == nil or userId == "" or userId ~= self.currentSoundUserId then
			return false
		end

		if self.isSoundSettingsLoaded == false or _SoundStorage == nil then
			log_warning("[SoundManager] sound settings save skipped because settings are not loaded")
			return false
		end

		self.serverMasterVolume = self:NormalizeRequestedVolume(requestedMasterVolume)
		self.serverBackgroundVolume = self:NormalizeRequestedVolume(requestedBackgroundVolume)
		self.serverEffectVolume = self:NormalizeRequestedVolume(requestedEffectVolume)
		_SoundStorage:SaveSoundSettingsAsync(
			userId,
			self.serverMasterVolume,
			self.serverBackgroundVolume,
			self.serverEffectVolume)
		return true
	end

	@ExecSpace("ServerOnly")
	method void PushSoundSettingsToClient(string forUserId)
		-- 서버 권위 사운드 설정을 지정한 클라이언트의 SoundManager와 설정 UI에 전달합니다.
		if forUserId == nil or forUserId == "" or self.isSoundSettingsLoaded == false then
			return
		end

		self:SyncSoundSettings(
			self.serverMasterVolume,
			self.serverBackgroundVolume,
			self.serverEffectVolume,
			forUserId)
	end

	@ExecSpace("Client")
	method void SyncSoundSettings(number loadedMasterVolume, number loadedBackgroundVolume, number loadedEffectVolume)
		-- 서버에서 받은 사운드 설정을 클라이언트 재생값과 메인 타이틀 설정 UI에 반영합니다.
		self.hasLoadedSoundSettings = true
		self:SetMasterVolume(loadedMasterVolume)
		self:SetBackgroundVolume(loadedBackgroundVolume)
		self:SetEffectVolume(loadedEffectVolume)

		if _MainTitleUILogic ~= nil then
			_MainTitleUILogic:ApplyLoadedSoundSettings(
				self.masterVolume,
				self.backgroundVolume,
				self.effectVolume)
		end
	end

	@ExecSpace("ServerOnly")
	method number NormalizeRequestedVolume(any value)
		-- 서버에 전달된 볼륨 값을 숫자로 변환하고 0~1 범위로 제한합니다.
		local numberValue = tonumber(value)
		if numberValue == nil then
			return 1
		end

		return math.max(0, math.min(1, numberValue))
	end

	@ExecSpace("ClientOnly")
	method void PlayBGM(string ruid, number baseVolume)
		-- BGM을 (작곡 볼륨 × 마스터 × 배경음) 볼륨으로 재생하고 현재 BGM 상태를 기억합니다.
		if ruid == nil or ruid == "" then
			log_warning("[SoundManager] PlayBGM ruid is empty")
			return
		end

		self:CancelBgmFadeOut()
		self.bgmFadeOutMultiplier = 1
		self.currentBgmRuid = ruid
		self.currentBgmBaseVolume = self:NormalizeBaseVolume(baseVolume)
		self.isBgmPlaying = true

		_SoundService:PlayBGM(ruid, self:GetEffectiveBgmVolume())
	end

	@ExecSpace("ClientOnly")
	method void ReplaceBGMImmediately(string ruid, number baseVolume)
		-- 현재 BGM을 네이티브 즉시 정지한 뒤 지정한 BGM을 새로 재생합니다.
		self:StopBGM(0)
		self:PlayBGM(ruid, baseVolume)
	end

	@ExecSpace("ClientOnly")
	method void StopBGM(number fadeOutDuration)
		-- 0 이하면 즉시 종료하고, 양수면 현재 볼륨에서 0까지 직접 보간한 뒤 종료합니다.
		self:CancelBgmFadeOut()
		if self.isBgmPlaying == false then
			self:ResetBgmState()
			return
		end

		local safeDuration = math.max(fadeOutDuration or 0, 0)
		if safeDuration <= 0 then
			self:FinalizeBgmStop()
			return
		end

		local startMultiplier = self.bgmFadeOutMultiplier
		local elapsed = 0
		local previousTime = _UtilLogic.ElapsedSeconds
		self.bgmFadeOutTimerId = _TimerService:SetTimerRepeat(function()
			local now = _UtilLogic.ElapsedSeconds
			elapsed = elapsed + math.max(now - previousTime, 0)
			previousTime = now

			local progress = math.min(elapsed / safeDuration, 1)
			self.bgmFadeOutMultiplier = startMultiplier * (1 - progress)
			self:ApplyBgmVolume()
			if progress >= 1 then
				self:FinalizeBgmStop()
			end
		end, 1 / 60)
	end

	@ExecSpace("ClientOnly")
	method void CancelBgmFadeOut()
		-- 진행 중인 BGM 페이드 타이머만 취소하며 현재 볼륨 배율은 유지합니다.
		if self.bgmFadeOutTimerId > 0 then
			_TimerService:ClearTimer(self.bgmFadeOutTimerId)
			self.bgmFadeOutTimerId = 0
		end
	end

	@ExecSpace("ClientOnly")
	method void FinalizeBgmStop()
		-- 직접 보간이 끝난 BGM을 네이티브 즉시 종료로 확실하게 정리합니다.
		self:CancelBgmFadeOut()
		_SoundService:StopBGM(true)
		self:ResetBgmState()
	end

	@ExecSpace("ClientOnly")
	method void ResetBgmState()
		-- 다음 BGM 재생에 페이드 상태가 남지 않도록 런타임 상태를 초기화합니다.
		self.currentBgmRuid = ""
		self.currentBgmBaseVolume = 1
		self.isBgmPlaying = false
		self.bgmFadeOutMultiplier = 1
	end

	@ExecSpace("ClientOnly")
	method void PlaySfx(string ruid, number baseVolume)
		-- 효과음을 (작곡 볼륨 × 마스터 × 효과음) 볼륨으로 단발 재생합니다.
		if ruid == nil or ruid == "" then
			log_warning("[SoundManager] PlaySfx ruid is empty")
			return
		end

		local base = self:NormalizeBaseVolume(baseVolume)
		_SoundService:PlaySound(ruid, base * self.masterVolume * self.effectVolume)
	end

	@ExecSpace("ClientOnly")
	method void PlayLoopSfx(string ruid, number baseVolume)
		-- 효과음을 (작곡 볼륨 × 마스터 × 효과음) 볼륨으로 반복 재생. 중지는 StopSfx(ruid)
		if ruid == nil or ruid == "" then
			log_warning("[SoundManager] PlayLoopSfx ruid is empty")
			return
		end

		local base = self:NormalizeBaseVolume(baseVolume)
		_SoundService:PlayLoopSound(ruid, base * self.masterVolume * self.effectVolume)
	end

	@ExecSpace("ClientOnly")
	method void StopSfx(string ruid)
		-- 재생 중인 효과음(반복 포함)을 즉시 중지
		if ruid == nil or ruid == "" then
			return
		end

		_SoundService:StopSound(ruid)
	end

	@ExecSpace("ClientOnly")
	method void PlayDefaultButtonClickSfx()
		-- 일반 UI 버튼에 공통으로 사용하는 클릭 효과음을 재생합니다.
		self:PlaySfx(self.defaultButtonClickSfxRuid, self.defaultButtonClickSfxVolume)
	end

	@ExecSpace("ClientOnly")
	method void PlayScheduleActivitySuccessSfx()
		-- 주간 스케줄 활동 성공 결과가 표시될 때 전용 효과음을 재생합니다.
		self:PlaySfx(self.scheduleActivitySuccessSfxRuid, self.scheduleActivitySuccessSfxVolume)
	end

	@ExecSpace("ClientOnly")
	method void PlayScheduleActivityFailSfx()
		-- 주간 스케줄 활동 실패 결과가 표시될 때 전용 효과음을 재생합니다.
		self:PlaySfx(self.scheduleActivityFailSfxRuid, self.scheduleActivityFailSfxVolume)
	end

	@ExecSpace("ClientOnly")
	method void SetBgmBaseVolume(number baseVolume)
		-- 현재 BGM의 작곡 볼륨(공연 큐 등에서 지정)을 갱신하고 즉시 재적용합니다.
		self.currentBgmBaseVolume = self:NormalizeBaseVolume(baseVolume)
		self:ApplyBgmVolume()
	end

	@ExecSpace("ClientOnly")
	method void SetMasterVolume(number volume)
		-- 마스터 볼륨(0~1)을 설정하고 재생 중인 BGM에 즉시 반영합니다. 효과음은 다음 재생부터 적용됩니다.
		self.masterVolume = self:Clamp01(volume)
		self:ApplyBgmVolume()
	end

	@ExecSpace("ClientOnly")
	method void SetBackgroundVolume(number volume)
		-- 배경음 볼륨(0~1)을 설정하고 재생 중인 BGM에 즉시 반영합니다.
		self.backgroundVolume = self:Clamp01(volume)
		self:ApplyBgmVolume()
	end

	@ExecSpace("ClientOnly")
	method void SetEffectVolume(number volume)
		-- 효과음 볼륨(0~1)을 설정합니다. 단발성이라 다음 재생부터 적용됩니다.
		self.effectVolume = self:Clamp01(volume)
	end

	@ExecSpace("ClientOnly")
	method number GetMasterVolume()
		-- 현재 마스터 볼륨(0~1)을 반환합니다.
		return self.masterVolume
	end

	@ExecSpace("ClientOnly")
	method number GetBackgroundVolume()
		-- 현재 배경음 볼륨(0~1)을 반환합니다.
		return self.backgroundVolume
	end

	@ExecSpace("ClientOnly")
	method number GetEffectVolume()
		-- 현재 효과음 볼륨(0~1)을 반환합니다.
		return self.effectVolume
	end

	@ExecSpace("ClientOnly")
	method boolean ClientHasLoadedSoundSettings()
		-- 서버에서 사운드 설정을 한 번 이상 동기화받았는지 반환합니다.
		return self.hasLoadedSoundSettings
	end

	@ExecSpace("ClientOnly")
	method number GetEffectiveBgmVolume()
		-- 작곡·유저 설정 볼륨과 현재 페이드 배율을 곱해 최종 BGM 볼륨을 계산합니다.
		return self.currentBgmBaseVolume * self.masterVolume * self.backgroundVolume * self.bgmFadeOutMultiplier
	end

	@ExecSpace("ClientOnly")
	method void ApplyBgmVolume()
		-- 재생 중인 BGM이 있으면 현재 볼륨 설정을 즉시 반영합니다.
		if self.isBgmPlaying == false then
			return
		end

		_SoundService:SetBGMVolume(self:GetEffectiveBgmVolume())
	end

	@ExecSpace("ClientOnly")
	method number NormalizeBaseVolume(number baseVolume)
		-- 작곡 볼륨 인자가 없거나 음수면 안전한 값으로 보정합니다.(상한은 두지 않아 엔진 부스트 여지를 남김)
		if baseVolume == nil then
			return 1
		end

		if baseVolume < 0 then
			return 0
		end

		return baseVolume
	end

	@ExecSpace("ClientOnly")
	method number Clamp01(number value)
		-- 값을 0~1 범위로 제한합니다.
		if value == nil then
			return 0
		end

		if value < 0 then
			return 0
		end

		if value > 1 then
			return 1
		end

		return value
	end

end

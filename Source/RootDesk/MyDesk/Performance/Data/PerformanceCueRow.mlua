---@description "PerformanceCueTable의 row 구조체"
@Struct
script PerformanceCueRow

	-- 소속 공연 식별자
	property string performanceId = ""

	-- 실행 시점(초)
	property number time = 0

	-- 지속시간(초), 단발성 큐는 0
	property number duration = 0

	-- 트랙(조직용 라벨: camera / charA / charB / charC / ui / minigame / sfx / bgm)
	property string track = ""

	-- 큐 타입 (EPerformanceCueType 값)
	property integer cueType = 0

	-- 대상 식별자 (캐릭터 id / 카메라 엔티티 이름 / miniGameId / UI 프리셋 키 등)
	property string targetId = ""

	-- 문자열 파라미터 (자막 텍스트 / 애니메이션 상태 키 / 사운드 id 등)
	property string stringParam = ""

	-- 숫자 파라미터 1
	property number num1 = 0

	-- 숫자 파라미터 2
	property number num2 = 0

	-- 숫자 파라미터 3
	property number num3 = 0

end

---@description "공연 UI 오버레이(오타게 응원/원형 버스트) 표시·숨김과 비네트(카메라 스크린 머티리얼) 적용을 담당하는 클라이언트 로직."
@Logic
script PerformanceEffectLogic extends Logic

	-- 오타게 응원 오버레이 루트 (ui/PerformanceEffectUI/Otage)
	property Entity otageRoot = "862a9fe5-099f-4ccf-8148-ecf8096d9290"
	-- 비네팅(중앙 강조): UI 오버레이가 아니라 카메라 Screen/Vignette 머티리얼(포스트프로세스)로 처리
	-- Maker에서 Shader > Screen > Vignette 로 만든 머티리얼의 이름
	property string vignetteMaterialName = "M_Vignette"
	-- 캐시된 비네트 머티리얼 EntryId
	@HideFromInspector
	property string vignetteMatId = ""
	-- 적용 이전 카메라 머티리얼(복구용)
	@HideFromInspector
	property string savedCamMatId = ""

	-- 원형 버스트 오버레이 루트 (EffectCircleBurst)
	property Entity circleBurstRoot = "75739227-16cf-45d7-ab7c-53812b68d728"

	-- 불꽃 오버레이 루트 (EffectFirework)
	property Entity fireworkRoot = "b7dffe6a-0abb-41e3-b8b7-5cfad7601eb6"

	-- 스포트라이트 오버레이 루트 (EffectSpotlight)
	property Entity spotlightRoot = "199cf93d-0b3c-48dd-87ff-a498e8b61d9e"

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 시작 시 모든 오버레이를 숨긴 상태로 초기화
		self:HideAll()
	end

	@ExecSpace("ClientOnly")
	method void ShowPreset(integer preset)
		-- 비네팅은 UI 오버레이가 아니라 카메라 스크린 머티리얼(포스트프로세스)로 처리
		if preset == _EPerformanceUIPreset.Vignetting then
			self:ApplyCameraVignette()
			return
		end
		-- 그 외 프리셋은 해당 오버레이 루트를 켜서 표시 (파티클은 play_on_enable로 자동 재생)
		local root = self:GetRoot(preset)
		if isvalid(root) == false then
			log_warning("[PerformanceEffect] 알 수 없는 프리셋 또는 루트 없음 preset=" .. _EPerformanceUIPreset:ToKey(preset))
			return
		end
		-- Conductor가 오타게 응원을 켤 때는 상시 흔들림(autoSway)을 사용한다.
		if preset == _EPerformanceUIPreset.Otage then
			self:SetLightStickAutoSway(true)
		end
		root.Enable = true
	end

	@ExecSpace("ClientOnly")
	method void HidePreset(integer preset)
		-- 비네팅은 카메라 머티리얼 복구
		if preset == _EPerformanceUIPreset.Vignetting then
			self:ClearCameraMaterial()
			return
		end
		-- 그 외 프리셋은 해당 오버레이 루트를 꺼서 숨김
		local root = self:GetRoot(preset)
		if isvalid(root) == false then
			return
		end
		root.Enable = false
	end

	@ExecSpace("ClientOnly")
	method void SetLightStickAutoSway(boolean on)
		-- 오타게 오버레이 LightStick의 상시 흔들림(autoSway)을 켜고 끈다.
		if isvalid(self.otageRoot) == false then
			return
		end
		local sway = self.otageRoot.LightStickSwayComponent
		if isvalid(sway) then
			sway.autoSway = on
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowOtageForCommand()
		-- 커맨드/연타 미니게임이 오타게 오버레이를 켤 때: 상시 좌우 흔들림을 켠 채로 표시한다(입력마다 SwayOnce 팝은 별도로 추가됨).
		-- 켤 때 false로 두면 상시 흔들림이 공연 지휘자의 Otage 큐 전까지 적용되지 않아 "몇 초 뒤에 시작"되는 문제가 생긴다.
		self:SetLightStickAutoSway(true)
		if isvalid(self.otageRoot) then
			self.otageRoot.Enable = true
		end
	end

	@ExecSpace("ClientOnly")
	method void HideOtageForCommand()
		-- 커맨드 미니게임 종료 시 오타게 오버레이를 끄고 상시 흔들림 기본값(true)을 복구한다.
		if isvalid(self.otageRoot) then
			self.otageRoot.Enable = false
		end
		self:SetLightStickAutoSway(true)
	end

	@ExecSpace("ClientOnly")
	method void SwayLightStickOnce()
		-- 오타게 응원 오버레이의 응원봉(LightStick)을 1회 흔든다. (커맨드 정답 등 트리거용)
		-- 효과가 보이려면 오타게 오버레이(otageRoot)가 켜져 있어야 한다.
		if isvalid(self.otageRoot) == false then
			return
		end
		local sway = self.otageRoot.LightStickSwayComponent
		if isvalid(sway) then
			sway:SwayOnce()
		end
	end

	@ExecSpace("ClientOnly")
	method void SwayLightStickDirection(string direction)
		-- 오타게 응원봉을 지정 방향(Up/Down/Left/Right)으로 1회 흔든다. (커맨드 상하좌우 입력 트리거용)
		-- 방향이 비었거나 알 수 없으면 위로 팝으로 처리된다. 효과가 보이려면 오타게 오버레이가 켜져 있어야 한다.
		if isvalid(self.otageRoot) == false then
			return
		end
		local sway = self.otageRoot.LightStickSwayComponent
		if isvalid(sway) then
			sway:SwayDirection(direction)
		end
	end

	@ExecSpace("ClientOnly")
	method void HideAll()
		-- 모든 오버레이 루트를 숨기고 비네트 카메라 머티리얼도 복구 (공연 종료·초기화 시)
		if isvalid(self.otageRoot) then self.otageRoot.Enable = false end
		if isvalid(self.circleBurstRoot) then self.circleBurstRoot.Enable = false end
		if isvalid(self.fireworkRoot) then self.fireworkRoot.Enable = false end
		if isvalid(self.spotlightRoot) then self.spotlightRoot.Enable = false end
		self:ClearCameraMaterial()
	end

	@ExecSpace("ClientOnly")
	method void ApplyCameraVignette()
		-- 현재 활성 카메라에 Vignette 스크린 머티리얼을 적용 (풀스크린 포스트프로세스 = 중앙 강조)
		if self.vignetteMatId == "" then
			local id = _EntryService:GetMaterialIdByName(self.vignetteMaterialName)
			if id ~= nil then
				self.vignetteMatId = id
			end
		end
		if self.vignetteMatId == "" then
			log_warning("[PerformanceEffect] Vignette 머티리얼을 찾을 수 없음 name=" .. self.vignetteMaterialName ..
				" — Maker에서 Shader>Screen>Vignette 머티리얼을 이 이름으로 만들어 주세요")
			return
		end

		local cam = _CameraService:GetCurrentCameraComponent()
		if isvalid(cam) == false then
			return
		end
		-- 복구를 위해 현재 머티리얼을 저장한 뒤 비네트로 교체
		self.savedCamMatId = cam.MaterialId
		cam:ChangeMaterial(self.vignetteMatId)
	end

	@ExecSpace("ClientOnly")
	method void ClearCameraMaterial()
		-- 카메라 머티리얼을 적용 이전 상태로 복구
		local cam = _CameraService:GetCurrentCameraComponent()
		if isvalid(cam) == false then
			return
		end
		cam:ChangeMaterial(self.savedCamMatId)
	end

	method any GetRoot(integer preset)
		-- 프리셋 → 오버레이 루트 엔티티 매핑 (Vignetting은 카메라 머티리얼이라 여기 없음)
		if preset == _EPerformanceUIPreset.Otage then return self.otageRoot end
		if preset == _EPerformanceUIPreset.CircleBurst then return self.circleBurstRoot end
		if preset == _EPerformanceUIPreset.Firework then return self.fireworkRoot end
		if preset == _EPerformanceUIPreset.Spotlight then return self.spotlightRoot end
		return nil
	end

end

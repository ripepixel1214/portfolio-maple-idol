@Logic
script UIDebugLogic extends Logic

	property any keyDownHandler = nil

	property boolean isSpeedBoostEnabled = false

	property boolean hasSavedInputSpeed = false

	property number savedInputSpeed = 0

	property number debugSpeedMultiplier = 5

	property string debugTestChoiceEventId = "event_TestChoice"

	property string debugDialogId = "episode_cryingChild_IdolDream"

	property integer debugDailyDialogIndex = 1

	property string debugTestChoiceCharacterId = ""

	property string debugDowntownEventCharacterId = ""

	property integer debugDowntownEventDayProgress = 3

	property number debugDowntownEventRequiredFatigue = 100

	property boolean debugDowntownEventForceChance = true

	property string debugIntimacyCharacterId = "character_lucid"

	property number debugIntimacyDelta = 10

	property string debugUnlockCharacterId = "character_orca"

	property integer debugInitialActionPoint = 50

	property integer debugActionPointDelta = 10

	property integer debugInitialActionPointTimerId = 0

	method void OnBeginPlay()
		-- 테스트용 키 입력 이벤트를 연결합니다.
		if self:IsClient() == true then
			self.keyDownHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnKeyDown)
		end
	end

	method void OnEndPlay()
		-- 테스트용 키 입력 이벤트 연결을 해제합니다.
		self:ClearDebugInitialActionPointTimer()

		if self.keyDownHandler ~= nil then
			_InputService:DisconnectEvent(KeyDownEvent, self.keyDownHandler)
		end

		self.keyDownHandler = nil
	end

	@ExecSpace("ClientOnly")
	method void OnKeyDown(KeyDownEvent event)
		-- 테스트용 키 입력을 처리합니다.
		if true then
			return
		end

		if event.key == KeyboardKey.R then
			self:OpenDebugDialog()
		end

		if event.key == KeyboardKey.Alpha5 then
			self:SelectDebugDailyDialog(-1)
		end

		if event.key == KeyboardKey.Alpha6 then
			self:SelectDebugDailyDialog(1)
		end

		if event.key == KeyboardKey.O then
			self:StartDebugWeeklyPresentation(1)
		end

		if event.key == KeyboardKey.P then
			self:StartDebugWeeklyPresentation(2)
		end

		if event.key == KeyboardKey.Alpha1 then
			_ItemManager:RequestUnlockItem("photoCard_lucid_lv3")
		end

		if event.key == KeyboardKey.Alpha7 then
			self:RequestDebugUnlockCharacter()
		end

		if event.key == KeyboardKey.Alpha8 then
			self:RequestDebugIntimacy()
		end

		if event.key == KeyboardKey.Alpha9 then
			self:RequestDebugActionPointDelta(-self.debugActionPointDelta)
		end

		if event.key == KeyboardKey.Alpha0 then
			self:RequestDebugActionPointDelta(self.debugActionPointDelta)
		end
	end

	@ExecSpace("ClientOnly")
	method void OpenDebugDialog()
		-- R 키로 현재 디버그 대화를 엽니다. daily 대화 선택값이 유효하면 그쪽을 우선합니다.
		local dialogId = self.debugDialogId

		if _DialogUILogic == nil then
			log_warning("[UIDebugLogic] DialogUILogic is nil")
			return
		end

		-- 디버그 대화도 단일 옵션 기반 Open API를 사용합니다.
		local options = DialogOpenOptions()
		options.dialogId = dialogId or ""
		_DialogUILogic:Open(options)
		log("[UIDebugLogic] open debug dialogId=" .. tostring(dialogId))
	end

	@ExecSpace("ClientOnly")
	method void SelectDebugDailyDialog(integer delta)
		-- 5/6 키로 daily 디버그 대화 선택을 이전/다음으로 넘깁니다.
		local count = self:GetDebugDailyDialogCount()
		if count <= 0 then
			return
		end

		self.debugDailyDialogIndex = self.debugDailyDialogIndex + delta
		if self.debugDailyDialogIndex < 1 then
			self.debugDailyDialogIndex = count
		elseif self.debugDailyDialogIndex > count then
			self.debugDailyDialogIndex = 1
		end
	end

	@ExecSpace("ClientOnly")
	method integer GetDebugDailyDialogCount()
		return 12
	end

	@ExecSpace("ClientOnly")
	method string GetSelectedDebugDailyDialogKey()
		return self:GetDebugDailyDialogKey(self.debugDailyDialogIndex)
	end

	@ExecSpace("ClientOnly")
	method string GetSelectedDebugDailyDialogId()
		return self:GetDebugDailyDialogId(self.debugDailyDialogIndex)
	end

	@ExecSpace("ClientOnly")
	method string GetDebugDailyDialogKey(integer index)
		if index == 1 then
			return "episode_lucid_dessert"
		elseif index == 2 then
			return "daily_kingSinger"
		elseif index == 3 then
			return "daily_bossboysFan"
		elseif index == 4 then
			return "daily_chestnut"
		elseif index == 5 then
			return "daily_rockSpiritGirl"
		elseif index == 6 then
			return "daily_jm"
		elseif index == 7 then
			return "daily_busyMan"
		elseif index == 8 then
			return "daily_coolMan"
		elseif index == 9 then
			return "daily_clothesPartTime"
		elseif index == 10 then
			return "daily_cafePartTime"
		elseif index == 11 then
			return "daily_juiceBoss"
		elseif index == 12 then
			return "daily_foodStall"
		end

		return ""
	end

	@ExecSpace("ClientOnly")
	method string GetDebugDailyDialogId(integer index)
		if index == 1 then
			return "episode_lucid_dessert"
		elseif index == 2 then
			return "daily_dia"
		elseif index == 3 then
			return "daily_nemoroid"
		elseif index == 4 then
			return "daily_baker"
		elseif index == 5 then
			return "daily_highGirl"
		elseif index == 6 then
			return "daily_jm"
		elseif index == 7 then
			return "daily_busyMan"
		elseif index == 8 then
			return "daily_coolMan"
		elseif index == 9 then
			return "daily_clothesPartTime"
		elseif index == 10 then
			return "daily_cafePartTime"
		elseif index == 11 then
			return "daily_juiceBoss"
		elseif index == 12 then
			return "daily_foodStall"
		end

		return ""
	end

	@ExecSpace("ClientOnly")
	method void ClearDebugInitialActionPointTimer()
		-- 디버그 시작 액션 포인트 세팅 타이머를 정리합니다.
		if self.debugInitialActionPointTimerId > 0 and _TimerService ~= nil then
			_TimerService:ClearTimer(self.debugInitialActionPointTimerId)
		end

		self.debugInitialActionPointTimerId = 0
	end

	@ExecSpace("ClientOnly")
	method void RequestDebugSetActionPoint(integer actionPoint)
		-- 디버그 시작 액션 포인트 값을 서버 진행도 캐시에 요청합니다.
		if _ProgressManager == nil then
			log_warning("[UIDebugLogic] ProgressManager is nil")
			return
		end

		_ProgressManager:RequestSetActionPoint(actionPoint)
		log("[UIDebugLogic] request actionPoint set=" .. tostring(actionPoint))
	end

	@ExecSpace("ClientOnly")
	method void RequestDebugActionPointDelta(integer amount)
		-- 디버그 키 입력으로 액션 포인트 델타를 서버 진행도 캐시에 요청합니다.
		if _ProgressManager == nil then
			log_warning("[UIDebugLogic] ProgressManager is nil")
			return
		end

		_ProgressManager:RequestAddActionPoint(amount)
		log("[UIDebugLogic] request actionPoint delta=" .. tostring(amount))
	end

	@ExecSpace("ClientOnly")
	method void RequestDebugIntimacy()
		-- 디버그 키 8 입력으로 루시드의 친밀도 경험치를 증가시키도록 서버에 요청합니다.
		if _CharacterManager == nil then
			log_warning("[UIDebugLogic] CharacterManager is nil")
			return
		end

		local tDelta = {}
		tDelta.characterId = self.debugIntimacyCharacterId
		tDelta.vocal = 0
		tDelta.dance = 0
		tDelta.visual = 0
		tDelta.fatigue = 0
		tDelta.intimacy = self.debugIntimacyDelta

		_CharacterManager:RequestApplyCharacterStat(tDelta)
		log("[UIDebugLogic] request intimacy +" .. tostring(self.debugIntimacyDelta) .. " characterId=" .. tostring(self.debugIntimacyCharacterId))
	end

	@ExecSpace("ClientOnly")
	method void RequestDebugUnlockCharacter()
		-- 디버그 키 입력으로 지정한 캐릭터 해금을 서버에 요청합니다.
		if _CharacterManager == nil then
			log_warning("[UIDebugLogic] CharacterManager is nil")
			return
		end

		_CharacterManager:RequestUnlockCharacter(self.debugUnlockCharacterId)
		log("[UIDebugLogic] request unlock characterId=" .. tostring(self.debugUnlockCharacterId))
	end

	@ExecSpace("ClientOnly")
	method void StartDebugWeeklyPresentation(integer index)
		-- 디버그 키 입력으로 고정된 5일 주간 활동 진행 UI를 시작합니다.
		if _WeeklySequenceScheduler == nil then
			log_warning("[UIDebugLogic] WeeklySequenceScheduler is nil")
			return
		end

		if index == 1 then
			_WeeklySequenceScheduler:StartWeeklySequence(self:BuildDebugWeeklyPlan())
		elseif index == 2 then
			_WeeklySequenceScheduler:StartWeeklySequence(self:BuildDebugWeeklyPlan2())
		end
	end

	@ExecSpace("ClientOnly")
	method table BuildDebugWeeklyPlan()
		-- 리린/루시드/시그너스 테스트 편성 데이터를 만듭니다.
		local weeklyPlan = {}

		weeklyPlan[1] = self:CreateDebugWeeklyPlanSlot("character_lilin", "training_basic_dance")
		weeklyPlan[2] = self:CreateDebugWeeklyPlanSlot("character_lucid", "training_basic_vocal")
		weeklyPlan[3] = self:CreateDebugWeeklyPlanSlot("character_cygnus", "training_basic_visual")
		weeklyPlan[4] = self:CreateDebugWeeklyPlanSlot("character_lilin", "training_middle_dance")
		weeklyPlan[5] = self:CreateDebugWeeklyPlanSlot("character_lucid", "performance_mlive")

		return weeklyPlan
	end

	@ExecSpace("ClientOnly")
	method table BuildDebugWeeklyPlan2()
		-- 리린/루시드/시그너스 테스트 편성 데이터를 만듭니다.
		local weeklyPlan = {}

		weeklyPlan[1] = self:CreateDebugWeeklyPlanSlot("character_lilin", "performance_busking")
		weeklyPlan[2] = self:CreateDebugWeeklyPlanSlot("character_lucid", "performance_concert")
		weeklyPlan[3] = self:CreateDebugWeeklyPlanSlot("character_cygnus", "rest_dessert")
		weeklyPlan[4] = self:CreateDebugWeeklyPlanSlot("character_lilin", "rest_nap")
		weeklyPlan[5] = self:CreateDebugWeeklyPlanSlot("character_lucid", "rest_parkWalk")

		return weeklyPlan
	end

	@ExecSpace("ClientOnly")
	method WeeklyPlanData CreateDebugWeeklyPlanSlot(string characterId, string activityId)
		-- 주간 활동 진행 UI에 넘길 하루치 테스트 슬롯을 만듭니다.
		local slot = WeeklyPlanData()
		slot.characterId = characterId
		slot.activityId = activityId
		return slot
	end

end

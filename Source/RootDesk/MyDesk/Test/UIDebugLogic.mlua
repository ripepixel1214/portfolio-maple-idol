@Logic
script UIDebugLogic extends Logic

	property any keyDownHandler = nil

	property boolean isSpeedBoostEnabled = false

	property boolean hasSavedInputSpeed = false

	property number savedInputSpeed = 0

	property number debugSpeedMultiplier = 5

	property string debugTestChoiceEventId = "event_TestChoice"

	property string debugDialogId = "episode_cryingChild_IdolDream"

	property integer debugDailyDialogIndex = 1

	property string debugTestChoiceCharacterId = ""

	property string debugDowntownEventCharacterId = ""

	property integer debugDowntownEventDayProgress = 3

	property number debugDowntownEventRequiredFatigue = 100

	property boolean debugDowntownEventForceChance = true

	property string debugIntimacyCharacterId = "character_lucid"

	property integer debugIntimacyDelta = 50

	property integer debugMesoDelta = 1000

	property string debugUnlockCharacterId = "character_orca"

	property integer debugInitialActionPoint = 50

	property integer debugActionPointDelta = 10

	property integer debugInitialActionPointTimerId = 0

	------------------------------------------------------------------------------------------------------------------------------------------------------
	-- Event
	------------------------------------------------------------------------------------------------------------------------------------------------------

	-- Public API

	@ExecSpace("ClientOnly")
	method void OnKeyDown(KeyDownEvent event)
		-- 기존 미니게임 키와 겹치지 않게 메이커 디버그 입력을 Ctrl+숫자로 처리합니다.
		if Environment:IsMakerPlay() == false or event == nil then return end
		if _InputService:IsKeyPressed(KeyboardKey.LeftControl) == false and _InputService:IsKeyPressed(KeyboardKey.RightControl) == false then return end

		if event.key == KeyboardKey.Alpha1 then
			self:RequestGrantDebugMeso()
		elseif event.key == KeyboardKey.Alpha2 then
			self:RequestDebugIntimacy()
		elseif event.key == KeyboardKey.Alpha3 then
			self:SelectDebugCharacter(-1)
		elseif event.key == KeyboardKey.Alpha4 then
			self:SelectDebugCharacter(1)
		elseif event.key == KeyboardKey.Alpha5 then
			self:RequestToggleDebugUnlockAllCharacters()
		elseif event.key == KeyboardKey.Alpha8 then
			self:ShowCurrentDebugCharacter()
		end
	end

	@ExecSpace("Client")
	method void ShowDebugMessage(string message, string characterId)
		-- 디버그 키의 적용 결과와 현재 대상을 로그 대신 화면에 표시합니다.
		if Environment:IsMakerPlay() == false then return end
		if characterId ~= "" then message = _RuntimeActorManager:ClientGetLocalizedActorName(characterId) .. " · " .. message end
		_UIToast:ShowMessage(message)
	end

	------------------------------------------------------------------------------------------------------------------------------------------------------
	-- Debug
	------------------------------------------------------------------------------------------------------------------------------------------------------

	@ExecSpace("Server")
	method void RequestGrantDebugMeso()
		-- 메이커 테스트 유저에게 고정 메소를 지급하고 기존 진행도 저장·동기화를 사용합니다.
		if Environment:IsMakerPlay() == false or _ProgressManager:CanUseProgress(senderUserId) == false then return end
		local delta = ProgressStatDelta()
		delta.meso = self.debugMesoDelta
		if _ProgressManager:ApplyProgressStat(delta:ToPlainTable()) == false then return end
		_ProgressManager:SaveProgressToStorage()
		_ProgressManager:PushProgressToClient(senderUserId)
		self:ShowDebugMessage("메소 +" .. tostring(self.debugMesoDelta), "", senderUserId)
	end

	@ExecSpace("Server")
	method void RequestGrantDebugIntimacy(string characterId)
		-- 메이커에서 선택한 캐릭터의 친밀도를 올리고 실제 에피소드 해금·저장 경로를 실행합니다.
		if Environment:IsMakerPlay() == false or _CharacterManager:CanUseCharacters(senderUserId) == false then return end
		local delta = CharacterStatDelta()
		delta.characterId = characterId
		delta.intimacy = self.debugIntimacyDelta
		if _CharacterManager:ApplyCharacterStatWithCommit(delta:ToPlainTable(), senderUserId) == false then return end
		local character = _CharacterManager:ServerGetCharacterById(characterId)
		self:ShowDebugMessage("친밀도 +" .. tostring(self.debugIntimacyDelta) .. " (현재 " .. string.format("%.0f", character.intimacy) .. ")", characterId, senderUserId)
	end

	@ExecSpace("Server")
	method void RequestToggleDebugUnlockAllCharacters()
		-- 실제 보유 데이터는 건드리지 않고 메이커 전체 임시 해금 표시·편성 허용을 전환합니다.
		if Environment:IsMakerPlay() == false or _CharacterManager:CanUseCharacters(senderUserId) == false then return end
		_CharacterManager.debugUnlockAllCharacters = not _CharacterManager.debugUnlockAllCharacters
		_CharacterManager:PushCharactersToClient(senderUserId)
		self:ShowDebugMessage("전체 임시 해금 " .. (_CharacterManager.debugUnlockAllCharacters and "ON" or "OFF (실제 보유 상태)"), "", senderUserId)
	end

	------------------------------------------------------------------------------------------------------------------------------------------------------
	-- LifeCycle
	------------------------------------------------------------------------------------------------------------------------------------------------------

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 메이커 플레이에서만 테스트용 키 입력 이벤트를 연결합니다.
		if Environment:IsMakerPlay() == false then return end
		self.keyDownHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnKeyDown)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 테스트용 키 입력 이벤트 연결을 해제합니다.
		self:ClearDebugInitialActionPointTimer()

		if self.keyDownHandler ~= nil then
			_InputService:DisconnectEvent(KeyDownEvent, self.keyDownHandler)
		end

		self.keyDownHandler = nil
	end

	------------------------------------------------------------------------------------------------------------------------------------------------------
	-- Private Methods
	------------------------------------------------------------------------------------------------------------------------------------------------------

	@ExecSpace("ClientOnly")
	method void SelectDebugCharacter(integer direction)
		-- 전체 아카이브의 ID 순서로 친밀도 지급 대상을 순환합니다. 실제 스테이지 편성은 바꾸지 않습니다.
		local characters = _CharacterManager:ClientGetCharacters()
		if #characters == 0 then
			_UIToast:ShowMessage("캐릭터 데이터를 기다려주세요.")
			return
		end
		table.sort(characters, function(left, right) return left.id < right.id end)
		local currentIndex = direction > 0 and 0 or 1
		for index, character in ipairs(characters) do if character.id == self.debugIntimacyCharacterId then currentIndex = index; break end end
		local nextIndex = (currentIndex - 1 + direction) % #characters + 1
		self.debugIntimacyCharacterId = characters[nextIndex].id
		self:ShowCurrentDebugCharacter()
	end

	@ExecSpace("ClientOnly")
	method void ShowCurrentDebugCharacter()
		-- 현재 친밀도 테스트 대상과 친밀도·레벨을 표시합니다.
		local character = _CharacterManager:ClientGetCharacterById(self.debugIntimacyCharacterId)
		if character == nil then
			_UIToast:ShowMessage("캐릭터 데이터를 기다려주세요.")
			return
		end
		local level = _IntimacyLevelMaster:GetCurrentLevel(character.intimacy)
		self:ShowDebugMessage("테스트 대상 · 친밀도 " .. string.format("%.0f", character.intimacy) .. " · Lv." .. tostring(level), character.id)
	end

	@ExecSpace("ClientOnly")
	method void OpenDebugDialog()
		-- R 키로 현재 디버그 대화를 엽니다. daily 대화 선택값이 유효하면 그쪽을 우선합니다.
		local dialogId = self.debugDialogId

		if _DialogUILogic == nil then
			log_warning("[UIDebugLogic] DialogUILogic is nil")
			return
		end

		-- 디버그 대화도 단일 옵션 기반 Open API를 사용합니다.
		local options = DialogOpenOptions()
		options.dialogId = dialogId or ""
		_DialogUILogic:Open(options)
		log("[UIDebugLogic] open debug dialogId=" .. tostring(dialogId))
	end

	@ExecSpace("ClientOnly")
	method void SelectDebugDailyDialog(integer delta)
		-- 5/6 키로 daily 디버그 대화 선택을 이전/다음으로 넘깁니다.
		local count = self:GetDebugDailyDialogCount()
		if count <= 0 then
			return
		end

		self.debugDailyDialogIndex = self.debugDailyDialogIndex + delta
		if self.debugDailyDialogIndex < 1 then
			self.debugDailyDialogIndex = count
		elseif self.debugDailyDialogIndex > count then
			self.debugDailyDialogIndex = 1
		end
	end

	@ExecSpace("ClientOnly")
	method integer GetDebugDailyDialogCount()
		-- 기존 일상 대화 테스트 목록의 항목 수를 반환합니다.
		return 12
	end

	@ExecSpace("ClientOnly")
	method string GetSelectedDebugDailyDialogKey()
		-- 선택한 일상 대화의 키를 반환합니다.
		return self:GetDebugDailyDialogKey(self.debugDailyDialogIndex)
	end

	@ExecSpace("ClientOnly")
	method string GetSelectedDebugDailyDialogId()
		-- 선택한 일상 대화의 ID를 반환합니다.
		return self:GetDebugDailyDialogId(self.debugDailyDialogIndex)
	end

	@ExecSpace("ClientOnly")
	method string GetDebugDailyDialogKey(integer index)
		-- 기존 일상 대화 테스트 인덱스에 대응하는 키를 반환합니다.
		if index == 1 then
			return "episode_lucid_dessert"
		elseif index == 2 then
			return "daily_kingSinger"
		elseif index == 3 then
			return "daily_bossboysFan"
		elseif index == 4 then
			return "daily_chestnut"
		elseif index == 5 then
			return "daily_rockSpiritGirl"
		elseif index == 6 then
			return "daily_jm"
		elseif index == 7 then
			return "daily_busyMan"
		elseif index == 8 then
			return "daily_coolMan"
		elseif index == 9 then
			return "daily_clothesPartTime"
		elseif index == 10 then
			return "daily_cafePartTime"
		elseif index == 11 then
			return "daily_juiceBoss"
		elseif index == 12 then
			return "daily_foodStall"
		end

		return ""
	end

	@ExecSpace("ClientOnly")
	method string GetDebugDailyDialogId(integer index)
		-- 기존 일상 대화 테스트 인덱스에 대응하는 ID를 반환합니다.
		if index == 1 then
			return "episode_lucid_dessert"
		elseif index == 2 then
			return "daily_dia"
		elseif index == 3 then
			return "daily_nemoroid"
		elseif index == 4 then
			return "daily_baker"
		elseif index == 5 then
			return "daily_highGirl"
		elseif index == 6 then
			return "daily_jm"
		elseif index == 7 then
			return "daily_busyMan"
		elseif index == 8 then
			return "daily_coolMan"
		elseif index == 9 then
			return "daily_clothesPartTime"
		elseif index == 10 then
			return "daily_cafePartTime"
		elseif index == 11 then
			return "daily_juiceBoss"
		elseif index == 12 then
			return "daily_foodStall"
		end

		return ""
	end

	@ExecSpace("ClientOnly")
	method void ClearDebugInitialActionPointTimer()
		-- 디버그 시작 액션 포인트 세팅 타이머를 정리합니다.
		if self.debugInitialActionPointTimerId > 0 and _TimerService ~= nil then
			_TimerService:ClearTimer(self.debugInitialActionPointTimerId)
		end

		self.debugInitialActionPointTimerId = 0
	end

	@ExecSpace("ClientOnly")
	method void RequestDebugSetActionPoint(integer actionPoint)
		-- 디버그 시작 액션 포인트 값을 서버 진행도 캐시에 요청합니다.
		if _ProgressManager == nil then
			log_warning("[UIDebugLogic] ProgressManager is nil")
			return
		end

		_ProgressManager:RequestSetActionPoint(actionPoint)
		log("[UIDebugLogic] request actionPoint set=" .. tostring(actionPoint))
	end

	@ExecSpace("ClientOnly")
	method void RequestDebugActionPointDelta(integer amount)
		-- 디버그 키 입력으로 액션 포인트 델타를 서버 진행도 캐시에 요청합니다.
		if _ProgressManager == nil then
			log_warning("[UIDebugLogic] ProgressManager is nil")
			return
		end

		_ProgressManager:RequestAddActionPoint(amount)
		log("[UIDebugLogic] request actionPoint delta=" .. tostring(amount))
	end

	@ExecSpace("ClientOnly")
	method void RequestDebugIntimacy()
		-- 현재 테스트 대상의 친밀도 증가를 메이커 전용 서버 요청으로 전달합니다.
		self:RequestGrantDebugIntimacy(self.debugIntimacyCharacterId)
	end

	@ExecSpace("ClientOnly")
	method void RequestDebugUnlockCharacter()
		-- 디버그 키 입력으로 지정한 캐릭터 해금을 서버에 요청합니다.
		if _CharacterManager == nil then
			log_warning("[UIDebugLogic] CharacterManager is nil")
			return
		end

		_CharacterManager:RequestUnlockCharacter(self.debugUnlockCharacterId)
		log("[UIDebugLogic] request unlock characterId=" .. tostring(self.debugUnlockCharacterId))
	end

	@ExecSpace("ClientOnly")
	method void StartDebugWeeklyPresentation(integer index)
		-- 디버그 키 입력으로 고정된 5일 주간 활동 진행 UI를 시작합니다.
		if _WeeklySequenceScheduler == nil then
			log_warning("[UIDebugLogic] WeeklySequenceScheduler is nil")
			return
		end

		if index == 1 then
			_WeeklySequenceScheduler:StartWeeklySequence(self:BuildDebugWeeklyPlan())
		elseif index == 2 then
			_WeeklySequenceScheduler:StartWeeklySequence(self:BuildDebugWeeklyPlan2())
		end
	end

	@ExecSpace("ClientOnly")
	method table BuildDebugWeeklyPlan()
		-- 리린/루시드/시그너스 테스트 편성 데이터를 만듭니다.
		local weeklyPlan = {}

		weeklyPlan[1] = self:CreateDebugWeeklyPlanSlot("character_lilin", "performance_busking")
		weeklyPlan[2] = self:CreateDebugWeeklyPlanSlot("character_lucid", "performance_mlive")
		weeklyPlan[3] = self:CreateDebugWeeklyPlanSlot("character_cygnus", "performance_concert")
		weeklyPlan[4] = self:CreateDebugWeeklyPlanSlot("character_lilin", "performance_mlive")
		weeklyPlan[5] = self:CreateDebugWeeklyPlanSlot("character_lucid", "performance_mlive")

		return weeklyPlan
	end

	@ExecSpace("ClientOnly")
	method table BuildDebugWeeklyPlan2()
		-- 리린/루시드/시그너스 테스트 편성 데이터를 만듭니다.
		local weeklyPlan = {}

		weeklyPlan[1] = self:CreateDebugWeeklyPlanSlot("character_lilin", "performance_busking")
		weeklyPlan[2] = self:CreateDebugWeeklyPlanSlot("character_lucid", "performance_concert")
		weeklyPlan[3] = self:CreateDebugWeeklyPlanSlot("character_cygnus", "performance_busking")
		weeklyPlan[4] = self:CreateDebugWeeklyPlanSlot("character_lilin", "performance_mlive")
		weeklyPlan[5] = self:CreateDebugWeeklyPlanSlot("character_lucid", "performance_concert")

		return weeklyPlan
	end

	@ExecSpace("ClientOnly")
	method WeeklyPlanData CreateDebugWeeklyPlanSlot(string characterId, string activityId)
		-- 주간 활동 진행 UI에 넘길 하루치 테스트 슬롯을 만듭니다.
		local slot = WeeklyPlanData()
		slot.characterId = characterId
		slot.activityId = activityId
		return slot
	end

end

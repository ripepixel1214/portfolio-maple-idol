@Logic
script ResultPopupUILogic extends Logic

	property Entity rootEntity = "b1f0949a-1a48-437a-92b7-57802a3f368b"

	property Entity panelEntity = "8a4a1adf-9f4e-47a7-a7aa-27bca8e25e03"

	property TextGUIRendererComponent titleText = "11d550ef-b07d-4136-9adb-11f9d1cf8524"

	property TextGUIRendererComponent messageText = "54ad843d-9dfa-49bf-bd11-0ea27dae6587"

	property ButtonComponent confirmButton = "6dd161ff-e783-4dab-8302-a8c702d9ca5a"

	property TextGUIRendererComponent confirmButtonText = "6dd161ff-e783-4dab-8302-a8c702d9ca5a"

	property string UI_RESULT_TITLE_KEY = "ui.result_popup.title"

	property any confirmHandler = nil

	property any onConfirm = nil

	property number openDuration = 0.18

	property number closeDuration = 0.12

	property number openScaleFrom = 0.94

	property number closeScaleTo = 0.97

	property integer tweenTimerId = 0

	property boolean isOpen = false

	property boolean isTweenPlaying = false

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 결과 팝업을 초기 상태에서 닫고 확인 버튼 이벤트를 연결합니다.
		self:StopTween()
		self:SetVisibleImmediate(false)
		self:ConnectConfirmButton()
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 확인 버튼 이벤트 연결을 정리합니다.
		self:StopTween()
		self:DisconnectConfirmButton()
	end

	@ExecSpace("ClientOnly")
	method void OpenWithTitle(string title, string message, any onConfirm)
		-- 범용 결과 팝업을 열고 전달받은 결과 내용을 표시합니다.
		self.onConfirm = onConfirm
		self:SetTitle(title)
		self:SetMessage(message)
		self:OpenAnimated()
	end

	@ExecSpace("ClientOnly")
	method void OpenMessage(string message)
		-- 기본 제목으로 간단한 결과 메시지를 표시합니다.
		self:OpenWithTitle(self:GetLocalizedText(self.UI_RESULT_TITLE_KEY, ""), message, nil)
	end

	@ExecSpace("ClientOnly")
	method void Close()
		-- 결과 팝업을 닫습니다.
		if self.isOpen == false and self.isTweenPlaying == false then
			self:SetVisibleImmediate(false)
			return
		end

		self:StartTween(false)
	end

	@ExecSpace("ClientOnly")
	method void OnConfirmButtonClicked()
		-- 확인 버튼 입력을 처리하고 등록된 콜백을 실행합니다.
		if self.isTweenPlaying == true then
			return
		end

		local callback = self.onConfirm
		self.onConfirm = nil

		if callback ~= nil then
			callback()
		end

		self:Close()
	end

	@ExecSpace("ClientOnly")
	method void ConnectConfirmButton()
		-- 확인 버튼 클릭 이벤트를 연결합니다.
		self:DisconnectConfirmButton()

		if self.confirmButton == nil or self.confirmButton.Entity == nil then
			return
		end

		self.confirmHandler = self.confirmButton.Entity:ConnectEvent(ButtonClickEvent, self.OnConfirmButtonClicked)
	end

	@ExecSpace("ClientOnly")
	method void DisconnectConfirmButton()
		-- 확인 버튼 클릭 이벤트 연결을 해제합니다.
		if self.confirmHandler == nil then
			return
		end

		if self.confirmButton ~= nil and self.confirmButton.Entity ~= nil then
			self.confirmButton.Entity:DisconnectEvent(ButtonClickEvent, self.confirmHandler)
		end

		self.confirmHandler = nil
	end

	@ExecSpace("ClientOnly")
	method void SetVisible(boolean isVisible)
		-- 결과 팝업 루트 표시 상태를 변경합니다.
		if isVisible == true then
			self:OpenAnimated()
			return
		end

		self:Close()
	end

	@ExecSpace("ClientOnly")
	method void SetTitle(string title)
		-- 제목 텍스트를 갱신합니다.
		if self.titleText ~= nil then
			self.titleText.Text = title or self:GetLocalizedText(self.UI_RESULT_TITLE_KEY, "")
		end
	end

	@ExecSpace("ClientOnly")
	method string GetLocalizedText(string key, string fallbackText)
		-- 현재 locale의 UI 문구를 조회합니다.
		if _LocalizationLogic ~= nil then
			return _LocalizationLogic:GetText(key, fallbackText)
		end

		return fallbackText or ""
	end

	@ExecSpace("ClientOnly")
	method void SetMessage(string message)
		-- 본문 텍스트를 갱신합니다.
		if self.messageText ~= nil then
			self.messageText.Text = message or ""
		end
	end

	@ExecSpace("ClientOnly")
	method void OpenAnimated()
		-- 결과 팝업을 표시하고 짧은 페이드/스케일 트윈을 재생합니다.
		if self.rootEntity ~= nil then
			self.rootEntity.Enable = true
		end

		self.isOpen = true
		self:StartTween(true)
		self:SendVisibilityChangedEvent(true)
	end

	@ExecSpace("ClientOnly")
	method void SetVisibleImmediate(boolean isVisible)
		-- 트윈 없이 결과 팝업 표시 상태와 기본 알파/스케일을 즉시 적용합니다.
		if self.rootEntity ~= nil then
			self.rootEntity.Enable = isVisible

			local canvasGroup = self.rootEntity.CanvasGroupComponent
			if canvasGroup ~= nil then
				if isVisible == true then
					canvasGroup.GroupAlpha = 1
				else
					canvasGroup.GroupAlpha = 0
				end
			end
		end

		if self.panelEntity ~= nil and self.panelEntity.UITransformComponent ~= nil then
			self.panelEntity.UITransformComponent.UIScale = Vector3(1, 1, 1)
		end

		self.isOpen = isVisible
		self.isTweenPlaying = false
	end

	@ExecSpace("ClientOnly")
	method void StopTween()
		-- 진행 중인 결과 팝업 트윈 타이머를 정리합니다.
		if self.tweenTimerId > 0 then
			_TimerService:ClearTimer(self.tweenTimerId)
			self.tweenTimerId = 0
		end

		self.isTweenPlaying = false
	end

	@ExecSpace("ClientOnly")
	method void StartTween(boolean isOpening)
		-- 결과 팝업의 등장/퇴장 페이드와 패널 스케일 트윈을 시작합니다.
		self:StopTween()

		local canvasGroup = nil
		if self.rootEntity ~= nil then
			canvasGroup = self.rootEntity.CanvasGroupComponent
		end

		local transform = nil
		if self.panelEntity ~= nil then
			transform = self.panelEntity.UITransformComponent
		end

		if canvasGroup == nil and transform == nil then
			self:SetVisibleImmediate(isOpening)
			if isOpening == false then
				self:SendVisibilityChangedEvent(false)
			end
			return
		end

		local duration = self.openDuration
		local startScale = self.openScaleFrom
		local endScale = 1
		local startAlpha = 0
		local endAlpha = 1
		local easeType = EaseType.SineEaseOut

		if isOpening == false then
			duration = self.closeDuration
			startScale = 1
			endScale = self.closeScaleTo
			startAlpha = 1
			endAlpha = 0
			easeType = EaseType.SineEaseIn
		end

		if duration <= 0 then
			self:SetVisibleImmediate(isOpening)
			if isOpening == false then
				self:SendVisibilityChangedEvent(false)
			end
			return
		end

		if canvasGroup ~= nil then
			canvasGroup.GroupAlpha = startAlpha
		end

		if transform ~= nil then
			transform.UIScale = Vector3(startScale, startScale, 1)
		end

		self.isTweenPlaying = true
		local elapsed = 0
		local previousTime = _UtilLogic.ElapsedSeconds

		local tick = function()
			local now = _UtilLogic.ElapsedSeconds
			local delta = now - previousTime
			previousTime = now
			elapsed = elapsed + delta

			local tweenTime = math.min(elapsed, duration)
			local alpha = _TweenLogic:Ease(startAlpha, endAlpha, duration, easeType, tweenTime)
			local scale = _TweenLogic:Ease(startScale, endScale, duration, easeType, tweenTime)

			if canvasGroup ~= nil then
				canvasGroup.GroupAlpha = alpha
			end

			if transform ~= nil then
				transform.UIScale = Vector3(scale, scale, 1)
			end

			if elapsed >= duration then
				if self.tweenTimerId > 0 then
					_TimerService:ClearTimer(self.tweenTimerId)
					self.tweenTimerId = 0
				end

				if transform ~= nil then
					transform.UIScale = Vector3(1, 1, 1)
				end

				if canvasGroup ~= nil then
					canvasGroup.GroupAlpha = endAlpha
				end

				self.isTweenPlaying = false
				self.isOpen = isOpening

				if isOpening == false then
					if self.rootEntity ~= nil then
						self.rootEntity.Enable = false
					end

					self:SendVisibilityChangedEvent(false)
				end
			end
		end

		self.tweenTimerId = _TimerService:SetTimerRepeat(tick, 1 / 60)
	end

	@ExecSpace("ClientOnly")
	method void SendVisibilityChangedEvent(boolean isOpen)
		-- 결과 팝업 표시 상태 변경을 범용 UI 표시 이벤트로 알립니다.
		if _UIVisibilityNotifierLogic == nil then
			return
		end

		_UIVisibilityNotifierLogic:SendFrom(self, "resultPopup", isOpen)
	end

end

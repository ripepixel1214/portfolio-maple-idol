	@ExecSpace("ClientOnly")
	method void SetGaugeFillByCardChild(Entity card, string childName, number fillAmount)
		-- 런타임 카드 하위의 지정된 게이지 SliderComponent에 Value를 적용합니다.
		if card == nil then
			return
		end

		local child = card:GetChildByName(childName, true)
		if child == nil then
			return
		end

		if child.SliderComponent ~= nil then
			child.SliderComponent.Value = self:Clamp01(fillAmount)
		end
	end

	@ExecSpace("ClientOnly")
	method void SetStatCard(integer index, any character)
		-- 한 캐릭터의 초상화, 스탯, 컨디션 텍스트를 카드 하나에 채웁니다.
		local cardPath = self:GetStatCardPath(index)
		local card = self:GetEntity(cardPath)
		if card == nil then
			return
		end
		
		if character == nil then
			card.Enable = false
			return
		end
		
		card.Enable = true
		local localizedCharacterName = self:GetLocalizedCharacterName(character)
		self:SetTextByPath(cardPath .. "/PortraitFrame/Character", localizedCharacterName)
		self:SetTextByPath(cardPath .. "/PortraitFrame/Text_1", localizedCharacterName)
		self:SetTextByPath(cardPath .. "/Vocal/Text", self:BuildStatValueText("vocal", character.vocal or 0))
		self:SetTextByPath(cardPath .. "/Dance/Text", self:BuildStatValueText("dance", character.dance or 0))
		self:SetTextByPath(cardPath .. "/Visual/Text", self:BuildStatValueText("visual", character.visual or 0))
		self:SetTextByPath(cardPath .. "/Condition/Text", self:BuildStatValueText("fatigue", character.fatigue or 0))
		self:SetImageByPath(cardPath .. "/PortraitFrame/Portrait", self:GetCharacterPortraitRuid(character.id), true)
		self:SetImageByPath(cardPath .. "/PortraitFrame/FavoriteBadge/Condition", self:GetConditionIconRuid(character.fatigue or 0), true)
	end

	@ExecSpace("ClientOnly")
	method string GetStatCardPath(integer index)
		-- 카드 인덱스를 UI 경로의 Card01, Card02 형식으로 변환합니다.
		if index < 10 then
			return "DesignRoot/MainPanel/StatContent/Card0" .. tostring(index)
		end
		
		return "DesignRoot/MainPanel/StatContent/Card" .. tostring(index)
	end


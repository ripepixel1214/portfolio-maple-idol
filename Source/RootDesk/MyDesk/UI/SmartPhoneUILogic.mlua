		self:SetTextByPath("DesignRoot/MainPanel/StatContent/Title/Band/Text", title)
		self:SetTextByPath("DesignRoot/MainPanel/IdolContent/Title/Band/Text", title)
		self:SetBoundText(self.AlbumTitleText, title)
		self:SetImageByPath("DesignRoot/MainPanel/StatContent/Title/Icon", iconRuid, true)
		self:SetImageByPath("DesignRoot/MainPanel/IdolContent/Title/Icon", iconRuid, true)
		self:SetBoundImage(self.AlbumTitleIconImage, iconRuid, true)
	end


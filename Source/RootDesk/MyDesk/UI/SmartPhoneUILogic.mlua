		local entity = self:GetEntity(path)
		if entity == nil or entity.SpriteGUIRendererComponent == nil then
			return
		end
		
		if isFilled ~= true or ruid == nil or ruid == "" then
			entity.SpriteGUIRendererComponent.ImageRUID = DataRef("")
			entity.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0)
			return
		end
		
		entity.SpriteGUIRendererComponent.ImageRUID = DataRef(ruid)
		entity.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
	end


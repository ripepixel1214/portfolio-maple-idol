	method string GetIdolCardPath(integer index)
		-- 아이돌 카드 인덱스를 제작 시 배치한 Card01, Card02 형식의 경로로 변환합니다.
		if index < 10 then
			return "DesignRoot/MainPanel/IdolContent/IdolScroll/Card0" .. tostring(index)

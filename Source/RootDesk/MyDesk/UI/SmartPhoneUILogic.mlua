	method void SetTextByPath(string path, string value)
		-- 경로로 찾은 TextComponent 또는 TextGUIRendererComponent에 문자열을 설정합니다.
		local entity = self:GetEntity(path)
		if entity == nil then
			return
		end

		if entity.TextComponent ~= nil then
			entity.TextComponent.Text = value or ""
		elseif entity.TextGUIRendererComponent ~= nil then
			entity.TextGUIRendererComponent.Text = value or ""
		end
	end


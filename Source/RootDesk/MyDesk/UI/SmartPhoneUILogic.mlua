		self:SetEntityEnable("DesignRoot/MainPanel/StatContent", false)
		self:SetBoundEntityEnable(self.AlbumContentEntity, false)
		self:SetEntityEnable("DesignRoot/MainPanel/CostumeContent", true)
		self:RefreshCostumeCharacters()
		self:ShowCostumeCategory("hair")
		self:ApplyCostumeBehavior()
		self:RefreshCostumeSaveButtonState()
	end

	@ExecSpace("ClientOnly")
	method void PrepareAlbumTemplate()
		-- 앨범의 정적 슬롯을 숨기고 Item01을 런타임 복제용 템플릿으로 사용합니다.
		self:ClearAlbumRuntimeCards()
		self:ShowAlbumTab("photoCard")
		
		local albumGrid = self.CherishedItemGridEntity
		if albumGrid ~= nil and albumGrid.ScrollLayoutGroupComponent ~= nil then
			albumGrid.ScrollLayoutGroupComponent.Enable = true
		end

		local fanPresentGrid = self.FanPresentGridEntity
		if fanPresentGrid ~= nil and fanPresentGrid.ScrollLayoutGroupComponent ~= nil then
			fanPresentGrid.ScrollLayoutGroupComponent.Enable = true
		end

		local photoCardGrid = self.PhotoCardGridEntity
		if photoCardGrid ~= nil and photoCardGrid.ScrollLayoutGroupComponent ~= nil then
			photoCardGrid.ScrollLayoutGroupComponent.Enable = true
		end
		
		local template = self:GetAlbumTemplate()
		if template ~= nil then
			template.Enable = false
		end

		local fanPresentTemplate = self:GetFanPresentTemplate()
		if fanPresentTemplate ~= nil then
			fanPresentTemplate.Enable = false
		end

		local photoCardTemplate = self:GetPhotoCardTemplate()
		if photoCardTemplate ~= nil then
			photoCardTemplate.Enable = false
		end
	end

	@ExecSpace("ClientOnly")
	method void PrepareCostumeTemplate()
		self:ClearCostumeRuntimeSlots()

		if self.CostumeItemGridEntity ~= nil and self.CostumeItemGridEntity.ScrollLayoutGroupComponent ~= nil then
			self.CostumeItemGridEntity.ScrollLayoutGroupComponent.Enable = true
		end

		if self.CostumeItemTemplateEntity ~= nil then
			self.CostumeItemTemplateEntity.Enable = false
		end
	end


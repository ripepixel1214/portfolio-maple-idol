		self:SetEntityEnable("DesignRoot/MainPanel/IdolContent", false)
		self:SetEntityEnable("DesignRoot/MainPanel/ProfilePreview", false)
		self:SetEntityEnable("DesignRoot/MainPanel/IdolScroll", false)
		self:SetEntityEnable("DesignRoot/MainPanel/StatContent", true)
		self:SetBoundEntityEnable(self.AlbumContentEntity, false)
		self:SetEntityEnable("DesignRoot/MainPanel/CostumeContent", false)
		self:RefreshStatCharacters()

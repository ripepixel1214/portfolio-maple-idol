	@ExecSpace("ClientOnly")
	method void ShowCostumePage()
		-- 메인 패널 콘텐츠를 치장 영역으로 바꾸고 헤어 카테고리에서 시작합니다.
		self:ClearAlbumNewItemSnapshot()
		self:ClearIdolNewCharacterSnapshot()
		self:ClearIdolEpisodeNewSnapshot()
		self.CurrentPage = "costume"
		self:SetEntityEnable("DesignRoot/MainPanel/IdolContent", false)
		self:SetEntityEnable("DesignRoot/MainPanel/ProfilePreview", false)

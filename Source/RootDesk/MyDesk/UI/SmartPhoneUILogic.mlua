---@description "스마트폰 앱 등록, 생명주기, 메뉴와 실행 흐름 관리."
@Logic
script SmartPhoneUILogic extends Logic

	property boolean IsInitialized = false

	property boolean AreAppsRegistered = false

	property boolean IsRootVisible = true

	property ButtonComponent OpenButton = "9a3bdfd8-6b52-4e00-a2f3-82b2eab4aa88"

	property boolean IsOpen = false

	property any openClickHandler = nil

	property ButtonComponent CloseButton = "1cfbe402-ac2e-43b4-9702-1edca3607d3a"

	property any closeClickHandler = nil

	property string CurrentPage = ""

	property any CurrentApp = nil

	property table AppEntries = {}

	property table AppsById = {}


	property any newContentChangedHandler = nil

	property Entity DefaultSmartPhoneNewBadgeEntity = "e61b1e2c-7268-433b-92d2-b93de464e51e"

	property Entity DesignRootEntity = "e0f63c1d-efdb-4696-ad4c-beedc034930d"

	property Entity DimmerEntity = "b72f719d-48f9-48ee-b681-81350776e71d"

	property Entity PhoneEntity = "9a6fa10f-e78e-4b08-93c6-3f48207330ba"

	property Entity MainPanelEntity = "551c0d87-21e9-4fe5-9d38-03a3519eccb7"

	-- Public API

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 계약 검증에 성공한 앱만 초기화하고 UI 준비 지연은 OnUpdate에서 재시도합니다.
		self.AreAppsRegistered = self:RegisterApps()
		self:TryInitialize()
	end

	@ExecSpace("ClientOnly")
	method boolean TryInitialize()
		-- 모든 앱과 메뉴가 준비된 뒤 이벤트를 연결하고 현재 데이터로 초기 화면을 갱신합니다.
		if self.IsInitialized then
			return true
		end

		if self.AreAppsRegistered == false then
			return false
		end

		if self.OpenButton == nil or self.OpenButton.Entity == nil then
			return false
		end
		_SmartPhoneUIUtil:SetEntityEnable(self.MainPanelEntity, false)

		for _, entry in ipairs(self.AppEntries) do
			local app = entry.App
			if app.MenuButton == nil or app.MenuButton.Entity == nil then
				return false
			end

			if app:Initialize() == false then
				return false
			end
		end

		self.IsInitialized = true
		for _, entry in ipairs(self.AppEntries) do
			entry.App:ConnectEvents()
		end
		
		self:ConnectOpenButton()
		self:ConnectCloseButton()
		self:ConnectMenuButtons()
		self:ConnectNewContentChanged()
		_CharacterManager:ConnectEvent(CharacterChangedEvent, self.OnCharacterChanged)

		self.OpenButton.Entity.Enable = self.IsRootVisible
		self:HideSmartPhone()
		return true
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 등록 실패는 재시도하지 않고 UI 엔티티가 늦게 준비되는 경우만 기다립니다.
		if self.AreAppsRegistered and self.IsInitialized == false then
			self:TryInitialize()
		end
	end

	@ExecSpace("ClientOnly")
	method void ConnectOpenButton()
		-- DefaultUI의 스마트폰 버튼을 스마트폰과 메인 패널 열기 동작에 연결합니다.
		if self.OpenButton ~= nil and self.OpenButton.Entity ~= nil and self.openClickHandler == nil then
			self.openClickHandler = self.OpenButton.Entity:ConnectEvent(ButtonClickEvent, self.OnOpenButtonClicked)
		end
	end

	@ExecSpace("ClientOnly")
	method void ConnectCloseButton()
		-- 메인 패널의 닫기 버튼을 스마트폰 닫기 동작에 연결합니다.
		if self.CloseButton ~= nil and self.CloseButton.Entity ~= nil and self.closeClickHandler == nil then
			self.closeClickHandler = self.CloseButton.Entity:ConnectEvent(ButtonClickEvent, self.OnCloseButtonClicked)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnCloseButtonClicked(ButtonClickEvent event)
		-- 메인 패널 닫기 버튼을 누르면 스마트폰 UI를 닫습니다.
		self:HideSmartPhone()
	end

	@ExecSpace("ClientOnly")
	method void OnOpenButtonClicked(ButtonClickEvent event)
		-- 실행 버튼을 누를 때 스마트폰과 우측 패널을 열거나 닫습니다.
		if self.IsOpen then
			self:HideSmartPhone()
			return
		end

		self:ShowSmartPhone()
	end

	@ExecSpace("ClientOnly")
	method void ShowSmartPhone()
		-- 마지막 앱을 복원하고, 아직 선택하지 않았거나 등록에서 빠진 앱이면 첫 앱을 엽니다.
		if self.AppsById[self.CurrentPage] == nil then
			local firstEntry = self.AppEntries[1]
			self.CurrentPage = firstEntry and firstEntry.Id or ""
		end
		self.IsOpen = true
		_UIVisibilityNotifierLogic:SendFrom(self, "smartphone", true)
		_SmartPhoneUIUtil:SetEntityEnable(self.DesignRootEntity, true)
		_SmartPhoneUIUtil:SetEntityEnable(self.DimmerEntity, true)
		_SmartPhoneUIUtil:SetEntityEnable(self.PhoneEntity, true)
		_SmartPhoneUIUtil:SetEntityEnable(self.MainPanelEntity, true)
		self:OpenApp(self.CurrentPage)
	end

	@ExecSpace("ClientOnly")
	method void HideSmartPhone()
		-- 열려 있는 앱을 닫고 스마트폰 컨테이너를 숨깁니다. 마지막 앱 ID는 재진입을 위해 유지합니다.
		local currentApp = self.CurrentApp
		self.CurrentApp = nil
		if currentApp ~= nil then
			currentApp:Close()
		end
		self.IsOpen = false
		_UIVisibilityNotifierLogic:SendFrom(self, "smartphone", false)
		_SmartPhoneUIUtil:SetEntityEnable(self.DimmerEntity, false)
		_SmartPhoneUIUtil:SetEntityEnable(self.PhoneEntity, false)
		_SmartPhoneUIUtil:SetEntityEnable(self.MainPanelEntity, false)
		self:RefreshNewContentBadges()
	end

	@ExecSpace("ClientOnly")
	method void SetVisibleRoot(boolean visible)
		-- 초기화 전 요청도 보관하고, 준비된 뒤 스마트폰과 실행 버튼의 표시 상태를 적용합니다.
		self.IsRootVisible = visible
		if self.IsInitialized == false then
			return
		end

		if visible == false then
			self:HideSmartPhone()
		end
		self.OpenButton.Entity.Enable = visible
	end

	@ExecSpace("ClientOnly")
	method void ConnectMenuButtons()
		-- 왼쪽 스마트폰의 아이콘 터치 이벤트를 등록된 앱의 열기 동작에 연결합니다.
		for _, entry in ipairs(self.AppEntries) do
			if entry.MenuClickHandler == nil then
				local appId = entry.Id
				entry.MenuClickHandler = entry.App.MenuButton.Entity:ConnectEvent(ButtonClickEvent, function()
					self:OpenApp(appId)
				end)
			end
		end
	end

	@ExecSpace("ClientOnly")

	@ExecSpace("ClientOnly")
	method void OnCharacterChanged(any event)
		-- 열려 있는 앱에 캐릭터 변경을 전달합니다. 닫힌 앱은 다음 Open에서 최신 데이터를 읽습니다.
		if self.CurrentApp ~= nil then
			self.CurrentApp:Refresh()
		end
	end

	@ExecSpace("ClientOnly")
	method void ConnectNewContentChanged()
		-- 새 콘텐츠 동기화 이벤트를 한 번만 구독합니다.
		if self.newContentChangedHandler == nil then
			self.newContentChangedHandler = _NewContentManager:ConnectEvent(NewContentChangedEvent, self.OnNewContentChanged)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnNewContentChanged(NewContentChangedEvent event)
		-- 모든 앱에 새 콘텐츠 변경을 알린 뒤 전체 알림 상태를 집계합니다.
		for _, entry in ipairs(self.AppEntries) do
			entry.App:OnNewContentChanged()
		end
		self:RefreshNewContentBadges()
	end

	@ExecSpace("ClientOnly")
	method void RefreshNewContentBadges()
		-- 앱이 각자의 배지를 갱신하고 반환한 알림 여부로 실행 버튼의 배지를 표시합니다.
		local hasAnyNew = false
		for _, entry in ipairs(self.AppEntries) do
			local hasAppNew = entry.App:RefreshBadges()
			hasAnyNew = hasAppNew or hasAnyNew
		end
		_SmartPhoneUIUtil:SetEntityEnable(self.DefaultSmartPhoneNewBadgeEntity, hasAnyNew)
	end

	@ExecSpace("ClientOnly")
	method boolean RegisterApps()
		-- 앱 구성은 이곳에서 관리하며, 계약 위반이 있으면 등록과 초기화를 중단합니다.
		self.AppEntries = {}
		self.AppsById = {}
		return 	self:RegisterApp("stat", _SmartPhoneStatAppLogic)
			and self:RegisterApp("idol", _SmartPhoneIdolAppLogic)
			and self:RegisterApp("album", _SmartPhoneAlbumAppLogic)
			and self:RegisterApp("costume", _SmartPhoneCostumeAppLogic)
	end

	@ExecSpace("ClientOnly")
	method boolean RegisterApp(string appId, any app)
		-- 모든 앱은 이 진입점에서 한 번 검증받습니다. 실패한 앱은 목록과 조회 테이블에 넣지 않습니다.
		if appId == "" or self.AppsById[appId] ~= nil then
			log_warning("[SmartPhoneUILogic] 앱 등록 실패: ID가 비어 있거나 중복되었습니다. '" .. appId .. "'")
			return false
		end

		local errorMessage = self:CheckAppInterface(app)
		if errorMessage ~= "" then
			log_warning("[SmartPhoneUILogic] 앱 '" .. appId .. "' 등록 실패: " .. errorMessage)
			return false
		end

		table.insert(self.AppEntries, {Id = appId, App = app})
		self.AppsById[appId] = app
		return true
	end

	@ExecSpace("ClientOnly")
	method string CheckAppInterface(any app)
		-- 순수 가상 함수처럼 각각의 App이 아래의 메서드를 구현했는지 체크합니다.
		if app == nil then
			return "앱이 없습니다."
		end

		local requiredMethods = {
			"Initialize",       -- boolean: 준비 완료 true / UI 대기 false. 재호출해도 초기화를 중복하지 않습니다.
			"ConnectEvents",    -- void: 모든 앱의 초기화 이후 앱 내부 이벤트를 연결합니다.
			"Open",             -- void: 초기화 이후 앱을 열고 최신 데이터를 표시합니다.
			"Close",            -- void: 열린 앱을 닫습니다. 마지막 선택 ID는 관리자가 보관합니다.
			"Refresh",          -- void: 열린 앱의 데이터를 갱신합니다.
			"RefreshLocalized", -- void: 열린 앱의 언어 변경을 반영합니다.
			"OnNewContentChanged", -- void: 새 콘텐츠 변경을 반영합니다. 앱이 닫힌 상태에서도 호출됩니다.
			"RefreshBadges"     -- boolean: 앱 배지를 갱신하고 새 콘텐츠 여부를 반환합니다.
		}

		for _, methodName in ipairs(requiredMethods) do
			if type(app[methodName]) ~= "function" then
				return "필수 메서드 " .. methodName .. "()가 구현되지 않았거나 함수가 아닙니다."
			end
		end

		return ""
	end

	@ExecSpace("ClientOnly")
	method any GetApp(string appId)
		-- 등록된 ID로 앱을 조회합니다.
		return self.AppsById[appId]
	end

	@ExecSpace("ClientOnly")
	method void OpenApp(string appId)
		-- 현재 앱을 닫고 등록된 앱으로 전환합니다. 같은 앱의 메뉴를 다시 눌러도 상태를 유지합니다.
		local nextApp = self:GetApp(appId)
		if nextApp == nil or self.CurrentApp == nextApp then
			return
		end

		if self.CurrentApp ~= nil then
			self.CurrentApp:Close()
		end
		
		self.CurrentPage = appId
		self.CurrentApp = nextApp
		nextApp:Open()
		self:RefreshNewContentBadges()
	end

end

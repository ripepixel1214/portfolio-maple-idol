	@ExecSpace("ClientOnly")
	method void ConnectLanguageChanged()
		-- 언어 변경 이벤트 구독
		if _LocalizationLogic ~= nil and self.languageChangedHandler == nil then
			self.languageChangedHandler = _LocalizationLogic:ConnectEvent(LanguageChangedEvent, self.OnLanguageChanged)
		end
	end

	@ExecSpace("ClientOnly")
	method void DisconnectLanguageChanged()
		-- 언어 변경 이벤트 구독 해제
		if self.languageChangedHandler ~= nil and _LocalizationLogic ~= nil then
			_LocalizationLogic:DisconnectEvent(LanguageChangedEvent, self.languageChangedHandler)
		end
		self.languageChangedHandler = nil
	end

	@ExecSpace("ClientOnly")
	method void OnLanguageChanged(LanguageChangedEvent event)
		-- 현재 페이지의 동적 이름·상태 문구 갱신
		if self.CurrentPage == "stat" then
			self:RefreshStatCharacters()
		elseif self.CurrentPage == "idol" then
			self:RefreshIdolCharacters()
		elseif self.CurrentPage == "album" then
			self:RefreshAlbumItems()
		elseif self.CurrentPage == "costume" then
			self:RebuildCostumeSlots()
			self:RefreshSelectedCostumeTextsFromCurrentCostume()
		end
	end

	@ExecSpace("ClientOnly")
	method void OnCharacterChanged(any characterChangedEvent)
		-- 캐릭터 데이터가 바뀌면 현재 열린 스탯 페이지를 최신 값으로 갱신합니다.
		if self.CurrentPage == "stat" then
			self:RefreshStatCharacters()
		elseif self.CurrentPage == "idol" then
			self:RefreshIdolCharacters()
		elseif self.CurrentPage == "album" then
			self:RefreshAlbumItems()
		elseif self.CurrentPage == "costume" then
			self:RefreshCostumeCharacters()
			self:RebuildCostumeSlots()
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowIdolPage()
		-- 기존 아이돌 목록/프로필 영역을 켜고 스탯 영역을 숨깁니다.
		self:ClearAlbumNewItemSnapshot()
		self:DiscardCostumeDraftsIfLeavingCostume()
		self.CurrentPage = "idol"
		self:BeginIdolPageVisit()
		self:SetTitle(self:GetLocalizedText(self.UI_TITLE_IDOL_LIST_KEY, ""), self:GetIdolIconRuid())
		self:SetEntityEnable("DesignRoot/MainPanel/IdolContent", true)
		self:SetEntityEnable("DesignRoot/MainPanel/ProfilePreview", true)
		self:SetEntityEnable("DesignRoot/MainPanel/IdolScroll", true)
		self:SetEntityEnable("DesignRoot/MainPanel/IdolContent/ProfilePreview", true)
		self:SetEntityEnable("DesignRoot/MainPanel/IdolContent/IdolScroll", true)
		self:SetEntityEnable("DesignRoot/MainPanel/StatContent", false)
		self:SetBoundEntityEnable(self.AlbumContentEntity, false)
		self:SetEntityEnable("DesignRoot/MainPanel/CostumeContent", false)
		self:RefreshIdolCharacters()
		self:BeginIdolEpisodeVisit(self.selectedIdolCharacterId)
	end

	@ExecSpace("ClientOnly")
	method void ShowStatPage()
		-- 기존 스마트폰 위치는 유지한 채 메인 패널 콘텐츠만 스탯 영역으로 바꿉니다.
		self:ClearAlbumNewItemSnapshot()
		self:ClearIdolNewCharacterSnapshot()
		self:ClearIdolEpisodeNewSnapshot()
		self:DiscardCostumeDraftsIfLeavingCostume()
		self.CurrentPage = "stat"

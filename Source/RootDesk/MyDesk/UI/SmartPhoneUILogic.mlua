		if _LocalizationLogic ~= nil then
			return _LocalizationLogic:GetText(key, fallbackText)
		end

		return fallbackText or ""
	end

	@ExecSpace("ClientOnly")
	method string FormatLocalized(string key, string fallbackText, any value1, any value2, any value3)
		-- 현재 locale의 UI 템플릿에 값을 반영
		if _LocalizationLogic ~= nil then
			return _LocalizationLogic:Format(key, fallbackText, value1, value2, value3, "")
		end

		return fallbackText or ""
	end

	method string BuildStatValueText(string statKey, number value)
		-- 스마트폰 스탯 카드의 locale별 이름과 값을 조합합니다.
		local statName = _ScheduleStatTextUtil ~= nil and _ScheduleStatTextUtil:GetLocalizedStatName(statKey, statKey) or statKey
		return statName .. " : " .. tostring(math.floor(value or 0))
	end


	@ExecSpace("ClientOnly")
	method string GetImageRuidByPath(string path, string fallbackRuid)
		-- SpriteGUIRendererComponent의 현재 ImageRUID를 읽어옵니다.
		local entity = self:GetEntity(path)
		if entity == nil or entity.SpriteGUIRendererComponent == nil then
			return fallbackRuid or ""
		end

		local imageRuid = entity.SpriteGUIRendererComponent.ImageRUID
		if imageRuid ~= nil and imageRuid.DataId ~= nil and imageRuid.DataId ~= "" then
			return imageRuid.DataId
		end

		return fallbackRuid or ""
	end


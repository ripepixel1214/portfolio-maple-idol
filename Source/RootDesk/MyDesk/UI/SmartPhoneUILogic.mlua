		if _RuntimeActorManager ~= nil then
			local portraitRuid = _RuntimeActorManager:ClientGetActorPortraitRuid(characterId, "")
			if portraitRuid ~= nil and portraitRuid ~= "" then
				return portraitRuid
			end
		end
		
		return self.PlaceholderRuid
	end

	@ExecSpace("ClientOnly")
	method string GetConditionIconRuid(number fatigue)
		-- ConditionMaster/ResourceTable 기준으로 피로도에 해당하는 컨디션 아이콘 RUID를 반환합니다.
		if _ConditionMaster == nil then
			return self.PlaceholderRuid
		end

		local conditionRuid = _ConditionMaster:GetConditionIconRuidByFatigue(fatigue or 0)
		if conditionRuid == nil or conditionRuid == "" then
			return self.PlaceholderRuid
		end

		return conditionRuid
	end


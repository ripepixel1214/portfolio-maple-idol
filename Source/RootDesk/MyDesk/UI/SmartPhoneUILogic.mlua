	@ExecSpace("ClientOnly")
	method void SetEntityEnable(string path, boolean enable)
		-- 경로로 찾은 UI 엔티티 전체를 켜거나 끕니다.
		local entity = self:GetEntity(path)
		if entity ~= nil then
			entity.Enable = enable
		end
	end

	@ExecSpace("ClientOnly")
	method Entity GetEntity(string path)
		-- 현재 UI 루트 기준 상대 경로로 엔티티를 찾습니다.
		if path == "Button" then
			if self.OpenButton ~= nil then
				return self.OpenButton.Entity
			end
		end

		if path == "DesignRoot" then
			if self.DesignRootEntity ~= nil then
				return self.DesignRootEntity
			end
		end

		if path == "DesignRoot/Dimmer" then
			return self.DimmerEntity
		end

		if path == "DesignRoot/Phone" then
			return self.PhoneEntity
		end

		if path == "DesignRoot/MainPanel" then
			return self.MainPanelEntity
		end

		if self.RootPath == "" then
			return nil
		end
		
		return _EntityService:GetEntityByPath(self.RootPath .. "/" .. path)
	end

end

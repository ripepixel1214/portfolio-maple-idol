	@ExecSpace("ClientOnly")
	method void SetAlbumCardPosition(Entity card, integer index, integer columnCount)
		-- 런타임 앨범 카드를 각 앨범 그리드의 열 수에 맞춰 배치합니다.
		if card == nil or card.UITransformComponent == nil then
			return
		end
		if columnCount <= 0 then
			columnCount = self.AlbumCardColumnCount
		end
		
		local zeroIndex = index - 1
		local column = zeroIndex % columnCount
		local row = math.floor(zeroIndex / columnCount)
		card.UITransformComponent.anchoredPosition = Vector2(
			self.AlbumCardStartX + column * self.AlbumCardStepX,
			self.AlbumCardStartY - row * self.AlbumCardStepY
		)
	end


	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 화면 루트 경로를 잡고 스마트폰 메뉴 전환 이벤트를 연결합니다.
		if self.IsInitialized then
			return
		end

		self.RootPath = "/ui/SmartPhoneUI"
		self:DisableLegacyOpenButton()
		if self.OpenButton == nil or self.OpenButton.Entity == nil then
			return
		end

		self.IsInitialized = true
		self:PrepareIdolTemplate()
		self:PrepareAlbumTemplate()
		self:PrepareCostumeTemplate()
		self:ConnectOpenButton()
		self:ConnectCloseButton()
		self:ConnectMenuButtons()
		self:ConnectAlbumTabButtons()
		self:ConnectPhotoCardFrontBackButton()
		self:ConnectIdolEpisodeButtons()
		self:ConnectCostumeCategoryButtons()
		self:ConnectCostumeSelectedItemButtons()
		self:ConnectCostumePortraitFrames()
		self:ConnectCostumeBehaviorButtons()
		self:ConnectCostumeSaveButton()
		self:ConnectShopItemChanged()
		self:ConnectNewContentChanged()
		self:RefreshNewContentBadges()
		self:ApplyCostumeBehavior()
		
		if _CharacterManager ~= nil then
			self.characterChangedHandler = _CharacterManager:ConnectEvent(CharacterChangedEvent, self.OnCharacterChanged)
		end
		self:ConnectLanguageChanged()
		
		self:HideSmartPhone()
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- UI 엔티티가 늦게 준비되는 경우 초기화를 다시 시도합니다.
		if self.IsInitialized == false then
			self:OnBeginPlay()
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 화면이 내려갈 때 연결했던 이벤트 핸들러를 정리합니다.
		self:ClearIdolRuntimeCards()
		self:ClearAlbumRuntimeCards()
		self:ClearCostumeRuntimeSlots()
		self:DisconnectOpenButton()
		self:DisconnectCloseButton()
		self:DisconnectMenuButtons()
		self:DisconnectAlbumTabButtons()
		self:DisconnectPhotoCardFrontBackButton()
		self:DisconnectIdolEpisodeButtons()
		self:DisconnectCostumeCategoryButtons()
		self:DisconnectCostumeSelectedItemButtons()
		self:DisconnectCostumePortraitFrames()
		self:DisconnectCostumeBehaviorButtons()
		self:DisconnectCostumeSaveButton()
		self:DisconnectShopItemChanged()
		self:DisconnectNewContentChanged()
		self:ClearPhotoCardToggleTween()
		self:ClearPhotoCardFlipTween()
		
		if self.characterChangedHandler ~= nil and _CharacterManager ~= nil then
			_CharacterManager:DisconnectEvent(CharacterChangedEvent, self.characterChangedHandler)
			self.characterChangedHandler = nil
		end
		self:DisconnectLanguageChanged()

		self.IsInitialized = false
	end

	@ExecSpace("ClientOnly")
	method void ConnectOpenButton()
		-- DefaultUI의 스마트폰 버튼을 스마트폰과 메인 패널 열기 동작에 연결합니다.
		if self.OpenButton ~= nil and self.OpenButton.Entity ~= nil then
			self.openClickHandler = self.OpenButton.Entity:ConnectEvent(ButtonClickEvent, self.OnOpenButtonClicked)
		end
	end

	@ExecSpace("ClientOnly")
	method void DisconnectOpenButton()
		-- DefaultUI 스마트폰 버튼에 연결했던 클릭 핸들러를 해제합니다.
		if self.OpenButton ~= nil and self.OpenButton.Entity ~= nil and self.openClickHandler ~= nil then
			self.OpenButton.Entity:DisconnectEvent(ButtonClickEvent, self.openClickHandler)
			self.openClickHandler = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void DisableLegacyOpenButton()
		-- SmartPhoneUI에 남아 있는 이전 실행 버튼을 항상 비활성화합니다.
		if self.LegacyOpenButtonEntity ~= nil then
			self.LegacyOpenButtonEntity.Enable = false
		end
	end

	@ExecSpace("ClientOnly")
	method void ConnectCloseButton()
		-- 메인 패널의 닫기 버튼을 스마트폰 닫기 동작에 연결합니다.
		if self.CloseButton ~= nil and self.CloseButton.Entity ~= nil and self.closeClickHandler == nil then
			self.closeClickHandler = self.CloseButton.Entity:ConnectEvent(ButtonClickEvent, self.OnCloseButtonClicked)
		end
	end

	@ExecSpace("ClientOnly")
	method void DisconnectCloseButton()
		-- 메인 패널 닫기 버튼에 연결했던 클릭 핸들러를 해제합니다.
		if self.CloseButton ~= nil and self.CloseButton.Entity ~= nil and self.closeClickHandler ~= nil then
			self.CloseButton.Entity:DisconnectEvent(ButtonClickEvent, self.closeClickHandler)
			self.closeClickHandler = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void OnCloseButtonClicked(ButtonClickEvent event)
		-- 메인 패널 닫기 버튼을 누르면 스마트폰 UI를 닫습니다.
		self:HideSmartPhone()
	end

	@ExecSpace("ClientOnly")
	method void OnOpenButtonClicked(ButtonClickEvent event)
		-- 실행 버튼을 누를 때 스마트폰과 우측 패널을 열거나 닫습니다.
		if self.IsOpen then
			self:HideSmartPhone()
			return
		end
		
		self:ShowSmartPhone()
	end

	@ExecSpace("ClientOnly")
	method void ShowSmartPhone()
		-- 스마트폰 컨테이너를 켜고 마지막으로 보던 페이지를 복원합니다.
		self.IsOpen = true
		if _UIVisibilityNotifierLogic ~= nil then
			_UIVisibilityNotifierLogic:SendFrom(self, "smartphone", true)
		end
		self:SetEntityEnable("DesignRoot", true)
		self:SetEntityEnable("DesignRoot/Dimmer", true)
		self:SetEntityEnable("DesignRoot/Phone", true)
		self:SetEntityEnable("DesignRoot/MainPanel", true)
		self:ConnectMenuButtons()
		
		if self.CurrentPage == "stat" then
			self:ShowStatPage()
		elseif self.CurrentPage == "album" then
			self:ShowAlbumPage()
		elseif self.CurrentPage == "costume" then
			self:ShowCostumePage()
		else
			self:ShowIdolPage()
		end
	end

	@ExecSpace("ClientOnly")
	method void HideSmartPhone()
		-- 실행 버튼은 유지한 채 스마트폰과 패널 하위 영역만 숨깁니다.
		self:DiscardCostumeDraftsIfLeavingCostume()
		self:ClearAlbumNewItemSnapshot()
		self:ClearIdolNewCharacterSnapshot()
		self:ClearIdolEpisodeNewSnapshot()
		self.IsOpen = false
		if _UIVisibilityNotifierLogic ~= nil then
			_UIVisibilityNotifierLogic:SendFrom(self, "smartphone", false)
		end
		self:SetEntityEnable("DesignRoot/Dimmer", false)
		self:SetEntityEnable("DesignRoot/Phone", false)
		self:SetEntityEnable("DesignRoot/MainPanel", false)
	end

	@ExecSpace("ClientOnly")
	method void SetVisibleRoot(boolean visible)
		-- 공연 중에는 열린 스마트폰과 DefaultUI 실행 버튼을 숨기고, 종료 시 실행 버튼을 복구합니다.
		if visible == false then
			self:HideSmartPhone()
		end
		self:DisableLegacyOpenButton()
		if self.OpenButton ~= nil and self.OpenButton.Entity ~= nil then
			self.OpenButton.Entity.Enable = visible
		end
	end

	@ExecSpace("ClientOnly")
	method void ConnectMenuButtons()
		-- 왼쪽 스마트폰의 스탯/아이돌/앨범 아이콘 터치 이벤트를 연결합니다.
		local statButton = self:GetEntity("DesignRoot/Phone/MenuStat/ButtonBg")
		if statButton ~= nil and self.statClickHandler == nil then
			self.statClickHandler = statButton:ConnectEvent(ButtonClickEvent, self.OnStatClicked)
		end
		
		local idolButton = self:GetEntity("DesignRoot/Phone/MenuIdol/ButtonBg")
		if idolButton ~= nil and self.idolClickHandler == nil then
			self.idolClickHandler = idolButton:ConnectEvent(ButtonClickEvent, self.OnIdolClicked)
		end
		
		local albumButton = self:GetEntity("DesignRoot/Phone/MenuAlbum/ButtonBg")
		if albumButton ~= nil and self.albumClickHandler == nil then
			self.albumClickHandler = albumButton:ConnectEvent(ButtonClickEvent, self.OnAlbumClicked)
		end

		local costumeButton = self:GetEntity("DesignRoot/Phone/MenuCosutme/ButtonBg")
		if costumeButton ~= nil and self.costumeClickHandler == nil then
			self.costumeClickHandler = costumeButton:ConnectEvent(ButtonClickEvent, self.OnCostumeClicked)
		end
	end

	@ExecSpace("ClientOnly")
	method void DisconnectMenuButtons()
		-- 메뉴 버튼 이벤트 연결을 해제해 중복 호출을 방지합니다.
		local statButton = self:GetEntity("DesignRoot/Phone/MenuStat/ButtonBg")
		if statButton ~= nil and self.statClickHandler ~= nil then
			statButton:DisconnectEvent(ButtonClickEvent, self.statClickHandler)
			self.statClickHandler = nil
		end
		
		local idolButton = self:GetEntity("DesignRoot/Phone/MenuIdol/ButtonBg")
		if idolButton ~= nil and self.idolClickHandler ~= nil then
			idolButton:DisconnectEvent(ButtonClickEvent, self.idolClickHandler)
			self.idolClickHandler = nil
		end
		
		local albumButton = self:GetEntity("DesignRoot/Phone/MenuAlbum/ButtonBg")
		if albumButton ~= nil and self.albumClickHandler ~= nil then
			albumButton:DisconnectEvent(ButtonClickEvent, self.albumClickHandler)
			self.albumClickHandler = nil
		end

		local costumeButton = self:GetEntity("DesignRoot/Phone/MenuCosutme/ButtonBg")
		if costumeButton ~= nil and self.costumeClickHandler ~= nil then
			costumeButton:DisconnectEvent(ButtonClickEvent, self.costumeClickHandler)
			self.costumeClickHandler = nil
		end

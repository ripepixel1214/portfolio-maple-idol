@Logic
script ScreenEffectUILogic extends Logic

	property Entity root = "af92dd72-aaef-41b4-8f7b-c702b88d40a4"

	property SpriteGUIRendererComponent overlay = "c3f41de8-8b89-4964-8051-efa7317db0f2"

	property Color overlayColor = Color(0, 0, 0, 1)

	property number currentAlpha = 0

	property boolean isTweening = false

	property number tweenElapsed = 0

	property number tweenDuration = 0

	property number startAlpha = 0

	property number targetAlpha = 0

	property boolean hideOnComplete = true

	property any onEffectComplete = nil

	-- 검은 화면 강제 유지 여부. true면 밝아지는(페이드인) 요청을 무시해 맵 전환 자동 페이드인을 억제
	property boolean isBlackHeld = false

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 화면 효과 UI를 초기 상태로 숨깁니다.
		self:Clear()
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 진행 중인 오버레이 알파 전환을 갱신합니다.
		if self.isTweening == false then
			return
		end

		self.tweenElapsed = self.tweenElapsed + delta
		local ratio = 1
		if self.tweenDuration > 0 then
			ratio = math.min(self.tweenElapsed / self.tweenDuration, 1)
		end

		local alpha = self.startAlpha + (self.targetAlpha - self.startAlpha) * ratio
		self:ApplyAlpha(alpha)

		if ratio >= 1 then
			self:CompleteEffect()
		end
	end

	@ExecSpace("ClientOnly")
	method void SetOverlay(Color color, number alpha)
		-- 오버레이 색상과 알파를 즉시 적용합니다.
		if color ~= nil then
			self.overlayColor = color
		end

		self:StopEffect()
		self:ApplyAlpha(alpha)
		self:SetRootEnable(self.currentAlpha > 0)
	end

	@ExecSpace("ClientOnly")
	method void SetColor(Color color)
		-- 현재 오버레이의 색상만 변경합니다.
		if color == nil then
			return
		end

		self.overlayColor = color
		self:ApplyAlpha(self.currentAlpha)
	end

	@ExecSpace("ClientOnly")
	method void SetAlpha(number alpha)
		-- 현재 오버레이의 알파만 즉시 변경합니다.
		self:StopEffect()
		self:ApplyAlpha(alpha)
		self:SetRootEnable(self.currentAlpha > 0)
	end

	@ExecSpace("ClientOnly")
	method void TweenAlpha(number alpha, number duration, any onComplete)
		-- 현재 알파에서 목표 알파까지 오버레이를 전환합니다.
		local safeAlpha = _MathUtil:Clamp(alpha or 0, 0, 1)
		if self.isBlackHeld == true and safeAlpha < self.currentAlpha then
			-- 검은 화면 유지 중에는 밝아지는(페이드인) 요청을 무시하되, 호출자 콜백은 즉시 실행해 전환 로직(맵 전환 정리 등)이 멈추지 않게 한다
			if onComplete ~= nil then
				onComplete()
			end
			return
		end
		self:StartEffect(self.currentAlpha, safeAlpha, duration, safeAlpha <= 0, onComplete)
	end

	@ExecSpace("ClientOnly")
	method void FadeOut(number duration, any onComplete)
		-- 화면을 완전히 덮는 편의 전환을 실행합니다.
		self:TweenAlpha(1, duration, onComplete)
	end

	@ExecSpace("ClientOnly")
	method void FadeIn(number duration, any onComplete)
		-- 화면 덮개를 완전히 걷는 편의 전환을 실행합니다.
		self:TweenAlpha(0, duration, onComplete)
	end

	@ExecSpace("ClientOnly")
	method void Transition(number duration, any middleAction)
		-- 화면을 덮은 뒤 중간 작업을 실행하고 다시 걷어냅니다.
		self:FadeOut(duration, function()
			if middleAction ~= nil then
				middleAction()
			end

			self:FadeIn(duration, nil)
		end)
	end

	@ExecSpace("ClientOnly")
	method void Clear()
		-- 화면 효과를 즉시 숨기고 진행 중인 콜백을 제거합니다.
		self:StopEffect()
		self:ApplyAlpha(0)
		self:SetRootEnable(false)
	end

	@ExecSpace("ClientOnly")
	method void HoldBlack()
		-- 검은 화면을 강제로 유지한다. 맵 전환의 자동 페이드인을 억제하기 위해 즉시 불투명 검정으로 만든다
		self.isBlackHeld = true
		self:StopEffect()
		self:ApplyAlpha(1)
		self:SetRootEnable(true)
	end

	@ExecSpace("ClientOnly")
	method void ReleaseBlack()
		-- 검은 화면 강제 유지를 해제한다. 이후 FadeIn 등 페이드 요청이 정상 동작
		self.isBlackHeld = false
	end

	@ExecSpace("ClientOnly")
	method boolean IsBlackHeld()
		-- 현재 검은 화면 강제 유지 상태인지 반환
		return self.isBlackHeld
	end

	@ExecSpace("ClientOnly")
	method void StartEffect(number fromAlpha, number toAlpha, number duration, boolean hideWhenComplete, any onComplete)
		-- 지정한 알파 범위와 시간으로 오버레이 효과를 시작합니다.
		self.startAlpha = _MathUtil:Clamp(fromAlpha or 0, 0, 1)
		self.targetAlpha = _MathUtil:Clamp(toAlpha or 0, 0, 1)
		self.tweenDuration = math.max(duration or 0, 0)
		self.tweenElapsed = 0
		self.hideOnComplete = hideWhenComplete
		self.onEffectComplete = onComplete
		self.isTweening = true

		self:SetRootEnable(true)
		self:ApplyAlpha(self.startAlpha)

		if self.tweenDuration <= 0 then
			self:CompleteEffect()
		end
	end

	@ExecSpace("ClientOnly")
	method void StopEffect()
		-- 진행 중인 오버레이 효과와 콜백을 정리합니다.
		self.isTweening = false
		self.onEffectComplete = nil
	end

	@ExecSpace("ClientOnly")
	method void CompleteEffect()
		-- 효과 완료 상태를 적용하고 등록된 콜백을 한 번 실행합니다.
		self.isTweening = false
		self:ApplyAlpha(self.targetAlpha)

		if self.hideOnComplete == true then
			self:SetRootEnable(false)
		end

		local callback = self.onEffectComplete
		self.onEffectComplete = nil
		if callback ~= nil then
			callback()
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyAlpha(number alpha)
		-- 오버레이 스프라이트의 색상과 알파를 적용합니다.
		if self.overlay == nil then
			return
		end

		local safeAlpha = _MathUtil:Clamp(alpha or 0, 0, 1)
		self.currentAlpha = safeAlpha
		self.overlay.Color = Color(self.overlayColor.r, self.overlayColor.g, self.overlayColor.b, safeAlpha)
		self.overlay.Enable = safeAlpha > 0
	end

	@ExecSpace("ClientOnly")
	method void SetRootEnable(boolean isEnabled)
		-- 화면 효과 UI 루트와 오버레이 표시 상태를 맞춥니다.
		if self.root ~= nil then
			self.root.Enable = isEnabled
		end

		if self.overlay ~= nil and isEnabled == false then
			self.overlay.Enable = false
		end
	end

end

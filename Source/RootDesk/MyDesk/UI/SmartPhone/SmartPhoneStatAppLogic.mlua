---@description "스마트폰 스탯 앱의 캐릭터 데이터와 표시 흐름."
@Logic
script SmartPhoneStatAppLogic extends Logic

	property ButtonComponent MenuButton = "d8bb9838-1c2b-4db2-923a-050e3a0b71b3"

	property StatAppViewComponent View = "818e42b0-5c09-435b-bc87-36cc2ff366b6"

	property boolean IsInitialized = false

	property boolean IsOpen = false

	-- Public API

	-- SmartPhoneUILogic이 검사하는 앱 계약 메서드입니다.

	@ExecSpace("ClientOnly")
	method boolean Initialize()
		-- View를 준비합니다. 이벤트는 모든 앱의 초기화 후 연결합니다.
		if self.IsInitialized then
			return true
		end

		self.View:Initialize()
		self.IsInitialized = true
		return true
	end

	@ExecSpace("ClientOnly")
	method void ConnectEvents()
		-- 스탯 앱은 내부 이벤트를 구독하지 않습니다. 공통 데이터 변경은 관리자가 전달합니다.
	end

	@ExecSpace("ClientOnly")
	method void Open()
		-- 앱을 열고 현재 캐릭터 데이터를 표시합니다.
		self.IsOpen = true
		self:Refresh()
		self.View:SetVisible(true)
	end

	@ExecSpace("ClientOnly")
	method void Close()
		-- 앱 화면을 닫습니다.
		self.IsOpen = false
		self.View:SetVisible(false)
	end

	@ExecSpace("ClientOnly")
	method void Refresh()
		-- 기존 데이터 매니저에서 앱의 최신 표시 데이터를 읽습니다.
		self:RefreshStatCharacters()
	end

	@ExecSpace("ClientOnly")
	method void RefreshLocalized()
		-- 언어 변경에 맞춰 앱의 동적 텍스트를 다시 표시합니다.
		self:Refresh()
	end

	@ExecSpace("ClientOnly")
	method void OnNewContentChanged()
		-- 스탯 앱은 새 콘텐츠 알림에 따라 갱신할 항목이 없습니다.
	end

	@ExecSpace("ClientOnly")
	method boolean RefreshBadges()
		-- 스탯 앱은 새 콘텐츠 배지가 없으므로 항상 false를 반환합니다.
		return false
	end

	-- Private Methods

	@ExecSpace("ClientOnly")
	method void RefreshStatCharacters()
		-- 캐릭터 매니저의 보유 캐릭터 3명을 스탯 카드에 반영합니다.
		local characters = _CharacterManager:ClientGetActiveCharacters()

		for index = 1, 3 do
			self:SetStatCard(index, characters[index])
		end
	end

	@ExecSpace("ClientOnly")
	method void SetStatCard(integer index, any character)
		-- 캐릭터 데이터를 카드에 표시할 값으로 변환해 View에 전달합니다.
		if character == nil then
			self.View:HideCard(index)
			return
		end

		self.View:ShowCard(
			index,
			_SmartPhoneUIUtil:GetLocalizedCharacterName(character),
			character.vocal or 0,
			character.dance or 0,
			character.visual or 0,
			character.fatigue or 0,
			_SmartPhoneUIUtil:GetCharacterPortraitRuid(character.id),
			_ConditionMaster:GetConditionIconRuidByFatigue(character.fatigue or 0) or ""
		)
	end

end

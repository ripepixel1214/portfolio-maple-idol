---@description "스마트폰 앨범 앱의 탭, 목록, 상세 선택과 방문 상태."
@Logic
script SmartPhoneAlbumAppLogic extends Logic

	property ButtonComponent MenuButton = "8a566345-be2d-4407-be79-ac77bbc4f7c6"

	property Entity MenuNewBadgeEntity = "aabb640b-625a-42ec-af96-1bbcb439c8e2"

	property AlbumAppViewComponent View = "76e1b7cf-6a9e-49f5-9b34-0835dd342dda"

	property boolean IsInitialized = false

	property boolean IsOpen = false

	property any cherishedItemTabClickHandler = nil

	property any fanPresentTabClickHandler = nil

	property any photoCardTabClickHandler = nil

	property string currentAlbumTabKey = "photoCard"

	property string albumNewSnapshotCategory = ""

	property any albumNewItemSnapshotSet = {}

	property any albumNewItemViewByItemId = {}

	property integer MinAlbumSlotCount = 35

	property any albumCardClickHandlers = {}

	property string selectedAlbumItemId = ""

	property string selectedFanPresentItemId = ""

	property string selectedPhotoCardItemId = ""

	-- Public API

	-- SmartPhoneUILogic이 검사하는 앱 계약 메서드입니다.

	@ExecSpace("ClientOnly")
	method boolean Initialize()
		-- UI 참조와 초기 표시 상태를 준비합니다. 이벤트는 모든 앱의 초기화 후 연결합니다.
		if self.IsInitialized then
			return true
		end
		self.View:Initialize()
		self.IsInitialized = true
		return true
	end

	@ExecSpace("ClientOnly")
	method void ConnectEvents()
		-- 스마트폰 관리자가 모든 앱의 초기화를 마친 뒤 입력과 데이터 이벤트를 연결합니다.
		self.View:ConnectEvents()
		self:ConnectAlbumTabButtons()
	end

	@ExecSpace("ClientOnly")
	method void Open()
		-- 스마트폰 관리자가 초기화를 마친 앱을 열고 현재 데이터로 표시를 갱신합니다.
		self.IsOpen = true
		self:ShowAlbumTab("photoCard")
		self.View:SetVisible(true)
	end

	@ExecSpace("ClientOnly")
	method void Close()
		-- 초기화된 앱의 방문 상태를 정리하고 화면을 닫습니다.
		self:ClearAlbumNewItemSnapshot()
		self.View:StopAnimations()
		self.IsOpen = false
		self.View:SetVisible(false)
	end

	@ExecSpace("ClientOnly")
	method void Refresh()
		-- 기존 데이터 매니저에서 앱의 최신 표시 데이터를 읽습니다.
		self:RefreshAlbumItems()
	end

	@ExecSpace("ClientOnly")
	method void RefreshLocalized()
		-- 언어 변경에 맞춰 앱의 동적 텍스트를 다시 표시합니다.
		self:Refresh()
	end

	@ExecSpace("ClientOnly")
	method void OnNewContentChanged()
		-- 열린 앨범의 새 항목을 방문 상태에 합치고 목록에 반영합니다.
		if self.IsOpen then
			self:CaptureAlbumNewItemsForCurrentTab()
			self:RefreshAlbumItems()
		end
	end

	@ExecSpace("ClientOnly")
	method boolean RefreshBadges()
		-- 저장된 미확인 정보와 현재 방문 상태를 합쳐 앱 내부 배지를 갱신합니다.
		local categories = {"cherishedItem", "fanPresent", "photoCard"}
		local hasAnyNew = _NewContentManager:ClientHasAnyNewContent("album", "")
		local hasSnapshot = self:HasAlbumNewItemSnapshot()
		for _, category in ipairs(categories) do
			local isNew = _NewContentManager:ClientHasAnyNewContent("album", category)
			if hasSnapshot and self.albumNewSnapshotCategory == category then
				isNew = true
			end
			self.View:SetCategoryBadge(category, isNew)
		end
		local hasAppNew = hasAnyNew or hasSnapshot
		_SmartPhoneUIUtil:SetEntityEnable(self.MenuNewBadgeEntity, hasAppNew)
		return hasAppNew
	end

	-- Private Methods

	@ExecSpace("ClientOnly")
	method void ConnectAlbumTabButtons()
		-- 앨범 내부 탭 버튼을 애장품/팬선물/포토카드 컨텐츠 전환에 연결합니다.
		local buttons = self.View:GetTabButtons()
		if self.cherishedItemTabClickHandler == nil then
			self.cherishedItemTabClickHandler = buttons.cherishedItem.Entity:ConnectEvent(ButtonClickEvent, self.OnCherishedItemTabClicked)
		end

		if self.fanPresentTabClickHandler == nil then
			self.fanPresentTabClickHandler = buttons.fanPresent.Entity:ConnectEvent(ButtonClickEvent, self.OnFanPresentTabClicked)
		end

		if self.photoCardTabClickHandler == nil then
			self.photoCardTabClickHandler = buttons.photoCard.Entity:ConnectEvent(ButtonClickEvent, self.OnPhotoCardTabClicked)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnCherishedItemTabClicked(ButtonClickEvent event)
		-- 체리쉬드 아이템 탭을 선택합니다.
		self:ShowAlbumTab("cherishedItem")
	end

	@ExecSpace("ClientOnly")
	method void OnFanPresentTabClicked(ButtonClickEvent event)
		-- 팬 선물 탭을 선택합니다.
		self:ShowAlbumTab("fanPresent")
	end

	@ExecSpace("ClientOnly")
	method void OnPhotoCardTabClicked(ButtonClickEvent event)
		-- 포토카드 탭을 선택합니다.
		self:ShowAlbumTab("photoCard")
	end

	@ExecSpace("ClientOnly")
	method void ShowAlbumTab(string tabKey)
		-- 앨범 내부 컨텐츠 중 선택된 탭의 계열만 표시합니다.
		self.View:SetTab(tabKey)
		self.currentAlbumTabKey = tabKey

		if self.IsOpen and self.albumNewSnapshotCategory ~= tabKey then
			self:BeginAlbumTabVisit(tabKey)
			self:RefreshAlbumItems()
		end
	end

	@ExecSpace("ClientOnly")
	method void CaptureAlbumNewItemsForCurrentTab()
		-- 현재 보고 있는 앨범 탭에서 새로 동기화된 항목을 방문 스냅샷에 합칩니다.
		if self.currentAlbumTabKey == "" then
			return
		end

		local contentIds = _NewContentManager:ClientGetNewContentIds("album", self.currentAlbumTabKey)
		if #contentIds > 0 then
			self.albumNewSnapshotCategory = self.currentAlbumTabKey
		end
		for _, contentId in ipairs(contentIds) do
			if contentId ~= nil and contentId ~= "" then
				self.albumNewItemSnapshotSet[contentId] = true
			end
		end

		if #contentIds > 0 then
			_NewContentManager:RequestAcknowledgeCategory("album", self.currentAlbumTabKey)
		end
	end

	@ExecSpace("ClientOnly")
	method boolean HasAlbumNewItemSnapshot()
		-- 현재 앨범 방문에서 NEW 항목이 남아 있는지 확인합니다.
		for _, isNew in pairs(self.albumNewItemSnapshotSet) do
			if isNew == true then
				return true
			end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method void BeginAlbumTabVisit(string category)
		-- 앨범 탭의 새 항목을 방문 상태로 복사한 뒤 확인 처리를 요청합니다.
		self:ClearAlbumNewItemSnapshot()
		self.albumNewSnapshotCategory = category or ""
		if self.albumNewSnapshotCategory == "" then
			return
		end

		local contentIds = _NewContentManager:ClientGetNewContentIds("album", self.albumNewSnapshotCategory)
		for _, contentId in ipairs(contentIds) do
			if contentId ~= nil and contentId ~= "" then
				self.albumNewItemSnapshotSet[contentId] = true
			end
		end
		self:NotifyBadgesChanged()

		if #contentIds > 0 then
			_NewContentManager:RequestAcknowledgeCategory("album", self.albumNewSnapshotCategory)
		end
	end

	@ExecSpace("ClientOnly")
	method void ClearAlbumNewItemSnapshot()
		-- 앨범 방문 상태와 슬롯별 배지 참조를 비웁니다.
		self.albumNewSnapshotCategory = ""
		self.albumNewItemSnapshotSet = {}
		self.albumNewItemViewByItemId = {}
		self:NotifyBadgesChanged()
	end

	@ExecSpace("ClientOnly")
	method boolean IsAlbumItemNewInSnapshot(any tItem)
		-- 아이템이 이번 방문의 NEW 목록에 포함되는지 확인합니다.
		if tItem == nil then
			return false
		end

		local itemId = tItem.itemId or ""
		return itemId ~= "" and self.albumNewItemSnapshotSet[itemId] == true
	end

	@ExecSpace("ClientOnly")
	method void DismissAlbumItemNewBadge(string itemId)
		-- 클릭한 앨범 아이템의 방문 배지를 해제합니다.
		if itemId == nil or itemId == "" then
			return
		end

		self.albumNewItemSnapshotSet[itemId] = nil
		local itemView = self.albumNewItemViewByItemId[itemId]
		if itemView ~= nil then
			itemView:SetNewBadge(false)
		end
		self.albumNewItemViewByItemId[itemId] = nil
		self:NotifyBadgesChanged()
	end

	@ExecSpace("ClientOnly")
	method void RefreshAlbumItems()
		-- ItemManager의 보유 아이템 수와 최소 35칸 조건을 기준으로 앨범 슬롯을 다시 구성합니다.
		local items = _ItemManager:ClientGetOwnedItems()

		local cherishedItems = self:FilterAlbumItemsByType(items, "cherished")
		local fanPresentItems = self:FilterAlbumItemsByType(items, "fanPresent")
		local photoCardItems = self:FilterAlbumItemsByType(items, "photoCard")

		self:ClearAlbumRuntimeCards()
		self:RebuildAlbumCards(cherishedItems, self:GetAlbumCardCount(cherishedItems), "cherishedItem")
		self:RebuildAlbumCards(fanPresentItems, self:GetAlbumCardCount(fanPresentItems), "fanPresent")
		self:RebuildAlbumCards(photoCardItems, self:GetAlbumCardCount(photoCardItems), "photoCard")
		self:RefreshSelectedAlbumInfo(cherishedItems)
		self:RefreshSelectedFanPresentInfo(fanPresentItems)
		self:RefreshSelectedPhotoCardInfo(photoCardItems)
	end

	@ExecSpace("ClientOnly")
	method integer GetAlbumCardCount(any items)
		-- 목록 개수를 기준으로 최소 앨범 슬롯 개수를 보장합니다.
		local cardCount = #items
		if cardCount < self.MinAlbumSlotCount then
			cardCount = self.MinAlbumSlotCount
		end

		return cardCount
	end

	@ExecSpace("ClientOnly")
	method any FilterAlbumItemsByType(any items, string gridType)
		-- 아이템 타입에 따라 애장품/팬선물/포토카드 그리드에 들어갈 목록을 분리합니다.
		local filteredItems = {}
		if items == nil then
			return filteredItems
		end

		for _, tItem in ipairs(items) do
			if self:IsAlbumItemForGrid(tItem, gridType) then
				table.insert(filteredItems, tItem)
			end
		end

		return filteredItems
	end

	@ExecSpace("ClientOnly")
	method boolean IsAlbumItemForGrid(any tItem, string gridType)
		-- 애장품, 팬선물, 포토카드 그리드가 담당하는 아이템 타입인지 확인합니다.
		if tItem == nil then
			return false
		end

		local itemType = tItem.type or ""
		if gridType == "photoCard" then
			return itemType == "photoCard" or itemType == "photocard"
		end
		if gridType == "fanPresent" then
			return itemType == "present" or itemType == "fan"
		end

		return itemType == "cherished"
	end

	@ExecSpace("ClientOnly")
	method void RebuildAlbumCards(any items, integer cardCount, string tabKey)
		-- items: ItemRow[]
		-- Item01/Item04 템플릿을 런타임 카드로 복제하고 아이템 또는 잠금 슬롯 정보를 채웁니다.
		for index = 1, cardCount do
			local tItem = items[index]
			local itemView = self.View:CreateItem(tabKey, self:GetAlbumRuntimeCardName(index), index)
			if itemView ~= nil then
				self:SetAlbumCard(itemView, tItem)
				if tItem ~= nil then
					self:ConnectAlbumCardClick(itemView:GetClickEntity(), tItem)
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ClearAlbumRuntimeCards()
		-- 앨범 런타임 슬롯과 클릭 핸들러를 모두 정리합니다.
		self:DisconnectAlbumCardClicks()
		self.View:ClearItems()
		self.albumNewItemViewByItemId = {}
	end

	@ExecSpace("ClientOnly")
	method void ConnectAlbumCardClick(Entity card, any tItem)
		-- tItem: ItemRow
		-- 아이템이 있는 슬롯만 클릭 가능하게 연결합니다.
		if card == nil or tItem == nil or tItem.itemId == nil or tItem.itemId == "" then
			return
		end

		local capturedItemId = tItem.itemId
		local clickHandler = card:ConnectEvent(ButtonClickEvent, function()
			self:OnAlbumCardClicked(capturedItemId)
		end)

		table.insert(self.albumCardClickHandlers, { entity = card, eventHandler = clickHandler })
	end

	@ExecSpace("ClientOnly")
	method void DisconnectAlbumCardClicks()
		-- 앨범 슬롯에 연결한 클릭 핸들러를 해제합니다.
		if self.albumCardClickHandlers == nil then
			self.albumCardClickHandlers = {}
			return
		end

		for _, item in ipairs(self.albumCardClickHandlers) do
			if item.entity ~= nil and isvalid(item.entity) and item.eventHandler ~= nil then
				item.entity:DisconnectEvent(ButtonClickEvent, item.eventHandler)
			end
		end

		self.albumCardClickHandlers = {}
	end

	@ExecSpace("ClientOnly")
	method void OnAlbumCardClicked(string itemId)
		-- 선택한 앨범 아이템의 상세 정보를 오른쪽 패널에 반영합니다.
		if itemId == "" then
			return
		end

		local tItem = _ItemMaster:GetItemById(itemId)
		if tItem == nil then
			return
		end

		self:DismissAlbumItemNewBadge(itemId)

		if self:IsAlbumItemForGrid(tItem, "photoCard") then
			self:SetPhotoCardInfo(tItem)
			return
		end
		if self:IsAlbumItemForGrid(tItem, "fanPresent") then
			self:SetFanPresentInfo(tItem)
			return
		end

		self:SetAlbumInfo(tItem)
	end

	@ExecSpace("ClientOnly")
	method void RefreshSelectedAlbumInfo(any items)
		-- items: ItemRow[]
		-- 기존 선택을 유지하고, 없으면 첫 번째 아이템을 상세 패널에 표시합니다.
		local selectedItem = nil
		if self.selectedAlbumItemId ~= "" then
			selectedItem = self:FindAlbumItemInList(items, self.selectedAlbumItemId)
		end

		if selectedItem == nil then
			selectedItem = items[1]
		end

		self:SetAlbumInfo(selectedItem)
	end

	@ExecSpace("ClientOnly")
	method void RefreshSelectedFanPresentInfo(any items)
		-- 팬선물 목록에서 기존 선택을 유지하고, 없으면 첫 번째 아이템을 상세 패널에 표시합니다.
		local selectedItem = nil
		if self.selectedFanPresentItemId ~= "" then
			selectedItem = self:FindAlbumItemInList(items, self.selectedFanPresentItemId)
		end

		if selectedItem == nil then
			selectedItem = items[1]
		end

		self:SetFanPresentInfo(selectedItem)
	end

	@ExecSpace("ClientOnly")
	method any FindAlbumItemInList(any items, string itemId)
		-- items: ItemRow[]
		-- 목록에서 itemId에 해당하는 ItemRow를 찾습니다.
		if items == nil or itemId == "" then
			return nil
		end

		for _, tItem in ipairs(items) do
			if tItem ~= nil and tItem.itemId == itemId then
				return tItem
			end
		end

		return nil
	end

	@ExecSpace("ClientOnly")
	method void SetAlbumCard(any itemView, any tItem)
		-- tItem: ItemRow
		-- 앨범 슬롯에 아이템 이미지 또는 잠금 이미지를 표시합니다.
		if tItem == nil then
			itemView:ShowLocked()
			return
		end

		local isNew = self:IsAlbumItemNewInSnapshot(tItem)
		itemView:ShowItem(self:GetAlbumItemImageRuid(tItem), isNew)
		if isNew then
			self.albumNewItemViewByItemId[tItem.itemId or ""] = itemView
		end
	end

	@ExecSpace("ClientOnly")
	method void SetAlbumInfo(any tItem)
		-- tItem: ItemRow
		-- 선택한 앨범 아이템의 이미지, 이름, 설명, 타입 배지를 갱신합니다.
		if tItem == nil then
			self.selectedAlbumItemId = ""
			self.View:ShowAlbumDetail("", "", "", false)
			return
		end

		self.selectedAlbumItemId = tItem.itemId or ""
		self.View:ShowAlbumDetail(tItem.name or "", tItem.description or "", self:GetAlbumItemImageRuid(tItem), true)
	end

	@ExecSpace("ClientOnly")
	method void SetFanPresentInfo(any tItem)
		-- tItem: ItemRow
		-- 선택한 팬선물 아이템의 이미지, 이름, 설명, 타입 배지를 갱신합니다.
		if tItem == nil then
			self.selectedFanPresentItemId = ""
			self.View:ShowFanPresentDetail("", "", "", false)
			return
		end

		self.selectedFanPresentItemId = tItem.itemId or ""
		self.View:ShowFanPresentDetail(tItem.name or "", tItem.description or "", self:GetAlbumItemImageRuid(tItem), true)
	end

	@ExecSpace("ClientOnly")
	method void RefreshSelectedPhotoCardInfo(any items)
		-- 포토카드 목록에서 기존 선택을 유지하고, 없으면 첫 번째 포토카드를 상세 영역에 표시합니다.
		local selectedItem = nil
		if self.selectedPhotoCardItemId ~= "" then
			selectedItem = self:FindAlbumItemInList(items, self.selectedPhotoCardItemId)
		end

		if selectedItem == nil then
			selectedItem = items[1]
		end

		self:SetPhotoCardInfo(selectedItem)
	end

	@ExecSpace("ClientOnly")
	method void SetPhotoCardInfo(any tItem)
		-- 선택된 포토카드 아이템과 PhotoCardTable 데이터를 합쳐 포토카드 상세 UI를 갱신합니다.
		if tItem == nil then
			self.selectedPhotoCardItemId = ""
			self.View:ShowPhotoCardDetail("", "", "", "", "", "", false)
			return
		end

		local itemId = tItem.itemId or ""
		self.selectedPhotoCardItemId = itemId
		local tMasterItem = self:GetItemById(itemId)
		local cardName = tItem.name or ""
		local description = tItem.description or ""
		if tMasterItem ~= nil then
			cardName = tMasterItem.name or ""
			description = tMasterItem.description or ""
		end

		local tPhotoCard = _PhotoCardMaster:GetPhotoCardByItemId(itemId)

		if tPhotoCard == nil then
			self.View:ShowPhotoCardDetail("", cardName, description, "", "", "", false)
			return
		end

		---@type PhotoCardRow
		local photoCardRow = tPhotoCard
		self.View:ShowPhotoCardDetail(
			_SmartPhoneUIUtil:GetActorName(photoCardRow.characterId or ""),
			cardName,
			description,
			_SmartPhoneUIUtil:GetCharacterVerticalPortraitRuid(photoCardRow.characterId or ""),
			_ResourceMaster:ResolveResourceId(photoCardRow.cardFront or ""),
			_ResourceMaster:ResolveResourceId(photoCardRow.cardBack or ""),
			true
		)
	end

	@ExecSpace("ClientOnly")
	method string GetAlbumItemImageRuid(any tItem)
		-- tItem: ItemRow
		-- ItemRow.image 값을 실제 UI ImageRUID로 변환합니다.
		if tItem == nil then
			return ""
		end

		local image = tItem.image or ""
		return _ResourceMaster:ResolveResourceId(image)
	end

	@ExecSpace("ClientOnly")
	method string GetAlbumRuntimeCardName(integer index)
		-- 앨범 카드 인덱스를 런타임 전용 복제 카드 이름으로 변환합니다.
		if index < 10 then
			return "RuntimeAlbumItem0" .. tostring(index)
		end

		return "RuntimeAlbumItem" .. tostring(index)
	end

	@ExecSpace("ClientOnly")
	method any GetItemById(string itemId)
		-- ItemTable 기준 ItemRow를 조회합니다.
		if itemId == nil or itemId == "" then
			return nil
		end

		return _ItemMaster:GetItemById(itemId)
	end

	@ExecSpace("ClientOnly")
	method void NotifyBadgesChanged()
		-- 앱 방문 상태가 바뀌면 스마트폰 메뉴 배지를 다시 집계합니다.
		_SmartPhoneUILogic:RefreshNewContentBadges()
	end

end

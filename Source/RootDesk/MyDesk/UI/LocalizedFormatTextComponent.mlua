---@description "에디터에 설정된 로컬라이즈 키에 실행 중 값을 적용해 표시합니다."
@Component
script LocalizedFormatTextComponent extends Component

	property string LocalizationKey = ""

	-- Public API

	@ExecSpace("ClientOnly")
	method void SetArguments(any value1, any value2, any value3, any value4)
		self.Entity.TextGUIRendererComponent.Text = _LocaleTextUtil:Format(self.LocalizationKey, value1, value2, value3, value4)
	end

end

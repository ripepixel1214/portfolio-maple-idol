@Logic
script TagTrainingUILogic extends Logic
	property string TEXT_TAG_TRAINING_FATIGUE = "tag_training_fatigue"

	property Entity root = "483451ef-aa92-42fc-9cfc-d6ed2f509abb"
	property EntityRef closeButton = "383dc183-860b-4fcb-b3c8-e1aa8981afdf"
	property EntityRef resultRoot = "ad6c10c3-e8a2-4e46-81de-0459af8b5843"
	property string successEffectRuid = "54ddb99704ad49019d5a6b0d45226e8a"
	property string failureEffectRuid = "4feefaa857f945b79245d8a5ebd21023"
	property string successSoundRuid = "2e1b79ab613447c6bf332fa0adbfbaf4"
	property string failureSoundRuid = "0e97d39a68ad4a978268579a606e64fc"
	property number resultSoundVolume = 0.65
	property number resultEffectScale = 1.9
	property Vector2 resultEffectOffset = Vector2(-180, 80)
	property integer debugResultCharacterIndex = 2
	property string emptyTagBackgroundRuid = "05960bca189b4734a00473ed26ec5733"
	property string lockedTagBackgroundRuid = "18c6da25f41f400d86cdf92c93f742bc"
	property string tagBackgroundRuid = "b0759810ab55423e9323a2730e71eff3"
	property string overflowTagBackgroundRuid = "d3530b867c684936bd3f7ffec68a656a"
	property string settlementDialogId = "tag_training_settlement"
	property string settlementMessage = "임시 결산 문구 입니다."
	property Vector2 overflowListTagSize = Vector2(188.74, 60.42)
	property number tagLongPressDuration = 0.5
	property any state = nil
	property any connections = {}
	property any profiles = {}
	property any cards = {}
	property any characterIds = {}
	property any selectedTagIndexSet = {}
	property any overflowChips = {}
	property integer dragIndex = 0
	property integer dragTouchId = 0
	property Vector2 dragStart = Vector2(0, 0)
	property Vector2 dragOrigin = Vector2(0, 0)
	property boolean dragged = false
	property integer previewIndex = 0
	property boolean waiting = false
	property number waitingTime = 0
	property any heldChip = nil
	property Entity tooltipChip = nil
	property integer tooltipShowFrames = 0
	property boolean openRequested = false

	------------------------------------------------------------------------------------------------------------------------------------------------------
	-- Public API
	------------------------------------------------------------------------------------------------------------------------------------------------------

	@ExecSpace("ClientOnly")
	method void Open()
		-- 저장된 육성을 이어 요청합니다. 패널을 닫거나 재접속해도 선택지를 재추첨하지 않습니다.
		self.openRequested = true
		self.waiting = true
		_TagTrainingManager:RequestOpen()
	end

	@ExecSpace("ClientOnly")
	method void Close()
		-- 육성 저장은 유지하고 패널 표시·드래그·설명·월드 입력 잠금만 정리합니다.
		self.openRequested = false
		self:CancelDrag()
		self.heldChip = nil
		self:HideTooltip()
		self:UpdateCardHighlights(1)
		self.state = nil
		self.waiting = false
		self.waitingTime = 0
		self.root.Enable = false
		self.root:GetChildByName("Overflow").Enable = false
		if isvalid(self._T.debugResultEffect) then self._T.debugResultEffect.Enable = false end
		_UIVisibilityNotifierLogic:SendFrom(self, "tagTraining", false)
	end

	@ExecSpace("ClientOnly")
	method void ApplyState(table state, table result)
		-- 서버 응답을 반영하되 닫힌 화면을 늦은 응답으로 다시 열지 않습니다.
		local previousStateVersion = self.state ~= nil and self.state.stateVersion or -1
		local reopening = self.root.Enable == false
		self.waiting = self.resultRoot:GetChildByName("Effect").Enable
		self.waitingTime = 0
		self.state = state
		if state.pending == false and state.usedTurns >= state.totalTurns then self._T.pendingSettlementCards = state.settlementCards end
		if self.openRequested == false then return end
		self.root.Enable = true
		_UIVisibilityNotifierLogic:SendFrom(self, "tagTraining", true)
		self:RefreshProfiles(nil)
		if reopening or previousStateVersion ~= state.stateVersion then self.heldChip = nil; self:HideTooltip(); self:RefreshChoices() end
		self:RefreshHeader()
		if result.failed ~= nil and previousStateVersion < state.stateVersion then self:PlayChoiceResult(result) end
		if reopening or previousStateVersion ~= state.stateVersion then self:RefreshOverflow() end
		self:TryOpenSettlement()
	end

	------------------------------------------------------------------------------------------------------------------------------------------------------
	-- Event Handlers
	------------------------------------------------------------------------------------------------------------------------------------------------------

	@ExecSpace("ClientOnly")
	method void OnCardDown(integer index, UITouchDownEvent event)
		-- 다른 손가락이나 처리 중인 요청이 드래그를 덮어쓰지 않게 합니다.
		if self.waiting or self.state == nil or self.state.pending ~= false or self.dragIndex ~= 0 then return end
		local choice = self.state.choices[index]
		if choice == nil or choice.sealed == true or (event.TouchId < 0 and event.TouchId ~= -1) then return end
		self.dragIndex = index
		self.dragTouchId = event.TouchId
		self.dragStart = event.TouchPoint
		self.dragOrigin = self.cards[index].UITransformComponent.anchoredPosition
		self.dragged = false
		_UILogic:SetSiblingIndex(self.cards[index].UITransformComponent, 10000)
	end

	@ExecSpace("ClientOnly")
	method void OnCardDrag(integer index, UITouchDragEvent event)
		-- 화면 좌표를 부모 UI 좌표로 변환해 해상도에 무관하게 드래그합니다.
		if self.dragIndex ~= index or self.dragTouchId ~= event.TouchId then return end
		local parent = self.cards[index].Parent.UITransformComponent
		local start = _UILogic:ScreenToLocalUIPosition(self.dragStart, parent)
		local current = _UILogic:ScreenToLocalUIPosition(event.TouchPoint, parent)
		local movement = current - start
		if self.dragged == false and movement.x * movement.x + movement.y * movement.y < 64 then return end
		self.heldChip = nil
		self:HideTooltip()
		self.cards[index].UITransformComponent.anchoredPosition = self.dragOrigin + current - start
		self.dragged = true
		local target = self:FindDropTarget(event.TouchPoint)
		self:RefreshProfiles(target)
	end

	@ExecSpace("ClientOnly")
	method void OnCardUp(integer index, UITouchUpEvent event)
		-- 유효한 캐릭터 위에 놓았을 때만 서버에 수행을 요청합니다.
		if self.dragIndex ~= index or self.dragTouchId ~= event.TouchId then return end
		-- 태그를 짧게 누른 입력은 카드 수행 없이 설명을 유지합니다.
		if self.dragged == false then self.dragIndex = 0; return end
		local target = self:FindDropTarget(event.TouchPoint)
		self:CancelDrag()
		if target == nil then return end
		self.waiting = true
		_TagTrainingManager:RequestUseChoice(self.state.stateVersion, index, self.characterIds[target])
	end

	@ExecSpace("ClientOnly")
	method void OnChipDown(Entity chip, string tagId, integer index, UITouchDownEvent event)
		-- 짧은 터치와 모바일 길게 누르기를 구분할 입력 상태를 기억합니다.
		if tagId == "" or self.heldChip ~= nil or (event.TouchId < 0 and event.TouchId ~= -1) then return end
		if index > 0 and (self.waiting or self.state == nil or self.state.pending == false) then return end
		self.heldChip = {entity = chip, tagId = tagId, index = index, touchId = event.TouchId, start = event.TouchPoint, mobile = Environment:IsMobilePlatform(), holdTime = 0, longPressed = false, cancelled = false}
		if self.heldChip.mobile then self:HideTooltip() end
	end

	@ExecSpace("ClientOnly")
	method void OnChipDrag(UITouchDragEvent event)
		-- 손가락을 움직이거나 목록을 스크롤한 입력은 태그 교체와 길게 누르기에서 제외합니다.
		local held = self.heldChip
		if held == nil or held.touchId ~= event.TouchId or held.cancelled then return end
		local parent = self.root.UITransformComponent
		local start = _UILogic:ScreenToLocalUIPosition(held.start, parent)
		local current = _UILogic:ScreenToLocalUIPosition(event.TouchPoint, parent)
		local movement = current - start
		if movement.x * movement.x + movement.y * movement.y < 64 then return end
		held.cancelled = true
		self:HideTooltip()
	end

	@ExecSpace("ClientOnly")
	method void OnChipUp(UITouchUpEvent event)
		-- 짧은 터치는 태그를 넣고 빼며 모바일 설명은 손을 떼면 닫고 교체하지 않습니다.
		if self.heldChip == nil or self.heldChip.touchId ~= event.TouchId then return end
		local held = self.heldChip
		self.heldChip = nil
		if held.mobile then self:HideTooltip() end
		if held.cancelled or held.longPressed then return end
		if self:IsPointInside(held.entity, event.TouchPoint) == false then return end
		local index = held.index
		if index > 0 and self.waiting == false then
			self:HideTooltip()
			self:MoveOverflowTag(index, self.selectedTagIndexSet[index] and self._T.overflowRegions[index] or 2)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnMouseMove(MouseMoveEvent event)
		-- PC 호버 설명만 마우스를 따라가고 모바일 설명은 누른 위치에 유지합니다.
		if self.root.Enable and Environment:IsPCPlatform() and self.tooltipChip ~= nil then self:PositionTooltip(_InputService:GetCursorPosition()) end
	end

	@ExecSpace("ClientOnly")
	method void OnProgressChanged(ProgressChangedEvent event)
		-- 마지막 결과 연출 중에는 진행 스텝이 바뀌어도 닫기를 연출 종료까지 미룹니다.
		local progress = _ProgressManager:ClientGetProgress()
		if progress == nil or progress.eCurrentStep == _EProgressStep.BeforeTraining then return end
		if self.resultRoot:GetChildByName("Effect").Enable then return end
		if self:TryOpenSettlement() == false then self:Close() end
	end

	@ExecSpace("ClientOnly")
	method void OnDialogClosed(DialogClosedEvent event)
		-- 태그 육성 결산 문구가 끝나면 함께 표시한 캐릭터 결산 카드를 닫습니다.
		if event.dialogId == self.settlementDialogId then _SettlementCardUILogic:Close() end
	end

	@ExecSpace("ClientOnly")
	method void OnChoiceResultEnd(SpriteGUIAnimPlayerEndEvent event)
		-- 결과 연출을 숨기고 입력을 해제한 뒤 필요한 경우 태그 교체창을 표시합니다.
		event.Entity.Enable = false
		event.Entity.SpriteGUIRendererComponent.ImageRUID = DataRef("")
		self.waiting = false
		self.waitingTime = 0
		local progress = _ProgressManager:ClientGetProgress()
		if self:TryOpenSettlement() then return end
		if progress ~= nil and progress.eCurrentStep ~= _EProgressStep.BeforeTraining then self:Close(); return end
		if self.root.Enable and self.state ~= nil then self:RefreshOverflow() end
	end

	------------------------------------------------------------------------------------------------------------------------------------------------------
	-- Debug
	------------------------------------------------------------------------------------------------------------------------------------------------------

	@ExecSpace("ClientOnly")
	method void OnDebugKeyDown(KeyDownEvent event)
		-- J/K로 재생하고 방향키로 위치, PageUp/PageDown으로 크기를 조절하며 Enter로 최종 값을 출력합니다.
		if Environment:IsMakerPlay() == false or self.root.Enable == false or self.waiting or self.dragIndex ~= 0 then return end
		if event.key == KeyboardKey.J then self:DebugPlayChoiceResult(self.debugResultCharacterIndex, false); return end
		if event.key == KeyboardKey.K then self:DebugPlayChoiceResult(self.debugResultCharacterIndex, true); return end
		if event.key == KeyboardKey.Return or event.key == KeyboardKey.KeypadEnter then log(string.format("[TagTrainingUILogic] resultEffectOffset = Vector2(%g, %g), resultEffectScale = %.2f", self.resultEffectOffset.x, self.resultEffectOffset.y, self.resultEffectScale)); return end
		local offset = self.resultEffectOffset
		local scale = self.resultEffectScale
		local fineAdjustment = _InputService:IsKeyPressed(KeyboardKey.LeftShift) or _InputService:IsKeyPressed(KeyboardKey.RightShift)
		local step = fineAdjustment and 1 or 10
		local scaleStep = fineAdjustment and 0.01 or 0.1
		if event.key == KeyboardKey.LeftArrow then offset = offset + Vector2(-step, 0)
		elseif event.key == KeyboardKey.RightArrow then offset = offset + Vector2(step, 0)
		elseif event.key == KeyboardKey.UpArrow then offset = offset + Vector2(0, step)
		elseif event.key == KeyboardKey.DownArrow then offset = offset + Vector2(0, -step)
		elseif event.key == KeyboardKey.Home then offset = Vector2(0, 0)
		elseif event.key == KeyboardKey.PageUp then scale = scale + scaleStep
		elseif event.key == KeyboardKey.PageDown then scale = math.max(0.1, scale - scaleStep)
		else return end
		local profile = self.profiles[self.debugResultCharacterIndex]
		if profile == nil or profile.Enable == false then return end
		self.resultEffectOffset = offset
		self.resultEffectScale = scale
		-- 위치·크기 조절 중에는 소리를 반복하지 않고 마지막에 선택한 연출만 새 설정으로 다시 보여줍니다.
		self:PlayResultSprite(self._T.debugResultEffect, profile, self._T.debugResultFailed)
	end

	@ExecSpace("ClientOnly")
	method void DebugPlayChoiceResult(integer characterIndex, boolean failed)
		-- 왼쪽부터 1~3번 캐릭터 위치에 결과 연출과 효과음만 재생하며 수치·태그·턴은 변경하지 않습니다.
		if Environment:IsMakerPlay() == false or self.root.Enable == false or self.waiting or self.dragIndex ~= 0 then return end
		local profile = self.profiles[characterIndex]
		if profile == nil or profile.Enable == false then return end
		self._T.debugResultFailed = failed
		self:PlayResultSprite(self._T.debugResultEffect, profile, failed)
		_SoundService:PlaySound(failed and self.failureSoundRuid or self.successSoundRuid, self.resultSoundVolume)
	end

	@ExecSpace("ClientOnly")
	method void OnDebugResultEnd(SpriteGUIAnimPlayerEndEvent event)
		-- 디버그 연출만 숨기고 실제 결과 완료 처리나 태그 교체창 갱신은 실행하지 않습니다.
		event.Entity.Enable = false
		event.Entity.SpriteGUIRendererComponent.ImageRUID = DataRef("")
	end

	------------------------------------------------------------------------------------------------------------------------------------------------------
	-- LifeCycle
	------------------------------------------------------------------------------------------------------------------------------------------------------

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 기존 UI 원형을 재사용하고 모든 입력 연결을 해제 가능한 목록으로 보관합니다.
		self.connections = {}
		self.state = nil
		self.openRequested = false
		self.profiles = {}
		self.cards = {}
		self._T.tagIdByChipId = {}
		self._T.cardHighlightLevels = {}
		self._T.cardHighlightTime = 0
		self._T.pendingSettlementCards = nil
		self.root.Enable = false
		self:Connect(self.closeButton, ButtonClickEvent, function()
			local effect = self.resultRoot:GetChildByName("Effect")
			effect.Enable = false
			effect.SpriteGUIRendererComponent.ImageRUID = DataRef("")
			if self:TryOpenSettlement() == false then self:Close() end
		end)
		self.resultRoot:GetChildByName("Effect").Enable = false
		self:Connect(self.resultRoot:GetChildByName("Effect"), SpriteGUIAnimPlayerEndEvent, self.OnChoiceResultEnd)
		-- 실제 결과 연출과 종료 이벤트가 섞이지 않도록 메이커에서만 별도 복제본을 사용합니다.
		if Environment:IsMakerPlay() then
			self._T.debugResultFailed = false
			self._T.debugResultEffect = self.resultRoot:GetChildByName("Effect"):Clone("DebugEffect")
			self:Connect(self._T.debugResultEffect, SpriteGUIAnimPlayerEndEvent, self.OnDebugResultEnd)
			self:Connect(_InputService, KeyDownEvent, self.OnDebugKeyDown)
		end
		self._T.tooltipWidth = self.root:GetChildByName("Tooltip").UITransformComponent.RectSize.x
		self:HideTooltip()
		local panel = self.root:GetChildByName("SchedulerBG", true)
		local profile = panel:GetChildByName("Character0")
		for index = 1, 3 do
			local row = index == 1 and profile or profile:Clone("Character" .. tostring(index - 1))
			self.profiles[index] = row
			self:UpdateCardSparkles(row:GetChildByName("BG"), 0)
			for tagIndex = 1, 8 do self:ConnectChip(row:GetChildByName("Tag" .. tostring(tagIndex), true), false) end
		end
		local card = panel:GetChildByName("Card0")
		for index = 1, 5 do
			local entry = index == 1 and card or card:Clone("Card" .. tostring(index - 1))
			entry.Enable = false
			self.cards[index] = entry
			self:UpdateCardSparkles(entry:GetChildByName("UISprite"), 0)
			local capturedIndex = index
			self:Connect(entry, UITouchDownEvent, function(event) self:OnCardDown(capturedIndex, event) end)
			self:Connect(entry, UITouchDragEvent, function(event) self:OnCardDrag(capturedIndex, event) end)
			self:Connect(entry, UITouchUpEvent, function(event) self:OnCardUp(capturedIndex, event) end)
			for tagIndex = 1, 3 do
				local chip = entry:GetChildByName("ChoiceTag" .. tostring(tagIndex), true)
				self:ConnectChip(chip, false)
				self:Connect(chip, UITouchDownEvent, function(event) self:OnCardDown(capturedIndex, event) end)
				self:Connect(chip, UITouchDragEvent, function(event) self:OnCardDrag(capturedIndex, event) end)
				self:Connect(chip, UITouchUpEvent, function(event) self:OnCardUp(capturedIndex, event) end)
			end
		end
		self:InitializeOverflowChips()
		self:Connect(self.root:GetChildByName("ConfirmButton", true), ButtonClickEvent, function()
			if self:CanConfirmTags() == false then return end
			local selectedTagIndices = {}
			for index = 1, #_TagTrainingRules:GetTags(self.state.pending.tags) do if self.selectedTagIndexSet[index] then table.insert(selectedTagIndices, index) end end
			self.waiting = true
			_TagTrainingManager:RequestConfirmTags(self.state.stateVersion, selectedTagIndices)
		end)
		self:Connect(_ProgressManager, ProgressChangedEvent, self.OnProgressChanged)
		self:Connect(_DialogUILogic, DialogClosedEvent, self.OnDialogClosed)
		self:Connect(_InputService, MouseMoveEvent, self.OnMouseMove)
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 모바일 길게 누르기와 준비된 설명을 표시하고 카드·태그 강조를 갱신합니다. 저장은 하지 않습니다.
		if isvalid(self.root) == false or self.root.Enable == false then return end
		local held = self.heldChip
		if held ~= nil and held.mobile and held.cancelled == false and held.longPressed == false then
			held.holdTime = held.holdTime + delta
			if held.holdTime >= self.tagLongPressDuration then
				held.longPressed = true
				self:ShowTooltip(held.entity, held.tagId, held.start)
			end
		end
		if self.tooltipShowFrames > 0 then
			self.tooltipShowFrames = self.tooltipShowFrames - 1
			if self.tooltipShowFrames == 0 then self.root:GetChildByName("Tooltip").CanvasGroupComponent.GroupAlpha = 1 end
		end
		self:UpdateCardHighlights(delta)
		if self.waiting then
			self.waitingTime = self.waitingTime + delta
			if self.waitingTime >= 8 then self.waitingTime = 0; _TagTrainingManager:RequestOpen() end
		end
		for _, profile in ipairs(self.profiles) do
			for index = 1, 8 do self:UpdateTagHighlight(profile:GetChildByName("Tag" .. tostring(index), true)) end
		end
		if self.state ~= nil and self.state.pending ~= false then
			for _, chip in ipairs(self.overflowChips[2]) do self:UpdateTagHighlight(chip) end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 모든 이벤트 연결을 정리하고 다음 플레이에 입력이 남지 않게 합니다.
		for _, connection in ipairs(self.connections) do if isvalid(connection.source) then connection.source:DisconnectEvent(connection.eventType, connection.eventHandler) end end
		self.connections = {}
		self.heldChip = nil
		self:HideTooltip()
		self.resultRoot:GetChildByName("Effect").Enable = false
		if isvalid(self._T.debugResultEffect) then self._T.debugResultEffect:Destroy(); self._T.debugResultEffect = nil end
	end

	------------------------------------------------------------------------------------------------------------------------------------------------------
	-- Private Methods
	------------------------------------------------------------------------------------------------------------------------------------------------------

	@ExecSpace("ClientOnly")
	method boolean TryOpenSettlement()
		-- 마지막 결과 연출과 태그 교체가 모두 끝난 뒤 결산 카드, 대표 캐릭터, 임시 문구를 함께 엽니다.
		if self._T.pendingSettlementCards == nil or self.resultRoot:GetChildByName("Effect").Enable then return false end
		local settlementCards = self._T.pendingSettlementCards
		local featuredCharacterId = self:GetMostChangedCharacterId(settlementCards)
		self._T.pendingSettlementCards = nil
		self:Close()
		self:OpenSettlementDialog(featuredCharacterId)
		_SettlementCardUILogic:Open(settlementCards)
		return true
	end

	@ExecSpace("ClientOnly")
	method string GetMostChangedCharacterId(table settlementCards)
		-- 표시 스탯의 절댓값 변화 합계가 가장 큰 캐릭터를 대표 캐릭터로 선택합니다.
		local characterId = ""
		local largestChange = -1
		for _, card in ipairs(settlementCards) do
			local totalChange = math.abs(card.vocal or 0)
				+ math.abs(card.dance or 0)
				+ math.abs(card.visual or 0)
				+ math.abs(card.fandom or 0)
				+ math.abs(card.fatigue or 0)
			if totalChange > largestChange then
				largestChange = totalChange
				characterId = card.characterId or ""
			end
		end
		return characterId
	end

	@ExecSpace("ClientOnly")
	method void OpenSettlementDialog(string characterId)
		-- 동적 임시 문구를 Schedule 결산과 같은 왼쪽 대표 캐릭터 바인딩으로 엽니다.
		local options = DialogOpenOptions()
		options.dialogId = self.settlementDialogId
		options.overrideTableOption = true
		options.useActorBinding = true
		options.speakerActorId = characterId
		options.leftActorId = characterId
		options.leftOverrideResourceId = self:GetSettlementPortraitOverrideResourceId(characterId)
		_DialogUILogic:OpenTextWithOptions(self.settlementDialogId, self.settlementMessage, options)
	end

	@ExecSpace("ClientOnly")
	method string GetSettlementPortraitOverrideResourceId(string characterId)
		-- Schedule 결산에서 사용하는 전신 일러스트 예외를 동일하게 적용합니다.
		if characterId == "character_lucid" then return "portrait_lucid_fullbody_smile" end
		if characterId == "character_lilin" then return "portrait_lilin_fullbody_smile" end
		if characterId == "character_cygnus" then return "portrait_cygnus_fullbody_smile" end
		return ""
	end

	@ExecSpace("ClientOnly")
	method void PlayChoiceResult(table result)
		-- 수행한 캐릭터 초상화 위에 결과 애니메이션과 효과음을 한 번 재생하며 마지막 턴에도 연출을 유지합니다.
		local profile = nil
		for index, characterId in ipairs(self.characterIds) do if characterId == result.characterId then profile = self.profiles[index]; break end end
		if profile == nil then return end
		if isvalid(self._T.debugResultEffect) then self._T.debugResultEffect.Enable = false end
		self:PlayResultSprite(self.resultRoot:GetChildByName("Effect"), profile, result.failed)
		self.waiting = true
		_SoundService:PlaySound(result.failed and self.failureSoundRuid or self.successSoundRuid, self.resultSoundVolume)
	end

	@ExecSpace("ClientOnly")
	method void PlayResultSprite(Entity effect, Entity profile, boolean failed)
		-- 부모 배율까지 반영한 카드 중앙에 위치 보정과 카드 크기 비례 배율을 적용해 결과 스프라이트를 재생합니다.
		local card = profile.UITransformComponent
		local resultTransform = self.resultRoot.UITransformComponent
		local bottomLeft = resultTransform:ToLocalPoint(card:ToWorldPoint(Vector3(-card.RectSize.x * card.Pivot.x, -card.RectSize.y * card.Pivot.y, 0)))
		local topRight = resultTransform:ToLocalPoint(card:ToWorldPoint(Vector3(card.RectSize.x * (1 - card.Pivot.x), card.RectSize.y * (1 - card.Pivot.y), 0)))
		effect.Enable = false
		effect.UITransformComponent.anchoredPosition = Vector2((bottomLeft.x + topRight.x) / 2, (bottomLeft.y + topRight.y) / 2) + self.resultEffectOffset
		effect.UITransformComponent.RectSize = Vector2(math.abs(topRight.x - bottomLeft.x) * self.resultEffectScale, math.abs(topRight.y - bottomLeft.y) * self.resultEffectScale)
		effect.SpriteGUIRendererComponent.PlayRate = failed and 1.8 or 1
		effect.SpriteGUIRendererComponent.ImageRUID = DataRef("")
		effect.SpriteGUIRendererComponent.ImageRUID = DataRef(failed and self.failureEffectRuid or self.successEffectRuid)
		effect.Enable = true
	end

	@ExecSpace("ClientOnly")
	method void Connect(any source, any eventType, any callback)
		-- 동적 이벤트 구독을 한 곳에 모아 종료 시 대칭적으로 해제합니다.
		local eventHandler = source:ConnectEvent(eventType, callback)
		table.insert(self.connections, {source = source, eventType = eventType, eventHandler = eventHandler})
	end

	@ExecSpace("ClientOnly")
	method void ConnectChip(Entity chip, boolean isOverflow)
		-- PC 호버와 모바일 길게 누르기를 연결하고 짧은 터치만 교체 입력으로 사용합니다.
		self:Connect(chip, UITouchEnterEvent, function(event)
			local tagId = self._T.tagIdByChipId[chip.Id] or ""
			if Environment:IsPCPlatform() and self.heldChip == nil then self:ShowTooltip(chip, tagId, event.TouchPoint) end
		end)
		self:Connect(chip, UITouchExitEvent, function(event)
			if self.tooltipChip == chip then self:HideTooltip() end
			local held = self.heldChip
			if held ~= nil and held.entity == chip and held.touchId == event.TouchId and held.mobile then held.cancelled = true end
		end)
		self:Connect(chip, UITouchDownEvent, function(event)
			local tagId = self._T.tagIdByChipId[chip.Id] or ""
			local index = isOverflow and self._T.overflowTagIndices[chip.Id] or 0
			self:OnChipDown(chip, tagId, index, event)
		end)
		self:Connect(chip, UITouchUpEvent, self.OnChipUp)
		self:Connect(chip, UITouchDragEvent, self.OnChipDrag)
	end

	@ExecSpace("ClientOnly")
	method void InitializeOverflowChips()
		-- 템플릿 하나로 IN/OUT 슬롯을 처음에만 준비해 교체 중에는 부모·크기·앵커를 바꾸지 않습니다.
		self.overflowChips = {{}, {}, {}}
		self._T.overflowTagIndices = {}
		local overflow = self.root:GetChildByName("Overflow")
		local profile = overflow:GetChildByName("CharacterPanel")
		for index = 1, 8 do
			local chip = profile:GetChildByName("Tag" .. tostring(index), true)
			self.overflowChips[2][index] = chip
			self:ConnectChip(chip, true)
		end
		local inList = overflow:GetChildByName("In"):GetChildByName("List")
		local outList = overflow:GetChildByName("Out"):GetChildByName("List")
		local template = overflow:GetChildByName("OverflowTagTemplate")
		-- 한 선택지에서 추가되거나 교체로 빠지는 태그는 최대 3개입니다.
		for index = 1, 3 do
			local inChip = template:Clone("InTag" .. tostring(index))
			local outChip = template:Clone("OutTag" .. tostring(index))
			self.overflowChips[1][index] = inChip
			self.overflowChips[3][index] = outChip
			for _, chip in ipairs({inChip, outChip}) do
				chip.Enable = true
				local parent = chip == inChip and inList or outList
				chip:AttachTo(parent)
				local parentScale = parent.Parent.UITransformComponent.UIScale
				chip.UITransformComponent.AlignmentOption = AlignmentType.TopLeft
				chip.UITransformComponent.Pivot = Vector2(0, 1)
				chip.UITransformComponent.UIScale = Vector3(1, 1, 1)
				chip.UITransformComponent.RectSize = Vector2(self.overflowListTagSize.x / parentScale.x, self.overflowListTagSize.y / parentScale.y)
				chip.UITransformComponent.anchoredPosition = Vector2(0, 0)
				self:ConnectChip(chip, true)
				self:SetTagChip(chip, "", "", self.overflowTagBackgroundRuid)
				self:SetOverflowChipVisible(chip, false)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method string Text(string key)
		-- LocaleDataSet에서 현재 언어의 문자열을 조회합니다.
		return _LocalizationService:GetText(key)
	end

	@ExecSpace("ClientOnly")
	method any GetCharacter(string characterId)
		-- 실제 캐릭터 캐시 대신 서버가 동기화한 임시 육성 캐릭터를 반환합니다.
		for _, character in ipairs(self.state.characters) do if character.id == characterId then return character end end
		return nil
	end

	@ExecSpace("ClientOnly")
	method void SetText(Entity entity, string text)
		-- 이미 번역되거나 포맷된 동적 문자열을 표시합니다.
		entity.TextGUIRendererComponent.Text = text
	end

	@ExecSpace("ClientOnly")
	method string TagName(string tagId)
		-- TagTable에 지정된 이름 키를 현재 언어로 반환합니다.
		return self:Text(_TrainingDataMaster:GetTag(tagId).nameKey)
	end

	@ExecSpace("ClientOnly")
	method string TagDescription(string tagId)
		-- TagTable에 지정된 설명 키를 현재 언어로 반환합니다.
		return self:Text(_TrainingDataMaster:GetTag(tagId).descriptionKey)
	end

	@ExecSpace("ClientOnly")
	method Color TagColor(string tagId)
		-- TagTable의 16진수 색상을 UI 표시 색상으로 변환합니다.
		return Color.FromHexCode(_TrainingDataMaster:GetTag(tagId).colorHex)
	end

	@ExecSpace("ClientOnly")
	method void SetTagChip(Entity chip, string tagId, string fallback, string filledBackgroundRuid)
		-- 빈 슬롯·잠긴 슬롯·태그를 지정 이미지로 구분하고 원 이미지에 태그별 색상을 입힙니다.
		local label = chip:GetChildByName("UIText")
		local locked = fallback == "X"
		self._T.tagIdByChipId[chip.Id] = tagId
		self:SetText(label, tagId ~= "" and self:TagName(tagId) or (locked and "" or fallback))
		chip.SpriteGUIRendererComponent.ImageRUID = DataRef(tagId ~= "" and filledBackgroundRuid or (locked and self.lockedTagBackgroundRuid or self.emptyTagBackgroundRuid))
		label.UITransformComponent.anchoredPosition = Vector2(tagId ~= "" and 7 or 0, 0)
		label.UITransformComponent.RectSize = Vector2(chip.UITransformComponent.RectSize.x - (tagId ~= "" and 22 or 6), chip.UITransformComponent.RectSize.y - 4)
		local dot = chip:GetChildByName("Dot")
		dot.Enable = tagId ~= ""
		if dot.Enable then dot.SpriteGUIRendererComponent.Color = self:TagColor(tagId) end
	end

	@ExecSpace("ClientOnly")
	method void SetOverflowChipVisible(Entity chip, boolean visible)
		-- 리스트 슬롯 엔티티는 유지하고 렌더러만 숨겨 자동 레이아웃의 재배치를 막습니다.
		chip.SpriteGUIRendererComponent.Enable = visible
		chip:GetChildByName("UIText").Enable = visible
		if visible == false then chip:GetChildByName("Dot").Enable = false end
	end

	@ExecSpace("ClientOnly")
	method void RefreshHeader()
		-- 주차, 목표 점수와 현재 턴을 갱신합니다.
		local panel = self.root:GetChildByName("SchedulerBG", true)
		local progress = _ProgressManager:ClientGetProgress()
		self:SetText(panel:GetChildByName("CardCount"):GetChildByName("UIText"), tostring(math.min(self.state.usedTurns + 1, self.state.totalTurns)) .. "/" .. tostring(self.state.totalTurns))
		self:SetText(panel:GetChildByName("MonthText", true), _LocaleTextUtil:Format("tag_training_month", progress.currentMonth, nil, nil, ""))
		self:SetText(panel:GetChildByName("WeekText", true), _LocaleTextUtil:Format("tag_training_week", progress.currentWeek, nil, nil, ""))
		local stage = _StageMaster:GetStage(progress.eCurrentStage)
		self:SetText(panel:GetChildByName("GoalText", true), _LocaleTextUtil:Format("tag_training_goal", stage ~= nil and stage.targetScore or 0, nil, nil, ""))
	end

	@ExecSpace("ClientOnly")
	method void RefreshChoices()
		-- 선택지가 바뀌었을 때만 카드 내용을 갱신합니다.
		if self.dragIndex == 0 then self:LayoutCardRow(self.cards, #self.state.choices, 20) end
		for index, card in ipairs(self.cards) do
			local choice = self.state.choices[index]
			card.Enable = choice ~= nil
			if choice ~= nil then
				local trainingCard = _TrainingDataMaster:GetTrainingCard(choice.cardId)
				local cardColor = Color(1, 1, 1, 1)
				if choice.sealed == true then cardColor = Color(0.55, 0.55, 0.55, 1) end
				card:GetChildByName("UISprite").SpriteGUIRendererComponent.Color = cardColor
				self:SetText(card:GetChildByName("Title", true), self:Text(trainingCard.nameKey))
				local icon = _ResourceMaster:ResolveResourceId(trainingCard.iconResource)
				local iconEntity = card:GetChildByName("Icon", true)
				iconEntity.Enable = icon ~= ""
				if icon ~= "" then
					iconEntity.SpriteGUIRendererComponent.ImageRUID = DataRef(icon)
					iconEntity.SpriteGUIRendererComponent.Color = cardColor
				end
				local tags = _TagTrainingRules:GetTags(choice.tags)
				for tagIndex = 1, 3 do
					local chip = card:GetChildByName("ChoiceTag" .. tostring(tagIndex), true)
					chip.Enable = tags[tagIndex] ~= nil
					if tags[tagIndex] ~= nil then self:SetTagChip(chip, tags[tagIndex], "", self.tagBackgroundRuid) end
				end
				self:LayoutChoiceTagRow(card, math.min(#tags, 3))
				local values = {}
				for _, stat in ipairs({"vocal", "dance", "visual", "fatigue"}) do if trainingCard[stat] ~= 0 then table.insert(values, (stat == "fatigue" and self:Text(self.TEXT_TAG_TRAINING_FATIGUE) or self:TagName(stat)) .. " " .. (trainingCard[stat] > 0 and "+" or "") .. string.format("%.0f", trainingCard[stat])) end end
				self:SetText(card:GetChildByName("Effects"), table.concat(values, "\n"))
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshProfiles(any previewIndex)
		-- 편성 캐릭터를 갱신하고 드래그 대상에게만 최종 예상 수치를 색상으로 표시합니다.
		self.previewIndex = previewIndex or 0
		local characters = self.state ~= nil and self.state.characters or {}
		self:LayoutCardRow(self.profiles, math.min(#characters, #self.profiles), 70)
		for index, row in ipairs(self.profiles) do
			local character = characters[index]
			row.Enable = character ~= nil
			if character ~= nil then
				self.characterIds[index] = character.id
				self:SetText(row:GetChildByName("Name"):GetChildByName("UIText"), _RuntimeActorManager:ClientGetLocalizedActorName(character.id))
				local portrait = _ResourceMaster:ResolveResourceId(_ActorMaster:GetActorPortrait(character.id))
				if portrait ~= "" then row:GetChildByName("Portrait", true).SpriteGUIRendererComponent.ImageRUID = DataRef(portrait) end
				local preview = nil
				if previewIndex == index and self.dragIndex > 0 then preview = _TagTrainingRules:Calculate(character, _TrainingDataMaster:GetTrainingCard(self.state.choices[self.dragIndex].cardId), false) end
				for _, stat in ipairs({"vocal", "dance", "visual", "fatigue"}) do
					local label = stat == "fatigue" and self:Text(self.TEXT_TAG_TRAINING_FATIGUE) or self:TagName(stat)
					local value = string.format("%.0f", character[stat])
					if preview ~= nil and preview[stat] ~= 0 then
						local beneficial = (stat == "fatigue" and preview[stat] < 0) or (stat ~= "fatigue" and preview[stat] > 0)
						value = "<color=" .. (beneficial and "#24AD59" or "#F06282") .. ">" .. string.format("%.0f", character[stat] + preview[stat]) .. "</color>"
					end
					local statNode = string.upper(string.sub(stat, 1, 1)) .. string.sub(stat, 2)
					self:SetText(row:GetChildByName(statNode):GetChildByName("UIText"), label .. " : " .. value)
				end
				local tags = _TagTrainingRules:GetTags(character.tags or "")
				local activeTags = preview ~= nil and preview.activeTags or _TagTrainingRules:GetReadyTags(character)
				for tagIndex = 1, 8 do
					local chip = row:GetChildByName("Tag" .. tostring(tagIndex), true)
					local tagId = tags[tagIndex] or ""
					self:SetTagChip(chip, tagIndex > character.tagCapacity and "" or tagId, tagIndex > character.tagCapacity and "X" or "", self.tagBackgroundRuid)
					-- 별도 LineGUI 테두리는 일부만 표시되어 태그 이미지의 둥근 외곽선을 직접 사용합니다.
					chip.SpriteGUIRendererComponent.Outline = activeTags[tagIndex] == true
					self:UpdateTagHighlight(chip)
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void LayoutCardRow(any entries, integer count, number spacing)
		-- 하얀 콘텐츠 영역의 중앙을 기준으로 고정 간격을 유지해 카드가 양옆으로 늘어나도록 정렬합니다.
		for index = 1, count do
			local transform = entries[index].UITransformComponent
			local x = (index - (count + 1) / 2) * (transform.RectSize.x + spacing)
			transform.anchoredPosition = Vector2(x, transform.anchoredPosition.y)
		end
	end

	@ExecSpace("ClientOnly")
	method void LayoutChoiceTagRow(Entity card, integer count)
		-- 태그를 표시 개수에 맞춰 카드 중앙에서 좌우로 배치합니다.
		for index = 1, count do
			local chip = card:GetChildByName("ChoiceTag" .. tostring(index), true)
			local x = (index - (count + 1) / 2) * 69
			chip.UITransformComponent.anchoredPosition = Vector2(x, 0)
		end
	end

	@ExecSpace("ClientOnly")
	method any FindDropTarget(Vector2 screenPoint)
		-- 피벗을 고려한 실제 캐릭터 UI 사각형 안에 있는 대상을 찾습니다.
		for index, row in ipairs(self.profiles) do
			if row.Enable then
				local transform = row.UITransformComponent
				local point = _UILogic:ScreenToLocalUIPosition(screenPoint, transform)
				local minX = -transform.RectSize.x * transform.Pivot.x
				local minY = -transform.RectSize.y * transform.Pivot.y
				if point.x >= minX and point.x <= minX + transform.RectSize.x and point.y >= minY and point.y <= minY + transform.RectSize.y then return index end
			end
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method void CancelDrag()
		-- 카드를 원래 위치로 되돌리고 태그 누르기와 대상 미리보기를 해제합니다.
		if self.dragIndex > 0 then self.cards[self.dragIndex].UITransformComponent.anchoredPosition = self.dragOrigin end
		self.dragIndex = 0
		self.dragged = false
		self.heldChip = nil
		if isvalid(self.root) then self:HideTooltip() end
		if #self.profiles > 0 then self:RefreshProfiles(nil) end
	end

	@ExecSpace("ClientOnly")
	method void UpdateCardHighlights(number delta)
		-- 외곽선과 장식용 별빛만 갱신해 카드 배치·터치 영역과 텍스트를 건드리지 않습니다.
		self._T.cardHighlightTime = self._T.cardHighlightTime + delta * 1.3
		for index, card in ipairs(self.cards) do self:UpdateCardHighlight(card:GetChildByName("UISprite").SpriteGUIRendererComponent, card.Enable and self.dragged and self.dragIndex == index, true, delta) end
		for index, profile in ipairs(self.profiles) do self:UpdateCardHighlight(profile:GetChildByName("BG").SpriteGUIRendererComponent, profile.Enable and self.dragged and self.previewIndex == index, false, delta) end
	end

	@ExecSpace("ClientOnly")
	method void UpdateCardHighlight(SpriteGUIRendererComponent renderer, boolean active, boolean lifted, number delta)
		-- 캐릭터 카드만 반짝이고 드래그 카드는 고정된 윤곽선과 얕은 그림자로 강조합니다. 두께는 UI 설정값을 유지합니다.
		local strength = self._T.cardHighlightLevels[renderer] or 0
		if active == false and strength == 0 then return end
		strength = strength + ((active and 1 or 0) - strength) * math.min(1, delta * 14)
		if active == false and strength < 0.01 then strength = 0 end
		self._T.cardHighlightLevels[renderer] = strength
		renderer.Outline = strength > 0.01
		renderer.DropShadow = lifted and renderer.Outline
		self:UpdateCardSparkles(renderer.Entity, lifted and 0 or strength)
		if renderer.Outline == false then return end
		local pulse = lifted and 0 or (math.sin(self._T.cardHighlightTime * 4) + 1) / 2
		local flash = lifted and 0 or (math.cos(self._T.cardHighlightTime * math.pi * 2 / 2.4) + 1) / 2
		renderer.OutlineColor = Color(0.32 + flash * 0.5, 0.87 + flash * 0.13, 0.67 + flash * 0.26, strength * math.min(1, 0.8 + pulse * 0.16 + flash * 0.12))
		if lifted then renderer.DropShadowColor = Color(0, 0, 0, strength * 0.18) end
	end

	@ExecSpace("ClientOnly")
	method void UpdateTagHighlight(Entity chip)
		-- 태그 고유 색상과 캐릭터 카드의 반짝임 주기는 유지하고 알파를 0~100%로 변화시킵니다. 두께는 UI 설정값을 유지합니다.
		local renderer = chip.SpriteGUIRendererComponent
		if renderer.Outline == false then return end
		local color = chip:GetChildByName("Dot").SpriteGUIRendererComponent.Color
		local flash = (math.cos(self._T.cardHighlightTime * math.pi * 2 / 2.4) + 1) / 2
		local brightness = flash * 0.2
		renderer.OutlineColor = Color(color.r + (1 - color.r) * brightness, color.g + (1 - color.g) * brightness, color.b + (1 - color.b) * brightness, flash)
	end

	@ExecSpace("ClientOnly")
	method void UpdateCardSparkles(Entity background, number strength)
		-- 모서리의 작은 별빛 두 개가 쉬는 구간 없이 번갈아 반짝이며 강조가 끝나면 함께 숨깁니다.
		for index = 1, 2 do
			local sparkle = background:GetChildByName("Sparkle" .. tostring(index))
			local phase = self._T.cardHighlightTime * math.pi * 2 / 2.4 + (index - 1) * math.pi
			local twinkle = (math.cos(phase) + 1) / 2
			sparkle.Enable = strength > 0.01 and twinkle > 0.005
			sparkle.CanvasGroupComponent.GroupAlpha = strength * twinkle * 0.9
			local scale = 0.55 + twinkle * 0.45
			sparkle.UITransformComponent.UIScale = Vector3(scale, scale, 1)
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshOverflow()
		-- 결과 연출이 끝나면 교체 캐릭터를 크게 표시하고 기존 태그는 중앙, 새 태그는 In에 배치합니다.
		local overflow = self.root:GetChildByName("Overflow")
		overflow.Enable = self.state.pending ~= false and self.resultRoot:GetChildByName("Effect").Enable == false
		self.closeButton.Enable = overflow.Enable == false
		if overflow.Enable == false then return end
		self.selectedTagIndexSet = {}
		self._T.overflowRegions = {}
		self._T.centerTagIndices = {}
		for index = 1, self.state.pending.existingTagCount do
			self.selectedTagIndexSet[index] = true
			self._T.centerTagIndices[index] = index
		end
		local character = self:GetCharacter(self.state.pending.characterId)
		local profile = overflow:GetChildByName("CharacterPanel")
		self:SetText(profile:GetChildByName("Name"):GetChildByName("UIText"), _RuntimeActorManager:ClientGetLocalizedActorName(character.id))
		local portrait = _ResourceMaster:ResolveResourceId(_ActorMaster:GetActorPortrait(character.id))
		if portrait ~= "" then profile:GetChildByName("Portrait", true).SpriteGUIRendererComponent.ImageRUID = DataRef(portrait) end
		for _, stat in ipairs({"vocal", "dance", "visual", "fatigue"}) do
			local label = stat == "fatigue" and self:Text(self.TEXT_TAG_TRAINING_FATIGUE) or self:TagName(stat)
			local statNode = string.upper(string.sub(stat, 1, 1)) .. string.sub(stat, 2)
			self:SetText(profile:GetChildByName(statNode):GetChildByName("UIText"), label .. " : " .. string.format("%.0f", character[stat]))
		end
		local tags = _TagTrainingRules:GetTags(self.state.pending.tags)
		for index = 1, #tags do self._T.overflowRegions[index] = index <= self.state.pending.existingTagCount and 3 or 1 end
		self:LayoutOverflowTags()
		for _, region in ipairs({"In", "Out"}) do overflow:GetChildByName(region):GetChildByName("List").ScrollLayoutGroupComponent:ResetScrollPosition(UITransformAxis.Vertical) end
	end

	@ExecSpace("ClientOnly")
	method boolean CanConfirmTags()
		-- 신규 태그를 전부 넣고 사용 가능한 보유 칸을 모두 채운 뒤에만 교체를 확정합니다.
		if self.waiting or self.state == nil or self.state.pending == false then return false end
		local tags = _TagTrainingRules:GetTags(self.state.pending.tags)
		for index = self.state.pending.existingTagCount + 1, #tags do if self.selectedTagIndexSet[index] ~= true then return false end end
		local count = 0
		for _, isSelected in pairs(self.selectedTagIndexSet) do if isSelected then count = count + 1 end end
		return count == self:GetCharacter(self.state.pending.characterId).tagCapacity
	end

	@ExecSpace("ClientOnly")
	method void MoveOverflowTag(integer index, integer region)
		-- 기존 중앙 태그는 움직이지 않고 새로 넣는 태그는 첫 번째 빈 슬롯에 배치합니다.
		if region == 2 and self.selectedTagIndexSet[index] ~= true then
			local count = 0
			for _, isSelected in pairs(self.selectedTagIndexSet) do if isSelected then count = count + 1 end end
			local capacity = self:GetCharacter(self.state.pending.characterId).tagCapacity
			if count >= capacity then self:LayoutOverflowTags(); return end
			for slotIndex = 1, capacity do
				if self._T.centerTagIndices[slotIndex] == nil then
					self._T.centerTagIndices[slotIndex] = index
					break
				end
			end
		elseif region ~= 2 then
			local count = 0
			local tags = _TagTrainingRules:GetTags(self.state.pending.tags)
			for tagIndex = 1, #tags do
				if self.selectedTagIndexSet[tagIndex] ~= true and self._T.overflowRegions[tagIndex] == region then count = count + 1 end
			end
			local newTagCount = #tags - self.state.pending.existingTagCount
			if count >= newTagCount then return end
			for slotIndex = 1, self:GetCharacter(self.state.pending.characterId).tagCapacity do
				if self._T.centerTagIndices[slotIndex] == index then
					self._T.centerTagIndices[slotIndex] = nil
					break
				end
			end
		end
		self.selectedTagIndexSet[index] = region == 2
		if region ~= 2 then self._T.overflowRegions[index] = region end
		self:LayoutOverflowTags()
	end

	@ExecSpace("ClientOnly")
	method void LayoutOverflowTags()
		-- 고정된 영역별 슬롯에 태그 내용만 채워 부모 전환과 크기 변경으로 생기는 순간적인 튐을 막습니다.
		local overflow = self.root:GetChildByName("Overflow")
		local character = self:GetCharacter(self.state.pending.characterId)
		local tags = _TagTrainingRules:GetTags(self.state.pending.tags)
		local indices = {{}, {}, {}}
		local selectedTags = {}
		local selectedSlots = {}
		for index, tagId in ipairs(tags) do
			if self.selectedTagIndexSet[index] ~= true then table.insert(indices[self._T.overflowRegions[index]], index) end
		end
		for slotIndex = 1, character.tagCapacity do
			local tagIndex = self._T.centerTagIndices[slotIndex]
			if tagIndex ~= nil then
				table.insert(selectedTags, tags[tagIndex])
				table.insert(selectedSlots, slotIndex)
			end
		end
		local readyTags = _TagTrainingRules:GetReadyTags({tags = table.concat(selectedTags, ","), fatigue = character.fatigue})
		local activeTags = {}
		for index, slotIndex in ipairs(selectedSlots) do activeTags[slotIndex] = readyTags[index] end
		self._T.overflowTagIndices = {}
		for region, chips in ipairs(self.overflowChips) do
			for slotIndex, chip in ipairs(chips) do
				local tagIndex = region == 2 and self._T.centerTagIndices[slotIndex] or indices[region][slotIndex]
				self._T.overflowTagIndices[chip.Id] = tagIndex
				-- 이번에 IN에서 넣은 새 태그만 표시하고 재정렬 후에도 실제 태그 인덱스로 구분합니다.
				if region == 2 then chip:GetChildByName("NewBadge").Enable = tagIndex ~= nil and tagIndex > self.state.pending.existingTagCount end
				self:SetTagChip(chip, tagIndex ~= nil and tags[tagIndex] or "", region == 2 and slotIndex > character.tagCapacity and "X" or "", self.overflowTagBackgroundRuid)
				chip.SpriteGUIRendererComponent.Outline = region == 2 and activeTags[slotIndex] == true
				self:UpdateTagHighlight(chip)
				chip.Enable = true
				if region ~= 2 then self:SetOverflowChipVisible(chip, tagIndex ~= nil) end
			end
		end
		local capacity = overflow:GetChildByName("Capacity")
		self:SetText(capacity, tostring(#selectedTags) .. "/" .. tostring(character.tagCapacity))
		local confirm = overflow:GetChildByName("ConfirmButton")
		local canConfirm = self:CanConfirmTags()
		confirm.ButtonComponent.Enable = canConfirm
		confirm.SpriteGUIRendererComponent.Color = canConfirm and Color(0.69, 0.99, 0.42, 1) or Color(0.8, 0.8, 0.8, 1)
	end

	@ExecSpace("ClientOnly")
	method void ShowTooltip(Entity chip, string tagId, Vector2 screenPoint)
		-- 태그 설명만 입력 위치 옆에 표시하며 이동 버튼이나 별도 선택 UI는 넣지 않습니다.
		if tagId == "" then return end
		local tooltip = self.root:GetChildByName("Tooltip")
		-- 이전 내용이 노출되지 않게 숨긴 채 갱신하고 UI 레이아웃이 한 프레임 반영된 뒤 표시합니다.
		tooltip.CanvasGroupComponent.GroupAlpha = 0
		self.tooltipShowFrames = 2
		self:SetText(tooltip:GetChildByName("UIText"), self:TagName(tagId) .. "\n" .. self:TagDescription(tagId))
		self.tooltipChip = chip
		self:PositionTooltip(screenPoint)
	end

	@ExecSpace("ClientOnly")
	method void PositionTooltip(Vector2 screenPoint)
		-- 실제 화면을 부모 좌표로 변환해 포인터 옆에 배치하고 가장자리에서는 반대쪽으로 펼칩니다.
		local tooltip = self.root:GetChildByName("Tooltip")
		local parent = tooltip.Parent.UITransformComponent
		local bounds = _UIScreenUtil:GetScreenBoundsInLocal(parent)
		if bounds == nil then return end
		local label = tooltip:GetChildByName("UIText")
		local width = math.min(self._T.tooltipWidth, bounds.right - bounds.left - 32)
		local textHeight = label.TextGUIRendererComponent:GetPreferredHeight(label.TextGUIRendererComponent.Text, width - 40)
		local height = math.min(math.max(64, textHeight + 24), bounds.top - bounds.bottom - 32)
		tooltip.UITransformComponent.RectSize = Vector2(width, height)
		label.UITransformComponent.RectSize = Vector2(width - 40, height - 24)
		local point = _UILogic:ScreenToLocalUIPosition(screenPoint, parent)
		local gap = Environment:IsMobilePlatform() and 48 or 24
		local x = point.x + gap + width / 2
		if x + width / 2 > bounds.right - 16 then x = point.x - gap - width / 2 end
		local y = point.y - gap - height / 2
		if Environment:IsMobilePlatform() or y - height / 2 < bounds.bottom + 16 then y = point.y + gap + height / 2 end
		x = math.max(bounds.left + 16 + width / 2, math.min(bounds.right - 16 - width / 2, x))
		y = math.max(bounds.bottom + 16 + height / 2, math.min(bounds.top - 16 - height / 2, y))
		tooltip.UITransformComponent.anchoredPosition = Vector2(x, y)
	end

	@ExecSpace("ClientOnly")
	method void HideTooltip()
		-- 표시 대기를 해제하고 알파로 숨겨 이전 렌더링 상태가 다시 노출되지 않게 합니다.
		self.tooltipShowFrames = 0
		self.root:GetChildByName("Tooltip").CanvasGroupComponent.GroupAlpha = 0
		self.tooltipChip = nil
	end

	@ExecSpace("ClientOnly")
	method boolean IsPointInside(Entity entity, Vector2 screenPoint)
		-- 화면 입력을 부모 배율까지 반영한 로컬 좌표로 바꿔 UI 사각형 안에 있는지 판정합니다.
		local transform = entity.UITransformComponent
		local root = self.root.UITransformComponent
		local rootPoint = _UILogic:ScreenToLocalUIPosition(screenPoint, root)
		local point = transform:ToLocalPoint(root:ToWorldPoint(Vector3(rootPoint.x, rootPoint.y, 0)))
		local minX = -transform.RectSize.x * transform.Pivot.x
		local minY = -transform.RectSize.y * transform.Pivot.y
		return point.x >= minX and point.x <= minX + transform.RectSize.x and point.y >= minY and point.y <= minY + transform.RectSize.y
	end


end

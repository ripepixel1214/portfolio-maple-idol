@Logic
script TagTrainingManager extends Logic

	property integer totalTurns = 15

	property integer choiceCount = 3

	property boolean isTrainingCardUnlockLoaded = false

	property any unlockedTrainingCardIds = {}

	property any unlockedTrainingCardIdSet = {}

	property any savedUnlockedTrainingCardIds = {}

	property string currentUserId = ""

	property any state = nil

	property any userEnterHandler = nil

	property any userLeaveHandler = nil

	------------------------------------------------------------------------------------------------------------------------------------------------------
	-- Public API
	------------------------------------------------------------------------------------------------------------------------------------------------------

	@ExecSpace("Server")
	method void RequestOpen()
		-- 저장된 같은 주차의 육성을 이어 열고, 새 주차의 선택지는 처음 한 번만 생성합니다.
		if self:CanTrain(senderUserId) == false then return end
		local state = self:GetState()
		if state == nil then
			state = self:CreateState()
			if state == nil then return end
			self.state = state
		end
		self:SyncOrComplete(state, {}, senderUserId)
	end

	@ExecSpace("Server")
	method void RequestUseChoice(integer stateVersion, integer choiceIndex, string characterId)
		-- 현재 서버 선택지와 편성 캐릭터를 검증한 뒤 한 턴을 수행합니다.
		if self:CanTrain(senderUserId) == false then return end
		local state = self:GetState()
		local result = self:UseChoice(state, stateVersion, choiceIndex, characterId)
		if result == nil then
			if state ~= nil then self:SyncState(state, {}, senderUserId) end
			return
		end
		self:SyncOrComplete(state, result, senderUserId)
	end

	@ExecSpace("Server")
	method void RequestConfirmTags(integer stateVersion, table selectedTagIndices)
		-- 중복 태그를 ID가 아닌 획득 순서 인덱스로 구분해 교체를 확정합니다.
		if self:CanTrain(senderUserId) == false then return end
		local state = self:GetState()
		if self:ApplyTagSelection(state, stateVersion, selectedTagIndices) == false then
			if state ~= nil then self:SyncState(state, {}, senderUserId) end
			return
		end
		self:SyncOrComplete(state, {}, senderUserId)
	end

	@ExecSpace("ServerOnly")
	method boolean IsTrainingComplete()
		-- 태그 교체까지 확정한 마지막 턴만 훈련 완료로 인정합니다.
		local state = self:GetState()
		return state ~= nil and state.pending == false and state.usedTurns >= state.totalTurns
	end

	@ExecSpace("ServerOnly")
	method string CreateSaveString()
		-- 선택지·수행 횟수·캐릭터 육성 결과·교체 대기를 하나의 저장 문자열로 묶습니다.
		if self.state == nil then return "" end

		-- JSONEncode는 빈 Lua 테이블의 배열·객체 타입을 구분하지 못하므로 빈 선택지는 저장에서 제외합니다.
		local saveState = {}
		for key, value in pairs(self.state) do
			if key ~= "choices" or #value > 0 then saveState[key] = value end
		end
		return _HttpService:JSONEncode(saveState)
	end

	@ExecSpace("ServerOnly")
	method void RestoreState(string savedState)
		-- 캐릭터 저장과 함께 읽은 육성 상태를 복원하고 주차 일치는 열 때 검사합니다.
		self.state = nil
		if savedState == "" then return end
		local ok, state = pcall(function() return _HttpService:JSONDecode(savedState) end)
		if ok == false or type(state) ~= "table" then
			log_warning("[TagTrainingManager] training state restore failed")
			return
		end
		-- 기존 저장 상태의 revision을 현재 stateVersion으로 변환합니다.
		if state.stateVersion == nil then
			state.stateVersion = state.revision
			state.revision = nil
		end
		-- 태그 선택 대기 중 저장된 기존 oldCount도 현재 이름으로 변환합니다.
		if state.pending ~= false and state.pending.existingTagCount == nil then
			state.pending.existingTagCount = state.pending.oldCount
			state.pending.oldCount = nil
		end
		-- 기존 저장 선택지의 activityId를 태그 육성 전용 cardId로 변환합니다.
		for _, choice in ipairs(state.choices or {}) do
			if choice.cardId == nil then
				choice.cardId = choice.activityId
				choice.activityId = nil
			end
		end
		state.fandomDelta = nil
		self.state = state
	end

	@ExecSpace("ServerOnly")
	method void ClearState()
		-- 스테이지 시작·종료 시 이어하기 상태를 비웁니다. 저장은 호출한 진행 흐름이 담당합니다.
		self.state = nil
	end

	@ExecSpace("ServerOnly")
	method boolean IsTrainingCardsLoaded()
		-- 서버의 육성 카드 해금 데이터 로드 여부를 반환합니다.
		return self.isTrainingCardUnlockLoaded
	end

	@ExecSpace("ServerOnly")
	method boolean ServerHasTrainingCardUnlocked(string cardId)
		-- 서버 권위 캐시에 지정한 육성 카드가 해금되어 있는지 반환합니다.
		return self.isTrainingCardUnlockLoaded and self.unlockedTrainingCardIdSet[cardId] == true
	end

	@ExecSpace("ServerOnly")
	method table ServerGetUnlockedTrainingCardIds()
		-- 서버 권위 해금 육성 카드 ID 목록의 복사본을 반환합니다.
		return self:CopyStringList(self.unlockedTrainingCardIds)
	end

	@ExecSpace("ServerOnly")
	method boolean UnlockTrainingCard(string cardId)
		-- TrainingCardTable에 존재하는 카드를 서버 권위 해금 목록에 추가합니다.
		if self.isTrainingCardUnlockLoaded == false then return false end
		local trainingCard = _TrainingDataMaster:GetTrainingCard(cardId)
		if trainingCard == nil then
			log_warning("[TagTrainingManager] training card not found cardId=" .. tostring(cardId))
			return false
		end
		if self.unlockedTrainingCardIdSet[cardId] == true then return true end
		table.insert(self.unlockedTrainingCardIds, cardId)
		self.unlockedTrainingCardIdSet[cardId] = true
		if trainingCard.defaultUnlocked == false then table.insert(self.savedUnlockedTrainingCardIds, cardId) end
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean UnlockTrainingCardWithCommit(string cardId)
		-- 육성 카드 해금을 캐시에 반영하고 전용 저장소에 저장합니다.
		if self:UnlockTrainingCard(cardId) == false then return false end
		self:SaveTrainingCardsToStorage()
		return true
	end

	@ExecSpace("ServerOnly")
	method void LoadTrainingCards()
		-- 전용 저장소의 추가 해금 카드와 기본 해금 카드를 서버 권위 캐시로 구성합니다.
		local loadedCardIds = _TrainingCardStorage:LoadTrainingCards(self.currentUserId)
		if loadedCardIds == nil then
			self.isTrainingCardUnlockLoaded = false
			return
		end
		self:RegisterUnlockedTrainingCards(loadedCardIds)
		self.isTrainingCardUnlockLoaded = true
	end

	@ExecSpace("ServerOnly")
	method void SaveTrainingCardsToStorage()
		-- 기본 해금을 제외한 추가 해금 육성 카드만 전용 저장소에 저장합니다.
		if self.isTrainingCardUnlockLoaded == false then return end
		_TrainingCardStorage:SaveTrainingCardsAsync(self.currentUserId, self:CopyStringList(self.savedUnlockedTrainingCardIds))
	end

	@ExecSpace("Client")
	method void SyncState(table state, table result)
		-- 서버 육성 상태를 받은 뒤 UI 입력 잠금을 해제하고 필요한 영역만 갱신합니다.
		_TagTrainingUILogic:ApplyState(state, result)
	end

	@ExecSpace("ServerOnly")
	method void OnUserEnter(UserEnterEvent event)
		-- 유저 입장 시 전용 육성 카드 해금 데이터를 로드합니다.
		self.currentUserId = event.UserId
		self:LoadTrainingCards()
	end

	@ExecSpace("ServerOnly")
	method void OnUserLeave(UserLeaveEvent event)
		-- 카드별 저장 요청은 유지하고 퇴장한 유저의 메모리 상태만 정리합니다.
		if event.UserId ~= self.currentUserId then return end
		self.state = nil
		self.currentUserId = ""
		self.isTrainingCardUnlockLoaded = false
		self.unlockedTrainingCardIds = {}
		self.unlockedTrainingCardIdSet = {}
		self.savedUnlockedTrainingCardIds = {}
	end

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 접속 상태를 초기화하고 육성 카드 해금 데이터의 입장·퇴장 이벤트를 연결합니다.
		self.state = nil
		self.userEnterHandler = _UserService:ConnectEvent(UserEnterEvent, self.OnUserEnter)
		self.userLeaveHandler = _UserService:ConnectEvent(UserLeaveEvent, self.OnUserLeave)
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 저장 데이터는 유지하고 입장·퇴장 이벤트 연결만 정리합니다.
		self.state = nil
		if self.userEnterHandler ~= nil then _UserService:DisconnectEvent(UserEnterEvent, self.userEnterHandler); self.userEnterHandler = nil end
		if self.userLeaveHandler ~= nil then _UserService:DisconnectEvent(UserLeaveEvent, self.userLeaveHandler); self.userLeaveHandler = nil end
	end

	------------------------------------------------------------------------------------------------------------------------------------------------------
	-- Private Methods
	------------------------------------------------------------------------------------------------------------------------------------------------------

	@ExecSpace("ServerOnly")
	method boolean CanTrain(string userId)
		-- 현재 유저의 진행 및 캐릭터 데이터가 준비된 훈련 전 스텝만 허용합니다.
		return self.currentUserId == userId and self.isTrainingCardUnlockLoaded
			and _ProgressManager:CanUseProgress(userId) and _CharacterManager:CanUseCharacters(userId)
			and _ProgressManager:IsCurrentStep(_EProgressStep.BeforeTraining)
	end

	@ExecSpace("ServerOnly")
	method string GetStateKey()
		-- 스테이지와 월·주차를 묶어 다른 주차의 선택지를 재사용하지 않습니다.
		local progress = _ProgressManager:ServerGetProgress()
		return progress.eCurrentStage .. ":" .. tostring(progress.currentMonth) .. ":" .. tostring(progress.currentWeek)
	end

	@ExecSpace("ServerOnly")
	method any GetState()
		-- 복원된 상태 중 같은 스테이지와 주차의 육성만 반환합니다.
		if self.state == nil or self.state.key ~= self:GetStateKey() then return nil end
		return self.state
	end

	@ExecSpace("ServerOnly")
	method any CreateState()
		-- 편성 캐릭터의 육성 복사본을 만들고 카드별 결과는 상태와 함께 저장합니다.
		local state = {key = self:GetStateKey(), stateVersion = 1, usedTurns = 0, totalTurns = self.totalTurns, choices = {}, pending = false, characters = {}}
		for _, characterId in ipairs(_CharacterManager.activeCharacterIds) do table.insert(state.characters, _CharacterManager:ServerGetCharacterById(characterId)) end
		if self:DealChoices(state) == false then return nil end
		return state
	end

	@ExecSpace("ServerOnly")
	method any GetCharacter(table state, string characterId)
		-- 육성 상태 안에서 사용하는 캐릭터 복사본을 반환합니다.
		for _, character in ipairs(state.characters) do if character.id == characterId then return character end end
		return nil
	end

	@ExecSpace("ServerOnly")
	method boolean DealChoices(table state)
		-- TrainingCardTable에서 해금된 육성 카드 선택지를 생성하고 기존 규칙으로 태그를 추첨합니다.
		local trainingCards = self:GetUnlockedTrainingCards()
		if #trainingCards == 0 then
			log_warning("[TagTrainingManager] no unlocked training cards")
			return false
		end
		state.choices = {}
		for index = 1, math.max(3, math.min(5, self.choiceCount)) do
			local trainingCard = trainingCards[math.random(1, #trainingCards)]
			local tags = _TagTrainingRules:RollTags(trainingCard)
			state.choices[index] = {cardId = trainingCard.cardId, tags = table.concat(tags, ",")}
		end
		self:ApplyChoiceEffects(state.choices)
		return true
	end

	@ExecSpace("ServerOnly")
	method table GetUnlockedTrainingCards()
		-- 서버 권위 해금 목록에 포함된 카드를 TrainingCardTable 순서로 반환합니다.
		local trainingCards = {}
		for _, trainingCard in ipairs(_TrainingDataMaster:GetAllTrainingCards()) do
			if self.unlockedTrainingCardIdSet[trainingCard.cardId] == true then
				table.insert(trainingCards, trainingCard)
			end
		end

		return trainingCards
	end

	@ExecSpace("ServerOnly")
	method any UseChoice(any state, integer stateVersion, integer choiceIndex, string characterId)
		-- 육성 캐릭터에 카드 효과를 적용하고 소모 후 남은 태그 뒤에 신규 태그를 추가합니다.
		if state == nil or state.stateVersion ~= stateVersion or state.pending ~= false or state.usedTurns >= state.totalTurns then return nil end
		local choice = state.choices[choiceIndex]
		if choice == nil or choice.sealed == true or _CharacterManager:IsActiveCharacter(characterId) == false then return nil end
		local character = self:GetCharacter(state, characterId)
		if character == nil then return nil end
		local result = self:CalculateTrainingResult(character, choice.cardId)
		if result == nil then return nil end
		for _, stat in ipairs({"vocal", "dance", "visual", "fatigue"}) do character[stat] = character[stat] + result[stat] end
		local updatedTags = result.remainingTags
		local existingTagCount = #updatedTags
		local newTags = {}
		if result.failed == false then
			newTags = _TagTrainingRules:GetGrantedTags(choice.tags)
		end
		character.tags = table.concat(updatedTags, ",")
		for _, tagId in ipairs(newTags) do table.insert(updatedTags, tagId) end
		if #updatedTags > character.tagCapacity then
			state.pending = {characterId = characterId, tags = table.concat(updatedTags, ","), existingTagCount = existingTagCount}
		else
			character.tags = table.concat(updatedTags, ",")
		end
		state.usedTurns = state.usedTurns + 1
		state.stateVersion = state.stateVersion + 1
		if state.pending == false then
			if state.usedTurns < state.totalTurns then self:DealChoices(state) else state.choices = {} end
		end
		return result
	end

	@ExecSpace("ServerOnly")
	method void RegisterUnlockedTrainingCards(table savedCardIds)
		-- 기본 해금 카드와 저장된 추가 해금 카드를 중복 없이 등록합니다.
		self.unlockedTrainingCardIds = {}
		self.unlockedTrainingCardIdSet = {}
		self.savedUnlockedTrainingCardIds = {}
		for _, trainingCard in ipairs(_TrainingDataMaster:GetAllTrainingCards()) do
			if trainingCard.defaultUnlocked == true then
				table.insert(self.unlockedTrainingCardIds, trainingCard.cardId)
				self.unlockedTrainingCardIdSet[trainingCard.cardId] = true
			end
		end
		for _, cardId in ipairs(savedCardIds) do
			local trainingCard = _TrainingDataMaster:GetTrainingCard(cardId)
			if trainingCard ~= nil and self.unlockedTrainingCardIdSet[cardId] ~= true then
				table.insert(self.unlockedTrainingCardIds, cardId)
				self.unlockedTrainingCardIdSet[cardId] = true
				if trainingCard.defaultUnlocked == false then table.insert(self.savedUnlockedTrainingCardIds, cardId) end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void ApplyChoiceEffects(table choices)
		-- BuildChoices의 OtherChoice Seal 효과값만큼 다른 일반 선택지를 무작위로 봉인합니다.
		for pressureIndex, choice in ipairs(choices) do
			local sealCount = math.floor(_TagTrainingRules:GetEffectValue(choice.tags, "BuildChoices", "OtherChoice", "Seal"))
			for _ = 1, sealCount do
				local candidates = {}
				for index, candidate in ipairs(choices) do
					if index ~= pressureIndex and candidate.sealed ~= true
						and _TagTrainingRules:GetEffectValue(candidate.tags, "BuildChoices", "OtherChoice", "Seal") <= 0 then
						table.insert(candidates, candidate)
					end
				end
				if #candidates == 0 then break end
				candidates[math.random(1, #candidates)].sealed = true
			end
		end
	end

	method table CopyStringList(table source)
		-- 저장소와 외부 호출자에게 내부 배열을 직접 노출하지 않도록 복사합니다.
		local copied = {}
		for _, value in ipairs(source) do table.insert(copied, value) end
		return copied
	end

	@ExecSpace("ServerOnly")
	method any CalculateTrainingResult(table character, string cardId)
		-- TrainingCardTable의 카드와 TagEffectTable의 효과만 사용해 한 턴의 육성 결과를 계산합니다.
		local trainingCard = _TrainingDataMaster:GetTrainingCard(cardId)
		if trainingCard == nil then return nil end
		local failureChance = trainingCard.cardType == "training" and _TagTrainingRules:GetFailureChance(character.fatigue) or 0
		local failed = _TagTrainingRules:RollFailure(failureChance)
		local result = _TagTrainingRules:Calculate(character, trainingCard, failed)
		result.characterId = character.id
		result.cardId = trainingCard.cardId
		result.cardType = trainingCard.cardType
		result.failed = failed
		result.failureChance = failureChance
		result.startFatigue = character.fatigue
		return result
	end

	@ExecSpace("ServerOnly")
	method boolean ApplyTagSelection(any state, integer stateVersion, table selectedTagIndices)
		-- 신규 태그를 모두 포함하고 보유 칸을 채운 선택만 검증해 원래 순서로 확정합니다.
		if state == nil or state.stateVersion ~= stateVersion or state.pending == false then return false end
		local character = self:GetCharacter(state, state.pending.characterId)
		if character == nil or #selectedTagIndices ~= character.tagCapacity then return false end
		local allTags = _TagTrainingRules:GetTags(state.pending.tags)
		local selectedTagIndexSet = {}
		for _, index in ipairs(selectedTagIndices) do
			if type(index) ~= "number" or index ~= math.floor(index) or index < 1 or index > #allTags or selectedTagIndexSet[index] then return false end
			selectedTagIndexSet[index] = true
		end
		for index = state.pending.existingTagCount + 1, #allTags do if selectedTagIndexSet[index] ~= true then return false end end
		local selectedTags = {}
		for index, tagId in ipairs(allTags) do if selectedTagIndexSet[index] then table.insert(selectedTags, tagId) end end
		character.tags = table.concat(selectedTags, ",")
		state.pending = false
		state.stateVersion = state.stateVersion + 1
		if state.usedTurns < state.totalTurns then self:DealChoices(state) else state.choices = {} end
		return true
	end

	@ExecSpace("ServerOnly")
	method table BuildSettlementCards(table state)
		-- 실제 캐릭터에 반영하기 전 육성 상태와 현재 수치의 차이를 캐릭터별 결산 카드로 만듭니다.
		local settlementCards = {}
		for index, character in ipairs(state.characters) do
			if index > 3 then break end
			local current = _CharacterManager:ServerGetCharacterById(character.id)
			settlementCards[index] = {
				characterId = character.id,
				vocal = character.vocal - current.vocal,
				dance = character.dance - current.dance,
				visual = character.visual - current.visual,
				fatigue = character.fatigue - current.fatigue
			}
		end
		return settlementCards
	end

	@ExecSpace("ServerOnly")
	method void SyncOrComplete(table state, table result, string userId)
		-- 카드 수행·태그 교체를 저장하고 마지막 턴의 교체까지 끝나면 결과와 스텝을 확정합니다.
		-- 마지막 카드 결과도 스텝 완료 전에 전달해 성공·실패 연출이 누락되지 않게 합니다.
		local isComplete = self:IsTrainingComplete()
		if isComplete then state.settlementCards = self:BuildSettlementCards(state) end
		self:SyncState(state, result, userId)
		if isComplete == false then
			_CharacterManager:SaveCharactersToStorage()
			return
		end
		self:ApplyTrainingResults(state)
		_CharacterManager:PushCharactersToClient(userId)
		_ProgressManager:CompleteStep(_EProgressStep.BeforeTraining, userId)
		-- 완료 기록은 다음 주차까지 유지해 진행 저장이 늦어져도 같은 육성을 반복하지 않습니다.
	end

	@ExecSpace("ServerOnly")
	method void ApplyTrainingResults(table state)
		-- 완료된 육성의 스탯과 태그만 실제 유저 데이터에 반영합니다. 저장은 스텝 완료가 담당합니다.
		for _, character in ipairs(state.characters) do
			local current = _CharacterManager:ServerGetCharacterById(character.id)
			_CharacterManager:ApplyCharacterStat({characterId = character.id, vocal = character.vocal - current.vocal, dance = character.dance - current.dance, visual = character.visual - current.visual, fatigue = character.fatigue - current.fatigue})
			_CharacterManager:SetCharacterTags(character.id, character.tags)
		end
	end

end

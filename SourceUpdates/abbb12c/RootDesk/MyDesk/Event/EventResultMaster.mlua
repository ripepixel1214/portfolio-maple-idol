-- EventResultTable을 로드하고 이벤트 결과 액션과 결과 설명 텍스트를 제공합니다.
@Logic
script EventResultMaster extends Logic
	property string ACTION_GRANT_CONSUMABLE = "grant_consumable"
	property string UNLOCK_TARGET_ITEM = "item"

	property boolean IsEventResultTableLoaded = false

	-- Dictionary<string, EventResultRow>
	property any tEventResultById = {}

	-- EventResultRow[]
	property any tEventResults = {}

	-- Public API

	method void OnBeginPlay()
		-- 이벤트 결과 정적 데이터는 클라이언트/서버 양쪽에서 조회하므로 시작 시 캐시를 준비합니다.
		self:EnsureEventResultTableLoaded()
	end

	method void EnsureEventResultTableLoaded()
		-- 이벤트 결과 테이블이 아직 로드되지 않았으면 로드합니다.
		if self.IsEventResultTableLoaded == true then
			return
		end

		self:LoadEventResultTable()
	end

	method void LoadEventResultTable()
		-- EventResultTable을 읽고 id와 전체 목록 기준으로 캐싱합니다.
		if self.IsEventResultTableLoaded == true then
			return
		end

		self.tEventResultById = {}
		self.tEventResults = {}
		self.IsEventResultTableLoaded = false

		local dataSet = _DataService:GetTable("EventResultTable")
		if dataSet == nil then
			log_warning("[EventResultMaster] EventResultTable not found")
			return
		end

		for rowIndex = 1, dataSet:GetRowCount() do
			local id = _DataTableUtil:SafeGetString(dataSet, rowIndex, "eventResultId", "")
			if id ~= "" then
				local tEventResult = self:CreateEventResultRow(dataSet, rowIndex, id)
				self.tEventResultById[id] = tEventResult
				table.insert(self.tEventResults, tEventResult)
			end
		end

		self.IsEventResultTableLoaded = true
	end

	method any CreateEventResultRow(any dataSet, integer rowIndex, string id)
		-- EventResultTable의 한 row를 EventResultRow 구조체로 변환합니다.
		local tEventResult = EventResultRow()
		tEventResult.id = id
		tEventResult.descriptionKey = _DataTableUtil:SafeGetString(dataSet, rowIndex, "descriptionKey", "")
		tEventResult.value1Action = _DataTableUtil:SafeGetString(dataSet, rowIndex, "value1Action", "")
		tEventResult.value2Action = _DataTableUtil:SafeGetString(dataSet, rowIndex, "value2Action", "")
		tEventResult.value3Action = _DataTableUtil:SafeGetString(dataSet, rowIndex, "value3Action", "")
		return tEventResult
	end

	method any GetEventResult(string id)
		-- id에 해당하는 이벤트 결과 row를 반환합니다.
		self:EnsureEventResultTableLoaded()
		return self.tEventResultById[id]
	end

	method any GetAllEventResults()
		-- 전체 이벤트 결과 row 목록을 반환합니다.
		self:EnsureEventResultTableLoaded()
		return self.tEventResults
	end

	@ExecSpace("ClientOnly")
	method string GetFormattedDescription(string eventResultId, any value1, any value2, any value3, string characterName)
		-- 이벤트 결과 설명 템플릿에 value1~3 값을 반영한 표시 문자열을 반환합니다.
		local tEventResult = self:GetEventResult(eventResultId)
		if tEventResult == nil then
			log_warning("[EventResultMaster] event result not found eventResultId=" .. tostring(eventResultId))
			return ""
		end

		local displayValue1 = self:GetFormattedDescriptionValue(tEventResult.value1Action, value1)
		local displayValue2 = self:GetFormattedDescriptionValue(tEventResult.value2Action, value2)
		local displayValue3 = self:GetFormattedDescriptionValue(tEventResult.value3Action, value3)

		return _LocalizationService:GetTextFormat(
			tEventResult.descriptionKey,
			displayValue1,
			displayValue2,
			displayValue3,
			characterName)
	end

	method any GetFormattedDescriptionValue(string action, any value)
		-- 아이템 지급과 해금 대상의 ID를 표시 이름으로 변환
		if action == nil or action == "" then
			return value
		end
		if action == self.ACTION_GRANT_CONSUMABLE then
			return self:GetUnlockTargetName(self.UNLOCK_TARGET_ITEM, self:NormalizeActionValueToString(value))
		end

		if self:ParseActionOperation(action) ~= "unlock" then
			return value
		end

		local unlockType = self:ParseActionStatKey(action)
		local targetId = self:NormalizeActionValueToString(value)
		if targetId == "" then
			return value
		end

		return self:GetUnlockTargetName(unlockType, targetId)
	end

	method string GetUnlockTargetName(string unlockType, string targetId)
		-- 언락 타입별 마스터 데이터에서 표시 이름을 찾아 반환합니다.
		if unlockType == "activity" then
			local tActivity = _ActivityMaster:GetActivity(targetId)
			if tActivity ~= nil and tActivity.name ~= nil and tActivity.name ~= "" then
				return tActivity.name
			end
		elseif unlockType == "trainingCard" then
			local trainingCard = _TrainingDataMaster:GetTrainingCard(targetId)
			if trainingCard ~= nil then return _LocalizationService:GetText(trainingCard.nameKey) end
		elseif unlockType == "character" then
			local actorName = _RuntimeActorManager:ClientGetLocalizedActorName(targetId)
			if actorName ~= nil and actorName ~= "" then
				return actorName
			end
		elseif unlockType == self.UNLOCK_TARGET_ITEM then
			local tItem = _ItemMaster:GetItemById(targetId)
			if tItem ~= nil and tItem.name ~= nil and tItem.name ~= "" then
				return tItem.name
			end
		end

		return targetId
	end

	@ExecSpace("ClientOnly")
	method string GetFormattedDescriptionByEvent(string eventId, string eventResultId)
		-- 이벤트 row의 성공/실패 value를 찾아 이벤트 결과 설명 템플릿에 반영한 표시 문자열을 반환합니다.
		local tEvent = _EventMaster:GetEvent(eventId)
		if tEvent == nil then
			log_warning("[EventResultMaster] event not found eventId=" .. tostring(eventId))
			return ""
		end

		local characterName = _RuntimeActorManager:ClientGetLocalizedActorName(tEvent.characterId)
		if tEvent.successResultId == eventResultId then
			return self:GetFormattedDescription(eventResultId, tEvent.successValue1, tEvent.successValue2, tEvent.successValue3, characterName)
		elseif tEvent.failResultId == eventResultId then
			return self:GetFormattedDescription(eventResultId, tEvent.failValue1, tEvent.failValue2, tEvent.failValue3, characterName)
		else
			log_warning("[EventResultMaster] event result does not belong to event eventId=" .. tostring(eventId) .. ", eventResultId=" .. tostring(eventResultId))
			return ""
		end
	end

	method any BuildEventResultDataByEvent(string eventId, string eventResultId, string characterId)
		-- eventId/resultId를 바탕으로 이벤트 결과 델타 plain table을 재구성합니다.
		local tEventResult = self:GetEventResult(eventResultId)
		if tEventResult == nil then
			return nil
		end

		local values = self:GetEventResultValuesByEvent(eventId, eventResultId)
		if values == nil then
			return nil
		end

		local tData = {}
		tData.eventId = eventId or ""
		tData.eventResultId = eventResultId or ""
		tData.characterId = characterId or ""
		tData.characterStatDelta = CharacterStatDelta():ToPlainTable()
		tData.progressStatDelta = ProgressStatDelta():ToPlainTable()
		tData.actions = {}

		if self:AddEventResultActionData(tData, tEventResult.value1Action, values[1], characterId) == false then
			return nil
		end

		if self:AddEventResultActionData(tData, tEventResult.value2Action, values[2], characterId) == false then
			return nil
		end

		if self:AddEventResultActionData(tData, tEventResult.value3Action, values[3], characterId) == false then
			return nil
		end

		return tData
	end

	-- Private Methods

	method any GetEventResultValuesByEvent(string eventId, string eventResultId)
		-- EventTable의 성공/실패 value 중 eventResultId에 대응되는 값을 반환합니다.
		local tEvent = _EventMaster:GetEvent(eventId)
		if tEvent == nil then
			return nil
		end

		if tEvent.successResultId == eventResultId then
			return { tEvent.successValue1, tEvent.successValue2, tEvent.successValue3 }
		end

		if tEvent.failResultId == eventResultId then
			return { tEvent.failValue1, tEvent.failValue2, tEvent.failValue3 }
		end

		return nil
	end

	method boolean AddEventResultActionData(table tData, string action, any value, string characterId)
		-- 이벤트 결과 액션 하나를 델타 plain table에 누적합니다.
		if action == nil or action == "" then
			return true
		end

		local operation = self:ParseActionOperation(action)
		local statKey = self:ParseActionStatKey(action)
		if operation == "" or statKey == "" then
			return false
		end

		if operation == "unlock" then
			local targetId = self:NormalizeActionValueToString(value)
			if targetId == "" then
				return false
			end

			table.insert(tData.actions, { action = action, unlockType = statKey, targetId = targetId })
			return true
		end

		local appliedValue = tonumber(value)
		if appliedValue == nil then
			return false
		end

		if operation == "sub" then
			appliedValue = -appliedValue
		elseif operation ~= "add" then
			return false
		end

		if self:IsProgressStatKey(statKey) == true then
			self:AddProgressStatDeltaValue(tData.progressStatDelta, statKey, appliedValue)
		elseif self:IsCharacterStatKey(statKey) == true then
			if characterId == nil or characterId == "" then
				return false
			end
			tData.characterStatDelta.characterId = characterId
			self:AddCharacterStatDeltaValue(tData.characterStatDelta, statKey, appliedValue)
		else
			return false
		end

		table.insert(tData.actions, { action = action, statKey = statKey, value = appliedValue })
		return true
	end

	method string NormalizeActionValueToString(any value)
		-- 이벤트 결과 value를 문자열 id 또는 표시값으로 변환합니다.
		if value == nil then
			return ""
		end

		return tostring(value)
	end

	method string ParseActionOperation(string action)
		local sepIdx, sepEnd = string.find(action, "_")
		if sepIdx == nil then
			return ""
		end

		return string.sub(action, 1, sepIdx - 1)
	end

	method string ParseActionStatKey(string action)
		local sepIdx, sepEnd = string.find(action, "_")
		if sepIdx == nil then
			return ""
		end

		return string.sub(action, sepIdx + 1)
	end

	method boolean IsCharacterStatKey(string statKey)
		return statKey == "vocal" or statKey == "dance" or statKey == "visual"
			or statKey == "fatigue" or statKey == "intimacy"
	end

	method boolean IsProgressStatKey(string statKey)
		return statKey == "fandom" or statKey == "actionPoint" or statKey == "meso" or statKey == "groupMeso"
	end

	method void AddCharacterStatDeltaValue(table tDelta, string statKey, number value)
		-- 캐릭터 스탯 델타 plain table에 값을 누적합니다.
		if statKey == "vocal" then
			tDelta.vocal = (tDelta.vocal or 0) + value
		elseif statKey == "dance" then
			tDelta.dance = (tDelta.dance or 0) + value
		elseif statKey == "visual" then
			tDelta.visual = (tDelta.visual or 0) + value
		elseif statKey == "fatigue" then
			tDelta.fatigue = (tDelta.fatigue or 0) + value
		elseif statKey == "intimacy" then
			tDelta.intimacy = (tDelta.intimacy or 0) + value
		end
	end

	method void AddProgressStatDeltaValue(table tDelta, string statKey, number value)
		-- 진행 스탯 델타 plain table에 값을 누적합니다.
		if statKey == "actionPoint" then
			tDelta.actionPoint = (tDelta.actionPoint or 0) + value
		elseif statKey == "fandom" then
			tDelta.fandom = (tDelta.fandom or 0) + value
		elseif statKey == "meso" then
			tDelta.meso = (tDelta.meso or 0) + value
		end
	end

end

---@description "NPC 컨텍스트 판정과 외출 NPC 이벤트 세션을 서버 권위로 관리"
@Logic
script NpcEventManager extends Logic

	property string ACTIVITY_TYPE_OUTDOOR = "outdoor"

	property string MAP_DOWNTOWN = "Map_Downtown"

	property string MAP_NIGHT_MARKET = "Map_NightMarket"

	property string SESSION_STATUS_IDLE = "idle"

	property string SESSION_STATUS_STARTING = "starting"

	property string SESSION_STATUS_WAITING_DIALOG_CLOSE = "waiting_dialog_close"

	property string SESSION_STATUS_ADVANCING = "advancing"

	property string REJECT_INVALID_REQUEST = "invalid_request"

	property string REJECT_INVALID_USER = "invalid_user"

	property string REJECT_INVALID_MAP = "invalid_map"

	property string REJECT_INVALID_PROGRESS = "invalid_progress"

	property string REJECT_BUSY = "busy"

	property string REJECT_NO_EVENT = "no_event"

	property string REJECT_NO_ACTION_POINT = "no_action_point"

	property string REJECT_EXECUTION_FAILED = "execution_failed"

	property integer OUTDOOR_DAY_PROGRESS = 5

	property integer MAX_NPC_SPAWN_COUNT = 4

	property integer MAX_TRIGGER_COUNT = 1

	property integer MAX_PROCESSED_REQUEST_ID_COUNT = 32

	-- 서버가 확정한 NPC별 이벤트 컨텍스트
	property any preparedContextByNpc = {}

	property string preparedUserId = ""

	property string preparedMapName = ""

	property any processedContextRequestIds = {}

	property any processedContextRequestIdOrder = {}

	property any processedInteractionRequestIds = {}

	property any processedInteractionRequestIdOrder = {}

	property string activeSessionId = ""

	property string activeRequestId = ""

	property string activeSessionStatus = "idle"

	property string activeUserId = ""

	property string activeNpcId = ""

	property string activeMapName = ""

	property string activeCharacterId = ""

	property any activeEventIds = {}

	property integer activeEventIndex = 1

	property string activeEventId = ""

	property string activeStepToken = ""

	property integer activeStepSequence = 0

	property boolean activeActionPointConsumed = false

	property integer activeExecutedEventCount = 0

	property integer sessionSequence = 0

	property integer clientRequestSequence = 0

	@HideFromInspector
	property any userLeaveHandler = nil

	property number REQUEST_TIMEOUT_SECONDS = 5
	property integer MAX_REQUEST_RETRIES = 2
	property number SESSION_TIMEOUT_SECONDS = 600
	property string REJECT_TIMEOUT = "timeout"
	property string REJECT_UNAUTHORIZED_BRANCH = "unauthorized_branch"
	property string REASON_CANCELLED = "cancelled"
	property number activeSessionElapsed = 0
	property string lastAdvancedStepToken = ""
	property any tDialogState = nil
	property any tLastEndedSession = nil
	property any tClientSession = nil
	property any tClientBranchRequest = nil
	property table clientQueuedEventIds = {}
	property number clientSessionElapsed = 0
	property string cachedContextRequestId = ""
	property string cachedContextUserId = ""
	property string cachedContextMapName = ""
	property table cachedNpcContexts = {}
	property table cancelledRequestIds = {}
	property table cancelledRequestIdOrder = {}

	@ExecSpace("ClientOnly")
	method string CreateClientRequestId(string prefix)
		-- 맵 재진입과 NPC 재스폰에도 충돌하지 않는 클라이언트 요청 ID 발급
		self.clientRequestSequence = self.clientRequestSequence + 1
		return tostring(prefix or "npc") .. ":" .. tostring(self.clientRequestSequence)
	end

	method void OnBeginPlay()
		-- 서버 NPC 컨텍스트와 활성 세션 초기화
		if self:IsClient() then
			self.tClientSession = nil
			self.tClientBranchRequest = nil
			self.clientQueuedEventIds = {}
			self.clientSessionElapsed = 0
			return
		end
		self.processedContextRequestIds = {}
		self.processedContextRequestIdOrder = {}
		self.processedInteractionRequestIds = {}
		self.processedInteractionRequestIdOrder = {}
		self:ClearPreparedContext()
		self:ClearActiveSession()
		self.tLastEndedSession = nil
		self.cachedContextRequestId = ""
		self.cancelledRequestIds = {}
		self.cancelledRequestIdOrder = {}
		if self.userLeaveHandler == nil and _UserService ~= nil then
			self.userLeaveHandler = _UserService:ConnectEvent(UserLeaveEvent, self.OnUserLeave)
		end
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 사용자 이탈 이벤트 구독과 서버 세션 상태 정리
		if self.userLeaveHandler ~= nil and _UserService ~= nil then
			_UserService:DisconnectEvent(UserLeaveEvent, self.userLeaveHandler)
			self.userLeaveHandler = nil
		end
		self:ClearPreparedContext()
		self:ClearActiveSession()
	end

	@ExecSpace("ServerOnly")
	method void OnUserLeave(UserLeaveEvent event)
		-- 요청 사용자 이탈 시 활성 세션과 재전송 방지 캐시 정리
		if event == nil or event.UserId == nil or event.UserId == "" then
			return
		end
		if self.activeUserId == event.UserId then
			self:ClearActiveSession()
		end
		if self.preparedUserId == event.UserId then
			self:ClearPreparedContext()
		end
		self.processedContextRequestIds = {}
		self.processedContextRequestIdOrder = {}
		self.processedInteractionRequestIds = {}
		self.processedInteractionRequestIdOrder = {}
		self.cachedContextRequestId = ""
		self.cachedNpcContexts = {}
		self.tLastEndedSession = nil
		self.cancelledRequestIds = {}
		self.cancelledRequestIdOrder = {}
	end

	@ExecSpace("Server")
	method void RequestNpcContext(string requestId, string mapName)
		-- 요청자 상태를 검증한 뒤 외출 맵 NPC 표시 컨텍스트 계산
		local userId = senderUserId
		local user = self:ResolveRequestUser(userId)
		if requestId ~= "" and requestId == self.cachedContextRequestId
			and userId == self.cachedContextUserId and mapName == self.cachedContextMapName
			and self:IsValidOutdoorMap(user, mapName) then
			self:SyncNpcContext(requestId, self.cachedNpcContexts, userId)
			return
		end
		if requestId == nil or requestId == "" then
			self:PushNpcContextRejected(requestId or "", self.REJECT_INVALID_REQUEST, userId)
			return
		end
		if #requestId > 200 or self.activeSessionStatus ~= self.SESSION_STATUS_IDLE then
			self:PushNpcContextRejected(requestId, self.REJECT_BUSY, userId)
			return
		end

		if self:TryRecordProcessedRequestId(
			self.processedContextRequestIds,
			self.processedContextRequestIdOrder,
			requestId) == false then
			log_warning("[NpcEventSession] duplicate context request userId=" .. tostring(userId)
				.. " requestId=" .. tostring(requestId)
				.. " mapName=" .. tostring(mapName)
				.. " reason=" .. self.REJECT_INVALID_REQUEST)
			self:PushNpcContextRejected(requestId, self.REJECT_INVALID_REQUEST, userId)
			return
		end

		user = self:ResolveRequestUser(userId)
		if user == nil then
			self:PushNpcContextRejected(requestId, self.REJECT_INVALID_USER, userId)
			return
		end

		if self:IsValidOutdoorMap(user, mapName) == false then
			self:PushNpcContextRejected(requestId, self.REJECT_INVALID_MAP, userId)
			return
		end

		if _OutdoorMapTransitionLogic == nil or _OutdoorMapTransitionLogic:CanUseOutdoorProgress(userId) == false then
			self:PushNpcContextRejected(requestId, self.REJECT_INVALID_PROGRESS, userId)
			return
		end

		local npcContexts = self:EvaluateNpcContext(userId, mapName)
		self.cachedContextRequestId = requestId
		self.cachedContextUserId = userId
		self.cachedContextMapName = mapName
		self.cachedNpcContexts = npcContexts
		self:SyncNpcContext(requestId, npcContexts, userId)
	end

	@ExecSpace("Client")
	method void SyncNpcContext(string requestId, table npcContexts)
		-- 서버가 확정한 NPC 표시 컨텍스트를 현재 외출 맵 스폰 컴포넌트에 전달
		local player = _UserService.LocalPlayer
		local currentMap = player ~= nil and player.CurrentMap or nil
		if isvalid(currentMap) == false then
			return
		end

		---@type NpcSpawnComponent
		local spawnComponent = currentMap:GetComponent("script.NpcSpawnComponent")
		if spawnComponent ~= nil and requestId ~= spawnComponent.pendingContextRequestId then
			return
		end
		if spawnComponent ~= nil then
			spawnComponent:ApplyNpcContext(requestId, npcContexts)
		end

		local triggerComponents = currentMap:GetChildComponentsByTypeName("script.NpcEventTriggerComponent", true) or {}
		for _, triggerComponent in ipairs(triggerComponents) do
			local matchedContext = nil
			for _, npcContext in ipairs(npcContexts) do
				if triggerComponent ~= nil and npcContext ~= nil and triggerComponent.npcId == npcContext.npcId then
					matchedContext = npcContext
					break
				end
			end

			if triggerComponent ~= nil then
				if matchedContext ~= nil then
					triggerComponent:ConfigureNpcContext(
						matchedContext.npcId or "",
						matchedContext.characterId or "",
						matchedContext.eventAvailable == true)
				else
					triggerComponent:ConfigureNpcContext(triggerComponent.npcId or "", "", false)
				end
			end
		end
	end

	@ExecSpace("Client")
	method void SyncNpcContextRejected(string requestId, string reason)
		-- NPC 컨텍스트 거절 상태를 현재 외출 맵 스폰 컴포넌트에 전달
		local player = _UserService.LocalPlayer
		local currentMap = player ~= nil and player.CurrentMap or nil
		if isvalid(currentMap) == false then
			return
		end

		---@type NpcSpawnComponent
		local spawnComponent = currentMap:GetComponent("script.NpcSpawnComponent")
		if spawnComponent ~= nil and requestId ~= spawnComponent.pendingContextRequestId then
			return
		end
		if spawnComponent ~= nil then
			spawnComponent:OnNpcContextRejected(requestId, reason)
		end

		local triggerComponents = currentMap:GetChildComponentsByTypeName("script.NpcEventTriggerComponent", true) or {}
		for _, triggerComponent in ipairs(triggerComponents) do
			if triggerComponent ~= nil then
				triggerComponent:ConfigureNpcContext(triggerComponent.npcId or "", "", false)
			end
		end
	end

	@ExecSpace("Server")
	method void RequestBeginNpcInteraction(string requestId, string npcId)
		-- 서버가 준비한 NPC 이벤트를 검증하고 행동력 차감과 세션 생성을 단일 처리
		local userId = senderUserId
		if self.cancelledRequestIds[requestId] then
			self:RejectInteraction(requestId, npcId, self.REASON_CANCELLED, userId)
			return
		end
		if requestId ~= "" and requestId == self.activeRequestId and npcId == self.activeNpcId
			and self:IsBranchContextValid(self.activeSessionId, self.activeStepToken, userId) then
			self:NotifyNpcSessionStarted(requestId, self.activeSessionId, npcId, self.activeStepToken, userId)
			self:ReplayNpcPresentation(userId)
			return
		end
		if requestId == nil or requestId == "" or npcId == nil or npcId == "" then
			self:RejectInteraction(requestId or "", npcId or "", self.REJECT_INVALID_REQUEST, userId)
			return
		end

		if self:TryRecordProcessedRequestId(
			self.processedInteractionRequestIds,
			self.processedInteractionRequestIdOrder,
			requestId) == false then
			self:RejectInteraction(requestId, npcId, self.REJECT_INVALID_REQUEST, userId)
			return
		end

		if self.activeSessionStatus ~= self.SESSION_STATUS_IDLE then
			self:RejectInteraction(requestId, npcId, self.REJECT_BUSY, userId)
			return
		end

		local user = self:ResolveRequestUser(userId)
		if user == nil then
			self:RejectInteraction(requestId, npcId, self.REJECT_INVALID_USER, userId)
			return
		end

		local currentMapName = user.CurrentMap ~= nil and user.CurrentMap.Name or ""
		if self:IsValidOutdoorMap(user, currentMapName) == false
			or currentMapName ~= self.preparedMapName
			or userId ~= self.preparedUserId then
			self:RejectInteraction(requestId, npcId, self.REJECT_INVALID_MAP, userId)
			return
		end

		if self:CanUseOutdoorProgress(userId) == false then
			self:RejectInteraction(requestId, npcId, self.REJECT_INVALID_PROGRESS, userId)
			return
		end

		local context = self.preparedContextByNpc[npcId]
		if context == nil or context.eventIds == nil or #context.eventIds <= 0 then
			self:RejectInteraction(requestId, npcId, self.REJECT_NO_EVENT, userId)
			return
		end
		if self:IsPreparedContextValid(context, npcId, currentMapName) == false then
			self:RejectInteraction(requestId, npcId, self.REJECT_NO_EVENT, userId)
			return
		end

		if _ProgressManager == nil or _ProgressManager:TryConsumeNpcActionPoint(userId) == false then
			self:RejectInteraction(requestId, npcId, self.REJECT_NO_ACTION_POINT, userId)
			return
		end

		self.sessionSequence = self.sessionSequence + 1
		self.activeSessionId = "npc:" .. tostring(self.sessionSequence) .. ":" .. tostring(userId)
		self.activeRequestId = requestId
		self.activeSessionStatus = self.SESSION_STATUS_STARTING
		self.activeUserId = userId
		self.activeNpcId = npcId
		self.activeMapName = currentMapName
		self.activeCharacterId = context.characterId or ""
		self.activeEventIds = self:CopyStringList(context.eventIds)
		self.activeEventIndex = 1
		self.activeEventId = ""
		self.activeStepToken = ""
		self.activeStepSequence = 0
		self.activeActionPointConsumed = true
		self.activeExecutedEventCount = 0
		self.activeSessionElapsed = 0
		self.lastAdvancedStepToken = ""

		if self:PrepareActiveStep() == false then
			self:RejectRunningSession(self.REJECT_EXECUTION_FAILED)
			return
		end
		self:NotifyNpcSessionStarted(requestId, self.activeSessionId, npcId, self.activeStepToken, userId)
		if self:ExecuteAuthorizedNpcEvent(self.activeSessionId) == false then
			self:RejectRunningSession(self.REJECT_EXECUTION_FAILED)
		end
	end

	@ExecSpace("Server")
	method void RequestAdvanceNpcInteraction(string sessionId, string stepToken)
		-- 현재 서버 세션의 대화 종료를 확인하고 완료 기록 후 다음 이벤트 진행
		if self.tLastEndedSession ~= nil and sessionId == self.tLastEndedSession.sessionId
			and senderUserId == self.tLastEndedSession.userId and stepToken == self.tLastEndedSession.stepToken then
			self:NotifyNpcSessionEnded(sessionId, self.tLastEndedSession.npcId,
				self.tLastEndedSession.success, self.tLastEndedSession.reason, senderUserId)
			return
		end
		if stepToken ~= "" and stepToken == self.lastAdvancedStepToken
			and self:IsSessionOwner(sessionId, senderUserId) then
			self:NotifyNpcSessionStep(sessionId, self.activeNpcId, self.activeStepToken, senderUserId)
			self:ReplayNpcPresentation(senderUserId)
			return
		end
		if self:IsSessionOwner(sessionId, senderUserId) == false
			or self.activeSessionStatus ~= self.SESSION_STATUS_WAITING_DIALOG_CLOSE
			or stepToken == nil
			or stepToken == ""
			or stepToken ~= self.activeStepToken then
			log_warning("[NpcEventSession] advance rejected userId=" .. tostring(senderUserId)
				.. " sessionId=" .. tostring(sessionId)
				.. " stepToken=" .. tostring(stepToken)
				.. " expectedStepToken=" .. tostring(self.activeStepToken)
				.. " status=" .. tostring(self.activeSessionStatus)
				.. " requestId=" .. tostring(self.activeRequestId)
				.. " npcId=" .. tostring(self.activeNpcId)
				.. " mapName=" .. tostring(self.activeMapName)
				.. " reason=" .. self.REJECT_INVALID_REQUEST)
			return
		end
		if self.tDialogState == nil or not self.tDialogState:IsComplete() then
			self:RejectRunningSession(self.REJECT_UNAUTHORIZED_BRANCH)
			return
		end
		self.lastAdvancedStepToken = stepToken
		self.activeSessionStatus = self.SESSION_STATUS_ADVANCING

		local user = self:ResolveRequestUser(senderUserId)
		local currentMapName = user ~= nil and user.CurrentMap ~= nil and user.CurrentMap.Name or ""
		if currentMapName ~= self.activeMapName or self:CanUseOutdoorProgress(senderUserId) == false then
			self:RejectRunningSession(self.REJECT_INVALID_MAP)
			return
		end

		if self.activeEventId ~= "" and _EventCompletionManager ~= nil then
			_EventCompletionManager:MarkEventCompletedWithCommit(self.activeEventId, self.activeCharacterId, self.activeUserId)
		end

		self.activeEventIndex = self.activeEventIndex + 1
		self.activeEventId = ""
		self.activeStepToken = ""
		if self.activeEventIndex <= #self.activeEventIds then
			if self:PrepareActiveStep() == false then
				self:RejectRunningSession(self.REJECT_EXECUTION_FAILED)
				return
			end
			self:NotifyNpcSessionStep(self.activeSessionId, self.activeNpcId, self.activeStepToken, self.activeUserId)
			if self:ExecuteAuthorizedNpcEvent(sessionId) == false then
				self:RejectRunningSession(self.REJECT_EXECUTION_FAILED)
			end
			return
		end

		self:CompleteActiveSession()
	end

	@ExecSpace("Server")
	method void RequestCancelNpcInteraction(string sessionId)
		-- 요청자 소유 세션을 환불 없이 종료
		if self:IsSessionOwner(sessionId, senderUserId) == false then
			return
		end

		self:RejectRunningSession(self.REASON_CANCELLED)
	end

	@ExecSpace("ServerOnly")
	method any EvaluateNpcContext(string userId, string mapName)
		-- 서버 진행 상태와 트리거 데이터로 NPC별 표시 컨텍스트와 비공개 이벤트 목록 계산
		local contexts = {}
		self:ClearPreparedContext()
		self.preparedUserId = userId or ""
		self.preparedMapName = mapName or ""

		local progress = _ProgressManager ~= nil and _ProgressManager:ServerGetProgress() or nil
		if self:CanUseOutdoorProgress(userId) == false or progress == nil or (progress.actionPoint or 0) <= 0 then
			return contexts
		end

		if _EventTriggerManager == nil then
			return contexts
		end

		if _EventTriggerManager.IsEventTriggerTableLoaded == false then
			_EventTriggerManager:LoadEventTriggerTable()
		end

		local seenNpcIds = {}
		for _, trigger in ipairs(_EventTriggerManager.tTriggers) do
			local npcId = trigger.npcId or ""
			if trigger.enabled == true
				and self:IsNpcTriggerAvailableOnMap(trigger, mapName) == true
				and npcId ~= ""
				and seenNpcIds[npcId] ~= true then
				seenNpcIds[npcId] = true
				local characterId = self:ResolveNpcCharacterId(npcId)
				local triggers = _EventTriggerManager:EvaluateActivityTriggers(
					trigger.activityType or "", trigger.activityId or "", characterId, npcId,
					self.OUTDOOR_DAY_PROGRESS, self.MAX_TRIGGER_COUNT)
				local eventIds = _EventTriggerManager:GetEventIds(triggers)
				if eventIds ~= nil and #eventIds > 0 then
					local winningTrigger = triggers[1]
					local context = {
						npcId = npcId,
						characterId = characterId,
						spawnX = winningTrigger.spawnX or 0,
						spawnY = winningTrigger.spawnY or 0,
						eventAvailable = true,
						eventIds = self:CopyStringList(eventIds)
					}
					self.preparedContextByNpc[npcId] = context
					table.insert(contexts, {
						npcId = context.npcId,
						characterId = context.characterId,
						spawnX = context.spawnX,
						spawnY = context.spawnY,
						eventAvailable = true
					})
					if #contexts >= self.MAX_NPC_SPAWN_COUNT then
						break
					end
				end
			end
		end

		return contexts
	end

	@ExecSpace("ServerOnly")
	method boolean ExecuteAuthorizedNpcEvent(string sessionId)
		-- 서버 세션에 저장된 현재 이벤트만 EventExecutor 내부 실행 경로로 전달
		if self:IsSessionOwner(sessionId, self.activeUserId) == false
			or self:CanUseOutdoorProgress(self.activeUserId) == false then
			return false
		end

		if self.activeEventIndex <= 0 or self.activeEventIndex > #self.activeEventIds then
			return false
		end

		local eventId = self.activeEventIds[self.activeEventIndex] or ""
		local eventData = _EventMaster ~= nil and _EventMaster:GetEvent(eventId) or nil
		if eventData == nil or eventData.eventType ~= _EEventType.Dialog then
			return false
		end

		self.activeEventId = eventId
		_NpcDialogGuard:EnsureCached()
		if not _NpcDialogGuard.isCached then return false end
		local tState = NpcDialogState()
		tState.rootEventId = eventId
		tState:SetDialog(eventData.dialogId, _NpcDialogGuard:GetDialogEventIds(eventData.dialogId))
		self.tDialogState = tState
		local isExecuted = _EventExecutor ~= nil
			and _EventExecutor:ExecuteEvent(eventId, self.activeCharacterId, self.activeUserId) == true
		if isExecuted == true then
			self.activeExecutedEventCount = self.activeExecutedEventCount + 1
		end
		return isExecuted
	end

	@ExecSpace("ServerOnly")
	method boolean PrepareActiveStep()
		-- 현재 이벤트 단계의 1회성 진행 토큰 발급과 대화 종료 대기 상태 전환
		if self.activeSessionStatus ~= self.SESSION_STATUS_STARTING
			and self.activeSessionStatus ~= self.SESSION_STATUS_ADVANCING then
			return false
		end
		if self.activeEventIndex <= 0 or self.activeEventIndex > #self.activeEventIds then
			return false
		end

		self.activeStepSequence = self.activeStepSequence + 1
		self.activeStepToken = self.activeSessionId
			.. ":step:" .. tostring(self.activeEventIndex)
			.. ":" .. tostring(self.activeStepSequence)
		self.activeSessionStatus = self.SESSION_STATUS_WAITING_DIALOG_CLOSE
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean CanUseOutdoorProgress(string userId)
		-- 스테이지 진행 중 외출 단계만 NPC 이벤트 허용, 단순 외출 접근 권한과 분리
		if _ProgressManager == nil or _ProgressManager:CanUseProgress(userId) == false then
			return false
		end
		local progress = _ProgressManager:ServerGetProgress()
		if progress == nil or progress.eCurrentStep ~= _EProgressStep.Outdoor
			or progress.eCurrentStage == nil or progress.eCurrentStage == "" then
			return false
		end
		return _OutdoorMapTransitionLogic ~= nil
			and _OutdoorMapTransitionLogic:CanUseOutdoorProgress(userId) == true
	end

	@ExecSpace("ServerOnly")
	method Entity ResolveRequestUser(string userId)
		-- 1인 인스턴스 전제와 진행 데이터 소유자가 일치하는 요청자 반환
		if userId == nil or userId == "" or _UserService == nil then
			return nil
		end

		if _ProgressManager == nil or _ProgressManager.currentUserId ~= userId then
			return nil
		end

		return _UserService:GetUserEntityByUserId(userId)
	end

	@ExecSpace("ServerOnly")
	method boolean IsValidOutdoorMap(Entity user, string mapName)
		-- 현재 맵 일치와 공통 외출 해금 조건 확인
		if isvalid(user) == false or isvalid(user.CurrentMap) == false or user.PlayerComponent == nil
			or _OutdoorMapTransitionLogic == nil then
			return false
		end
		return user.CurrentMap.Name == mapName
			and _OutdoorMapTransitionLogic:CanAccessOutdoorMap(user.PlayerComponent.UserId, mapName) == true
	end

	@ExecSpace("ServerOnly")
	method string ResolveNpcCharacterId(string npcId)
		-- 보유 캐릭터와 일치하는 NPC만 이벤트 대상 characterId로 사용
		if npcId == nil or npcId == "" or _CharacterManager == nil then
			return ""
		end

		if _CharacterManager:ServerGetCharacterById(npcId) ~= nil then
			return npcId
		end

		return ""
	end

	@ExecSpace("ServerOnly")
	method boolean IsSessionOwner(string sessionId, string userId)
		-- 활성 세션 식별자와 사용자 소유권 일치 여부 확인
		return self.activeSessionStatus ~= self.SESSION_STATUS_IDLE
			and sessionId ~= nil
			and sessionId ~= ""
			and sessionId == self.activeSessionId
			and userId == self.activeUserId
	end

	@ExecSpace("ServerOnly")
	method boolean IsPreparedContextValid(any context, string npcId, string mapName)
		-- 서버 보관 컨텍스트의 NPC·이벤트 매핑과 미완료 상태 재검증
		if context == nil or context.npcId ~= npcId or context.eventIds == nil
			or _EventTriggerManager == nil or _EventExecutor == nil or _EventMaster == nil then
			return false
		end

		for _, eventId in ipairs(context.eventIds) do
			local isMappedNpcEvent = false
			for _, trigger in ipairs(_EventTriggerManager.tTriggers) do
				if trigger.eventId == eventId
					and trigger.npcId == npcId
					and trigger.enabled == true
					and self:IsNpcTriggerAvailableOnMap(trigger, mapName) == true then
					isMappedNpcEvent = true
					break
				end
			end

			if isMappedNpcEvent == false then
				return false
			end
			local eventData = _EventMaster:GetEvent(eventId)
			if eventData == nil or eventData.eventType ~= _EEventType.Dialog
				or eventData.dialogId == nil or eventData.dialogId == "" then
				return false
			end
			if _EventCompletionManager ~= nil
				and _EventCompletionManager:ServerIsEventCompleted(eventId, context.characterId or "") == true then
				return false
			end
		end

		return #context.eventIds > 0
	end

	@ExecSpace("ServerOnly")
	method boolean IsNpcTriggerAvailableOnMap(any trigger, string mapName)
		-- 외출 트리거의 활동 유형과 맵 식별자 일치 여부 확인
		if trigger == nil or mapName == nil or mapName == "" then
			return false
		end

		return trigger.activityType == self.ACTIVITY_TYPE_OUTDOOR
			and trigger.activityId ~= nil
			and trigger.activityId ~= ""
			and trigger.activityId == mapName
	end

	@ExecSpace("ServerOnly")
	method void CompleteActiveSession()
		-- 완료 세션 저장과 클라이언트 종료 통지 후 서버 상태 초기화
		local sessionId = self.activeSessionId
		local userId = self.activeUserId
		local npcId = self.activeNpcId
		self:RememberEndedSession(true, "")
		_UserDataManager:SaveCoreData()

		self:ClearActiveSession()
		self:NotifyNpcSessionEnded(sessionId, npcId, true, "", userId)
	end

	@ExecSpace("ServerOnly")
	method void RejectRunningSession(string reason)
		-- 실행 중 세션 실패 상태를 클라이언트에 통지하고 서버 상태 초기화
		local sessionId = self.activeSessionId
		local requestId = self.activeRequestId
		local userId = self.activeUserId
		local npcId = self.activeNpcId
		local mapName = self.activeMapName
		self:RememberEndedSession(false, reason)
		local isActionPointRolledBack = self:TryRollbackFailedSessionActionPoint(reason)
		log_warning("[NpcEventSession] session rejected userId=" .. tostring(userId)
			.. " requestId=" .. tostring(requestId)
			.. " sessionId=" .. tostring(sessionId)
			.. " npcId=" .. tostring(npcId)
			.. " mapName=" .. tostring(mapName)
			.. " reason=" .. tostring(reason)
			.. " actionPointRolledBack=" .. tostring(isActionPointRolledBack))
		self:ClearActiveSession()
		self:NotifyNpcSessionEnded(sessionId, npcId, false, reason, userId)
	end

	@ExecSpace("ServerOnly")
	method boolean TryRollbackFailedSessionActionPoint(string reason)
		-- 첫 이벤트가 시작되기 전 서버 실행 실패에 한해 행동력 소비 취소
		if reason ~= self.REJECT_EXECUTION_FAILED
			or self.activeActionPointConsumed ~= true
			or self.activeExecutedEventCount > 0
			or _ProgressManager == nil then
			return false
		end

		local isRolledBack = _ProgressManager:RollbackNpcActionPoint(self.activeUserId)
		if isRolledBack == true then
			self.activeActionPointConsumed = false
		end
		return isRolledBack
	end

	@ExecSpace("ServerOnly")
	method void RejectInteraction(string requestId, string npcId, string reason, string userId)
		-- 상호작용 요청 거절 사유 기록과 대상 클라이언트 통지
		log_warning("[NpcEventSession] interaction rejected userId=" .. tostring(userId)
			.. " requestId=" .. tostring(requestId)
			.. " npcId=" .. tostring(npcId)
			.. " reason=" .. tostring(reason))
		if userId ~= nil and userId ~= "" then
			self:NotifyNpcSessionRejected(requestId, npcId, reason, userId)
		end
	end

	@ExecSpace("ServerOnly")
	method void PushNpcContextRejected(string requestId, string reason, string userId)
		-- NPC 컨텍스트 요청 거절 사유 기록과 대상 클라이언트 통지
		log_warning("[NpcEventSession] context rejected userId=" .. tostring(userId)
			.. " requestId=" .. tostring(requestId)
			.. " reason=" .. tostring(reason))
		if userId ~= nil and userId ~= "" then
			self:SyncNpcContextRejected(requestId, reason, userId)
		end
	end

	@ExecSpace("Client")
	method void NotifyNpcSessionStarted(string requestId, string sessionId, string npcId, string stepToken)
		-- 대상 NPC 클라이언트 컴포넌트에 서버 세션 시작 전달
		self:DispatchSessionStateToNpc(npcId, requestId, sessionId, stepToken, true, "")
	end

	@ExecSpace("Client")
	method void NotifyNpcSessionStep(string sessionId, string npcId, string stepToken)
		-- 대상 NPC 클라이언트 컴포넌트에 다음 대화 단계 토큰 전달
		local player = _UserService.LocalPlayer
		local currentMap = player ~= nil and player.CurrentMap or nil
		if isvalid(currentMap) == false then
			return
		end

		local components = currentMap:GetChildComponentsByTypeName("script.NpcEventTriggerComponent", true) or {}
		for _, component in ipairs(components) do
			if component ~= nil and component.npcId == npcId then
				component:OnServerSessionStep(sessionId, stepToken)
			end
		end
	end

	@ExecSpace("Client")
	method void NotifyNpcSessionRejected(string requestId, string npcId, string reason)
		-- 대상 NPC 클라이언트 컴포넌트에 서버 요청 거절 전달
		self:DispatchSessionStateToNpc(npcId, requestId, "", "", false, reason)
	end

	@ExecSpace("Client")
	method void NotifyNpcSessionEnded(string sessionId, string npcId, boolean isCompleted, string reason)
		-- 대상 NPC 클라이언트 컴포넌트에 세션 종료 전달
		if not isCompleted and self.tClientSession ~= nil and self.tClientSession.sessionId == sessionId then
			self:EndClientSession(reason, false)
			return
		end
		local player = _UserService.LocalPlayer
		local currentMap = player ~= nil and player.CurrentMap or nil
		if isvalid(currentMap) == false then
			return
		end

		local components = currentMap:GetChildComponentsByTypeName("script.NpcEventTriggerComponent", true) or {}
		for _, component in ipairs(components) do
			if component ~= nil and component.npcId == npcId then
				component:OnServerSessionEnded(sessionId, isCompleted, reason)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void DispatchSessionStateToNpc(string npcId, string requestId, string sessionId, string stepToken, boolean isAccepted, string reason)
		-- 현재 맵의 대상 NPC 상호작용 컴포넌트에 서버 응답 전달
		local player = _UserService.LocalPlayer
		local currentMap = player ~= nil and player.CurrentMap or nil
		if isvalid(currentMap) == false then
			return
		end

		local components = currentMap:GetChildComponentsByTypeName("script.NpcEventTriggerComponent", true) or {}
		for _, component in ipairs(components) do
			if component ~= nil and component.npcId == npcId then
				if isAccepted == true then
					component:OnServerSessionStarted(requestId, sessionId, stepToken)
				else
					component:OnServerSessionRejected(requestId, reason)
				end
			end
		end
	end

	method any CopyStringList(any source)
		-- 문자열 배열의 독립 복사본 생성
		local copied = {}
		if source == nil or type(source) ~= "table" then
			return copied
		end

		for _, value in ipairs(source) do
			if value ~= nil and value ~= "" then
				table.insert(copied, tostring(value))
			end
		end
		return copied
	end

	@ExecSpace("ServerOnly")
	method boolean TryRecordProcessedRequestId(any requestIdSet, any requestIdOrder, string requestId)
		-- 최근 요청 ID만 보관하는 FIFO 캐시 기록
		if requestIdSet == nil or requestIdOrder == nil
			or requestId == nil or requestId == ""
			or requestIdSet[requestId] == true then
			return false
		end

		requestIdSet[requestId] = true
		table.insert(requestIdOrder, requestId)
		while #requestIdOrder > self.MAX_PROCESSED_REQUEST_ID_COUNT do
			local expiredRequestId = table.remove(requestIdOrder, 1)
			if expiredRequestId ~= nil then
				requestIdSet[expiredRequestId] = nil
			end
		end
		return true
	end

	@ExecSpace("ServerOnly")
	method void ClearPreparedContext()
		-- 서버가 보관한 NPC 표시 및 이벤트 컨텍스트 초기화
		self.preparedContextByNpc = {}
		self.preparedUserId = ""
		self.preparedMapName = ""
	end

	@ExecSpace("ServerOnly")
	method void ClearActiveSession()
		-- 서버 활성 NPC 이벤트 세션 초기화
		local endedSessionId = self.activeSessionId
		local endedUserId = self.activeUserId
		self.activeSessionId = ""
		self.activeRequestId = ""
		self.activeSessionStatus = self.SESSION_STATUS_IDLE
		self.activeUserId = ""
		self.activeNpcId = ""
		self.activeMapName = ""
		self.activeCharacterId = ""
		self.activeEventIds = {}
		self.activeEventIndex = 1
		self.activeEventId = ""
		self.activeStepToken = ""
		self.activeStepSequence = 0
		self.activeActionPointConsumed = false
		self.activeExecutedEventCount = 0
		self.tDialogState = nil
		self.activeSessionElapsed = 0
		self.lastAdvancedStepToken = ""
		if endedSessionId ~= "" and _EventExecutor ~= nil then
			local pending = {}
			for miniGameSessionId, context in pairs(_EventExecutor.miniGameContextBySession) do
				if context.npcSessionId == endedSessionId then table.insert(pending, miniGameSessionId) end
			end
			for _, miniGameSessionId in ipairs(pending) do
				_EventExecutor:ClearMiniGameContext(miniGameSessionId)
				_MiniGameContentService:Cancel(miniGameSessionId, endedUserId)
			end
		end
	end

	method void OnUpdate(number delta)
		-- 서버 세션 만료와 클라이언트 응답 대기를 저장소 호출 없이 감시
		if self:IsClient() then
			self:UpdateClientRequests(delta)
			return
		end
		if self.activeSessionStatus == self.SESSION_STATUS_IDLE then return end
		self.activeSessionElapsed += math.max(delta, 0)
		if self.activeSessionElapsed >= self.SESSION_TIMEOUT_SECONDS then
			self:RejectRunningSession(self.REJECT_TIMEOUT)
			return
		end
		local user = self:ResolveRequestUser(self.activeUserId)
		if not self:IsValidOutdoorMap(user, self.activeMapName) or not self:CanUseOutdoorProgress(self.activeUserId) then
			self:RejectRunningSession(self.REJECT_INVALID_MAP)
		end
	end

	@ExecSpace("ServerOnly")
	method void RememberEndedSession(boolean success, string reason)
		-- 마지막 종료 응답을 보관해 대화 종료 요청 재전송에 동일 결과 반환
		local tReceipt = NpcRequestState()
		tReceipt.requestId = self.activeRequestId
		tReceipt.sessionId = self.activeSessionId
		tReceipt.stepToken = self.lastAdvancedStepToken ~= "" and self.lastAdvancedStepToken or self.activeStepToken
		tReceipt.userId = self.activeUserId
		tReceipt.npcId = self.activeNpcId
		tReceipt.success = success
		tReceipt.reason = reason
		self.tLastEndedSession = tReceipt
	end

	@ExecSpace("Server")
	method void RequestCancelNpcRequest(string requestId, string npcId)
		-- 시작 응답이 유실된 요청도 식별자로 취소하고 뒤늦은 시작 차단
		if requestId == "" or npcId == "" or self:ResolveRequestUser(senderUserId) == nil then return end
		self:TryRecordProcessedRequestId(self.cancelledRequestIds, self.cancelledRequestIdOrder, requestId)
		if self.activeRequestId == requestId and self.activeNpcId == npcId and self.activeUserId == senderUserId then
			self:RejectRunningSession(self.REASON_CANCELLED)
		end
	end

	@ExecSpace("ServerOnly")
	method boolean IsBranchContextValid(string sessionId, string stepToken, string userId)
		-- 세션 소유권과 현재 맵 및 서버 단계 토큰을 함께 검증
		local user = self:ResolveRequestUser(userId)
		return self:IsSessionOwner(sessionId, userId) and stepToken ~= "" and stepToken == self.activeStepToken
			and self.activeSessionStatus == self.SESSION_STATUS_WAITING_DIALOG_CLOSE
			and self:IsValidOutdoorMap(user, self.activeMapName) and self:CanUseOutdoorProgress(userId)
	end

	@ExecSpace("Server")
	method void RequestExecuteNpcEvent(string sessionId, string stepToken, string requestId, string eventId)
		-- 현재 대화의 분기만 실행하고 같은 요청 재전송에는 저장된 응답 반환
		self:HandleNpcEventRequest(sessionId, stepToken, requestId, eventId, senderUserId)
	end

	@ExecSpace("ServerOnly")
	method void HandleNpcEventRequest(string sessionId, string stepToken, string requestId, string eventId, string userId)
		-- 분기 예약을 실행 전에 확정해 동시 요청과 다른 선택지 재실행 차단
		if requestId == "" or #requestId > 200 or eventId == ""
			or not self:IsBranchContextValid(sessionId, stepToken, userId) or self.tDialogState == nil then return end
		---@type NpcDialogState
		local tState = self.tDialogState
		local tReceipt = tState.receipts[requestId]
		if tReceipt ~= nil then
			if tReceipt.eventId == eventId and tReceipt.finished then self:ReplyNpcBranch(requestId, eventId, tReceipt.success, userId) end
			return
		end
		local tEvent = _EventMaster:GetEvent(eventId)
		if tEvent == nil or not tState:ConsumeEvent(eventId, requestId) then
			log_warning("[NpcEventSession] NPC 비허용 분기 거절 event=" .. tostring(eventId))
			self:ReplyNpcBranch(requestId, eventId, false, userId)
			return
		end
		if tEvent.eventType == _EEventType.Dialog then
			tState:SetDialog(tEvent.dialogId, _NpcDialogGuard:GetDialogEventIds(tEvent.dialogId))
		elseif tEvent.eventType == _EEventType.Choice then
			tState.choiceEventId = eventId
			tState.choiceEventIds = _EventMaster:GetChoiceEventIds(eventId)
		elseif tEvent.eventType == _EEventType.MiniGame then
			tState.pendingMiniGameEventId = eventId
		end
		local success = _EventExecutor:ExecuteEvent(eventId, self.activeCharacterId, userId)
		tReceipt = tState.receipts[requestId]
		tReceipt.finished = true
		tReceipt.success = success
		if self.tDialogState ~= tState then return end
		self:ReplyNpcBranch(requestId, eventId, success, userId)
		if not success then self:RejectRunningSession(self.REJECT_EXECUTION_FAILED) end
	end

	@ExecSpace("ServerOnly")
	method string ClaimNpcReward(string eventId, string eventResultId, string userId)
		-- 승인된 분기를 한 번만 실행하고 소모품 지급은 인벤토리 영수증으로 중복 차단
		---@type NpcDialogState
		local tState = self.tDialogState
		if tState == nil or not self:IsBranchContextValid(self.activeSessionId, self.activeStepToken, userId)
			or not tState.executedEventIds[eventId] then return _NpcDialogGuard.REWARD_REJECTED end
		if tState.rewardClaims[eventId] then return _NpcDialogGuard.REWARD_DUPLICATE end
		local tEvent = _EventMaster:GetEvent(eventId)
		if tEvent == nil then return _NpcDialogGuard.REWARD_REJECTED end
		local tResult = _EventResultMaster:GetEventResult(eventResultId)
		if tResult ~= nil and tResult.value1Action == _EventResultMaster.ACTION_GRANT_CONSUMABLE then
			if not _EventCompletionManager:CanUseCompletions(userId) then return _NpcDialogGuard.REWARD_REJECTED end
			tState.rewardClaims[eventId] = true
			return _NpcDialogGuard.REWARD_CLAIMED
		end
		local characterId = (tEvent.characterId or "") ~= "" and tEvent.characterId or self.activeCharacterId
		local claim = _EventCompletionManager:ClaimNpcReward(tState.rootEventId, eventId, characterId, userId)
		if claim ~= _NpcDialogGuard.REWARD_REJECTED then tState.rewardClaims[eventId] = true end
		return claim
	end

	@ExecSpace("ServerOnly")
	method void FinishNpcMiniGame(string eventId, boolean cancelled)
		-- 미니게임 완료 후 분기 대기를 정리하고 취소 시 NPC 세션 종료
		if self.tDialogState == nil or self.tDialogState.pendingMiniGameEventId ~= eventId then return end
		self.tDialogState.pendingMiniGameEventId = ""
		if cancelled then self:RejectRunningSession(self.REASON_CANCELLED) end
	end

	@ExecSpace("ServerOnly")
	method void ReplyNpcBranch(string requestId, string eventId, boolean success, string userId)
		-- 승인 결과와 현재 표시 상태를 plain table 응답으로 전달
		local tResponse = NpcRequestState()
		tResponse.sessionId = self.activeSessionId
		tResponse.stepToken = self.activeStepToken
		tResponse.eventId = eventId
		tResponse.success = success
		if self.tDialogState ~= nil then
			tResponse.dialogId = self.tDialogState.dialogId
			tResponse.choiceEventId = self.tDialogState.choiceEventId
		end
		if not success then tResponse.reason = self.REJECT_UNAUTHORIZED_BRANCH end
		self:SyncNpcBranchResponse(requestId, tResponse:ToPlainTable(), userId)
	end

	@ExecSpace("ServerOnly")
	method void ReplayNpcPresentation(string userId)
		-- 시작 또는 단계 응답 재전송 시 누락된 대화와 선택지도 함께 복구
		self:ReplyNpcBranch("", "", true, userId)
	end

	@ExecSpace("ClientOnly")
	method void BindClientSession(string sessionId, string stepToken, string npcId)
		-- 컴포넌트에서 검증한 세션 식별자만 대화 RPC 라우팅에 사용
		if self.tClientSession == nil or self.tClientSession.sessionId ~= sessionId then
			self.tClientSession = NpcRequestState()
			self.clientSessionElapsed = 0
		end
		self.tClientSession.sessionId = sessionId
		self.tClientSession.stepToken = stepToken
		self.tClientSession.npcId = npcId
		if self.tClientBranchRequest == nil and #self.clientQueuedEventIds > 0 then
			self:TryRequestNpcEvent(table.remove(self.clientQueuedEventIds, 1))
		end
	end

	@ExecSpace("ClientOnly")
	method boolean TryRequestNpcEvent(string eventId)
		-- 활성 NPC 대화의 이벤트를 토큰을 포함한 전용 RPC로 순서대로 전송
		if self.tClientSession == nil or self.tClientSession.sessionId == "" then
			local player = _UserService.LocalPlayer
			local map = isvalid(player) and player.CurrentMap or nil
			if not isvalid(map) then return false end
			for _, component in ipairs(map:GetChildComponentsByTypeName("script.NpcEventTriggerComponent", true)) do
				if component.IsExecutingEvent and component.pendingInteractionRequestId ~= "" then
					for _, queuedId in ipairs(self.clientQueuedEventIds) do if queuedId == eventId then return true end end
					if #self.clientQueuedEventIds < 32 then table.insert(self.clientQueuedEventIds, eventId) end
					return true
				end
			end
			return false
		end
		if self.tClientBranchRequest ~= nil then
			if self.tClientBranchRequest.eventId ~= eventId and #self.clientQueuedEventIds < 32 then
				for _, queuedId in ipairs(self.clientQueuedEventIds) do if queuedId == eventId then return true end end
				table.insert(self.clientQueuedEventIds, eventId)
			end
			return true
		end
		local tRequest = NpcRequestState()
		tRequest.requestId = self:CreateClientRequestId("npc-branch")
		tRequest.sessionId = self.tClientSession.sessionId
		tRequest.stepToken = self.tClientSession.stepToken
		tRequest.eventId = eventId
		self.tClientBranchRequest = tRequest
		self:SendClientBranchRequest()
		return true
	end

	@ExecSpace("ClientOnly")
	method void SendClientBranchRequest()
		-- 재시도에서도 동일 요청 ID와 세션 토큰 유지
		local tRequest = self.tClientBranchRequest
		if tRequest == nil then return end
		self:RequestExecuteNpcEvent(tRequest.sessionId, tRequest.stepToken, tRequest.requestId, tRequest.eventId)
	end

	@ExecSpace("ClientOnly")
	method boolean HasPendingBranchRequests()
		-- 대화 종료보다 먼저 분기 응답과 전송 큐가 정리됐는지 확인
		return self.tClientBranchRequest ~= nil or #self.clientQueuedEventIds > 0
	end

	@ExecSpace("Client")
	method void SyncNpcBranchResponse(string requestId, table tPlainResponse)
		-- 늦은 응답을 무시하고 응답 유실로 누락된 화면 및 완료 알림 복구
		local tResponse = NpcRequestState():FromPlainTable(tPlainResponse)
		if self.tClientSession == nil or tResponse.sessionId ~= self.tClientSession.sessionId
			or tResponse.stepToken ~= self.tClientSession.stepToken then return end
		if requestId ~= "" then
			if self.tClientBranchRequest == nil or self.tClientBranchRequest.requestId ~= requestId then return end
			self.tClientBranchRequest = nil
		end
		if not tResponse.success then self:EndClientSession(tResponse.reason, true) return end
		local tEvent = _EventMaster:GetEvent(tResponse.eventId)
		if requestId == "" or (tEvent ~= nil and (tEvent.eventType == _EEventType.Dialog or tEvent.eventType == _EEventType.Choice)) then
			self:RestoreClientPresentation(tResponse)
		end
		if tEvent ~= nil and tEvent.eventType == _EEventType.Straight then
			local completed = EventExecutionCompletedEvent()
			completed.eventId = tResponse.eventId
			completed.isSuccess = true
			_EventExecutor:SendEvent(completed)
		end
		if self.tClientBranchRequest == nil and #self.clientQueuedEventIds > 0 then
			self:TryRequestNpcEvent(table.remove(self.clientQueuedEventIds, 1))
		end
	end

	@ExecSpace("ClientOnly")
	method void RestoreClientPresentation(NpcRequestState tResponse)
		-- 이미 열린 대화는 유지하고 유실된 대화 또는 선택지만 다시 표시
		if tResponse.dialogId ~= "" and _DialogUILogic ~= nil
			and (_DialogUILogic.currentDialogId ~= tResponse.dialogId or not _DialogUILogic:IsDialogOpen()) then
			local tOptions = DialogOpenOptions()
			tOptions.dialogId = tResponse.dialogId
			_DialogUILogic:Open(tOptions)
		end
		if tResponse.choiceEventId ~= "" and _ChoiceEventUILogic ~= nil and #self.clientQueuedEventIds == 0
			and #(_ChoiceEventUILogic.tChoiceEventIds or {}) == 0 then
			_ChoiceEventUILogic:Open(_EventMaster:GetChoiceEventIds(tResponse.choiceEventId), "")
		end
	end

	@ExecSpace("ClientOnly")
	method void UpdateClientRequests(number delta)
		-- 응답 유실은 제한 횟수 재전송 후 대화와 조작 잠금 복구
		if self.tClientSession == nil then return end
		self.clientSessionElapsed += math.max(delta, 0)
		if self.clientSessionElapsed >= self.SESSION_TIMEOUT_SECONDS then self:EndClientSession(self.REJECT_TIMEOUT, true) return end
		local tRequest = self.tClientBranchRequest
		if tRequest == nil or not tRequest:ShouldRetry(delta, self.REQUEST_TIMEOUT_SECONDS) then return end
		if tRequest.retryCount >= self.MAX_REQUEST_RETRIES then
			self:EndClientSession(self.REJECT_TIMEOUT, true)
			return
		end
		tRequest.retryCount += 1
		self:SendClientBranchRequest()
	end

	@ExecSpace("ClientOnly")
	method void ClearClientSession(string sessionId)
		-- 종료한 세션의 늦은 응답과 전송 대기를 폐기
		if self.tClientSession == nil then
			if sessionId == "" then self.clientQueuedEventIds = {} end
			return
		end
		if self.tClientSession.sessionId ~= sessionId then return end
		self.tClientSession = nil
		self.tClientBranchRequest = nil
		self.clientQueuedEventIds = {}
		self.clientSessionElapsed = 0
	end

	@ExecSpace("ClientOnly")
	method void EndClientSession(string reason, boolean cancelServer)
		-- 현재 NPC 세션만 취소하고 관련 대화와 선택지 및 조작 잠금 해제
		local tSession = self.tClientSession
		if tSession == nil then return end
		self:ClearClientSession(tSession.sessionId)
		if cancelServer then self:RequestCancelNpcInteraction(tSession.sessionId) end
		local player = _UserService.LocalPlayer
		local map = isvalid(player) and player.CurrentMap or nil
		if isvalid(map) then
			for _, component in ipairs(map:GetChildComponentsByTypeName("script.NpcEventTriggerComponent", true)) do
				if component.npcId == tSession.npcId then component:OnServerSessionEnded(tSession.sessionId, false, reason) end
			end
		end
		if _ChoiceEventUILogic ~= nil then _ChoiceEventUILogic:Close() end
		if _DialogUILogic ~= nil and _DialogUILogic:IsDialogOpen() then _DialogUILogic:Close() end
		if _NpcInteractionGateLogic ~= nil then _NpcInteractionGateLogic:Unhold("interaction") end
		log("[NpcEventSession] NPC 응답 대기 복구 reason=" .. reason)
	end

end

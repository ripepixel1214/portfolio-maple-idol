-- 상점 상품 데이터 조회와 원본 행 검증
@Logic
script ShopItemMaster extends Logic

	property boolean IsLoaded = false

	property string TABLE_SHOP_ITEMS = "ShopItemTable"
	property string CATEGORY_PACKAGE = "package"
	property string CATEGORY_NIGHT_MARKET = "nightMarket"
	property string NIGHT_MARKET_COOKIE_ITEM_ID = "heart_flutter_cookie"
	property integer DRAW_WEIGHT_TOTAL = 10000
	property string ALBUM_FRAGMENT_ITEM_ID = "album_fragment"
	property string LEGACY_DRAW_POINTS_ITEM_ID = "album_gacha_pity_point"
	property string DRAW_EXCHANGE_PRODUCT_ID = "package_album_1_draw"
	property string PACKAGE_COSTUME_SEPARATOR = "|"
	property table COSTUME_CATEGORIES = { hair = true, clothes = true, shoes = true, hat = true, goods = true }
	-- 숫자 변환 후 정밀도를 보장하는 최대 정수
	property integer MAX_EXACT_PRICE = 9007199254740991
	property string COIN_TYPE_MESO = "meso"
	property string COIN_TYPE_DIAMOND = "diamond"
	property string COIN_TYPE_NIGHT_MARKET = "nightMarketCoin"
	property string COIN_TYPE_LEGACY_WORLD_COIN = "worldCoin"

	-- ShopItemRow 목록입니다(테이블 행 순서 유지).
	property any tShopItems = {}

	-- { [shopItemId:string] = ShopItemRow }
	property any tShopItemById = {}

	-- { [category:string] = ShopItemRow[] }
	property any tShopItemsByCategory = {}

	method void OnBeginPlay()
		-- 로직 시작 시 ShopItemTable을 읽어 상점 아이템 데이터를 캐싱합니다.
		self:LoadShopItems()
	end

	method void LoadShopItems()
		-- 중복 ID와 잘못된 행을 제외한 상품 목록 구성
		self.tShopItems = {}
		self.tShopItemById = {}
		self.tShopItemsByCategory = {}
		self.IsLoaded = false

		local dataSet = _DataService:GetTable(self.TABLE_SHOP_ITEMS)
		if dataSet == nil then
			log_warning("[ShopItemMaster] ShopItemTable not found")
			return
		end

		local rowCount = dataSet:GetRowCount()
		local columns = {}
		if rowCount > 0 then
			for _, column in ipairs(dataSet.Columns:ToTable()) do
				columns[column] = true
			end
		end
		local tIdCounts = {}
		for rowIndex = 1, rowCount do
			local shopItemId = _DataTableUtil:SafeGetString(dataSet, rowIndex, "shopItemId", "")
			tIdCounts[shopItemId] = (tIdCounts[shopItemId] or 0) + 1
		end

		for rowIndex = 1, rowCount do
			local shopItemId = _DataTableUtil:SafeGetString(dataSet, rowIndex, "shopItemId", "")
			local tShopItem = nil
			if shopItemId == "" or tIdCounts[shopItemId] ~= 1 then
				log_warning("[ShopItemMaster] invalid or duplicate shopItemId row=" .. tostring(rowIndex) .. " id=" .. shopItemId)
			else
				tShopItem = self:ReadShopItem(dataSet, rowIndex, columns)
			end
			if tShopItem ~= nil then
				table.insert(self.tShopItems, tShopItem)
				self.tShopItemById[shopItemId] = tShopItem
			end
		end

		local validItems = {}
		for _, tShopItem in ipairs(self.tShopItems) do
			if tShopItem.category == self.CATEGORY_PACKAGE and (not self:HasValidPackageCostumes(tShopItem) or not self:HasValidDrawDrops(tShopItem)) then
				self.tShopItemById[tShopItem.shopItemId] = nil
				log_warning("[ShopItemMaster] invalid package reward references id=" .. tShopItem.shopItemId)
			else
				table.insert(validItems, tShopItem)
				if self.tShopItemsByCategory[tShopItem.category] == nil then
					self.tShopItemsByCategory[tShopItem.category] = {}
				end
				table.insert(self.tShopItemsByCategory[tShopItem.category], tShopItem)
			end
		end
		self.tShopItems = validItems
		self.IsLoaded = true
	end

	method boolean HasValidPackageCostumes(any tPackage)
		-- 상점 행을 모두 읽은 뒤 실지급 가능한 치장 참조만 허용
		local seen = {}
		for _, id in ipairs(tPackage.packageCostumeIds) do
			local tCostume = self.tShopItemById[id]
			if tCostume == nil or not self.COSTUME_CATEGORIES[tCostume.category] or tCostume.characterId ~= ""
				or tCostume.grantItemId ~= "" or seen[id] then return false end
			seen[id] = true
		end
		return true
	end

	method any ParseDrawDrops(string pool)
		-- 항목별 보상 ID, 수량, 확률, 중복 포인트, 교환 비용 해석
		local drops = {}
		if pool == "" then return drops end
		local rawEntries = {}
		local total = 0
		local seen = {}
		for entry in string.gmatch(pool, "[^|]+") do
			local id, quantity, weight, duplicate, exchange = string.match(entry, "^([%w_%-]+):(%d+):(%d+):(%d+):(%d+)$")
			if id == nil or #id > 100 then return nil end
			local count = tonumber(quantity)
			local units = tonumber(weight)
			local points = tonumber(duplicate)
			local cost = tonumber(exchange)
			local key = id .. ":" .. tostring(count)
			if seen[key] or #drops >= 100 or units <= 0 or units > self.DRAW_WEIGHT_TOTAL
				or not _ItemStorage:IsValidStackCount(count) or not _ItemStorage:IsValidStackCount(points)
				or not _ItemStorage:IsValidStackCount(cost) then return nil end
			if count == 0 and (points <= 0 or cost <= 0) then return nil end
			if count > 0 and (points ~= 0 or cost ~= 0) then return nil end
			seen[key] = true
			total = total + units
			table.insert(rawEntries, entry)
			table.insert(drops, { id = id, count = count, weight = units, duplicateFragments = points, exchangeCost = cost })
		end
		if total ~= self.DRAW_WEIGHT_TOTAL or table.concat(rawEntries, self.PACKAGE_COSTUME_SEPARATOR) ~= pool then return nil end
		return drops
	end

	method boolean HasValidDrawDrops(any tShopItem)
		if #tShopItem.drawDrops == 0 then return true end
		if not _ItemMaster:IsConsumable(_ItemMaster:GetItemById(self.ALBUM_FRAGMENT_ITEM_ID)) then return false end
		for _, tDrop in ipairs(tShopItem.drawDrops) do
			if tDrop.count == 0 then
				local tCostume = self.tShopItemById[tDrop.id]
				if tCostume == nil or not tCostume.packageOnly or not self.COSTUME_CATEGORIES[tCostume.category] then return false end
			elseif not _ItemMaster:IsConsumable(_ItemMaster:GetItemById(tDrop.id)) then return false end
		end
		return true
	end

	@ExecSpace("ServerOnly")
	method any RollDrawDrop(any tPackage)
		local roll = _UtilLogic:RandomIntegerRange(1, self.DRAW_WEIGHT_TOTAL)
		for _, tDrop in ipairs(tPackage.drawDrops) do
			roll = roll - tDrop.weight
			if roll <= 0 then return tDrop end
		end
		return nil
	end

	method table GetDrawExchangeDrops()
		local tPackage = self:GetShopItemById(self.DRAW_EXCHANGE_PRODUCT_ID)
		local drops = {}
		if tPackage == nil then return drops end
		for _, tDrop in ipairs(tPackage.drawDrops) do
			if tDrop.count == 0 then table.insert(drops, tDrop) end
		end
		return drops
	end

	method integer GetDrawExchangeCost(string shopItemId)
		for _, tDrop in ipairs(self:GetDrawExchangeDrops()) do
			if tDrop.id == shopItemId then return tDrop.exchangeCost end
		end
		return 0
	end

	method string ReadOptionalShopCell(any dataSet, integer rowIndex, table columns, string key, string defaultValue)
		-- 기존 시트에 아직 없는 선택 열은 네이티브 셀 조회 생략
		if columns[key] ~= true then return defaultValue end
		return _DataTableUtil:SafeGetString(dataSet, rowIndex, key, defaultValue)
	end

	method any ReadShopItem(any dataSet, integer rowIndex, table columns)
		-- 결제 금액을 임의 보정하지 않고 필수 값과 참조 검사
		local tShopItem = ShopItemRow()
		tShopItem.shopItemId = _DataTableUtil:SafeGetString(dataSet, rowIndex, "shopItemId", "")
		tShopItem.nameKey = _DataTableUtil:SafeGetString(dataSet, rowIndex, "nameKey", "")
		tShopItem.category = _DataTableUtil:SafeGetString(dataSet, rowIndex, "category", "")
		tShopItem.characterId = _DataTableUtil:SafeGetString(dataSet, rowIndex, "characterId", "")
		tShopItem.coinType = _DataTableUtil:SafeGetString(dataSet, rowIndex, "coinType", "")
		tShopItem.ruid = _DataTableUtil:SafeGetString(dataSet, rowIndex, "ruid", "")
		tShopItem.grantItemId = self:ReadOptionalShopCell(dataSet, rowIndex, columns, "grantItemId", "")
		local packageOnly = string.lower(self:ReadOptionalShopCell(dataSet, rowIndex, columns, "packageOnly", "false"))
		tShopItem.packageOnly = packageOnly == "true"
		local costumeIds = self:ReadOptionalShopCell(dataSet, rowIndex, columns, "packageCostumeIds", "")
		local isPackage = tShopItem.category == self.CATEGORY_PACKAGE
		local isNightMarket = tShopItem.category == self.CATEGORY_NIGHT_MARKET
		-- 원본의 지급 키에서 야시장 코인 교환을 인벤토리 지급과 분리
		if isNightMarket and tShopItem.grantItemId == self.COIN_TYPE_NIGHT_MARKET then
			tShopItem.grantCurrencyId = self.COIN_TYPE_NIGHT_MARKET
			tShopItem.grantItemId = ""
		end
		local drops = self:ParseDrawDrops(self:ReadOptionalShopCell(dataSet, rowIndex, columns, "drawPool", ""))
		local parsedCostumeIds = {}
		if costumeIds ~= "" then
			for id in string.gmatch(costumeIds, "[^" .. self.PACKAGE_COSTUME_SEPARATOR .. "]+") do
				table.insert(parsedCostumeIds, id)
			end
		end
		local grantCount = tonumber(self:ReadOptionalShopCell(dataSet, rowIndex, columns, "grantCount", "0"))
		local priceValue = tonumber(_DataTableUtil:SafeGetString(dataSet, rowIndex, "price", ""))
		local widthValue = tonumber(_DataTableUtil:SafeGetString(dataSet, rowIndex, "width", "0"))
		local heightValue = tonumber(_DataTableUtil:SafeGetString(dataSet, rowIndex, "height", "0"))
		local invalidReason = ""
		if tShopItem.shopItemId == "" or tShopItem.nameKey == "" or tShopItem.category == "" then
			invalidReason = "missing required ID/nameKey/category"
		elseif self:IsSupportedCoinType(tShopItem.coinType) == false then
			invalidReason = "unknown coinType=" .. tShopItem.coinType
		elseif self:IsNonNegativeFiniteNumber(priceValue) == false then
			invalidReason = "invalid price"
		elseif priceValue > self.MAX_EXACT_PRICE then
			invalidReason = "price exceeds exact integer range"
		elseif priceValue ~= math.floor(priceValue) then
			invalidReason = "fractional price"
		elseif self:IsNonNegativeFiniteNumber(widthValue) == false or self:IsNonNegativeFiniteNumber(heightValue) == false then
			invalidReason = "invalid display size"
		elseif drops == nil then
			invalidReason = "invalid drawPool"
		elseif #drops > 0 and (not isPackage or tShopItem.coinType ~= self.COIN_TYPE_DIAMOND
			or costumeIds ~= "" or tShopItem.grantItemId ~= "") then
			invalidReason = "draw package requires diamond price and a dedicated pool"
		elseif isPackage and (tShopItem.packageOnly or tShopItem.characterId ~= "" or priceValue == 0
			or (#drops == 0 and (costumeIds == "") == (tShopItem.grantItemId == ""))) then
			invalidReason = "invalid package grant"
		elseif costumeIds ~= "" and (not isPackage or #parsedCostumeIds > 20
			or table.concat(parsedCostumeIds, self.PACKAGE_COSTUME_SEPARATOR) ~= costumeIds) then
			invalidReason = "invalid packageCostumeIds"
		elseif isNightMarket and (tShopItem.ruid == "" or priceValue <= 0 or tShopItem.characterId ~= ""
			or (tShopItem.coinType ~= self.COIN_TYPE_MESO and tShopItem.coinType ~= self.COIN_TYPE_NIGHT_MARKET)
			or packageOnly ~= "false" or not _ItemStorage:IsValidStackCount(grantCount) or grantCount <= 0
			or (tShopItem.grantCurrencyId ~= "" and tShopItem.coinType ~= self.COIN_TYPE_MESO)
			or (tShopItem.grantCurrencyId == "" and tShopItem.grantItemId ~= self.NIGHT_MARKET_COOKIE_ITEM_ID)) then
			invalidReason = "invalid night market grant"
		elseif not tShopItem.packageOnly and packageOnly ~= "false" then
			invalidReason = "invalid packageOnly"
		elseif tShopItem.packageOnly and (not self.COSTUME_CATEGORIES[tShopItem.category] or tShopItem.characterId ~= "" or tShopItem.grantItemId ~= "") then
			invalidReason = "packageOnly requires a costume"
		elseif tShopItem.grantItemId ~= "" then
			local tGrantItem = _ItemMaster:GetItemById(tShopItem.grantItemId)
			if tShopItem.characterId ~= "" or not _ItemMaster:IsConsumable(tGrantItem)
				or #tShopItem.grantItemId > 100 or not _ItemStorage:IsValidStackCount(grantCount) or grantCount == 0 then
				invalidReason = "invalid consumable grant"
			end
		elseif tShopItem.grantCurrencyId == "" and grantCount ~= 0 then
			invalidReason = "grantCount requires grantItemId"
		elseif tShopItem.characterId ~= "" then
			if _CharacterBaseStatMaster == nil or _CharacterBaseStatMaster:GetCharacterBaseStat(tShopItem.characterId) == nil
				or _ActorMaster == nil or _ActorMaster:GetActor(tShopItem.characterId) == nil then
				invalidReason = "unknown characterId=" .. tShopItem.characterId
			end
		elseif not isPackage and tShopItem.ruid == "" then
			invalidReason = "missing costume ruid"
		end
		if invalidReason ~= "" then
			log_warning("[ShopItemMaster] rejected row=" .. tostring(rowIndex) .. " id=" .. tShopItem.shopItemId .. " reason=" .. invalidReason)
			return nil
		end

		tShopItem.price = math.floor(priceValue)
		tShopItem.grantCount = grantCount
		tShopItem.packageCostumeIds = parsedCostumeIds
		tShopItem.drawDrops = drops
		tShopItem.width = widthValue
		tShopItem.height = heightValue
		if self:IsClient() then tShopItem.name = _LocaleTextUtil:GetText(tShopItem.nameKey) end
		return tShopItem
	end

	method boolean IsSupportedCoinType(string coinType)
		-- 기존 임시 월드 코인은 데이터 이전 전까지 호환 유지
		return coinType == self.COIN_TYPE_MESO or coinType == self.COIN_TYPE_DIAMOND
			or coinType == self.COIN_TYPE_NIGHT_MARKET or coinType == self.COIN_TYPE_LEGACY_WORLD_COIN
	end

	method boolean IsNonNegativeFiniteNumber(any value)
		-- 누락 값과 음수, NaN, 무한대 거부
		return type(value) == "number" and value == value and value >= 0 and value < math.huge
	end

	method any GetShopItems()
		-- 테이블 행 순서를 유지한 전체 ShopItemRow 목록을 반환합니다.
		self:EnsureLoaded()
		return self.tShopItems
	end

	method any GetShopItemsByCategory(string category)
		-- 지정한 category의 ShopItemRow 목록을 반환합니다. 비어 있으면 전체를 반환합니다.
		self:EnsureLoaded()
		if category == nil or category == "" then
			return self.tShopItems
		end

		return self.tShopItemsByCategory[category] or {}
	end

	method any GetShopItemById(string shopItemId)
		-- shopItemId에 해당하는 ShopItemRow를 반환합니다.
		self:EnsureLoaded()
		if shopItemId == nil or shopItemId == "" then
			return nil
		end

		return self.tShopItemById[shopItemId]
	end

	method Vector2 GetDisplaySize(string shopItemId)
		-- shopItemId의 상점 표시 크기(width, height)를 Vector2로 반환합니다. 없으면 (0, 0)입니다.
		self:EnsureLoaded()
		local tShopItem = self.tShopItemById[shopItemId]
		if tShopItem == nil then
			return Vector2(0, 0)
		end

		return Vector2(tShopItem.width, tShopItem.height)
	end

	method void EnsureLoaded()
		-- 캐시가 비어 있으면 ShopItemTable을 다시 로드합니다.
		if self.IsLoaded == false then
			self:LoadShopItems()
		end
	end

end
